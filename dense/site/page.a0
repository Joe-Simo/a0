x48 "@media (max-width:640px){.nav,.fwrap,.home .wrap,.layout,.center,.docs .hero{padding-left:16px;padding-right:16px}.nav{gap:12px}.links{gap:12px}.nav .btn{display:none}.home section{padding:64px 0}.home .hero{padding:48px 0 56px}.home .chart,.chart{padding:16px}.brow{grid-template-columns:minmax(64px,92px) minmax(0,1fr) auto;gap:8px}.lrow,.lrow.wide{grid-template-columns:96px minmax(0,1fr)}.track{grid-template-columns:minmax(0,1fr) 60px}.row{grid-template-columns:minmax(0,1fr) auto}.row .lbl{grid-column:1/-1}.install{font-size:13px;padding-left:12px}}\n@media (max-width:400px){.links a[href^=\"https\"]{display:none}.theme{padding:0 8px}}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}\n\n"
