x45 "td.first{color:var(--fg);font-weight:700}\ntd.behind,td.loss,.val.loss,.ratio.loss{color:var(--mute)}\n.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:16px 0}\n.tile{border:1px solid var(--line);border-radius:10px;background:var(--card);padding:16px}\n.tile .n{font:700 28px var(--mono);color:var(--fg)}\n/* phone widths */\n@media (max-width:900px){.home .hero .wrap,.layout{grid-template-columns:minmax(0,1fr)}.rail{position:static;flex-direction:row;flex-wrap:wrap;gap:8px;max-height:none}.rail .rh{display:none}.rail a{padding:6px 12px;border:1px solid var(--line);border-radius:999px;font-size:13px}.toc{width:100%}.toc>summary{display:block}.toc[open]{display:flex;flex-wrap:wrap;gap:8px}}\n"
