use "sgstore.a0"

fn apb u32x128x512 u32 u32 -> u32x128x512
o hd A 111
w0 >> o 2
pi >> w0 7
wi and w0 127
pg get A pi
w get pg wi
b0 and o 3
sh << b0 3
v << C sh
w2 or w v
pg2 set pg wi w2
s1 set A pi pg2
o1 add o 1
r fold whd 1 s1 111 o1

fn apr u32x128x512 u32 u32 -> u32x128x512
pos add C B
b sb A pos
r fold apb 1 A b

fn apw u32x128x512 u32 u32 -> u32x128x512
s wstart A C
l wlen A C
r fold apr l A s

fn isws -> bool
lo ge A 9
hi le A 13
c and lo hi
sp eq A 32
r or c sp

fn wsmore u32 u32 u32x128x512 u32 -> bool
lt0 lt A D
b sb C A
w isws b
r and lt0 w

fn wsstep u32 u32 u32x128x512 u32 -> u32
r add A 1

fn tlmore u32 u32 u32x128x512 u32 -> bool
gt0 gt A D
w isws sb C sub A 1
r and gt0 w

fn tlstep u32 u32 u32x128x512 u32 -> u32
r sub A 1

fn apcond u32x128x512 u32 u32 u32 -> u32x128x512
one eq D 1
c1 select one 1 0
c2 select one 0 1
oth sub 399 C
s1 fold apw c1 A 204
s2 fold apw c1 s1 oth
s3 fold apw c1 s2 206
s4 fold apw c2 s3 205
s5 fold apw c2 s4 C
s6 fold apw c2 s5 207

fn apsel u32x128x512 u32 u32 u32 u32 u32 -> u32x128x512
n0 sub D C
s0 loop wsmore wsstep n0 C A D
n1 sub D s0
s1 loop tlmore tlstep n1 D A s0
ln sub s1 s0
long ge ln 5
rw wstart A 201
isr0 seq A s0 5 rw
isr and long isr0
cr select isr 1 0
cn select isr 0 1
a1 fold apw cr A 202
a2 fold apcond cr a1 E F
a3 fold apw cr a2 208
r5 add s0 5
l5 sub s1 r5
lr select isr l5 0
a4 fold apr lr a3 r5
b1 fold apw cn a4 203
b2 fold apcond cn b1 E F
b3 fold apw cn b2 209
lo select isr 0 ln
b4 fold apr lo b3 s0

fn segmore u32x128x512 u32 u32 u32 u32 u32 -> bool
r le hd A 113 D

fn segstep u32x128x512 u32 u32 u32 u32 u32 -> u32x128x512
a hd A 113
c sfind A a D 44
nf gt a C
cc select nf 1 0
s1 fold apb cc A 44
s2 fold apsel 1 s1 a c E F
c1 add c 1
s3 fold whd 1 s2 113 c1

fn rlmore u32x128x512 u32 u32 u32 u32 -> bool
r0 hd A 112
r lt r0 C

fn rlstep u32x128x512 u32 u32 u32 u32 -> u32x128x512
r hd A 112
lb sfind A r C 123
rb sfind A lb C 125
s1 fold whd 1 A 113 r
ns sub lb r
ns1 add ns 1
s2 loop segmore segstep ns1 s1 r lb D E
s3 fold apb 1 s2 123
d1 add lb 1
dl sub rb d1
s4 fold apr dl s3 d1
s5 fold apb 1 s4 125
rb1 add rb 1
s6 fold whd 1 s5 112 rb1

fn scope u32x128x512 u32 u32 u32 u32 u32 -> u32x128x512
s1 fold whd 1 A 112 C
n sub D C
r loop rlmore rlstep n s1 D E F

fn block u32x128x512 u32 u32 u32 u32 u32 -> u32x128x512
s1 fold apw 1 A 198
s2 fold apw 1 s1 D
s3 fold apb 1 s2 41
s4 fold apb 1 s3 123
s5 fold scope 1 s4 E F D 1
s6 fold apb 1 s5 125
s7 fold scope 1 s6 E F D 2

fn bemore u32 u32 u32x128x512 u32 -> bool
lt0 lt A D
b sb C A
ne0 ne b 125
r and lt0 ne0

fn bestep u32 u32 u32x128x512 u32 -> u32
c sfind C A D 125
r add c 1

fn csmore u32x128x512 u32 u32 -> bool
p hd A 110
r lt p C

fn csstep u32x128x512 u32 u32 -> u32x128x512
pos hd A 110
mw0 wstart A 198
ism seq A pos 29 mw0
m0 add pos 29
lw wstart A 199
dw wstart A 200
isl seq A m0 5 lw
isd seq A m0 4 dw
ml select isl 5 4
mw select isl 199 200
q add m0 ml
q1 add q 1
b0 sbis A q 41
b1 sbis A q1 123
paren and b0 b1
ld or isl isd
k0 and ism ld
blk and k0 paren
bs add q 2
n0 sub C bs
nb select blk n0 0
be loop bemore bestep nb bs A C
cb select blk 1 0
cc select blk 0 1
s1 fold apr cc A pos
s2 fold block cb s1 pos mw bs be
be1 add be 1
pos1 add pos 1
np select blk be1 pos1
s3 fold whd 1 s2 110 np

fn cssscope u32x128x512 u32 u32 u32 u32 -> u32x128x512
s1 fold whd 1 A 110 C
s2 fold whd 1 s1 111 E
e add C D
s3 loop csmore csstep D s2 e
o hd s3 111
n sub o E
s4 fold whd 1 s3 4 E
s5 fold whd 1 s4 5 n

