use "layout.a0"

fn rg u32x672 u32 u32 -> u32
b mul B 7
i add b C
v get A i

fn r_kind u32x672 u32 -> u32
f rg A B 5
k and f 255

fn r_vis u32x672 u32 -> bool
f rg A B 5
s >> f 8
b and s 1
r eq b 1

fn env_pred u32 u32 u32x672 u32 -> bool
r eq A 4294967295

fn env_step u32 u32 u32x672 u32 -> u32
id rg C B 0
hit eq id D
r select hit B A

fn env_find u32x672 u32 u32 -> u32
r loop env_pred env_step B 4294967295 A C

fn pg2vp
d sub A B
r << d 16

fn vp2pg
r add fx_sar A 16 B

fn edge_pt -> (u32,u32)
cx fx_clamp E A C
cy fx_clamp F B D
inx eq cx E
iny eq cy F
inside and inx iny
dl sub E A
dr sub C E
dt sub F B
db sub D F
m1 fx_min dl dr
m2 fx_min dt db
m fx_min m1 m2
isl eq m dl
isr eq m dr
ist eq m dt
ex2 select isr C E
ex select isl A ex2
ey4 select isr F D
ey5 select isl F ey4
ey6 select ist B ey5
rx select inside ex cx
ry select inside ey6 cy
r (rx ry)

fn edge_normal -> (u32,u32)
sx add A C
cx fx_sar sx 1
sy add B D
cy fx_sar sy 1
wx sub C A
hw fx_sar wx 1
wy sub D B
hh fx_sar wy 1
dx sub E cx
dy sub F cy
adx fx_abs dx
ady fx_abs dy
horiz fx_gt fx_mul adx hh fx_mul ady hw
nx0 fx_isneg dx
ny0 fx_isneg dy
sgx select nx0 4294901760 65536
sgy select ny0 4294901760 65536
nx select horiz sgx 0
ny select horiz 0 sgy
r (nx ny)

