fn open io u32 -> io write write A 1 B

fn close io -> io write A 3

fn mulstep u32 u32 -> u32
m mul A 10

fn tenpow
r fold mulstep A 1

fn digitstep u32 u32 u32 -> u32
s add A 1

fn morecheck -> bool
p tenpow A
fits lt C p
more select fits false true

fn ndigits
n loop morecheck digitstep 10 1 A

fn putdigit io u32 u32 u32 -> io
rest sub D B
pos sub rest 1
p tenpow pos
q div C p
d rem q 10
ch add d 48
t write A 2
u write t 1
v write u ch

fn putnum io u32 -> io
nd ndigits B
t fold putdigit nd A B nd

fn putfix io u32 -> io
ip div B 100
fp rem B 100
b write putnum A ip 2
dot "."
c puts b dot
tens div fp 10
ones rem fp 10
d0 add tens 48
d1 add ones 48
write write write write c 2 2 d0 d1

fn fill io u32 u32 -> io
c write write open A 5 4 2
cls "fill"
f write write puts c cls 12 1
num mul B 100
pct div num C
close write f pct

fn r_int io u32 u32 -> io
q div C 100
r putnum A q

fn r_one io u32 u32 -> io
q div C 100
b write putnum A q 2
dot "."
c puts b dot
tn div C 10
td rem tn 10
ch add td 48
write write write c 2 1 ch

fn r_two io u32 u32 -> io
r putfix A C

fn putratio io u32 -> io
big ge B 10000
mid ge B 1000
nb select big 1 0
nm0 select mid 1 0
nm select big 0 nm0
rest add nb nm
ns sub 1 rest
fold r_two ns fold r_one nm fold r_int nb A B B B

fn max3
ab lt A B
m1 select ab B A
mc lt m1 C
m2 select mc C m1

fn max2
ab lt A B
m select ab B A

