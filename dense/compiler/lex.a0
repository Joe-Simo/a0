fn isalpha -> bool
lo ge A 97
hi le A 122
a and lo hi
us eq A 95
r or a us

fn isdigit -> bool
lo ge A 48
hi le A 57
r and lo hi

fn isword -> bool
a isalpha A
d isdigit A
r or a d

fn isspace -> bool
sp eq A 32
tb eq A 9
cr eq A 13
r or or sp tb cr

