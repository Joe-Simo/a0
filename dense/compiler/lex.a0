fn lexstep -> (bool,u32,u32,u32,u32,u32,u32)
c mov C
isw isword c
isnl eq c 10
isq eq c 34
isbs eq c 92
ishash eq c 35
isminus eq c 45
isgt eq c 62
isat eq c 64
issp isspace c
k1 eq A 1
k2 eq A 2
k3 eq A 3
k6 eq A 6
k8 eq A 8
k5 eq A 5
k7 eq A 7
k9 eq A 9
inw or k1 k2
notw select isw false true
wclose and inw notw
escd eq E 1
notesc select escd false true
sq and k3 isq
sclose and sq notesc
cclose and k8 isnl
s57 or k5 k7
single or s57 k9
arrow and k6 isgt
e0 or wclose sclose
e1 or e0 single
emit or e1 k6
c0 or e0 cclose
c1 or c0 single
closed or c1 k6
consumed or sclose arrow
ek0 select k6 6 A
ek1 select arrow 4 ek0
ek select sclose 3 ek1
s1 add B 1
es select sclose s1 B
wl sub D B
sl sub wl 1
l0 select arrow 2 1
l1 select sclose sl l0
el select wclose wl l1
k0 eq A 0
none or k0 closed
notcons select consumed false true
free and none notcons
isd isdigit c
wk select isd 2 1
n0 select issp 0 9
n1 select isat 7 n0
n2 select isminus 6 n1
n3 select isnl 5 n2
n4 select ishash 8 n3
n5 select isq 3 n4
n6 select isw wk n5
cont select closed 0 A
nk select free n6 cont
ns select free D B
e2 select isbs 1 0
e3 select escd 0 e2
esc select k3 e3 0
r (emit ek es el nk ns esc)

fn lexbyte (u32x128x4,u32,u32,u32,u32) u32 u32x128 u32 -> (u32x128x4,u32,u32,u32,u32)
w at A 0
f at A 1
pk at A 2
ps at A 3
esc at A 4
c get C B
i add D B
d lexstep pk ps c i esc
emit at d 0
ek at d 1
es at d 2
el at d 3
h0 >> f 7
l0 and f 127
g0 get w h0
g0b set g0 l0 ek
w1 set w h0 g0b
f1 add f 1
h1 >> f1 7
l1 and f1 127
g1 get w1 h1
g1b set g1 l1 es
w2 set w1 h1 g1b
f2 add f 2
h2 >> f2 7
l2 and f2 127
g2 get w2 h2
g2b set g2 l2 el
w3 set w2 h2 g2b
f3 add f 3
fn1 select emit f3 f
nk at d 4
ns at d 5
$ne at d 6
r (w3 fn1 nk ns $ne)

fn lexpage (u32x128x384,u32,u32,u32,u32) u32 u32x512x64 u32 -> (u32x128x384,u32,u32,u32,u32)
out at A 0
nout at A 1
pg srcpg C B
base mul B 128
rest sub D base
big gt rest 128
cnt select big 128 rest
hi >> nout 7
f0 and nout 127
last get out hi
w0 [last last last last]
pk at A 2
ps at A 3
esc at A 4
s0 (w0 f0 pk ps esc)
s fold lexbyte cnt s0 pg base
w at s 0
f at s 1
c0f gt f 0
i0 add hi 0
c0t lt i0 384
c0 and c0f c0t
v0 get w 0
o0 get out i0
x0 select c0 v0 o0
out0 set out i0 x0
c1f gt f 128
i1 add hi 1
c1t lt i1 384
c1 and c1f c1t
v1 get w 1
o1 get out0 i1
x1 select c1 v1 o1
out1 set out0 i1 x1
c2f gt f 256
i2 add hi 2
c2t lt i2 384
c2 and c2f c2t
v2 get w 2
o2 get out1 i2
x2 select c2 v2 o2
out2 set out1 i2 x2
c3f gt f 384
i3 add hi 3
c3t lt i3 384
c3 and c3f c3t
v3 get w 3
o3 get out2 i3
x3 select c3 v3 o3
out3 set out2 i3 x3
lo sub nout f0
nout2 add lo f
nk at s 2
ns at s 3
$ne at s 4
r (out3 nout2 nk ns $ne)

fn tokput u32x128x384 u32 u32 bool -> u32x128x384
h >> B 7
l and B 127
g get A h
o get g l
in lt h 384
w and D in
v select w C o
g2 set g l v
t set A h g2

fn tokput3 u32x128x384 u32 u32 u32 u32 bool -> u32x128x384
h0 >> B 7
l0 and B 127
g0 get A h0
o0 get g0 l0
v0 select F C o0
g0b set g0 l0 v0
t0 set A h0 g0b
n1 add B 1
h1 >> n1 7
l1 and n1 127
g1 get t0 h1
o1 get g1 l1
v1 select F D o1
g1b set g1 l1 v1
t1 set t0 h1 g1b
n2 add B 2
h2 >> n2 7
l2 and n2 127
g2 get t1 h2
o2 get g2 l2
v2 select F E o2
g2b set g2 l2 v2
t2 set t1 h2 g2b

fn zpage -> u32x128
z [0;128]

fn zsrc -> u32x128x128
z zpage
t [z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z]

fn ztok -> u32x128x384
z zpage
t [z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z]

fn lexsrc u32x512x64 u32 -> (u32x128x384,u32)
zero ztok
n127 add B 127
np >> n127 7
s0 (zero 0 0 0 0)
s fold lexpage np s0 A B
out at s 0
nout at s 1
pk at s 2
ps at s 3
k1 eq pk 1
k2 eq pk 2
k5 eq pk 5
k6 eq pk 6
k7 eq pk 7
k9 eq pk 9
w or k1 k2
o0 or k5 k6
o1 or o0 k7
one or o1 k9
pend or w one
wlen sub B ps
len select w wlen 1
c tokput3 out nout pk ps len pend
n3 add nout 3
nf select pend n3 nout
r (c nf)

fn rbyte (u32x128,io) u32 -> (u32x128,io)
buf at A 0
tk at A 1
r read tk
v at r 0
t at r 1
nb set buf B v
out (nb t)

fn zpk -> u32x512
z [0;512]

fn zsrcp -> u32x512x64
z zpk
t [z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z]

fn rpkb (u32,u32,io) u32 -> (u32,u32,io)
w at A 0
sh at A 1
tk at A 2
r read tk
v at r 0
t at r 1
x << v sh
w2 or w x
sh2 add sh 8
o (w2 sh2 t)

fn rpkw (u32x512,io) u32 u32 u32 -> (u32x512,io)
pg at A 0
tk at A 1
b4 mul B 4
b add C b4
has lt b D
rest0 sub D b
rest select has rest0 0
big gt rest 4
cnt select big 4 rest
s0 (0 0 tk)
s fold rpkb cnt s0
w at s 0
t at s 2
pg2 set pg B w
r (pg2 t)

fn readpage (u32x512x64,io) u32 u32 u32x512 -> (u32x512x64,io)
src at A 0
tk at A 1
base mul B 2048
rest sub C base
r3 add rest 3
nw0 >> r3 2
big gt nw0 512
nw select big 512 nw0
s0 (D tk)
s fold rpkw nw s0 base C
pg at s 0
t at s 1
src2 set src B pg
r (src2 t)

fn readsrc io -> (u32x512x64,u32,io)
r0 read A
n0 at r0 0
t0 at r0 1
big lt 131072 n0
n select big 131072 n0
z zsrcp
zp zpk
n2047 add n 2047
np >> n2047 11
s0 (z t0)
s fold readpage np s0 n zp
src at s 0
t1 at s 1
r (src n t1)

fn wword io u32 u32x128 -> io
v get C B
w write A v

fn wtok io u32 u32x128x384 u32 -> io
pg get C B
base mul B 128
rest sub D base
big gt rest 128
cnt select big 128 rest
w fold wword cnt A pg

fn lexio io -> u32
rs readsrc A
src at rs 0
n at rs 1
t1 at rs 2
lx lexsrc src n
out at lx 0
nout at lx 1
t2 write t1 nout
n127 add nout 127
np >> n127 7
t3 fold wtok np t2 out nout
nout

