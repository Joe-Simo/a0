l and B 127
g srcpg A h
v get g l

fn sg_tokat u32x128x384 u32 -> (u32,u32,u32)
w mul B 3
h0 >> w 7
l0 and w 127
g0 get A h0
k get g0 l0
w1 add w 1
h1 >> w1 7
l1 and w1 127
g1 get A h1
s get g1 l1
