fn sg_sugg u32x512x64 u32 u32x128x384 u32 u32 -> (u32,u32,u32,u32x64,u32,u32)
c0 (0 0 4294967295)
c fold sg_ctxstep E c0 C A
ls at c 0
fs at c 1
ft at c 2
