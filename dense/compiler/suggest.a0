noft eq ft 4294967295
notnl select isnl false true
firstft and noft notnl
ft2 select firstft B ft
r (ls2 fs2 ft2)

fn sg_tokstep (u32,u32x64,u32,bool,bool,bool) u32 u32x128x384 u32x512x64 u32 u32 u32 u32x64 u32 -> (u32,u32x64,u32,bool,bool,bool)
