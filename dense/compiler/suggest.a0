n get g2 l2
r (k s n)

fn sg_cpstep u32x64 u32 u32x512x64 u32 u32 -> u32x64
i0 add D B
v sg_srcb C i0
inr lt B E
x select inr v 0
r set A B x

fn sg_copy64 u32x512x64 u32 u32 -> u32x64
z sg_z64
r fold sg_cpstep 64 z A B C

fn sg_entstep (u32x64,u32,bool) u32 u32x328 u32 -> (u32x64,u32,bool)
buf at A 0
len at A 1
stop at A 2
i0 add D B
v get C i0
sp eq v 32
stop2 or stop sp
nstop select stop2 false true
live and nstop true
x select live v 0
buf2 set buf B x
len1 add len 1
len2 select live len1 len
r (buf2 len2 stop2)

fn sg_entry u32x328 u32 -> (u32x64,u32)
z sg_z64
s0 (z 0 false)
off mul B 8
s fold sg_entstep 8 s0 A off
buf at s 0
len at s 1
r (buf len)

fn sg_names -> u32x328
t "mov     add     sub     mul     and     or      xor     shl     shr     eq      ne      lt      le      gt      ge      select  call    fold    loop    arr     rec     get     set     at      put     read    write   div     rem     puts    udiv    urem    u32     bool    io      fn      ret     end     patch   true    false   "

fn sg_eqstep bool u32 u32x64 u32x64 u32 -> bool
a get C B
b get D B
inr lt B E
e eq a b
ok select inr e true
r and A ok

fn sg_eqbuf u32x64 u32 u32x64 u32 -> bool
same eq B D
f fold sg_eqstep 64 true A C B
r and same f

fn sg_cistep bool u32 u32x64 u32x64 u32 -> bool
a get C B
b get D B
la sg_lower a
lb sg_lower b
inr lt B E
e eq la lb
ok select inr e true
r and A ok

fn sg_cieq u32x64 u32 u32x64 u32 -> bool
same eq B D
f fold sg_cistep 64 true A C B
r and same f

fn sg_initstep u32x65 u32 -> u32x65
v mul B 10
r set A B v

fn sg_levcell (u32x65,u32) u32 u32x65 u32x64 u32 -> (u32x65,u32)
row at A 0
left at A 1
j add B 1
cb get D B
pj get C j
pd get C B
$eq eq E cb
la sg_lower E
lb sg_lower cb
leq eq la lb
c1 select leq 1 20
subc add pd c1
del add pj 10
ins add left 10
m1 sg_umin del ins
m2 sg_umin m1 subc
d select $eq pd m2
row2 set row j d
r (row2 d)

fn sg_levrow u32x65 u32 u32x64 u32x64 u32 -> u32x65
i1 add B 1
ca get C B
v0 mul i1 10
row0 set A 0 v0
s0 (row0 v0)
s fold sg_levcell E s0 A D ca
r at s 0

fn sg_lev u32x64 u32 u32x64 u32 -> u32
z sg_z65
init fold sg_initstep 65 z
row fold sg_levrow B init A C D
d get row D

fn sg_consider (u32,u32x64,u32,bool,bool,bool) u32x64 u32 bool u32x64 u32 -> (u32,u32x64,u32,bool,bool,bool)
bestd at A 0
bestb at A 1
bestl at A 2
exact at A 3
later at A 4
stop at A 5
same sg_eqbuf B C E F
hit and D same
exact2 or exact hit
big gt C F
d1 sub C F
d2 sub F C
diff select big d1 d2
n34 mul F 34
n34d div n34 100
maxd sg_umax 2 n34d
ok1 le diff maxd
nsame select same false true
short lt C 3
ci sg_cieq B C E F
nsh select short false true
ok3 or nsh ci
cnt and D ok1
cnt1 and cnt nsame
cnt2 and cnt1 ok3
rows select cnt2 F 0
dist sg_lev E rows B C
better lt dist bestd
take and cnt2 better
d3 select take dist bestd
b3 select take B bestb
l3 select take C bestl
r (d3 b3 l3 exact2 later stop)

fn sg_rowstep (u32,u32x64,u32,bool,bool,bool) u32 u32x328 u32 u32x64 u32 -> (u32,u32x64,u32,bool,bool,bool)
k add B D
e sg_entry C k
buf at e 0
len at e 1
r sg_consider A buf len true E F

fn sg_rows (u32,u32x64,u32,bool,bool,bool) u32 u32 u32x64 u32 -> (u32,u32x64,u32,bool,bool,bool)
t sg_names
r fold sg_rowstep C A t B D E

fn sg_anystep bool u32 u32x328 u32 u32x64 u32 -> bool
k add B D
e sg_entry C k
buf at e 0
len at e 1
q sg_eqbuf buf len E F
r or A q

fn sg_inrows u32 u32 u32x64 u32 -> bool
