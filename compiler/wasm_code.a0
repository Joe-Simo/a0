ck call wfzp1 cj p1 61699 s
ret ck
end
# the span check of a pair: trip t of the span from its set p5 (after = p6): the instruction at
# p5 + 1 + t has a depth plus low that is not below after, and does not end a taken pair (state
# F = p4, the end flag of position k at 22528 + k); the accumulator p0 is kept only then
fn wfzspan u32 u32 u32x128x512 u32x128x352 u32x128x512 u32 u32 -> u32
a add p5 1
b add a p1
c call wfzg p2 b
d shl b 1
e call wfzgi p3 d
f add d 1
g call wfzgi p3 f
h call wfzlow e g
i add c h
j ge i p6
k add b 22528
l call wfzg p4 k
m eq l 0
n and j m
o select n p0 0
ret o
end
# the first of the taken gets right before the get q = p3 (state F = p2): trip t looks at q - 1 - t
# and moves the accumulator there while the run of end flags from q down is unbroken
fn wfzfirst u32 u32 u32x128x512 u32 -> u32
a sub p3 p1
b eq p0 a
c sub a 1
d add c 22528
e call wfzg p2 d
f ne e 0
g and b f
h select g c p0
ret h
end
# Verification, one trip per position p1 in order (state F: word p is 1 when the instruction at p is
# removed, word 22528 + p is 1 when a taken pair's get ends at p; extras: the forward state W = p2,
# the list L = p3). The pair of p (word 22528 + p of W, minus 1) is taken when the depth at the first
# of the taken gets right before its get (wfzfirst; its own get when there are none) is the depth
# after the set (the set's depth minus 1) and every instruction up to there passes wfzspan.
fn wfzver u32x128x512 u32 u32x128x512 u32x128x352 -> u32x128x512
a add p1 22528
b call wfzg p2 a
c ne b 0
d sub b 1
e call wfzg p2 p1
f add e 4294967295
