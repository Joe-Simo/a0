m set p0 i l
ret m
end
# state: the code table; instruction p1 of the stackified list p2 (slot table p3, offsets p4, np
# p5, i32 locals p6) written at its offset
fn wfzcode u32x128x512 u32 u32x128x512 u32x128x512 u32x128x512 u32 u32 -> u32x128x512
