# Arena diagnostic rendering in canonical A0. Development A0S expands static catalog bytes.
use "check_arena.a0"
use "number_u56.a0"
use "number_integer.a0"
fn ad_appendgo (u32,(u32,u32,u32),io) u32 u32 u32x128 -> (u32,(u32,u32,u32),io)
q0 at p0 2
q1 at p0 1
q2 call av_append q0 q1 p2 p3
ret q2
end
fn ad_append (u32,(u32,u32,u32),io) u32 u32x128 -> (u32,(u32,u32,u32),io)
q0 at p0 0
q1 eq q0 0
q2 select q1 1 0
q3 fold ad_appendgo q2 p0 p1 p2
ret q3
end
fn ad_byte (u32,(u32,u32,u32),io) u32 -> (u32,(u32,u32,u32),io)
z call arena_zero
q0 set z 0 p1
q1 call ad_append p0 1 q0
ret q1
end
fn ad_copyok (u32,(u32,u32,u32),io) u32 u32 u32 u32 -> bool
q0 at p0 0
q1 eq q0 0
ret q1
end
fn ad_copypage (u32,(u32,u32,u32),io) u32 u32 u32 u32 -> (u32,(u32,u32,u32),io)
offset mul p1 128
remain sub p4 offset
q0 gt remain 128
n select q0 128 remain
q1 at p0 2
q2 add p3 offset
r call arena_load q1 p2 q2 n
q3 at r 0
q4 at p0 1
q5 at r 2
q6 rec q3 q4 q5
q7 at r 1
q8 call ad_append q6 n q7
ret q8
end
fn ad_copy (u32,(u32,u32,u32),io) u32 u32 u32 -> (u32,(u32,u32,u32),io)
q0 div p3 128
q1 rem p3 128
q2 eq q1 0
q3 select q2 0 1
q4 add q0 q3
q5 loop ad_copyok ad_copypage q4 p0 p1 p2 p3
ret q5
end
fn ad_string (u32,(u32,u32,u32),io) (u32,u32,u32) -> (u32,(u32,u32,u32),io)
q0 at p1 0
q1 at p1 1
q2 call ad_copy p0 q0 0 q1
ret q2
end
fn ad_numstep (u32,u32x128,u32) u32 -> (u32,u32x128,u32)
v at p0 0
q0 at p0 1
q1 rem v 10
q2 add 48 q1
page set q0 p1 q2
q3 ne v 0
q4 eq p1 0
q5 or q3 q4
q6 add p1 1
q7 at p0 2
count select q5 q6 q7
q8 div v 10
q9 rec q8 page count
ret q9
end
fn ad_numrev u32x128 u32 u32x128 u32 -> u32x128
q0 sub p3 1
q1 sub q0 p1
q2 get p2 q1
q3 set p0 p1 q2
ret q3
end
fn ad_number (u32,(u32,u32,u32),io) u32 -> (u32,(u32,u32,u32),io)
z call arena_zero
q0 rec p1 z 0
r fold ad_numstep 10 q0
q1 at r 2
q2 at r 1
q3 at r 2
page fold ad_numrev q1 z q2 q3
q4 at r 2
q5 call ad_append p0 q4 page
ret q5
end
