fn arena_diagnostic io u32x128 -> (u32,(u32,u32,u32),u32x128,io)
q0 call ad_render p0 p1 1
ret q0
end
fn arena_parse_diagnostic io u32 u32 -> (u32,(u32,u32,u32),u32x128,io)
checked call arena_parse_check p0 p1 p2
q0 at checked 2
q1 at checked 1
q2 call arena_diagnostic q0 q1
ret q2
end
fn arena_diagnostic_options io u32x128 u32 -> (u32,(u32,u32,u32),u32x128,io)
q0 call ad_render p0 p1 p2
ret q0
end
fn ad_parse_default (u32,(u32,u32,u32),u32x128,io) u32 u32 u32 -> (u32,(u32,u32,u32),u32x128,io)
q0 at p0 3
q1 call arena_parse_diagnostic q0 p2 p3
ret q1
end
fn ad_parse_configured (u32,(u32,u32,u32),u32x128,io) u32 u32 u32 u32 -> (u32,(u32,u32,u32),u32x128,io)
q0 at p0 3
checked call arena_parse_check q0 p2 p3
q1 at checked 2
q2 at checked 1
q3 call arena_diagnostic_options q1 q2 p4
ret q3
end
fn arena_parse_diagnostic_options io u32 u32 u32 -> (u32,(u32,u32,u32),u32x128,io)
q0 eq p3 1
q1 select q0 1 0
q2 rec 0 0 0
q3 call arena_zero
q4 rec 0 q2 q3 p0
a fold ad_parse_default q1 q4 p1 p2
q5 ne p3 1
q6 select q5 1 0
q7 fold ad_parse_configured q6 a p1 p2 p3
ret q7
end
