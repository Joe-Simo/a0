nt get ctx 12
nf get ctx 11
nn get ctx 13
typewords mul nt 2
width call sv_allocate_meta p0 0 6 typewords
typeio call sv_allocate_meta width 0 7 nt
seq call sv_allocate_meta typeio 0 8 nf
fnio call sv_allocate_meta seq 0 9 nf
stagewords mul nn 2
stages call sv_allocate_meta fnio 0 10 stagewords
functionwords mul nf 2
functions call sv_allocate_meta stages 0 14 functionwords
boundwords mul nn 20
bounds call sv_allocate_meta functions 0 15 boundwords
ret bounds
end
# Context slots0..5 input handles;11..13 full-u32 function/type/node counts.
# Checked-IR schema includes sentinel node0/argument records and topological type/call order.

fn sv_analyze io u32x16 -> ((u32,(u32,u32,u32),io),u32x16)
v rec 0 0 0
nt get p1 12
nf get p1 11
nn get p1 13
typesafe le nt 2147483647
fnsafe le nf 2147483647
nodesafe le nn 214748364
a and typesafe fnsafe
safe and a nodesafe
status select safe 0 7
start rec status v p0
checked loop sv_ok sv_checked_node nn start p1 0 0
initial rec checked p1
code at checked 0
okay eq code 0
times select okay 1 0
prepared fold sv_prepare_metadata times initial
s at prepared 0
ctx at prepared 1
types loop sv_ok sv_type_plan nt s ctx 0 0
initialized loop sv_ok sv_bound_init nn types ctx 0 0
facts loop sv_ok sv_bound_level 9 initialized ctx 0 0
planned loop sv_ok sv_plan_function nf facts ctx 0 0
result rec planned ctx
ret result
end

fn sv_emit io u32x16 -> (u32,(u32,u32,u32),io)
phase call sv_analyze p0 p1
planned at phase 0
ctx at phase 1
code at planned 0
okay eq code 0
times select okay 1 0
rendered fold sv_program times planned ctx 0 0
out call ew_public rendered
ret out
end

fn sv_emit_target (u32,(u32,u32,u32),io) u32 u32x16 -> (u32,(u32,u32,u32),io)
t at p0 2
r call sv_emit t p2
ret r
end

fn sv_emit_shaped io u32x16 u32x16 -> (u32,(u32,u32,u32),io)
phase call sv_analyze p0 p1
s at phase 0
ctx at phase 1
old at s 0
out at s 1
t at s 2
sourcecount get p1 11
targetcount get p2 11
same eq sourcecount targetcount
fits le targetcount 429496729
valid and same fits
bad select fits 6 7
code select valid 0 bad
okay eq old 0
status select okay code old
start rec status out t
go eq status 0
times select go 1 0
handle get p2 2
words mul targetcount 10
copied fold sv_clone_table times start handle words
copyvec at copied 1
copyhandle at copyvec 0
marked loop sv_clock_good sv_clock_flag targetcount copied ctx 0 0 copyhandle
status1 at marked 0
go1 eq status1 0
times1 select go1 1 0
target set p2 2 copyhandle
emitted fold sv_emit_target times1 marked target
result call ew_public emitted
ret result
end
