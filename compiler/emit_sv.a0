t at p0 2
s call ew_new t p3
whole shr p3 7
tail and p3 127
has ne tail 0
extra select has 1 0
pages add whole extra
r loop sv_clone_good sv_clone_page pages s p2 p3
ret r
end

fn sv_prepare_metadata ((u32,(u32,u32,u32),io),u32x16) u32 -> ((u32,(u32,u32,u32),io),u32x16)
