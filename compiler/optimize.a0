ta at s1 2
tv at s1 3
hdrs at s1 5
nsym at s1 7
umode at s1 10
uerr at s1 11
uetok at s1 12
nhdr at s1 15
uopen ne umode 0
uerr0 eq uerr 0
ueof and uerr0 uopen
e1 select ueof 1 uerr
et1 select ueof ntok uetok
s2 call pass2 p1 sinfo nsym
pool at s2 0
s3 call pass3 p1 toks ta hdrs nhdr e1 et1 ntok
types at s3 0
tlist at s3 2
hout at s3 4
ntypes at s3 5
ntlist at s3 6
e3 at s3 11
et3 at s3 12
nhc at s3 18
nhn at s3 19
s4 call pass4 hout nhn nhc
fns0 at s4 0
names at s4 1
derr at s4 2
dtok at s4 3
dup ne derr 0
e4 select dup derr e3
et4 select dup dtok et3
s5 call pass5 fns0 names p1 toks ta tv ntok e4 et4 0
fns at s5 0
nodes at s5 1
alo at s5 2
narg at s5 5
args call bodyargs alo narg fns0 names p1 toks ta tv ntok e4 et4
fcs at s1 7
fcu at s1 8
fcp at s2 1
fch at s3 19
fct at s3 5
fcl at s3 6
fcn at s5 4
ovr call fecap toks ntok fcs fcp fcu fch fct fcl fcn narg
pcode0 at s5 8
pcode select ovr 4 pcode0
# after a parse error the function count may be below p4: nothing is checked then
cfrom call cumin p4 nhc
ck call checkir types tlist fns nodes args p3 ntypes ntlist nhc cfrom
types2 at ck 0
tlist2 at ck 2
ntys at ck 4
fstat at ck 7
ntypes2 at ck 8
cerr at ck 10
ns127 add nsym 127
nsp shr ns127 7
z64 call z64
st0 rec z64 0
st fold cstpg nsp st0 sinfo
starts at st 0
z16 call z16
fnm fold cfnm nhc z16 fns sinfo starts
pok eq pcode 0
code select pok cerr pcode
ok eq code 0
e_lx call lexsrc p7 p8
e_toks at e_lx 0
e_nw at e_lx 1
e_ntok div e_nw 3
e_s1 call pass1 p7 e_toks e_ntok
e_sinfo at e_s1 1
e_ta at e_s1 2
e_tv at e_s1 3
e_hdrs at e_s1 5
e_nsym at e_s1 7
e_umode at e_s1 10
e_uerr at e_s1 11
e_uetok at e_s1 12
e_nhdr at e_s1 15
e_uopen ne e_umode 0
e_uerr0 eq e_uerr 0
e_ueof and e_uerr0 e_uopen
e_e1 select e_ueof 1 e_uerr
e_et1 select e_ueof e_ntok e_uetok
e_s3 call pass3 p7 e_toks e_ta e_hdrs e_nhdr e_e1 e_et1 e_ntok
e_types at e_s3 0
e_tlist at e_s3 2
e_hout at e_s3 4
e_ntypes at e_s3 5
e_ntlist at e_s3 6
e_e3 at e_s3 11
e_et3 at e_s3 12
e_nhc at e_s3 18
e_nhn at e_s3 19
e_s4 call pass4 e_hout e_nhn e_nhc
e_fns0 at e_s4 0
e_names at e_s4 1
e_derr at e_s4 2
e_dtok at e_s4 3
e_dup ne e_derr 0
e_e4 select e_dup e_derr e_e3
e_et4 select e_dup e_dtok e_et3
e_s5 call pass5 e_fns0 e_names p7 e_toks e_ta e_tv e_ntok e_e4 e_et4 0
e_fns at e_s5 0
e_nodes at e_s5 1
e_alo at e_s5 2
e_narg at e_s5 5
e_args call bodyargs e_alo e_narg e_fns0 e_names p7 e_toks e_ta e_tv e_ntok e_e4 e_et4
e_pcode0 at e_s5 8
e0 eq code 0
enz ne e_pcode0 0
ebad and e0 enz
code2 select ebad 1 code
ok2 eq code2 0
go select ok2 1 0
s0 rec p0 0
t fold ozemitst go s0 types2 tlist2 fns nodes args ntys pool fnm p5 fstat ntypes2 p4 nhc p6 narg e_fns e_nodes e_args p9
tk at t 0
oc at t 1
rc select ok2 oc code2
r rec tk rc
ret r
end
