# The forward pass (src/optimize.ts `optimizeFunction` up to dead-code elimination)

# operand p1 (of the node whose operands start at p4, first node p5) is still a literal
fn ozlit bool u32 u32x128x100 u32x128x512 u32 u32 -> bool
i add p4 p1
o_x mul i 2
o_k_p shr o_x 7
o_k_g get p3 o_k_p
o_k_w and o_x 127
o_k get o_k_g o_k_w
o_w1 add o_k_w 1
o_v get o_k_g o_w1
o_r rec o_k o_v
o mov o_r
ok at o 0
ov at o 1
r_g add p5 ov
r_sk_v_p shr r_g 7
r_sk_v_g get p2 r_sk_v_p
r_sk_v_w and r_g 127
r_sk_v get r_sk_v_g r_sk_v_w
r_sk mov r_sk_v
r_vi add 2816 r_g
r_sv_v_p shr r_vi 7
r_sv_v_g get p2 r_sv_v_p
r_sv_v_w and r_vi 127
r_sv_v get r_sv_v_g r_sv_v_w
r_sv mov r_sv_v
r_isn eq ok 1
r_hs ne r_sk 0
r_u and r_isn r_hs
r_k select r_u r_sk ok
r_v select r_u r_sv ov
r_r rec r_k r_v
r mov r_r
rk at r 0
l ge rk 3
a and p0 l
ret a
end
# original operand p1 has a type holding io (node types p3, parameter types tlist p4 from p8,
# type info p5 with io in bit 31)
fn ozio bool u32 u32x128x512 u32x128x24 u32x128x65 u32x128x65 u32 u32 u32 -> bool
i add p6 p1
o_x mul i 2
o_k_p shr o_x 7
o_k_g get p2 o_k_p
o_k_w and o_x 127
o_k get o_k_g o_k_w
o_w1 add o_k_w 1
o_v get o_k_g o_w1
o_r rec o_k o_v
o mov o_r
ok at o 0
ov at o 1
g add p7 ov
tn_v_p shr g 7
tn_v_g get p3 tn_v_p
tn_v_w and g 127
tn_v get tn_v_g tn_v_w
tn mov tn_v
q add p8 ov
tp_v_p shr q 7
tp_v_g get p4 tp_v_p
tp_v_w and q 127
tp_v get tp_v_g tp_v_w
tp mov tp_v
isn eq ok 1
isp eq ok 2
t select isn tn tp
w_v_p shr t 7
w_v_g get p5 w_v_p
w_v_w and t 127
w_v get w_v_g w_v_w
w mov w_v
hi ge w 2147483648
nod or isn isp
x and hi nod
r or p0 x
ret r
end
# the literal value of operand p1 into the list
fn ozgat u32x64 u32 u32x128x100 u32x128x512 u32 u32 -> u32x64
i add p4 p1
o_x mul i 2
o_k_p shr o_x 7
o_k_g get p3 o_k_p
o_k_w and o_x 127
o_k get o_k_g o_k_w
o_w1 add o_k_w 1
o_v get o_k_g o_w1
o_r rec o_k o_v
o mov o_r
ok at o 0
ov at o 1
r_g add p5 ov
r_sk_v_p shr r_g 7
r_sk_v_g get p2 r_sk_v_p
r_sk_v_w and r_g 127
r_sk_v get r_sk_v_g r_sk_v_w
r_sk mov r_sk_v
r_vi add 2816 r_g
r_sv_v_p shr r_vi 7
r_sv_v_g get p2 r_sv_v_p
r_sv_v_w and r_vi 127
r_sv_v get r_sv_v_g r_sv_v_w
r_sv mov r_sv_v
r_isn eq ok 1
r_hs ne r_sk 0
r_u and r_isn r_hs
r_k select r_u r_sk ok
r_v select r_u r_sv ov
r_r rec r_k r_v
r mov r_r
rv at r 1
l set p0 p1 rv
ret l
end
# hash of an operand
fn ozhx u32 u32 -> u32
a mul p0 2654435761
b mul p1 2246822519
h xor a b
ret h
end
# the hash of final operand p1: (commutative sum, ordered rotate-xor)
fn ozhop (u32,u32) u32 u32x128x100 u32x128x512 u32 u32 u32 -> (u32,u32)
o_i add p4 p1
o_o_x mul o_i 2
o_o_k_p shr o_o_x 7
o_o_k_g get p3 o_o_k_p
