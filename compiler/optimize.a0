o_r_rk at o_r_r 0
o_r_rv at o_r_r 1
o_r_red and p6 4
o_r_isr ne o_r_red 0
o_r_k1 eq p1 1
o_r_rep and o_r_isr o_r_k1
o_r_nop shr p6 8
o_r_sh eq o_r_nop 9
o_r_lg call ozlg2 o_r_rv
o_r_m1 sub o_r_rv 1
o_r_lit select o_r_sh o_r_lg o_r_m1
