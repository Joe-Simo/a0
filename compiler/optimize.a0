c2 eq op 2
c4 eq op 4
c5 eq op 5
c6 eq op 6
c7 eq op 7
c12 eq op 12
cm1 or c2 c4
cm2 or cm1 c5
cm3 or cm2 c6
cm4 or cm3 c7
comm or cm4 c12
base select comm s q
o19 eq op 19
o20 eq op 20
o21 eq op 21
hc1 or o19 o20
hc or hc1 o21
cf select hc p6 0
pf select o21 p7 0
m1 mul op 40503
m2 mul cf 2654435769
m3 mul pf 97
m4 mul p4 7919
h1 xor base m1
h2 xor h1 m2
h3 xor h2 m3
h4 xor h3 m4
hh shr h4 12
h5 xor h4 hh
slot and h5 4095
ret slot
end
# final operands p1 of two nodes (operands from p4 flags p5, from p6 flags p7) are equal
fn ozeqo bool u32 u32x128x100 u32x128x512 u32 u32 u32 u32 u32 -> bool
