o_r_fv select o_r_rep o_r_lit o_r_rv
o_r_res rec o_r_fk o_r_fv
o_r mov o_r_res
o mov o_r
ok at o 0
ov at o 1
x call ozhx ok ov
s at p0 0
q at p0 1
