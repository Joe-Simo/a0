# Chunked emission for the bootstrap (DESIGN.md 7a stage 6), written in A0. `emitchunkio` is
# the entry of a0c-stage1/2/3 (tools/bootstrap.ts): it compiles one chunk of a program with the
# A0 front end (131072 source bytes, parse.a0 `fecap`) and the C emitter (emit_c.a0 `cunit` and `emitc`), so a program over the
# source limit is compiled a chunk at a time. `emitachunkio` is the same with the arm64 emitter
# (emit_arm64.a0 `qunit`), the entry of the arm64 stages (tools/bootstrap-arm64.ts); its output
# is assembly text where `emitchunkio` writes C, and its prelude (head 1) the two copy helpers.
# A chunk of a program in several chunks is: a header prelude (a function whose header names
# every header type of the whole program, in a fixed order, so that every chunk interns the
# same type table and the typedef names `a0t<index>` agree across chunks), the header of every
# function the chunk calls with a stub body, then the chunk's functions. Functions [from, nfns)
# are checked (given the iteration bounds of the earlier functions, read from the input) and
# emitted; the prelude and the stubs are only parsed. The C prelude and the typedefs of every
# type are written when head is 1.
# Input words: n, n source bytes, head, strict, from, then `from` iteration bounds. strict is 1
# for a program in several chunks: a body that builds a type no header names is then code 5,
# since its typedef index would differ between chunks. A program in one chunk (head 1, from 0)
# is compiled as `emitcio` compiles it.
# Output words when the code is 0: the C bytes, one per word, then the k = nfns - from
# iteration bounds of the chunk's functions (passed back with later chunks' stubs), then k.
# Nothing is written otherwise. The result is the diagnostic code (1 parse, 2 structure,
# 3 type, 4 limit, 5 above).

# `emitwasmio` is the entry of the A0 wasm32 emitter (compiler/emit_wasm.a0; driven by
# tools/selfhost-wasm.ts): its first input word is the mode, 1 a source chunk (the input of
# `emitchunkio`, then the variant count before the chunk and the call table (index, depth) of
# the chunk's first `from` functions), 2 a chunk as checked tables, 3 the module linker; 4, 5
# and 6 run the optimizer (compiler/optimize.a0) before the emitter: 4 is mode 1's input, then
# the eval program source (byte count, bytes) and its map (word count, then one word per chunk
# function: eval index + 1, 0 for none); 5 is mode 2's input, then the eval program as tables
# (function count, 7 words each; node count, 6 words each; operand count, pairs) and its map
# (one word per chunk function); 6 is mode 5 writing the optimized IR instead of the chunk. The
# result is the diagnostic code (6 for an unknown mode; 7: the optimizer needs the bodies of
# the chunk functions it wrote, followed by their count).

use "emit_arm64.a0"
use "optimize.a0"

# `read` as a function: its (u32,io) result is named by this header, so the prelude interns it
fn rdword io -> (u32,io)
r read p0
ret r
end
# iteration bound p1 of the input into the paged table
fn rdfst (u32x128x8,io) u32 -> (u32x128x8,io)
fs at p0 0
tk at p0 1
r call rdword tk
v at r 0
t at r 1
pi shr p1 7
wi and p1 127
pg get fs pi
pg2 set pg wi v
fs2 set fs pi pg2
o rec fs2 t
ret o
end
# iteration bound p3 + p1 of the paged table
fn wfst io u32 u32x128x8 u32 -> io
i add p3 p1
pi shr i 7
wi and i 127
pg get p2 pi
v get pg wi
w write p0 v
ret w
end
# after the C: the k = p4 - p3 iteration bounds (table p2) of the chunk's functions, then k
fn wtrail io u32 u32x128x8 u32 u32 -> io
k sub p4 p3
w0 fold wfst k p0 p2 p3
w1 write w0 k
ret w1
end
# the input: (source bytes, n, iteration bounds, from, strict, head, io)
fn rdchunk io -> (u32x512x64,u32,u32x128x8,u32,bool,bool,io)
rs call readsrc p0
src at rs 0
n at rs 1
t1 at rs 2
rh call rdword t1
head at rh 0
t2 at rh 1
rt call rdword t2
strict at rt 0
t3 at rt 1
rf call rdword t3
from at rf 0
t4 at rf 1
z8 call z8
fs0 rec z8 t4
fsr fold rdfst from fs0
fst at fsr 0
t5 at fsr 1
sb ne strict 0
hd ne head 0
r rec src n fst from sb hd t5
ret r
end
fn emitchunkio io -> u32
c call rdchunk p0
src at c 0
n at c 1
fst at c 2
from at c 3
sb at c 4
hd at c 5
t5 at c 6
u call cunit t5 src n fst from sb hd
t6 at u 0
code at u 1
fstat at u 2
nfns at u 3
ok eq code 0
go select ok 1 0
t7 fold wtrail go t6 fstat from nfns
ret code
end
fn emitachunkio io -> u32
c call rdchunk p0
src at c 0
n at c 1
fst at c 2
from at c 3
sb at c 4
hd at c 5
t5 at c 6
u call qunit t5 src n fst from sb hd
t6 at u 0
code at u 1
fstat at u 2
nfns at u 3
ok eq code 0
go select ok 1 0
t7 fold wtrail go t6 fstat from nfns
ret code
end
# wasm32, mode 1: a source chunk through the A0 front end
fn wam1 (io,u32) u32 -> (io,u32)
t at p0 0
c call rdchunk t
src at c 0
n at c 1
fst at c 2
from at c 3
t5 at c 6
rb call rdword t5
base at rb 0
t6 at rb 1
nd mul from 2
rd call warn16 t6 nd
dt at rd 0
t7 at rd 1
u call wasunit t7 src n fst from dt base
ret u
end
fn wam2 (io,u32) u32 -> (io,u32)
t at p0 0
r call wairchunk t
ret r
end
fn wam3 (io,u32) u32 -> (io,u32)
t at p0 0
r call walink t
ret r
end
# modes 4 5 6: the optimized chunk (4 source, 5 tables), the optimized IR of a table chunk (6)
fn wam4 (io,u32) u32 -> (io,u32)
t at p0 0
c call rdchunk t
src at c 0
n at c 1
fst at c 2
from at c 3
t5 at c 6
rb call rdword t5
base at rb 0
t6 at rb 1
nd mul from 2
rd call warn16 t6 nd
dt at rd 0
t7 at rd 1
re call readsrc t7
esrc at re 0
en at re 1
t8 at re 2
rm call rdword t8
nm at rm 0
t9 at rm 1
rq call warn16 t9 nm
emap at rq 0
t10 at rq 1
u call ozsunit t10 src n fst from dt base esrc en emap
ret u
end
fn wam5 (io,u32) u32 -> (io,u32)
t at p0 0
r call ozirchunk t false
ret r
end
fn wam6 (io,u32) u32 -> (io,u32)
t at p0 0
r call ozirchunk t true
ret r
end
fn emitwasmio io -> u32
r call rdword p0
m at r 0
t at r 1
s0 rec t 6
m1 eq m 1
m2 eq m 2
m3 eq m 3
m4 eq m 4
m5 eq m 5
m6 eq m 6
c1 select m1 1 0
c2 select m2 1 0
c3 select m3 1 0
c4 select m4 1 0
c5 select m5 1 0
c6 select m6 1 0
a fold wam1 c1 s0
b fold wam2 c2 a
c fold wam3 c3 b
d fold wam4 c4 c
e fold wam5 c5 d
f fold wam6 c6 e
code at f 1
ret code
end
