# Standalone specification phase using the shared source grammar.
use "source_grammar.a0"
fn sp_rawok (u32x128,u32x128,io) u32 u32x128 -> bool
p at p0 0
q0 get p 0
q1 eq q0 0
ret q1
end
fn arena_specs io u32x128 -> (u32,u32x128,io)
z call arena_zero
q0 get p1 0
q1 eq q0 0
q2 get p1 0
q3 eq q2 7
q4 or q1 q3
q5 get p1 0
q6 select q4 0 q5
q set z 0 q6
q7 get p1 6
q_1 set q 6 q7
q_2 set q_1 24 4294967295
q8 call sp_sy p1 62
q_3 call sp_setsy q_2 80 q8
q_4 set q_3 92 1
q9 get p1 57
q10 div q9 6
q11 rec q_4 z p0
r loop sp_rawok sp_raw q10 q11 p1
p at r 0
q12 get p 0
q13 eq q12 0
q14 get p 24
q15 ne q14 4294967295
q16 and q13 q15
q17 select q16 1 0
out fold sp_finishfunction q17 r
a at out 0
q18 get a 0
q19 at out 2
q20 rec q18 a q19
ret q20
end
