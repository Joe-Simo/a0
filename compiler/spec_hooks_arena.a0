use "specs_arena.a0"
use "spec_hooks_arena_shared.a0"

fn as_publish (u32x128,u32x128,io) -> (u32x128,io)
p at p0 0
q0 get p 60
fresh eq q0 0
q1 select fresh 1 0
r fold as_save_new q1 p0
q2 select fresh 0 1
r_1 fold as_save_old q2 r
q at r_1 0
sp at r_1 1
q3 get q 0
q4 eq q3 0
q5 get sp 0
q6 get q 0
code select q4 q5 q6
q7 eq code 6
q8 get q 0
q9 eq q8 0
grammar and q7 q9
q10 get sp 80
q11 get sp 81
q12 get sp 82
q13 rec q10 q11 q12
q14 get sp 83
q15 get sp 84
q16 get sp 85
q17 rec q13 q14 q15 q16
m3_a set q 62 q10
m3_b set m3_a 63 q11
q18 set m3_b 64 q12
m2_b set q18 65 q14
m2_c set m2_b 66 q15
q19 set m2_c 67 q16
q_1 set q19 0 code
q20 get q_1 1
q21 select grammar 714 q20
q_2 set q_1 1 q21
q22 get sp 31
q23 get q_2 2
q24 select grammar q22 q23
q_3 set q_2 2 q24
q25 get sp 2
q26 get q_3 3
q27 select grammar q25 q26
q_4 set q_3 3 q27
q28 get sp 3
q29 get q_4 4
q30 select grammar q28 q29
q_5 set q_4 4 q30
q31 get sp 1
q32 get q_5 5
q33 select grammar q31 q32
q_6 set q_5 5 q33
q34 at r_1 2
q35 rec q_6 q34
ret q35
end

fn as_runraw (u32x128,u32x128,io) u32 u32 u32x128 -> (u32x128,u32x128,io)
q0 call sp_raw p0 p2 p3
ret q0
end

fn as_accept_go (u32x128,io) u32 -> (u32x128,io)
loaded call as_resume p0
p at loaded 0
z call arena_zero
sp at loaded 1
q0 get p 0
sp_1 set sp 0 q0
q1 get p 0
q2 eq q1 0
q3 select q2 1 0
q4 at loaded 2
q5 rec sp_1 z q4
q6 get p 57
q7 div q6 6
q8 sub q7 1
parsed fold as_runraw q3 q5 q8 p
q9 at parsed 0
q10 at parsed 2
q11 rec p q9 q10
q12 call as_publish q11
ret q12
end

fn as_accept (u32x128,io) -> (u32x128,io)
p at p0 0
q0 get p 0
q1 eq q0 0
q2 select q1 1 0
q3 fold as_accept_go q2 p0
ret q3
end

fn as_finish_go (u32x128,io) u32 -> (u32x128,io)
loaded call as_resume p0
p at loaded 0
z call arena_zero
sp at loaded 1
q0 get p 0
sp_1 set sp 0 q0
q1 get p 0
q2 eq q1 0
q3 get sp_1 24
q4 ne q3 4294967295
q5 and q2 q4
q6 select q5 1 0
q7 at loaded 2
q8 rec sp_1 z q7
finished fold sp_finishfunction q6 q8
q9 at finished 0
sp_2 set q9 24 4294967295
q10 at finished 2
q11 rec p sp_2 q10
q12 call as_publish q11
ret q12
end

fn as_finish (u32x128,io) -> (u32x128,io)
p at p0 0
q0 get p 0
q1 eq q0 0
q2 get p 60
q3 ne q2 0
q4 and q1 q3
q5 select q4 1 0
q6 fold as_finish_go q5 p0
ret q6
end
