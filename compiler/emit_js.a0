w2 call cwdecc w1 digit p2
w3 call cws6c w2 yes 1702195828 0 0 0 0 0
w4 call cws6c w3 no 1936482662 101 0 0 0 0
ret w4
end

fn jwopstep io u32 u32 u32 -> io
r call jwop p0 p2 p3
ret r
end
fn jwopc io bool u32 u32 -> io
n select p1 1 0
r fold jwopstep n p0 p2 p3
ret r
end

fn jwarg io u32 u32x128x512 u32 u32 -> io
