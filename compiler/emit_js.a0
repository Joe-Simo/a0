ret w3
end

fn jwliststep io u32 u32x128x512 u32 u32 u32 -> io
r fold jwarg p4 p0 p2 p3 p5
ret r
end
fn jwlistc io bool u32x128x512 u32 u32 u32 -> io
n select p1 1 0
r fold jwliststep n p0 p2 p3 p4 p5
ret r
end
fn jname io bool u32x128x400 u32x128x16 u32 -> io
