o2 and p2 s2
v2 add d2 48
c2 get l2 n2
u2 select o2 v2 c2
l3 set l2 n2 u2
a2 add n2 1
n3 select o2 a2 n2
q3 div p1 1000000
d3 rem q3 10
z3 ne d3 0
s3 or s2 z3
o3 and p2 s3
v3 add d3 48
c3 get l3 n3
u3 select o3 v3 c3
l4 set l3 n3 u3
a3 add n3 1
n4 select o3 a3 n3
q4 div p1 100000
d4 rem q4 10
z4 ne d4 0
s4 or s3 z4
o4 and p2 s4
v4 add d4 48
c4 get l4 n4
u4 select o4 v4 c4
l5 set l4 n4 u4
a4 add n4 1
n5 select o4 a4 n4
q5 div p1 10000
d5 rem q5 10
z5 ne d5 0
s5 or s4 z5
o5 and p2 s5
v5 add d5 48
c5 get l5 n5
u5 select o5 v5 c5
l6 set l5 n5 u5
a5 add n5 1
n6 select o5 a5 n5
q6 div p1 1000
d6 rem q6 10
z6 ne d6 0
s6 or s5 z6
o6 and p2 s6
v6 add d6 48
c6 get l6 n6
u6 select o6 v6 c6
l7 set l6 n6 u6
a6 add n6 1
n7 select o6 a6 n6
q7 div p1 100
d7 rem q7 10
z7 ne d7 0
s7 or s6 z7
o7 and p2 s7
v7 add d7 48
c7 get l7 n7
u7 select o7 v7 c7
l8 set l7 n7 u7
a7 add n7 1
n8 select o7 a7 n7
q8 div p1 10
d8 rem q8 10
z8 ne d8 0
s8 or s7 z8
o8 and p2 s8
v8 add d8 48
c8 get l8 n8
u8 select o8 v8 c8
l9 set l8 n8 u8
a8 add n8 1
n9 select o8 a8 n8
q9 div p1 1
d9 rem q9 10
o9 mov p2
v9 add d9 48
c9 get l9 n9
u9 select o9 v9 c9
l10 set l9 n9 u9
a9 add n9 1
n10 select o9 a9 n9
r rec l10 n10
ret r
end
