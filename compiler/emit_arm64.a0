# fold (op 20) and loop (21)
fn qgfold io u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x45 u32x128x16 u32x128x400 u32 u32 -> io
j at p2 0
np at p2 1
op at p2 2
ce at p2 5
pr at p2 6
tag at p2 8
size at p2 9
k0 at p2 10
v0 at p2 11
k1 at p2 12
v1 at p2 13
ns at p2 16
nl at p2 17
off at p2 18
isl eq op 21
nlp select isl 1 0
agg ge tag 4
na select agg 1 0
sc select agg false true
nsc select agg 0 1
a fold qalloc na p0 size
# t b a agg "\tstr x12, [x21, #{off}]\n"
b_1 call cws6c a agg 1920234249 842102816 2019237932 539767090 35 0
b_2 call cwdecc b_1 agg off
b call cws6c b_2 agg 2653 0 0 0 0 0
c fold qld na b 1 k1 v1 np
# t d c agg "\tmov x0, x12\n"
d call cws6c c agg 1987013897 741373984 842102816 10 0 0
e fold qmovx na d 2 size
