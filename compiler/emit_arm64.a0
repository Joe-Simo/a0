q1 div p1 100000000
d1 rem q1 10
z1 ne d1 0
s1 or s0 z1
o1 and p2 s1
v1 add d1 48
c1 get l1 n1
u1 select o1 v1 c1
l2 set l1 n1 u1
a1 add n1 1
n2 select o1 a1 n1
q2 div p1 10000000
d2 rem q2 10
z2 ne d2 0
