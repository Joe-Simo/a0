v9 and x9 255
z9 ne v9 0
o9 and p5 z9
c9 get l9 n9
u9 select o9 v9 c9
l10 set l9 n9 u9
a9 add n9 1
n10 select o9 a9 n9
x10 shr p3 16
v10 and x10 255
z10 ne v10 0
o10 and p5 z10
c10 get l10 n10
u10 select o10 v10 c10
l11 set l10 n10 u10
a10 add n10 1
n11 select o10 a10 n10
x11 shr p3 24
v11 and x11 255
z11 ne v11 0
o11 and p5 z11
c11 get l11 n11
u11 select o11 v11 c11
l12 set l11 n11 u11
a11 add n11 1
n12 select o11 a11 n11
x12 shr p4 0
v12 and x12 255
z12 ne v12 0
o12 and p5 z12
c12 get l12 n12
u12 select o12 v12 c12
l13 set l12 n12 u12
a12 add n12 1
n13 select o12 a12 n12
x13 shr p4 8
v13 and x13 255
z13 ne v13 0
o13 and p5 z13
c13 get l13 n13
u13 select o13 v13 c13
l14 set l13 n13 u13
a13 add n13 1
n14 select o13 a13 n13
x14 shr p4 16
v14 and x14 255
z14 ne v14 0
o14 and p5 z14
c14 get l14 n14
u14 select o14 v14 c14
l15 set l14 n14 u14
a14 add n14 1
n15 select o14 a14 n14
x15 shr p4 24
v15 and x15 255
z15 ne v15 0
o15 and p5 z15
c15 get l15 n15
u15 select o15 v15 c15
l16 set l15 n15 u15
a15 add n15 1
n16 select o15 a15 n15
r rec l16 n16
ret r
end
# the decimal digits of p1 (unrolled over the ten powers of ten)
fn ldec (u32x512,u32) u32 bool -> (u32x512,u32)
l0 at p0 0
n0 at p0 1
q0 div p1 1000000000
d0 rem q0 10
z0 ne d0 0
s0 mov z0
o0 and p2 s0
v0 add d0 48
c0 get l0 n0
u0 select o0 v0 c0
l1 set l0 n0 u0
