n7 select o6 a6 n6
x7 shr p2 24
v7 and x7 255
z7 ne v7 0
o7 and p5 z7
c7 get l7 n7
u7 select o7 v7 c7
l8 set l7 n7 u7
a7 add n7 1
n8 select o7 a7 n7
x8 shr p3 0
v8 and x8 255
z8 ne v8 0
o8 and p5 z8
c8 get l8 n8
u8 select o8 v8 c8
l9 set l8 n8 u8
a8 add n8 1
n9 select o8 a8 n8
