# --- the line buffer (bytes, length): one byte, a short packed string, a symbol's bytes
fn lb (u32x512,u32) u32 bool -> (u32x512,u32)
l at p0 0
n at p0 1
c get l n
u select p2 p1 c
l2 set l n u
n1 add n 1
n2 select p2 n1 n
r rec l2 n2
ret r
end
fn lp1 (u32x512,u32) u32 bool -> (u32x512,u32)
r call lp p0 p1 0 0 0 p2
ret r
end
fn lnstep (u32x512,u32) u32 u32x512 u32 bool -> (u32x512,u32)
a add p3 p1
c get p2 a
r call lb p0 c p4
ret r
end
fn lname (u32x512,u32) u32x512 u32x512 u32 bool -> (u32x512,u32)
s2 mul p3 2
start get p2 s2
s21 add s2 1
len get p2 s21
r fold lnstep len p0 p1 start p4
ret r
end
fn line -> (u32x512,u32)
z call zeros512
r rec z 0
ret r
end
# --- the module buffer: a line is appended in two chunks; a line over 512 bytes marks the
# module full, which emitio reports as code 4
fn flushstep (u32x4096,u32) u32 u32x512 u32 bool -> (u32x4096,u32)
base mul p1 256
r call flush256 p0 p2 base p3 p4
ret r
end
fn flush (u32x4096,u32) (u32x512,u32) bool -> (u32x4096,u32)
l at p1 0
n at p1 1
over gt n 512
s fold flushstep 2 p0 l n p2
m at s 0
nout at s 1
full and p2 over
nout2 select full 4096 nout
r rec m nout2
ret r
end
# --- instruction writers. Packed operands: 3158391 w10, 3223927 w11, 3289463 w12, 14711 w9,
# 12407 w0, 28787 sp, 3748472 x29, 12323 #0, 12579 #1, 8236 ", ".
# "\t" mnem " " a [", " b [", " c [", " d]]] "\n" with p2 operands
fn lins (u32x512,u32) u32 u32 u32 u32 u32 u32 bool -> (u32x512,u32)
on2a ge p2 2
on2 and p7 on2a
on3a ge p2 3
on3 and p7 on3a
on4a ge p2 4
on4 and p7 on4a
s1 call lb p0 9 p7
s2 call lp1 s1 p1 p7
s3 call lb s2 32 p7
s4 call lp1 s3 p3 p7
s5 call lp1 s4 8236 on2
s6 call lp1 s5 p4 on2
s7 call lp1 s6 8236 on3
s8 call lp1 s7 p5 on3
s9 call lp1 s8 8236 on4
s10 call lp1 s9 p6 on4
s11 call lb s10 10 p7
ret s11
end
# "\t" mnem " " reg ", [" base ", #" off "]\n"
fn lmem (u32x512,u32) u32 u32 u32 u32 bool -> (u32x512,u32)
s1 call lb p0 9 p5
s2 call lp1 s1 p1 p5
s3 call lb s2 32 p5
s4 call lp1 s3 p2 p5
s5 call lp1 s4 5972012 p5
s6 call lp1 s5 p3 p5
s7 call lp1 s6 2301996 p5
s8 call ldec s7 p4 p5
s9 call lp1 s8 2653 p5
ret s9
end
# reg = imm: "movz reg, #lo" then "movk reg, #hi, lsl #16" when the high half is not zero
fn lmovi (u32x512,u32) u32 u32 bool -> (u32x512,u32)
lo and p2 65535
hi shr p2 16
hnz ne hi 0
onk and p3 hnz
s1 call lb p0 9 p3
s2 call lp1 s1 2054582125 p3
s3 call lb s2 32 p3
s4 call lp1 s3 p1 p3
s5 call lp1 s4 2301996 p3
s6 call ldec s5 lo p3
s7 call lb s6 10 p3
s8 call lb s7 9 onk
s9 call lp1 s8 1802923885 onk
s10 call lb s9 32 onk
s11 call lp1 s10 p1 onk
s12 call lp1 s11 2301996 onk
s13 call ldec s12 hi onk
s14 call lp s13 1936465964 824385644 2614 0 onk
ret s14
end
# "La0_" f "_" i suffix   (suffix 116 't' top, 100 'd' done)
fn llabel (u32x512,u32) u32 u32 u32 bool -> (u32x512,u32)
s1 call lp1 p0 1597006156 p4
s2 call ldec s1 p1 p4
s3 call lb s2 95 p4
s4 call ldec s3 p2 p4
s5 call lb s4 p3 p4
ret s5
end
# "\t" mnem " " pre label "\n"  (pre: a packed operand or 0)
fn lbr (u32x512,u32) u32 u32 u32 u32 u32 bool -> (u32x512,u32)
s1 call lb p0 9 p6
s2 call lp1 s1 p1 p6
s3 call lb s2 32 p6
s4 call lp1 s3 p2 p6
s5 call llabel s4 p3 p4 p5 p6
s6 call lb s5 10 p6
ret s6
end
fn lldef (u32x512,u32) u32 u32 u32 bool -> (u32x512,u32)
s1 call llabel p0 p1 p2 p3 p4
s2 call lp1 s1 2618 p4
ret s2
end
# "\tbl _a0_" name "\n"
fn lcall (u32x512,u32) u32x512 u32x512 u32 bool -> (u32x512,u32)
s1 call lp p0 543973897 1597006175 0 0 p4
s2 call lname s1 p1 p2 p3 p4
s3 call lb s2 10 p4
ret s3
end
# --- the stack argument area (Darwin: parameters after the eighth, u32 4 bytes aligned 4,
# bool 1 byte). state: (the offset after the parameters before j, the start of parameter k)
fn stkstep (u32,u32) u32 u32x1024 u32 u32 -> (u32,u32)
off at p0 0
sk at p0 1
lt8 lt p1 8
a add p3 p1
t get p2 a
isb eq t 1
size select isb 1 4
al0 add off 3
al1 shr al0 2
al shl al1 2
start select isb off al
end0 add start size
off2 select lt8 off end0
isk eq p1 p4
sk2 select isk start sk
r rec off2 sk2
ret r
end
# byte offset of parameter p2 of the list tlist[p1..) in the area
fn stkoff u32x1024 u32 u32 -> u32
k1 add p2 1
s0 rec 0 0
s fold stkstep k1 s0 p0 p1 p2
r at s 1
ret r
end
# bytes of the area for a function with p2 parameters
fn stkbytes u32x1024 u32 u32 -> u32
s0 rec 0 0
s fold stkstep p2 s0 p0 p1 p2
r at s 0
ret r
end
# --- values. An operand (kind p1, value p2) into register p3: 1 node 2 param 3 u32 4 bool
# 5 a slot offset; p4 the outgoing bytes, p5 the parameter count
fn lload (u32x512,u32) u32 u32 u32 u32 u32 bool -> (u32x512,u32)
k1 eq p1 1
k2 eq p1 2
k3 eq p1 3
k4 eq p1 4
k5 eq p1 5
n2 mul p2 2
ni add p5 n2
b4 mul ni 4
offn add p4 b4
b4p mul p2 4
offp add p4 b4p
off0 select k1 offn p2
off select k2 offp off0
ism0 or k1 k2
ism or ism0 k5
onm and p6 ism
s1 call lmem p0 7496812 p3 28787 off onm
isi or k3 k4
oni and p6 isi
s2 call lmovi s1 p3 p2 oni
ret s2
end
# argument k of a call, or of an iteration body when p10 (k 0 is the state slot p8, k 1 the
# counter slot p9): w0-w7, then through w9 to the stack area. p2 args p3 first arg p4 tlist
# p5 the callee's first parameter p6 outgoing bytes p7 parameter count p11 flag
fn argstep (u32x512,u32) u32 u32x8192 u32 u32x1024 u32 u32 u32 u32 u32 bool bool -> (u32x512,u32)
a add p3 p1
a2 mul a 2
ak get p2 a2
a21 add a2 1
av get p2 a21
k0 eq p1 0
k1 eq p1 1
sl0 and p10 k0
sl1 and p10 k1
kind0 select sl0 5 ak
kind select sl1 5 kind0
val0 select sl0 p8 av
val select sl1 p9 val0
lt8 lt p1 8
ge8 ge p1 8
onr and p11 lt8
ons and p11 ge8
r256 mul p1 256
reg add 12407 r256
s1 call lload p0 kind val reg p6 p7 onr
s2 call lload s1 kind val 14711 p6 p7 ons
t0 add p5 p1
t get p4 t0
isb eq t 1
mn select isb 1651668083 7500915
off call stkoff p4 p5 p1
s3 call lmem s2 mn 14711 28787 off ons
ret s3
end
# parameter i to its slot: from w0-w7 (a bool masked to its low bit) or from the caller's
# stack area above the saved frame. p2 tlist p3 first parameter p4 outgoing bytes
fn paramstep (u32x4096,u32) u32 u32x1024 u32 u32 -> (u32x4096,u32)
a add p3 p1
t get p2 a
isb eq t 1
lt8 lt p1 8
ge8 ge p1 8
onb and lt8 isb
r256 mul p1 256
reg add 12407 r256
b4 mul p1 4
slot add p4 b4
l0 call line
s1 call lins l0 6581857 3 reg reg 12579 0 onb
s2 call lmem s1 7500915 reg 28787 slot lt8
off0 call stkoff p2 p3 p1
off add off0 16
mn select isb 1651663980 7496812
s3 call lmem s2 mn 14711 3748472 off ge8
onsb and ge8 isb
s4 call lins s3 6581857 3 14711 14711 12579 0 onsb
s5 call lmem s4 7500915 14711 28787 slot ge8
r call flush p0 s5 true
ret r
end
# the largest stack argument area of the callees of a function (p2 nodes p3 fns p4 tlist p5 first node)
fn outstep u32 u32 u32x4096 u32x1024 u32x1024 u32 -> u32
g add p5 p1
g6 mul g 6
g61 add g6 1
op get p2 g61
g64 add g6 4
callee get p2 g64
ge19 ge op 19
le21 le op 21
isc and ge19 le21
c7 mul callee 7
c71 add c7 1
cn get p3 c71
c72 add c7 2
cfp get p3 c72
b call stkbytes p4 cfp cn
b2 select isc b 0
r call umax p0 b2
ret r
end
# --- one node. Operands to w9-w11, the operation to w12, the store to the node's slot; a
# call places its arguments and stores w0; a fold or loop is a counted loop around calls.
# p2 nodes p3 args p4 fns p5 tlist p6 pool p7 sym p8 first node p9 outgoing bytes
# p10 parameter count p11 function index
fn enodestep (u32x4096,u32) u32 u32x4096 u32x8192 u32x1024 u32x1024 u32x512 u32x512 u32 u32 u32 u32 -> (u32x4096,u32)
g add p8 p1
g6 mul g 6
g61 add g6 1
op get p2 g61
g63 add g6 3
fa get p2 g63
g64 add g6 4
callee get p2 g64
g65 add g6 5
pred get p2 g65
fa2 mul fa 2
a0k get p3 fa2
fa21 add fa2 1
a0v get p3 fa21
fa22 add fa2 2
a1k get p3 fa22
fa23 add fa2 3
a1v get p3 fa23
fa24 add fa2 4
a2k get p3 fa24
fa25 add fa2 5
a2v get p3 fa25
i2 mul p1 2
ni add p10 i2
b4 mul ni 4
dst add p9 b4
ctr add dst 4
ismov eq op 1
ge2 ge op 2
le9 le op 9
isar and ge2 le9
isdiv eq op 10
isrem eq op 11
isdr or isdiv isrem
ge12 ge op 12
le17 le op 17
iscmp and ge12 le17
isbin and ge2 le17
issel eq op 18
iscall eq op 19
isfold eq op 20
isloop eq op 21
isfl or isfold isloop
issc0 or ismov isbin
issc or issc0 issel
l10 or ismov isbin
# mnemonics by code: 2 add 3 sub 4 mul 5 and 6 orr 7 eor 8 lsl 9 lsr; conditions 12 eq 13 ne
# 14 lo 15 ls 16 hi 17 hs
o3 eq op 3
o4 eq op 4
o5 eq op 5
o6 eq op 6
o7 eq op 7
o8 eq op 8
o9 eq op 9
mn0 select o3 6452595 6579297
mn1 select o4 7107949 mn0
mn2 select o5 6581857 mn1
mn3 select o6 7500399 mn2
mn4 select o7 7499621 mn3
mn5 select o8 7107436 mn4
mn select o9 7500652 mn5
o13 eq op 13
o14 eq op 14
o15 eq op 15
o16 eq op 16
o17 eq op 17
cc0 select o13 25966 29029
cc1 select o14 28524 cc0
cc2 select o15 29548 cc1
cc3 select o16 26984 cc2
cc select o17 29544 cc3
# scalar operations
l0 call line
s1 call lload l0 a0k a0v 3158391 p9 p10 l10
s2 call lload s1 a0k a0v 14711 p9 p10 issel
s3 call lload s2 a1k a1v 3223927 p9 p10 isbin
s4 call lload s3 a1k a1v 3158391 p9 p10 issel
s5 call lload s4 a2k a2v 3223927 p9 p10 issel
s6 call lins s5 7761773 2 3289463 3158391 0 0 ismov
s7 call lins s6 mn 3 3289463 3158391 3223927 0 isar
s8 call lins s7 1986618485 3 3289463 3158391 3223927 0 isdr
s9 call lins s8 7368035 2 3223927 12323 0 0 isdiv
s10 call lins s9 1986947427 3 3289463 3289463 29029 0 isdiv
s11 call lins s10 1651864429 4 3289463 3289463 3223927 3158391 isrem
s12 call lins s11 7368035 2 3158391 3223927 0 0 iscmp
s13 call lins s12 1952805731 2 3289463 cc 0 0 iscmp
s14 call lins s13 7368035 2 14711 12323 0 0 issel
s15 call lins s14 1818588003 4 3289463 3158391 3223927 25966 issel
s16 call lmem s15 7500915 3289463 28787 dst issc
# call
c7 mul callee 7
cname get p4 c7
c71 add c7 1
cn get p4 c71
c72 add c7 2
cfp get p4 c72
pr7 mul pred 7
pname get p4 pr7
s17 fold argstep cn s16 p3 fa p5 cfp p9 p10 dst ctr false iscall
s18 call lcall s17 p6 p7 cname iscall
s19 call lmem s18 7500915 12407 28787 dst iscall
# fold and loop: the state and the counter, the top label and the bound, the predicate,
# the body, the step
s20 call lload s19 a1k a1v 14711 p9 p10 isfl
s21 call lmem s20 7500915 14711 28787 dst isfl
s22 call lins s21 2054582125 2 14711 12323 0 0 isfl
s23 call lmem s22 7500915 14711 28787 ctr isfl
s24 call lldef s23 p11 p1 116 isfl
s25 call lmem s24 7496812 14711 28787 ctr isfl
s26 call lload s25 a0k a0v 3158391 p9 p10 isfl
s27 call lins s26 7368035 2 14711 3158391 0 0 isfl
s28 call lbr s27 1936207458 0 p11 p1 100 isfl
s29 fold argstep cn s28 p3 fa p5 cfp p9 p10 dst ctr true isloop
s30 call lcall s29 p6 p7 pname isloop
s31 call lbr s30 8020579 539766903 p11 p1 100 isloop
s32 fold argstep cn s31 p3 fa p5 cfp p9 p10 dst ctr true isfl
s33 call lcall s32 p6 p7 cname isfl
s34 call lmem s33 7500915 12407 28787 dst isfl
s35 call lmem s34 7496812 14711 28787 ctr isfl
s36 call lins s35 6579297 3 14711 14711 12579 0 isfl
s37 call lmem s36 7500915 14711 28787 ctr isfl
s38 call lbr s37 98 0 p11 p1 116 isfl
s39 call lldef s38 p11 p1 100 isfl
r call flush p0 s39 true
ret r
end
# --- one function: symbol, prologue, frame, parameters, nodes, result, epilogue
# p2 pool p3 sym p4 fns p5 nodes p6 args p7 tlist
fn efnstep (u32x4096,u32) u32 u32x512 u32x512 u32x1024 u32x4096 u32x8192 u32x1024 -> (u32x4096,u32)
f7 mul p1 7
name get p4 f7
f71 add f7 1
np get p4 f71
f72 add f7 2
fp get p4 f72
f74 add f7 4
first get p4 f74
f75 add f7 5
cnt get p4 f75
f76 add f7 6
retw get p4 f76
ob fold outstep cnt 0 p5 p4 p7 first
ob15 add ob 15
ob16 shr ob15 4
o shl ob16 4
n2 mul cnt 2
pn add np n2
b4 mul pn 4
fr0 add o b4
fr15 add fr0 15
fr16 shr fr15 4
fr shl fr16 4
small le fr 4095
big gt fr 4095
# "\t.globl _a0_" name "\n\t.p2align 2\n_a0_" name ":\n\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n"
# then "\tsub sp, sp, #" fr "\n" or, above 4095, w9 = fr and "\tsub sp, sp, x9\n"
l0 call line
h1 call lp l0 1818701321 543973999 1597006175 0 true
h2 call lname h1 p2 p3 name true
h3 call lp h2 1882065162 1768710450 840986215 811687690 true
h4 call lb h3 95 true
h5 call lname h4 p2 p3 name true
h6 call lp h5 1929972282 2015391860 539769138 741356408 true
h7 call lp h6 1886608160 757276716 559756849 1869416714 true
h8 call lp h7 846733430 1931488313 2672 0 true
h9 call lp h8 1651864329 745567008 745567008 8992 small
h10 call ldec h9 fr small
h11 call lb h10 10 small
h12 call lmovi h11 14711 fr big
h13 call lp h12 1651864329 745567008 745567008 171538464 big
s1 call flush p0 h13 true
s2 fold paramstep np s1 p7 fp o
s3 fold enodestep cnt s2 p5 p6 p4 p7 p2 p3 first o np p1
# the result to w0, then "\tmov sp, x29\n\tldp x29, x30, [sp], #16\n\tret\n\n"
rk shr retw 28
rv and retw 268435455
e1 call lload l0 rk rv 12407 o np true
e2 call lp e1 1987013897 745567008 959608864 1684801802 true
e3 call lp e2 846733424 2015374393 539766835 1567650651 true
e4 call lp e3 824385580 1913195062 168457317 0 true
s4 call flush s3 e4 true
ret s4
end
# the module: p0 pool p1 sym p2 fns p3 nodes p4 args p5 tlist p6 function count
# "\t.section __TEXT,__text,regular,pure_instructions\n\n" first, "\n.subsections_via_symbols\n" last
fn emitmod u32x512 u32x512 u32x1024 u32x4096 u32x8192 u32x1024 u32 -> (u32x4096,u32)
z call zeros4096
s0 rec z 0
l0 call line
h1 call lp l0 1702047241 1869182051 1600069742 1415071060 true
h2 call lp h1 1952407340 745830501 1969710450 745693548 true
h3 call lp h2 1701999984 1936615775 1668641396 1852795252 true
h4 call lp h3 658035 0 0 0 true
s1 call flush s0 h4 true
s2 fold efnstep p6 s1 p0 p1 p2 p3 p4 p5
f1 call lp l0 1970482698 1667593058 1852795252 1769365363 true
f2 call lp f1 2037604193 1819239021 2675 0 true
s3 call flush s2 f2 true
ret s3
end
# --- the scope check: the first function with a parameter, result or node that is not u32
# or bool, as (fn node); node 4294967295 for a header type
fn scanp u32 u32 u32x1024 u32 -> u32
a add p3 p1
t get p2 a
bad gt t 1
b select bad 1 0
r add p0 b
ret r
end
fn scann u32 u32 u32x1024 u32 -> u32
a add p3 p1
t get p2 a
bad gt t 1
none eq p0 4294967295
new and none bad
r select new p1 p0
ret r
end
fn scanfn (u32,u32) u32 u32x1024 u32x1024 u32x1024 -> (u32,u32)
bfn at p0 0
bnode at p0 1
f7 mul p1 7
f71 add f7 1
np get p2 f71
f72 add f7 2
fp get p2 f72
f73 add f7 3
res get p2 f73
f74 add f7 4
first get p2 f74
f75 add f7 5
cnt get p2 f75
nbp fold scanp np 0 p3 fp
badp gt nbp 0
badr gt res 1
hdr or badp badr
bn fold scann cnt 4294967295 p4 first
badn ne bn 4294967295
bad or hdr badn
node select hdr 4294967295 bn
none eq bfn 4294967295
new and none bad
bfn2 select new p1 bfn
bnode2 select new node bnode
r rec bfn2 bnode2
ret r
end
fn wstep4096 io u32 u32x4096 -> io
v get p2 p1
w write p0 v
ret w
end
# io front: read n then n source bytes; lex, parse, check, emit; write ok, code, fn, node
# (as checkio; 5 for a function outside the scalar scope), then the byte count and the
# assembly bytes (0 on an error). The result is the code.
fn emitio io -> u32
r0 read p0
n0 at r0 0
t0 at r0 1
big lt 512 n0
n select big 512 n0
z call zeros512
s0 rec z t0
rd fold readbyte n s0
src at rd 0
t1 at rd 1
pr call parse src n
pcode at pr 0
petok at pr 1
pool at pr 2
sym at pr 3
types at pr 4
tlist at pr 5
fns at pr 6
nodes at pr 7
args at pr 8
ntypes at pr 12
ntlist at pr 13
nfns at pr 14
nnodes at pr 15
nargs at pr 16
ntypes3 mul ntypes 3
nfns7 mul nfns 7
nnodes6 mul nnodes 6
nargs2 mul nargs 2
z768 call zeros768
z1024 call zeros1024
z4096 call zeros4096
z8192 call zeros8192
z256 call zeros256
types1 fold cp768 ntypes3 z768 types
tlist1 fold cp1024 ntlist z1024 tlist
fns1 fold cp1024 nfns7 z1024 fns
nodes1 fold cp4096 nnodes6 z4096 nodes
args1 fold cp8192 nargs2 z8192 args
ck call check types1 tlist1 fns1 nodes1 args1 z256 ntypes ntlist nfns 0
ntys at ck 6
cerr at ck 10
cfn at ck 11
cnode at ck 12
pok eq pcode 0
code0 select pok cerr pcode
fn0 select pok cfn 4294967295
node0 select pok cnode petok
ok0 eq code0 0
sc0 rec 4294967295 4294967295
sc fold scanfn nfns sc0 fns1 tlist1 ntys
scfn at sc 0
scnode at sc 1
scbad ne scfn 4294967295
refuse and ok0 scbad
code1 select refuse 5 code0
fn1 select refuse scfn fn0
node1 select refuse scnode node0
ok1 eq code1 0
nemit select ok1 nfns 0
em call emitmod pool sym fns1 nodes1 args1 tlist1 nemit
out at em 0
nout at em 1
full ge nout 4096
over and ok1 full
code select over 4 code1
fnw0 select over 4294967295 fn1
nodew0 select over 4294967295 node1
ok eq code 0
fnw select ok 0 fnw0
nodew select ok 0 nodew0
okw select ok 1 0
w0 write t1 okw
w1 write w0 code
w2 write w1 fnw
w3 write w2 nodew
nbytes select ok nout 0
w4 write w3 nbytes
w5 fold wstep4096 nbytes w4 out
ret code
end

# ---------------------------------------------------------------------------------------------
# Whole-language emitter (stage 6b, the q functions): the checked paged IR of the A0
# front end (the tables emit_c.a0 `cunit` builds) to Darwin arm64 assembly text, one byte per io
# word, for every construct: u32 bool io, arrays and records at any nesting, call fold loop, arr rec text get set
# at put, read write puts. `qunit` is `cunit` with this emitter; boot.a0 `emitachunkio` is its
# chunked io entry, and a program compiled by it (the compiler itself included) needs no C.
# Values: a u32 or bool is one 32-bit word (bool 0/1), an array its elements back to back, a
# record its fields in order, io is zero bytes (the stream is the runtime's `_a0_io`, reached only
# through `_a0rt_read`, `_a0rt_write` and `_a0rt_puts`, which the host links in). Every
# parameter and node has an 8-byte cell at x21 + 8k (parameters first, then the nodes): a scalar
# zero-extended, an aggregate as a pointer to its bytes. Aggregates are never written after they
# are built, so `mov` `select` `get` `at` of an aggregate alias (the cell takes the pointer), and a
# node that builds one (`arr` `rec` `text` `set` `put` `read`, a call or a fold with an aggregate
# result) allocates its bytes on the machine stack (sp moves down; everything is released by the
# epilogue). Calls follow the Darwin arm64 C convention for the parameter list without its io
# entries: parameter k in the next of x0-x7 (a scalar as its w register, an aggregate as a
# pointer), then the stack at Darwin's packing (u32 4 bytes, bool 1, pointer 8); a scalar result
# in w0, an aggregate result written through x8 by the callee's `ret` (after the body, so x8 may
# be the fold state the body reads). So a function over scalars is callable from C as
# `_a0_<name>`. A fold or loop keeps its counter and bound in w19 and w20 and its state in the
# node's cell (for an aggregate state: its own bytes, passed as p0 and as x8). Frame:
#     x29 + 16 + ...   incoming stack parameters
#     x29              saved x29 x30, then x19 x20, x21 x22 (x22: the incoming x8)
#     x21 = sp at entry + cells (8 (np + nodes), rounded to 16); aggregates below
# The prelude (head) writes `_a0rt_copy` (x0 destination, x1 source, x2 bytes) and `_a0rt_zero`
# (x0, x2), which keep x9-x15. Node code: operands in x9-x11, the result in x12, element
# addresses in x13, sizes and offsets through x16.

# word p1 of a paged table (page p1 >> 7, word p1 & 127)
fn qw65 u32x128x65 u32 -> u32
pi shr p1 7
pg get p0 pi
wi and p1 127
v get pg wi
ret v
end
fn qw24 u32x128x24 u32 -> u32
pi shr p1 7
pg get p0 pi
wi and p1 127
v get pg wi
ret v
end
fn qw128 u32x128x128 u32 -> u32
pi shr p1 7
pg get p0 pi
wi and p1 127
v get pg wi
ret v
end
fn qw16 u32x128x16 u32 -> u32
pi shr p1 7
pg get p0 pi
wi and p1 127
v get pg wi
ret v
end
fn qw512 u32x128x512 u32 -> u32
pi shr p1 7
pg get p0 pi
wi and p1 127
v get pg wi
ret v
end
# word p2 of the triple (tag a b) of type p1
fn qtw u32x384x65 u32 u32 -> u32
pi shr p1 7
pg get p0 pi
wi and p1 127
w3 mul wi 3
i add w3 p2
v get pg i
ret v
end
# p0 plus the byte size of field p1 of the list tlist p3 from p4 (sizes p2)
fn qfsz u32 u32 u32x128x65 u32x128x65 u32 -> u32
i add p4 p1
t call qw65 p3 i
s call qw65 p2 t
r add p0 s
ret r
end
# the byte size of type p1 (u32 bool 4, io 0, arrays and records from their components, which
# are interned before them) into the size table p0
fn qszst u32x128x65 u32 u32x384x65 u32x128x65 -> u32x128x65
tag call qtw p2 p1 0
a call qtw p2 p1 1
b call qtw p2 p1 2
sc lt tag 3
t4 eq tag 4
t5 eq tag 5
eb call qw65 p0 b
am mul a eb
n5 select t5 b 0
rs fold qfsz n5 0 p0 p3 a
s1 select sc 4 0
s2 select t4 am s1
s3 select t5 rs s2
pi shr p1 7
pg get p0 pi
wi and p1 127
pg2 set pg wi s3
r set p0 pi pg2
ret r
end
fn qszt u32x384x65 u32x128x65 u32 -> u32x128x65
z call z65
r fold qszst p2 z p0 p1
ret r
end
# how a value of type p1 travels: 0 io (nowhere), 1 u32, 2 bool, 3 pointer (aggregates)
fn qcls u32x384x65 u32 -> u32
tag call qtw p0 p1 0
c1 eq tag 1
c2 eq tag 2
c3 eq tag 3
a select c2 2 3
b select c1 1 a
r select c3 0 b
ret r
end
# the stack bytes of a class (Darwin packing)
fn qcsz u32 -> u32
c1 eq p0 1
c2 eq p0 2
c3 eq p0 3
a select c3 8 0
b select c2 1 a
r select c1 4 b
ret r
end
# placement state (registers used, stack bytes) after parameter p1 of the list tlist p2 from p4
fn qplst (u32,u32) u32 u32x128x65 u32x384x65 u32 -> (u32,u32)
nr at p0 0
so at p0 1
i add p4 p1
t call qw65 p2 i
c call qcls p3 t
sz call qcsz c
nio ne c 0
rg lt nr 8
nr1 add nr 1
m1 sub sz 1
x add so m1
ng sub 0 sz
al and x ng
so1 add al sz
ur and nio rg
nrg select rg false true
us and nio nrg
nr2 select ur nr1 nr
so2 select us so1 so
r rec nr2 so2
ret r
end
# where parameter p3 of the list tlist p0 from p2 travels: (0 nowhere / 1 register / 2 stack,
# the register or the stack offset, the class)
fn qplace u32x128x65 u32x384x65 u32 u32 -> (u32,u32,u32)
z rec 0 0
s fold qplst p3 z p0 p1 p2
nr at s 0
so at s 1
i add p2 p3
t call qw65 p0 i
c call qcls p1 t
sz call qcsz c
nio ne c 0
rg lt nr 8
m1 sub sz 1
x add so m1
ng sub 0 sz
al and x ng
l1 select rg 1 2
loc select nio l1 0
wh select rg nr al
r rec loc wh c
ret r
end
# the stack argument bytes of the p3 parameters at tlist p0 from p2, rounded to 16
fn qstk u32x128x65 u32x384x65 u32 u32 -> u32
z rec 0 0
s fold qplst p3 z p0 p1 p2
so at s 1
x add so 15
r and x 4294967280
ret r
end
# operand (kind p3, value p4) into register p2 (p5 parameters): 1 node and 2 parameter from
# their cells, 3 u32 and 4 bool literals, 6 the fold counter w19
fn qld io u32 u32 u32 u32 u32 -> io
k1 eq p3 1
k2 eq p3 2
k3 eq p3 3
k4 eq p3 4
k6 eq p3 6
c1 add p5 p4
ca select k1 c1 p4
off mul ca 8
cell or k1 k2
# t a p0 cell "\tldr x{p2}, [x21, #{off}]\n"
a_1 call cws6c p0 cell 1919183881 30752 0 0 0 0
a_2 call cwdecc a_1 cell p2
a_3 call cws6c a_2 cell 2019237932 539767090 35 0 0 0
a_4 call cwdecc a_3 cell off
a call cws6c a_4 cell 2653 0 0 0 0 0
lit or k3 k4
lo and p4 65535
hi shr p4 16
hz ne hi 0
lh and lit hz
# t b a lit "\tmovz w{p2}, #{lo}\n"
b_1 call cws6c a lit 1987013897 7807098 0 0 0 0
b_2 call cwdecc b_1 lit p2
b_3 call cws6c b_2 lit 2301996 0 0 0 0 0
b_4 call cwdecc b_3 lit lo
b call cws6c b_4 lit 10 0 0 0 0 0
# t c b lh "\tmovk w{p2}, #{hi}, lsl #16\n"
c_1 call cws6c b lh 1987013897 7807083 0 0 0 0
c_2 call cwdecc c_1 lh p2
c_3 call cws6c c_2 lh 2301996 0 0 0 0 0
c_4 call cwdecc c_3 lh hi
c call cws6c c_4 lh 1936465964 824385644 2614 0 0 0
# t d c k6 "\tmov w{p2}, w19\n"
d_1 call cws6c c k6 1987013897 30496 0 0 0 0
d_2 call cwdecc d_1 k6 p2
d call cws6c d_2 k6 829890604 2617 0 0 0 0
ret d
end
# the 32-bit value p3 into x register p2 / w register p2
fn qmovx io u32 u32 u32 -> io
lo and p3 65535
hi shr p3 16
hz ne hi 0
# t a p0 - "\tmovz x{p2}, #{lo}\n"
a_1 call cws6 p0 1987013897 7872634 0 0 0 0
a_2 call cwdec a_1 p2
a_3 call cws6 a_2 2301996 0 0 0 0 0
a_4 call cwdec a_3 lo
a call cws6 a_4 10 0 0 0 0 0
# t b a hz "\tmovk x{p2}, #{hi}, lsl #16\n"
b_1 call cws6c a hz 1987013897 7872619 0 0 0 0
b_2 call cwdecc b_1 hz p2
b_3 call cws6c b_2 hz 2301996 0 0 0 0 0
b_4 call cwdecc b_3 hz hi
b call cws6c b_4 hz 1936465964 824385644 2614 0 0 0
ret b
end
fn qmovw io u32 u32 u32 -> io
lo and p3 65535
hi shr p3 16
hz ne hi 0
# t a p0 - "\tmovz w{p2}, #{lo}\n"
a_1 call cws6 p0 1987013897 7807098 0 0 0 0
a_2 call cwdec a_1 p2
a_3 call cws6 a_2 2301996 0 0 0 0 0
a_4 call cwdec a_3 lo
a call cws6 a_4 10 0 0 0 0 0
# t b a hz "\tmovk w{p2}, #{hi}, lsl #16\n"
b_1 call cws6c a hz 1987013897 7807083 0 0 0 0
b_2 call cwdecc b_1 hz p2
b_3 call cws6c b_2 hz 2301996 0 0 0 0 0
b_4 call cwdecc b_3 hz hi
b call cws6c b_4 hz 1936465964 824385644 2614 0 0 0
ret b
end
# p2 bytes (rounded to 16) on the stack; x12 points at them
fn qalloc io u32 u32 -> io
s add p2 15
r and s 4294967280
a call qmovx p0 0 16 r
# t b a - "\tsub sp, sp, x16\n\tmov x12, sp\n"
b_1 call cws6 a 1651864329 745567008 745567008 909211680 1869416714 829956214
b call cws6 b_1 1931488306 2672 0 0 0 0
ret b
end
# x13 = x<p4> + (w10 mod p2) * p3: the address of the element an index selects
fn qmod io u32 u32 u32 u32 -> io
a call qmovw p0 0 11 p2
# t b a - "\tudiv w13, w10, w11\n\tmsub w10, w13, w11, w10\n"
b_1 call cws6 a 1768191241 829890678 1998597171 539766833 170996087 1970498825
b call cws6 b_1 829890658 1998597168 539767601 741421431 808548128 10
c call qmovx b 0 11 p3
# t d c - "\tumaddl x13, w10, w11, x{p4}\n"
d_1 call cws6 c 1634563337 543974500 741552504 808548128 829890604 2015374385
d_2 call cwdec d_1 p4
d call cws6 d_2 10 0 0 0 0 0
ret d
end
# The node context (a record of 19 words): 0 index, 1 parameter count, 2 op, 3 operand count,
# 4 first operand, 5 callee, 6 predicate, 7 type, 8 its tag, 9 its size, 10-15 the kinds and
# values of the first three operands, 16 17 the function's name (pool start, length), 18 the
# cell offset.
# argument p1 of a call (mode 0: operand p1) or of a fold/loop body (mode 1: the state, the
# counter, then operand p1) into its register or stack slot; the callee's list is tlist p6 from p7
fn qarg io u32 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x512 u32x384x65 u32x128x65 u32 -> io
j at p3 0
np at p3 1
fa at p3 4
o add fa p1
w mul o 2
kind call qw512 p4 w
w1 add w 1
val call qw512 p4 w1
m1 eq p2 1
z eq p1 0
one eq p1 1
s0 and m1 z
s1 and m1 one
kd0 select s0 1 kind
kd select s1 6 kd0
vl select s0 j val
pl call qplace p6 p5 p7 p1
loc at pl 0
wh at pl 1
cls at pl 2
isr eq loc 1
iss eq loc 2
nr select isr 1 0
nst select iss 1 0
a fold qld nr p0 wh kd vl np
b fold qld nst a 9 kd vl np
c1 eq cls 1
c2 eq cls 2
c3 eq cls 3
t1 and iss c1
t2 and iss c2
t3 and iss c3
# t c b t1 "\tstr w9, [sp, #{wh}]\n"
c_1 call cws6c b t1 1920234249 741963552 1886608160 2301996 0 0
c_2 call cwdecc c_1 t1 wh
c call cws6c c_2 t1 2653 0 0 0 0 0
# t d c t2 "\tstrb w9, [sp, #{wh}]\n"
d_1 call cws6c c t2 1920234249 964108386 1935351852 589311088 0 0
d_2 call cwdecc d_1 t2 wh
d call cws6c d_2 t2 2653 0 0 0 0 0
# t e d t3 "\tstr x9, [sp, #{wh}]\n"
e_1 call cws6c d t3 1920234249 741963808 1886608160 2301996 0 0
e_2 call cwdecc e_1 t3 wh
e call cws6c e_2 t3 2653 0 0 0 0 0
ret e
end
# the arguments (mode p2), `bl` to function p10 and the stack arguments released
fn qinvoke io u32 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x512 u32x384x65 u32x128x65 u32x128x45 u32x128x16 u32x128x400 u32 -> io
cb mul p10 7
cnp call cfw p7 cb 1
cfp call cfw p7 cb 2
s call qstk p6 p5 cfp cnp
hs ne s 0
n select hs 1 0
a fold qmovx n p0 16 s
# t b a hs "\tsub sp, sp, x16\n"
b call cws6c a hs 1651864329 745567008 745567008 909211680 10 0
c fold qarg cnp b p2 p3 p4 p5 p6 cfp
m2 mul p10 2
cs call qw16 p8 m2
m3 add m2 1
cl call qw16 p8 m3
# t d c - "\tbl _a0_{name:p9,cs,cl}\n"
d_1 call cws6 c 543973897 1597006175 0 0 0 0
d_2 call cwnm d_1 true p9 cs cl
d call cws6 d_2 10 0 0 0 0 0
e fold qmovx n d 16 s
# t f e hs "\tadd sp, sp, x16\n"
f call cws6c e hs 1684300041 745567008 745567008 909211680 10 0
ret f
end
# The node groups, each run once for its ops (p2 the context; tables args ntys types tlist szt
# fns fnm pool; p11 the first node, p12 the first parameter).
# mov (op 1) and select (18)
fn qgmov io u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x45 u32x128x16 u32x128x400 u32 u32 -> io
np at p2 1
op at p2 2
k0 at p2 10
v0 at p2 11
k1 at p2 12
v1 at p2 13
k2 at p2 14
v2 at p2 15
off at p2 18
sl eq op 18
nm select sl 0 1
ns select sl 1 0
a fold qld nm p0 12 k0 v0 np
b fold qld ns a 9 k0 v0 np
c fold qld ns b 10 k1 v1 np
d fold qld ns c 11 k2 v2 np
# t e d sl "\tcmp w9, #0\n\tcsel x12, x10, x11, ne\n"
e_1 call cws6c d sl 1886216969 741963552 170926880 1702060809 829956204 2015374386
e call cws6c e_1 sl 539766833 741421432 174419488 0 0 0
# t f e - "\tstr x12, [x21, #{off}]\n"
f_1 call cws6 e 1920234249 842102816 2019237932 539767090 35 0
f_2 call cwdec f_1 off
f call cws6 f_2 2653 0 0 0 0 0
ret f
end
# ops 2-17
fn qgalu io u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x45 u32x128x16 u32x128x400 u32 u32 -> io
np at p2 1
op at p2 2
k0 at p2 10
v0 at p2 11
k1 at p2 12
v1 at p2 13
off at p2 18
a call qld p0 0 9 k0 v0 np
b call qld a 0 10 k1 v1 np
is2 eq op 2
is3 eq op 3
is4 eq op 4
is5 eq op 5
is6 eq op 6
is7 eq op 7
is8 eq op 8
is9 eq op 9
is10 eq op 10
is11 eq op 11
is12 eq op 12
is13 eq op 13
is14 eq op 14
is15 eq op 15
is16 eq op 16
is17 eq op 17
# t c2 b is2 "\tadd w12, w9, w10\n"
c2 call cws6c b is2 1684300041 842102560 964108332 829890604 2608 0
# t c3 c2 is3 "\tsub w12, w9, w10\n"
c3 call cws6c c2 is3 1651864329 842102560 964108332 829890604 2608 0
# t c4 c3 is4 "\tmul w12, w9, w10\n"
c4 call cws6c c3 is4 1819634953 842102560 964108332 829890604 2608 0
# t c5 c4 is5 "\tand w12, w9, w10\n"
c5 call cws6c c4 is5 1684955401 842102560 964108332 829890604 2608 0
# t c6 c5 is6 "\torr w12, w9, w10\n"
c6 call cws6c c5 is6 1920102153 842102560 964108332 829890604 2608 0
# t c7 c6 is7 "\teor w12, w9, w10\n"
c7 call cws6c c6 is7 1919902985 842102560 964108332 829890604 2608 0
# t c8 c7 is8 "\tlsl w12, w9, w10\n"
c8 call cws6c c7 is8 1819503625 842102560 964108332 829890604 2608 0
# t c9 c8 is9 "\tlsr w12, w9, w10\n"
c9 call cws6c c8 is9 1920166921 842102560 964108332 829890604 2608 0
# t c10 c9 is10 "\tudiv w12, w9, w10\n\tcmp w10, #0\n\tcsinv w12, w12, wzr, ne\n"
c10_1 call cws6c c9 is10 1768191241 829890678 1998597170 1998597177 151662641 544238947
c10_2 call cws6c c10_1 is10 741355895 170926880 1769169673 1998616174 539767345 741486967
c10 call cws6c c10_2 is10 1920628512 1701716012 10 0 0 0
# t c11 c10 is11 "\tudiv w12, w9, w10\n\tmsub w12, w12, w10, w9\n"
c11_1 call cws6c c10 is11 1768191241 829890678 1998597170 1998597177 151662641 1651864429
c11 call cws6c c11_1 is11 842102560 829890604 1998597170 539766833 670071 0
cmp ge op 12
# t cc c11 cmp "\tcmp w9, w10\n"
cc call cws6c c11 cmp 1886216969 741963552 808548128 10 0 0
# t c12 cc is12 "\tcset w12, eq\n"
c12 call cws6c cc is12 1702060809 829890676 1696607282 2673 0 0
# t c13 c12 is13 "\tcset w12, ne\n"
c13 call cws6c c12 is13 1702060809 829890676 1847602226 2661 0 0
# t c14 c13 is14 "\tcset w12, lo\n"
c14 call cws6c c13 is14 1702060809 829890676 1814047794 2671 0 0
# t c15 c14 is15 "\tcset w12, ls\n"
c15 call cws6c c14 is15 1702060809 829890676 1814047794 2675 0 0
# t c16 c15 is16 "\tcset w12, hi\n"
c16 call cws6c c15 is16 1702060809 829890676 1746938930 2665 0 0
# t c17 c16 is17 "\tcset w12, hs\n"
c17 call cws6c c16 is17 1702060809 829890676 1746938930 2675 0 0
# t z c17 - "\tstr x12, [x21, #{off}]\n"
z_1 call cws6 c17 1920234249 842102816 2019237932 539767090 35 0
z_2 call cwdec z_1 off
