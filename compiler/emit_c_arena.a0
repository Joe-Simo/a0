fn tc_allocate ((u32,(u32,u32,u32),io),u32x16) u32 u32 u32 -> ((u32,(u32,u32,u32),io),u32x16)
s at p0 0
ctx at p0 1
old at s 0
out at s 1
t at s 2
r call ew_new t p3
status at r 0
v at r 1
t1 at r 2
h at v 0
ok eq old 0
code select ok status old
s1 rec code out t1
next set ctx p2 h
result rec s1 next
ret result
end

fn tc_prepare ((u32,(u32,u32,u32),io),u32x16) u32 -> ((u32,(u32,u32,u32),io),u32x16)
ctx at p0 1
nt get ctx 12
nf get ctx 11
nn get ctx 13
typewords mul nt 8
names call tc_allocate p0 0 6 typewords
fnwords mul nf 4
functions call tc_allocate names 0 7 fnwords
aliaswords mul nn 2
aliases call tc_allocate functions 0 8 aliaswords
borrows call tc_allocate aliases 0 9 nn
live call tc_allocate borrows 0 10 nn
options call tc_allocate live 0 14 8
boundwords mul nn 20
bounds call tc_allocate options 0 15 boundwords
ret bounds
end

fn tc_analyze io u32x16 u32 u32 u32 u32 -> ((u32,(u32,u32,u32),io),u32x16)
v rec 0 0 0
nt get p1 12
nf get p1 11
nn get p1 13
typefits le nt 536870911
fnsafe le nf 429496729
nodesafe le nn 214748364
a and typefits fnsafe
safe and a nodesafe
status0 select safe 0 7
flags eq p5 0
status select flags status0 12
start rec status v p0
initial rec start p1
okay eq status 0
times select okay 1 0
prepared fold tc_prepare times initial
s at prepared 0
ctx at prepared 1
h get ctx 14
s0 call sv_store s h 0 p2
s1 call sv_store s0 h 1 p3
s2 call sv_store s1 h 2 p4
s3 call sv_store s2 h 3 p5
checked loop sv_ok tc_policy_opcode nn s3 ctx 0 0
layouts loop sv_ok tc_layout_type nt checked ctx 0 0
mangled loop sv_ok tc_type_mangle nt layouts ctx 0 0
summary loop sv_ok tc_type_summary nt mangled ctx 0 0
initialized loop sv_ok bc_bound_init nn summary ctx 0 0
facts loop sv_ok bc_bound_level 9 initialized ctx 0 0
strict loop sv_ok tc_policy_fn nf facts ctx 0 0
typepolicy loop sv_ok tc_policy_fn_types nf strict ctx 0 0
planned loop sv_ok tc_plan_fn nf typepolicy ctx 0 0
result rec planned ctx
ret result
end

fn c_emit io u32x16 u32 u32 u32 -> (u32,(u32,u32,u32),io)
phase call tc_analyze p0 p1 p2 p3 0 p4
s at phase 0
ctx at phase 1
code at s 0
okay eq code 0
times select okay 1 0
rendered fold tc_program times s ctx 0 0
result call ew_public rendered
ret result
end


fn tc_forward_c (u32,(u32,u32,u32),io) u32 u32x16 u32 u32 u32 -> (u32,(u32,u32,u32),io)
t at p0 2
r call c_emit t p2 p3 p4 p5
ret r
end

fn tc_same_count (u32,(u32,u32,u32),io) u32x16 u32x16 -> (u32,(u32,u32,u32),io)
old at p0 0
out at p0 1
t at p0 2
a get p1 11
b get p2 11
same eq a b
okay eq old 0
bad select same 0 6
code select okay bad old
r rec code out t
ret r
end

fn c_emit_shaped io u32x16 u32x16 u32 u32 u32 -> (u32,(u32,u32,u32),io)
phase call tc_analyze p0 p1 p3 p4 0 p5
s at phase 0
checked call tc_same_count s p1 p2
code at checked 0
okay eq code 0
times select okay 1 0
r fold tc_forward_c times checked p2 p3 p4 p5
out call ew_public r
ret out
end
