fn ap_fail (u32x128,io) u32 u32 u32 u32 u32 -> (u32x128,io)
p at p0 0
q0 get p 0
q1 eq q0 0
q2 ne p1 0
active and q1 q2
q3 get p 0
q4 select active 6 q3
a set p 0 q4
q5 get p 1
q6 select active p1 q5
b set a 1 q6
q7 get p 2
q8 select active p2 q7
c set b 2 q8
q9 get p 3
q10 select active p3 q9
d set c 3 q10
q11 get p 4
q12 select active p4 q11
e set d 4 q12
q13 get p 5
q14 select active p5 q13
f set e 5 q14
q15 at p0 1
q16 rec f q15
ret q16
end
fn ap_readgo (u32x128,u32x128,io) u32 u32 u32 u32 -> (u32x128,u32x128,io)
p at p0 0
q0 at p0 2
q1 get p p2
q2 add p2 1
q3 get p q2
q4 add p2 2
q5 get p q4
q6 rec q1 q3 q5
r call av_load q0 q6 p3 p4
q7 at r 0
q8 set p 0 q7
q9 at r 1
q10 at r 2
q11 rec q8 q9 q10
ret q11
end
fn ap_read (u32x128,io) u32 u32 u32 -> (u32x128,u32x128,io)
p at p0 0
z call arena_zero
q0 get p 0
q1 eq q0 0
q2 select q1 1 0
q3 at p0 1
q4 rec p z q3
q5 fold ap_readgo q2 q4 p1 p2 p3
ret q5
end
fn ap_appendgo (u32x128,io) u32 u32 u32 u32x128 -> (u32x128,io)
p at p0 0
q0 at p0 1
q1 get p p2
q2 add p2 1
q3 get p q2
q4 add p2 2
q5 get p q4
q6 rec q1 q3 q5
r call av_append q0 q6 p3 p4
q7 at r 1
q8 at q7 0
m1_a set p p2 q8
q9 add p2 1
q10 at q7 1
m1_b set m1_a q9 q10
q11 add p2 2
q12 at q7 2
q13 set m1_b q11 q12
q14 at r 0
q15 set q13 0 q14
q16 at r 2
q17 rec q15 q16
ret q17
end
fn ap_append (u32x128,io) u32 u32 u32x128 -> (u32x128,io)
p at p0 0
q0 get p 0
q1 eq q0 0
q2 select q1 1 0
q3 fold ap_appendgo q2 p0 p1 p2 p3
ret q3
end
