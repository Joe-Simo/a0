# Ordered spec verification. Parse all source, then body/types/evaluation/publication per function.
# Service state holds original IR, grammar, typed contracts, and the resumable evaluator separately.
use "spec_types_arena.a0"
use "eval_arena.a0"
use "verify_arena_shared.a0"

fn arena_parse_verify_begin io u32 u32 -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
p call arena_parse p0 p1 p2
q0 at p 2
q1 at p 1
q2 call arena_verify_begin q0 q1
ret q2
end
