  s = fold(csop, op == 4 ? 1 : 0, s, bk, bv)
  s = fold(cslit33, op == 4 ? 1 : 0, s)
  s = fold(cslit19, op == 5 ? 1 : 0, s)
  s = fold(csop, op == 5 ? 1 : 0, s, ak, av)
  s = fold(cslit36, op == 5 ? 1 : 0, s)
  s = fold(csop, op == 5 ? 1 : 0, s, bk, bv)
