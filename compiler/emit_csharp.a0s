  s = fold(cslit68, op == 34 ? 1 : 0, s)
  s = fold(csargs, op == 34 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 34 ? 1 : 0, s)
  s = fold(cslit69, op == 35 ? 1 : 0, s)
  s = fold(csargs, op == 35 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 35 ? 1 : 0, s)
  s = fold(cslit70, op == 36 ? 1 : 0, s)
  s = fold(csargs, op == 36 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 36 ? 1 : 0, s)
  s = fold(cslit71, op == 37 ? 1 : 0, s)
  s = fold(csargs, op == 37 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 37 ? 1 : 0, s)
  return s
end

fn csiter(s: io, i: u32, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, ty: u32x384x65, tl: u32x128x65, pool: u32x128x400, fnm: u32x128x16, first: u32, fp: u32) -> io
  let g = first + i
  let op = csn(nd, g, 1)
  let na = csn(nd, g, 2)
  let start = csn(nd, g, 3)
  let ak = csa(oa, start, 0)
  let av = csa(oa, start, 1)
  let bk = csa(oa, start + 1, 0)
  let bv = csa(oa, start + 1, 1)
  let ck = csa(oa, start + 2, 0)
  let cv = csa(oa, start + 2, 1)
  let atype = ak == 1 ? csnt(nt, first + av) : ak == 2 ? tl[fp + av] : ak == 4 ? 1 : 0
  let t = csnt(nt, g)
  let iter = (op == 20) | (op == 21)
  s = fold(cstyif, iter ? 1 : 0, s, ty, tl, t)
  s = fold(cslit72, iter ? 1 : 0, s)
  s = fold(cdecst2, iter ? 1 : 0, s, i)
  s = fold(cslit73, iter ? 1 : 0, s)
  s = fold(csop, iter ? 1 : 0, s, bk, bv)
  s = fold(cslit74, iter ? 1 : 0, s)
  s = fold(cdecst2, iter ? 1 : 0, s, i)
  s = fold(cslit75, iter ? 1 : 0, s)
  s = fold(cdecst2, iter ? 1 : 0, s, i)
  s = fold(cslit41, iter ? 1 : 0, s)
  s = fold(csop, iter ? 1 : 0, s, ak, av)
  s = fold(cslit76, iter ? 1 : 0, s)
  s = fold(cdecst2, iter ? 1 : 0, s, i)
  s = fold(cslit77, iter ? 1 : 0, s)
  s = fold(cslit78, op == 21 ? 1 : 0, s)
  s = fold(csnameif, op == 21 ? 1 : 0, s, pool, fnm, csn(nd, g, 5))
  s = fold(cslit79, op == 21 ? 1 : 0, s)
  s = fold(cdecst2, op == 21 ? 1 : 0, s, i)
  s = fold(cslit80, op == 21 ? 1 : 0, s)
  s = fold(cdecst2, op == 21 ? 1 : 0, s, i)
  s = fold(cslit5, (op == 21) & (na > 2) ? 1 : 0, s)
  s = fold(csargs, (op == 21) & (na > 2) ? 1 : 0, s, oa, start + 2, na - 2)
  s = fold(cslit81, op == 21 ? 1 : 0, s)
  s = fold(cslit0, iter ? 1 : 0, s)
  s = fold(cdecst2, iter ? 1 : 0, s, i)
  s = fold(cslit73, iter ? 1 : 0, s)
  s = fold(csnameif, iter ? 1 : 0, s, pool, fnm, csn(nd, g, 4))
  s = fold(cslit79, iter ? 1 : 0, s)
  s = fold(cdecst2, iter ? 1 : 0, s, i)
  s = fold(cslit80, iter ? 1 : 0, s)
  s = fold(cdecst2, iter ? 1 : 0, s, i)
  s = fold(cslit5, iter & (na > 2) ? 1 : 0, s)
  s = fold(csargs, iter & (na > 2) ? 1 : 0, s, oa, start + 2, na - 2)
  s = fold(cslit82, iter ? 1 : 0, s)
  return s
end

fn csnode(s: io, i: u32, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, ty: u32x384x65, tl: u32x128x65, pool: u32x128x400, fnm: u32x128x16, first: u32, fp: u32) -> io
  let g = first + i
  let op = csn(nd, g, 1)
  let na = csn(nd, g, 2)
  let start = csn(nd, g, 3)
  let ak = csa(oa, start, 0)
  let av = csa(oa, start, 1)
  let bk = csa(oa, start + 1, 0)
  let bv = csa(oa, start + 1, 1)
  let ck = csa(oa, start + 2, 0)
  let cv = csa(oa, start + 2, 1)
  let atype = ak == 1 ? csnt(nt, first + av) : ak == 2 ? tl[fp + av] : ak == 4 ? 1 : 0
  let t = csnt(nt, g)
  let plain = (op != 20) & (op != 21)
  s = fold(cslit83, true ? 1 : 0, s)
  s = fold(cslit61, plain ? 1 : 0, s)
  s = fold(cstyif, plain ? 1 : 0, s, ty, tl, t)
  s = fold(cslit72, plain ? 1 : 0, s)
  s = fold(cdecst2, plain ? 1 : 0, s, i)
  s = fold(cslit73, plain ? 1 : 0, s)
  s = csscalar(s, i, nd, oa, nt, ty, tl, pool, fnm, first, fp)
  s = cscomplex(s, i, nd, oa, nt, ty, tl, pool, fnm, first, fp)
  s = fold(cslit84, plain ? 1 : 0, s)
  s = csiter(s, i, nd, oa, nt, ty, tl, pool, fnm, first, fp)
  return s
end

fn csparam(s: io, i: u32, ty: u32x384x65, tl: u32x128x65, first: u32) -> io
  s = fold(cslit5, i != 0 ? 1 : 0, s)
  s = csty(s, ty, tl, tl[first + i])
  s = fold(cslit85, true ? 1 : 0, s)
  s = cwdec(s, i)
  return s
end

fn csfunction(s: io, i: u32, ty: u32x384x65, tl: u32x128x65, fns: u32x128x45, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, pool: u32x128x400, fnm: u32x128x16, from: u32) -> io
  let func = from + i
  let np = csf(fns, func, 1)
  let fp = csf(fns, func, 2)
  let result = csf(fns, func, 3)
  let first = csf(fns, func, 4)
  let count = csf(fns, func, 5)
  let ret = csf(fns, func, 6)
  let rk = ret >> 28
  let rv = ret & 0xfffffff
  let kind = rk == 5 ? csa(oa, rv, 0) : rk
  let value = rk == 5 ? csa(oa, rv, 1) : rv
  s = fold(cslit86, true ? 1 : 0, s)
  s = csty(s, ty, tl, result)
  s = fold(cslit87, true ? 1 : 0, s)
  s = csname(s, pool, fnm, func)
  s = fold(cslit19, true ? 1 : 0, s)
  s = fold(csparam, np, s, ty, tl, fp)
  s = fold(cslit88, true ? 1 : 0, s)
  s = fold(csnode, count, s, nd, oa, nt, ty, tl, pool, fnm, first, fp)
  s = fold(cslit89, true ? 1 : 0, s)
  s = csop(s, 0, kind, value)
  s = fold(cslit90, true ? 1 : 0, s)
  return s
end

fn csbadnode(bad: u32, i: u32, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, ty: u32x384x65, tl: u32x128x65, first: u32, fp: u32) -> u32
  let g = first + i
  let op = csn(nd, g, 1)
  let start = csn(nd, g, 3)
  let ak = csa(oa, start, 0)
  let av = csa(oa, start, 1)
  let atype = ak == 1 ? csnt(nt, first + av) : ak == 2 ? tl[fp + av] : 0
  let empty = ((op == 25) | (op == 26)) & (cst(ty, atype, 0) == 4) & (cst(ty, atype, 1) == 0)
  return bad | bit((op == 0) | (op > 37) | empty)
end
fn csbadfn(bad: u32, i: u32, fns: u32x128x45, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, ty: u32x384x65, tl: u32x128x65, from: u32) -> u32
  let f = from + i
  return fold(csbadnode, csf(fns, f, 5), bad, nd, oa, nt, ty, tl, csf(fns, f, 4), csf(fns, f, 2))
end

fn csnames(pool: u32x128x400, fnm: u32x128x16, from: u32, to: u32) -> u32
  return 0
end

fn csemit(s: io, unused: u32, ty: u32x384x65, tl: u32x128x65, fns: u32x128x45, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, pool: u32x128x400, fnm: u32x128x16, nty: u32, tfrom: u32, from: u32, to: u32, head: u32, tail: u32) -> io
  s = fold(cslit31, head != 0 ? 1 : 0, s)
  s = fold(csdecl, nty - tfrom, s, ty, tl, tfrom)
  s = fold(csfunction, to - from, s, ty, tl, fns, nd, oa, nt, pool, fnm, from)
  s = fold(cslit91, tail != 0 ? 1 : 0, s)
  return s
end

fn cssizecheck(ty: u32x384x65, tl: u32x128x65, nty: u32) -> u32
  let sizes = fold(cssizes, nty, (zeros(65), zeros(65), 0), ty, tl)
  return sizes#2
end
fn emitcsharp_profile(s: io, ty: u32x384x65, tl: u32x128x65, fns: u32x128x45, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, pool: u32x128x400, fnm: u32x128x16, nty: u32, tfrom: u32, from: u32, to: u32, head: u32, tail: u32, profile: u32, options: u32) -> (io,u32)
  let wide = cssizecheck(ty, tl, nty)
  let bad = fold(csbadfn, to - from, 0, fns, nd, oa, nt, ty, tl, from)
  let names = csnames(pool, fnm, from, to)
  let code = ((profile != 0) | (options != 0) | (names != 0)) ? 2 : wide != 0 ? 4 : bad != 0 ? 5 : 0
  let out = fold(csemit, code == 0 ? 1 : 0, s, ty, tl, fns, nd, oa, nt, pool, fnm, nty, tfrom, from, to, head, tail)
  return (out, code)
end

