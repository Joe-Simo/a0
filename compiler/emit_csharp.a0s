  s = fold(cslit19, op == 12 ? 1 : 0, s)
  s = fold(csop, op == 12 ? 1 : 0, s, ak, av)
  s = fold(cslit39, op == 12 ? 1 : 0, s)
  s = fold(csop, op == 12 ? 1 : 0, s, bk, bv)
  s = fold(cslit33, op == 12 ? 1 : 0, s)
  s = fold(cslit19, op == 13 ? 1 : 0, s)
