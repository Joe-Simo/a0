  s = fold(cslit5, op == 28 ? 1 : 0, s)
  s = fold(csop, op == 28 ? 1 : 0, s, ck, cv)
  s = fold(cslit33, op == 28 ? 1 : 0, s)
  s = fold(cslit63, op == 29 ? 1 : 0, s)
  s = fold(csargs, op == 29 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 29 ? 1 : 0, s)
  s = fold(cslit64, op == 30 ? 1 : 0, s)
  s = fold(csargs, op == 30 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 30 ? 1 : 0, s)
  s = fold(cslit65, op == 31 ? 1 : 0, s)
  s = fold(csargs, op == 31 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 31 ? 1 : 0, s)
  s = fold(cslit66, op == 32 ? 1 : 0, s)
  s = fold(csargs, op == 32 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 32 ? 1 : 0, s)
  s = fold(cslit67, op == 33 ? 1 : 0, s)
  s = fold(csargs, op == 33 ? 1 : 0, s, oa, start, na)
