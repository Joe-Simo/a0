  let ak = csa(oa, start, 0)
  let av = csa(oa, start, 1)
  let bk = csa(oa, start + 1, 0)
  let bv = csa(oa, start + 1, 1)
  let ck = csa(oa, start + 2, 0)
  let cv = csa(oa, start + 2, 1)
  let atype = ak == 1 ? csnt(nt, first + av) : ak == 2 ? tl[fp + av] : ak == 4 ? 1 : 0
  let t = csnt(nt, g)
  s = fold(csop, op == 1 ? 1 : 0, s, ak, av)
