end

fn cslit89(s: io, unused: u32) -> io
  s = cws6(s, 538976288, 1970562418, 2125426, 0, 0, 0)
  return s
end

fn cslit90(s: io, unused: u32) -> io
  s = cws6(s, 538970683, 175972477, 0, 0, 0, 0)
  return s
end

fn cslit91(s: io, unused: u32) -> io
  s = cws6(s, 2685, 0, 0, 0, 0, 0)
  return s
end

def csa(t: u32x128x512, i: u32, k: u32) -> u32
  let x = i * 2 + k
  return t[x]
end

def csn(t: u32x128x128, i: u32, k: u32) -> u32
  let x = i * 6 + k
  return t[x]
end

def csf(t: u32x128x45, i: u32, k: u32) -> u32
  let x = i * 7 + k
  return t[x]
end

def cst(t: u32x384x65, i: u32, k: u32) -> u32
  let page = t[i >> 7]
  return page[(i & 127) * 3 + k]
end
def csl(t: u32x128x65, i: u32) -> u32
  return t[i]
end
def csnt(t: u32x128x24, i: u32) -> u32
  return t[i]
end
def csdigits(x: u32) -> u32
  return 1 + bit(x >= 10) + bit(x >= 100) + bit(x >= 1000) + bit(x >= 10000) + bit(x >= 100000) + bit(x >= 1000000) + bit(x >= 10000000) + bit(x >= 100000000) + bit(x >= 1000000000)
end
fn cssum(s: u32, i: u32, sizes: u32x128x65, tl: u32x128x65, start: u32) -> u32
  let n = s + sizes[tl[start + i]]
  return n > 8193 ? 8193 : n
end
fn cssizes(s: (u32x128x65,u32x128x65,u32), i: u32, ty: u32x384x65, tl: u32x128x65) -> (u32x128x65,u32x128x65,u32)
  let (sizes, dims, bad) = s
  let kind = cst(ty, i, 0)
  let a = cst(ty, i, 1)
  let b = cst(ty, i, 2)
  let recsize = fold(cssum, kind == 5 ? b : 0, 0, sizes, tl, a)
  let size = kind <= 2 ? 1 : kind == 3 ? 2 : kind == 4 ? 2 + csdigits(a) + sizes[b] : 1 + csdigits(b) + recsize + b
  let dim = kind == 4 ? dims[b] + 1 : 0
  sizes[i] = size > 8193 ? 8193 : size
  dims[i] = dim
  return (sizes, dims, bad | bit((size > 8192) | (dim > 255) | ((kind == 5) & (b == 0))))
end

fn csop(s: io, unused: u32, kind: u32, value: u32) -> io
  s = fold(cslit0, kind == 1 ? 1 : 0, s)
  s = fold(cslit1, kind == 2 ? 1 : 0, s)
  s = fold(cdecst2, ((kind == 1) | (kind == 2)) ? 1 : 0, s, value)
  s = fold(cdecst2, kind == 3 ? 1 : 0, s, value)
  s = fold(cslit2, kind == 3 ? 1 : 0, s)
  s = fold(cslit3, (kind == 4) & (value == 0) ? 1 : 0, s)
  s = fold(cslit4, (kind == 4) & (value != 0) ? 1 : 0, s)
  return s
end

fn csarg(s: io, i: u32, oa: u32x128x512, start: u32) -> io
  s = fold(cslit5, i != 0 ? 1 : 0, s)
  s = csop(s, 0, csa(oa, start + i, 0), csa(oa, start + i, 1))
  return s
end

fn csargs(s: io, unused: u32, oa: u32x128x512, start: u32, count: u32) -> io
  return fold(csarg, count, s, oa, start)
end
def csname(s: io, pool: u32x128x400, fnm: u32x128x16, f: u32) -> io
  let a = cws6(s, 64, 0, 0, 0, 0, 0)
  return cwnm(a, true, pool, fnm[f * 2], fnm[f * 2 + 1])
end
fn csnameif(s: io, unused: u32, pool: u32x128x400, fnm: u32x128x16, f: u32) -> io
  return csname(s, pool, fnm, f)
end
fn csmrec(stack: u32x128x128, i: u32, tl: u32x128x65, first: u32, count: u32, base: u32) -> u32x128x128
  let k = count - i - 1
  stack[base + i * 2] = tl[first + k] + 1
  stack[base + i * 2 + 1] = 0 if k != 0
  return stack
end
fn csmgo(s: (io,u32x128x128,u32), i: u32, ty: u32x384x65, tl: u32x128x65) -> bool
  return s#2 != 0
end

fn csmstep(state: (io,u32x128x128,u32), unused: u32, ty: u32x384x65, tl: u32x128x65) -> (io,u32x128x128,u32)
  let (s, stack, sp) = state
  let top = sp - 1
  let code = stack[top]
  let t = code == 0 ? 0 : code - 1
  let kind = cst(ty, t, 0)
  let a = cst(ty, t, 1)
  let b = cst(ty, t, 2)
  let live = code != 0
  s = fold(cslit6, !live ? 1 : 0, s)
  s = fold(cslit2, live & (kind == 1) ? 1 : 0, s)
  s = fold(cslit7, live & (kind == 2) ? 1 : 0, s)
  s = fold(cslit8, live & (kind == 3) ? 1 : 0, s)
  s = fold(cslit9, live & (kind == 4) ? 1 : 0, s)
  s = fold(cdecst2, (live & (kind == 4)) ? 1 : 0, s, a)
  s = fold(cslit6, live & (kind == 4) ? 1 : 0, s)
  s = fold(cslit10, live & (kind == 5) ? 1 : 0, s)
  s = fold(cdecst2, (live & (kind == 5)) ? 1 : 0, s, b)
  s = fold(cslit6, live & (kind == 5) ? 1 : 0, s)
  stack[top] = b + 1 if live & (kind == 4)
  stack = fold(csmrec, (live & (kind == 5)) ? b : 0, stack, tl, a, b, top)
  let next = !live ? top : kind == 4 ? sp : kind == 5 ? top + b * 2 - 1 : top
  return (s, stack, next)
end

def csmangle(s: io, ty: u32x384x65, tl: u32x128x65, t: u32) -> io
  let stack = zeros(128)
  stack[0] = t + 1
  let out = loop(csmgo, csmstep, 8193, (s, stack, 1), ty, tl)
  return out#0
end
fn csmangleif(s: io, unused: u32, ty: u32x384x65, tl: u32x128x65, t: u32) -> io
  return csmangle(s, ty, tl, t)
end
fn csbasego(s: (u32,u32), i: u32, ty: u32x384x65) -> bool
  return cst(ty, s#0, 0) == 4
end
fn csbasestep(s: (u32,u32), i: u32, ty: u32x384x65) -> (u32,u32)
  return (cst(ty, s#0, 2), s#1 + 1)
end

def csty(s: io, ty: u32x384x65, tl: u32x128x65, t: u32) -> io
  let base = loop(csbasego, csbasestep, 256, (t, 0), ty)
  let kind = cst(ty, base#0, 0)
  s = fold(cslit11, kind == 1 ? 1 : 0, s)
  s = fold(cslit12, kind == 2 ? 1 : 0, s)
  s = fold(cslit13, kind == 3 ? 1 : 0, s)
  s = fold(cslit14, kind == 5 ? 1 : 0, s)
  s = fold(csmangleif, kind == 5 ? 1 : 0, s, ty, tl, base#0)
  s = fold(cslit15, base#1, s)
  return s
end

fn cstyif(s: io, unused: u32, ty: u32x384x65, tl: u32x128x65, t: u32) -> io
  return csty(s, ty, tl, t)
end

fn csfield(s: io, i: u32, ty: u32x384x65, tl: u32x128x65, first: u32) -> io
  s = fold(cslit5, i != 0 ? 1 : 0, s)
  s = csty(s, ty, tl, tl[first + i])
  s = fold(cslit16, true ? 1 : 0, s)
  s = cwdec(s, i)
  return s
end

fn csputdecl(s: io, i: u32, ty: u32x384x65, tl: u32x128x65, t: u32, first: u32, count: u32) -> io
  s = fold(cslit17, true ? 1 : 0, s)
  s = csty(s, ty, tl, t)
  s = fold(cslit18, true ? 1 : 0, s)
  s = csmangle(s, ty, tl, t)
  s = fold(cslit6, true ? 1 : 0, s)
  s = cwdec(s, i)
  s = fold(cslit19, true ? 1 : 0, s)
  s = csty(s, ty, tl, t)
  s = fold(cslit20, true ? 1 : 0, s)
  s = csty(s, ty, tl, tl[first + i])
  s = fold(cslit21, true ? 1 : 0, s)
  s = cwdec(s, i)
  s = fold(cslit22, true ? 1 : 0, s)
  return s
end

fn csdecl(s: io, i: u32, ty: u32x384x65, tl: u32x128x65, first: u32) -> io
  let t = first + i
  let kind = cst(ty, t, 0)
  let a = cst(ty, t, 1)
  let b = cst(ty, t, 2)
  let arr = kind == 4
  let rec = kind == 5
  let builtin = rec & (b == 2) & (tl[a] == 0) & ((tl[a + 1] == 1) | (tl[a + 1] == 2))
  let declrec = rec & !builtin
  s = fold(cslit17, arr ? 1 : 0, s)
  s = fold(cstyif, arr ? 1 : 0, s, ty, tl, t)
  s = fold(cslit23, arr ? 1 : 0, s)
  s = fold(csmangleif, arr ? 1 : 0, s, ty, tl, t)
  s = fold(cslit19, arr ? 1 : 0, s)
  s = fold(cstyif, arr ? 1 : 0, s, ty, tl, t)
  s = fold(cslit24, arr ? 1 : 0, s)
  s = fold(cstyif, arr ? 1 : 0, s, ty, tl, b)
  s = fold(cslit25, arr ? 1 : 0, s)
  s = fold(cstyif, arr ? 1 : 0, s, ty, tl, t)
  s = fold(cslit26, arr ? 1 : 0, s)
  s = fold(cstyif, arr ? 1 : 0, s, ty, tl, t)
  s = fold(cslit27, arr ? 1 : 0, s)
  s = fold(cdecst2, arr ? 1 : 0, s, a)
  s = fold(cslit28, arr ? 1 : 0, s)
  s = fold(cslit29, declrec ? 1 : 0, s)
  s = fold(cstyif, declrec ? 1 : 0, s, ty, tl, t)
  s = fold(cslit19, declrec ? 1 : 0, s)
  s = fold(csfield, declrec ? b : 0, s, ty, tl, a)
  s = fold(cslit30, declrec ? 1 : 0, s)
  s = fold(csputdecl, rec ? b : 0, s, ty, tl, t, a, b)
  return s
end

fn csscalar(s: io, i: u32, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, ty: u32x384x65, tl: u32x128x65, pool: u32x128x400, fnm: u32x128x16, first: u32, fp: u32) -> io
  let g = first + i
