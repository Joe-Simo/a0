  s = fold(csop, op == 15 ? 1 : 0, s, ak, av)
  s = fold(cslit42, op == 15 ? 1 : 0, s)
  s = fold(csop, op == 15 ? 1 : 0, s, bk, bv)
  s = fold(cslit33, op == 15 ? 1 : 0, s)
  s = fold(cslit19, op == 16 ? 1 : 0, s)
  s = fold(csop, op == 16 ? 1 : 0, s, ak, av)
  s = fold(cslit43, op == 16 ? 1 : 0, s)
  s = fold(csop, op == 16 ? 1 : 0, s, bk, bv)
