fn cszero(ok: bool, i: u32, oa: u32x128x512, start: u32) -> bool
  let k = csa(oa, start + i, 0)
  return ok & ((k == 3) | (k == 4)) & (csa(oa, start + i, 1) == 0)
end

fn cscomplex(s: io, i: u32, nd: u32x128x128, oa: u32x128x512, nt: u32x128x24, ty: u32x384x65, tl: u32x128x65, pool: u32x128x400, fnm: u32x128x16, first: u32, fp: u32) -> io
  let g = first + i
  let op = csn(nd, g, 1)
  let na = csn(nd, g, 2)
  let start = csn(nd, g, 3)
  let ak = csa(oa, start, 0)
  let av = csa(oa, start, 1)
  let bk = csa(oa, start + 1, 0)
  let bv = csa(oa, start + 1, 1)
  let ck = csa(oa, start + 2, 0)
  let cv = csa(oa, start + 2, 1)
  let atype = ak == 1 ? csnt(nt, first + av) : ak == 2 ? tl[fp + av] : ak == 4 ? 1 : 0
  let t = csnt(nt, g)
  s = fold(csnameif, op == 19 ? 1 : 0, s, pool, fnm, csn(nd, g, 4))
  s = fold(cslit19, op == 19 ? 1 : 0, s)
  s = fold(csargs, op == 19 ? 1 : 0, s, oa, start, na)
  s = fold(cslit33, op == 19 ? 1 : 0, s)
  let arr = (op == 22) | (op == 24)
  let zero = fold(cszero, arr ? na : 0, true, oa, start)
  let elem = cst(ty, t, 2)
  let scalarzero = arr & zero & (cst(ty, elem, 0) <= 2)
  let aggregate = ((arr & !scalarzero) | (op == 23))
  s = fold(cslit52, scalarzero ? 1 : 0, s)
  s = fold(cstyif, scalarzero ? 1 : 0, s, ty, tl, elem)
  s = fold(cslit53, scalarzero ? 1 : 0, s)
  s = fold(cdecst2, scalarzero ? 1 : 0, s, na)
  s = fold(cslit54, scalarzero ? 1 : 0, s)
  s = fold(cslit52, aggregate ? 1 : 0, s)
  s = fold(cstyif, aggregate ? 1 : 0, s, ty, tl, t)
  s = fold(cslit55, arr & !scalarzero ? 1 : 0, s)
  s = fold(cslit19, op == 23 ? 1 : 0, s)
  s = fold(csargs, aggregate ? 1 : 0, s, oa, start, na)
  s = fold(cslit56, arr & !scalarzero ? 1 : 0, s)
  s = fold(cslit33, op == 23 ? 1 : 0, s)
  s = fold(csop, op == 25 ? 1 : 0, s, ak, av)
  s = fold(cslit57, op == 25 ? 1 : 0, s)
  s = fold(csop, op == 25 ? 1 : 0, s, bk, bv)
  s = fold(cslit5, op == 25 ? 1 : 0, s)
  s = fold(cdecst2, op == 25 ? 1 : 0, s, cst(ty, atype, 1))
  s = fold(cslit58, op == 25 ? 1 : 0, s)
  s = fold(cslit59, op == 26 ? 1 : 0, s)
  s = fold(csmangleif, op == 26 ? 1 : 0, s, ty, tl, atype)
  s = fold(cslit19, op == 26 ? 1 : 0, s)
  s = fold(csargs, op == 26 ? 1 : 0, s, oa, start, 3)
  s = fold(cslit33, op == 26 ? 1 : 0, s)
  s = fold(csop, op == 27 ? 1 : 0, s, ak, av)
  s = fold(cslit60, op == 27 ? 1 : 0, s)
  s = fold(cdecst2, op == 27 ? 1 : 0, s, bv)
  s = fold(cslit61, op == 27 ? 1 : 0, s)
  s = fold(cslit62, op == 28 ? 1 : 0, s)
  s = fold(csmangleif, op == 28 ? 1 : 0, s, ty, tl, atype)
  s = fold(cslit6, op == 28 ? 1 : 0, s)
  s = fold(cdecst2, op == 28 ? 1 : 0, s, bv)
  s = fold(cslit19, op == 28 ? 1 : 0, s)
