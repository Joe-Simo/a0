sl add run p4
w3_a shr i2 7
w3_b get w2 w3_a
w3_c and i2 127
w3_d set w3_b w3_c sl
w3 set w2 w3_a w3_d
i3 add gm 4
w4_a shr i3 7
w4_b get w3 w4_a
w4_c and i3 127
w4_d set w4_b w4_c ce
w4 set w3 w4_a w4_d
i4 add gm 5
w5_a shr i4 7
w5_b get w4 w5_a
w5_c and i4 127
w5_d set w5_b w5_c pd
w5 set w4 w5_a w5_d
i5 add gm 0
w6_a shr i5 7
w6_b get w5 w6_a
w6_c and i5 127
w6_d set w6_b w6_c 0
w6 set w5 w6_a w6_d
nrun add run na
r rec w6 nrun
ret r
end
