fn shcps (u32x128x132,u32x128x48,u32x128x48,u32x128x96) u32 u32x128x132 u32x128x512 u32x128x24 u32x128 u32x128x24 -> (u32x128x132,u32x128x48,u32x128x48,u32x128x96)
bf get p5 0
