t2 add t 2
w2_a shr t2 7
w2_b get w1 w2_a
w2_c and t2 127
w2_d set w2_b w2_c v2
w2 set w1 w2_a w2_d
t3 add t 3
w3_a shr t3 7
w3_b get w2 w3_a
w3_c and t3 127
w3_d set w3_b w3_c v3
w3 set w2 w3_a w3_d
t4 add t 4
w4_a shr t4 7
w4_b get w3 w4_a
w4_c and t4 127
w4_d set w4_b w4_c v4
w4 set w3 w4_a w4_d
ret w4
end
