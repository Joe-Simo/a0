# ---------------------------------------------------------------------------------------------
# The three fusions (fuseExtra, fuseIntoState, fuseRecurrence) as attempts at a site. The site
# page st (u32x128): 0 first node of the function, 1 producer body, 2 consumer body, 3 k,
# 4 producer node, 5 consumer node, 6 n1, 7 n2, 8 array length, 11 consumer operand count,
# 12 its first operand, 13 the producer's first operand, 14 the producer's operand count,
# 15 recordState, 16 the consumer's type. An attempt gives (BLD, INF): INF (u32x128x2) word 0 ok,
# 1 kind (1 extra, 2 state, 3 recurrence), 2 parameter count of the fused body, 3 its result
# type, 4 operand count of the replacement fold, 5 consumer node, 6 producer node, 7 k, 8 the
# consumer's type, 9 1 when the type of the (state, previous) record is to be interned (the
# placeholder 4294967280 is used for it), 10 the state type; 16.. its parameter types; 128..
# the replacement fold's operand pairs (kind 9: a replacement node of the recurrence, value its
# index).

fn zinf -> u32x128x2
z call zpage
t arr z z
ret t
end

# parameter types of the fused body: body2's (except k, and parameter 0 when p5), then
fn shpa u32x128x2 u32 u32x128x65 u32 u32 bool -> u32x128x2
pi add p3 p1
t_a shr pi 7
t_b get p2 t_a
t_c and pi 127
t get t_b t_c
isk eq p1 p4
lt lt p1 p4
im1 sub p1 1
pos select lt p1 im1
i0 eq p1 0
sk0 and p5 i0
skip or isk sk0
idx0 add 16 pos
idx select skip 15 idx0
r_a shr idx 7
r_b get p0 r_a
r_c and idx 127
r_d set r_b r_c t
r set p0 r_a r_d
ret r
end
fn shpb u32x128x2 u32 u32x128x65 u32 u32 -> u32x128x2
a add p3 2
pi add a p1
t_a shr pi 7
t_b get p2 t_a
t_c and pi 127
t get t_b t_c
bi add p4 p1
idx add 16 bi
r_a shr idx 7
r_b get p0 r_a
r_c and idx 127
r_d set r_b r_c t
r set p0 r_a r_d
ret r
end
fn shpc u32x128x2 u32 u32x128x65 u32 -> u32x128x2
pi add p3 p1
t_a shr pi 7
t_b get p2 t_a
t_c and pi 127
t get t_b t_c
idx add 16 p1
r_a shr idx 7
r_b get p0 r_a
r_c and idx 127
r_d set r_b r_c t
r set p0 r_a r_d
ret r
end
# consumer operand i (of p4 = k removed): lo = p6, position base0 = p5 + i - lo - (i > k)
fn shpf u32x128x2 u32 u32x128x512 u32 u32 u32 u32 -> u32x128x2
s add p3 p1
a_k_m mul s 2
a_k_i add a_k_m 0
a_k_a shr a_k_i 7
a_k_b get p2 a_k_a
a_k_c and a_k_i 127
a_k get a_k_b a_k_c
a_v_m mul s 2
a_v_i add a_v_m 1
a_v_a shr a_v_i 7
a_v_b get p2 a_v_a
a_v_c and a_v_i 127
a_v get a_v_b a_v_c
ge ge p1 p6
isk eq p1 p4
nk select isk false true
el and ge nk
gk gt p1 p4
d select gk 1 0
b1 sub p1 p6
b2 add p5 b1
pos sub b2 d
i0 mul pos 2
ix add 128 i0
ix1 add ix 1
ixa select el ix 14
ixb select el ix1 15
w0_a shr ixa 7
w0_b get p0 w0_a
w0_c and ixa 127
w0_d set w0_b w0_c a_k
w0 set p0 w0_a w0_d
w1_a shr ixb 7
w1_b get w0 w1_a
w1_c and ixb 127
w1_d set w1_b w1_c a_v
w1 set w0 w1_a w1_d
ret w1
end
# producer extra i: operand 2 + i of the producer, at position p4 + i
fn shpg u32x128x2 u32 u32x128x512 u32 u32 -> u32x128x2
a add p3 2
s add a p1
x_k_m mul s 2
x_k_i add x_k_m 0
x_k_a shr x_k_i 7
x_k_b get p2 x_k_a
x_k_c and x_k_i 127
