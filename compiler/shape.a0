w3_b get w2 w3_a
w3_c and 1 127
w3_d set w3_b w3_c ov1
w3 set w2 w3_a w3_d
ret w3
end
# the operand (p0 p1) of a copied body under the copy context p2 and map p3
fn shmapo u32 u32 u32x128 u32x128x48 -> (u32,u32)
z0k get p2 4
z0v get p2 5
z1k get p2 6
z1v get p2 7
kk get p2 8
off2 get p2 9
isp eq p0 2
isn eq p0 1
i0 eq p1 0
i1 eq p1 1
lt lt p1 kk
v2 add p1 off2
pv select lt p1 v2
pk1 select i1 z1k 2
pk select i0 z0k pk1
pv1 select i1 z1v pv
pvv select i0 z0v pv1
mi mul p1 2
mk_a shr mi 7
mk_b get p3 mk_a
mk_c and mi 127
mk get mk_b mk_c
mi1 add mi 1
mv_a shr mi1 7
mv_b get p3 mv_a
mv_c and mi1 127
mv get mv_b mv_c
nk0 select isn mk p0
nv0 select isn mv p1
nk select isp pk nk0
nv select isp pvv nv0
r rec nk nv
ret r
end
# operand step k of a copied node: map it and add it (p0 BLD; args, first operand, cx, map)
fn shcpa u32x128x132 u32 u32x128x512 u32 u32x128 u32x128x48 bool -> u32x128x132
a_s add p3 p1
a_k_m mul a_s 2
a_k_i add a_k_m 0
a_k_a shr a_k_i 7
a_k_b get p2 a_k_a
a_k_c and a_k_i 127
a_k get a_k_b a_k_c
a_v_m mul a_s 2
a_v_i add a_v_m 1
a_v_a shr a_v_i 7
a_v_b get p2 a_v_a
a_v_c and a_v_i 127
a_v get a_v_b a_v_c
m call shmapo a_k a_v p4 p5
mk at m 0
mv at m 1
r call shbpair p0 mk mv p6
ret r
end
# the element cache: entry p1 matches the index (p3 p4)? State: the match + 1 or 0
fn shelc u32 u32 u32x128x96 u32 u32 -> u32
e mul p1 4
i0 add 4 e
k_a shr i0 7
k_b get p2 k_a
k_c and i0 127
k get k_b k_c
i1 add i0 1
v_a shr i1 7
v_b get p2 v_a
v_c and i1 127
v get v_b v_c
m_a eq k p3
m_b eq v p4
m and m_a m_b
z eq p0 0
t and m z
n1 add p1 1
r select t n1 p0
ret r
end

