f1_a shr ta1 7
f1_b get p3 f1_a
f1_c and ta1 127
f1 get f1_b f1_c
e0 eq f0 p4
e1 eq f1 0
m1 and isr two
m2 and m1 e0
m and m2 e1
z eq p0 0
t and m z
i1 add p1 1
r select t i1 p0
ret r
end
fn shtyrec u32x384x65 u32x128x65 u32 u32 u32 bool -> (u32x384x65,u32x128x65,u32,u32,u32)
fnd fold shtyf p2 0 p0 p1 p4
found ne fnd 0
nf select found false true
app and p5 nf
a_a shr p2 7
a_b get p0 a_a
a_l and p2 127
a_m mul a_l 3
a_i add a_m 0
a_d set a_b a_i 5
a set p0 a_a a_d
b_a shr p2 7
b_b get a b_a
b_l and p2 127
b_m mul b_l 3
b_i add b_m 1
b_d set b_b b_i p3
b set a b_a b_d
c_a shr p2 7
c_b get b c_a
c_l and p2 127
c_m mul c_l 3
c_i add c_m 2
c_d set c_b c_i 2
c set b c_a c_d
l0_a shr p3 7
l0_b get p1 l0_a
l0_c and p3 127
l0_d set l0_b l0_c p4
l0 set p1 l0_a l0_d
t1 add p3 1
l1_a shr t1 7
l1_b get l0 l1_a
l1_c and t1 127
l1_d set l1_b l1_c 0
l1 set l0 l1_a l1_d
fm1 sub fnd 1
idx select found fm1 p2
n1 add p2 1
n2 add p3 2
nty select app n1 p2
ntl select app n2 p3
r rec c l1 idx nty ntl
ret r
end

