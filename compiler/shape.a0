# operand k of node j (first node p4, args first p3): p0 used other than as a set target or by a
# previous-element read? State: failed.
fn shpb4a u32 u32 u32x128x512 u32 u32x128x24 u32 u32 -> u32
s add p3 p1
ak_m mul s 2
ak_i add ak_m 0
