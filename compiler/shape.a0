# Shape analyses and loop fusion, written in A0 (DESIGN.md 7a): the port of src/optimize.ts
# lines 716-1343 (storeOnly, overwritesState, fillRun, lazyArms, producerShape, fuseLoops) and of
# `borrowLive` of src/core.ts. The wasm emitter (compiler/emit_wasm.a0) does not `use` this file:
# compiler/boot.a0 runs it between the optimizer and the emitter, and the emitter reads the
# results from the SHAPE TABLE, one table `sh` (u32x128x200) that is an extra input of its chunk.
#
# Inputs: the OPTIMIZED chunk tables of compiler/emit_wasm.a0: types u32x384x65, tlist u32x128x65,
# fns u32x128x45 (7 words: 0 body flag, 1 parameter count, 2 first tlist word, 3 result type, 4
# first node, 5 node count, 6 packed ret; word 6 is 0 for a function without a body), nodes
# u32x128x132 (6 words a node: 0, op, operand count, first operand, callee, pred), args
# u32x128x512 (operand pairs), ntys u32x128x24 (node types). A node's index in its function is its
# position; the global node index g of node j is (first node of the function) + j. Type indices
# 0 1 2 are u32 bool io; an aggregate has an index of 3 or more.
#
# THE SHAPE TABLE (columns of 2816 words indexed by global node index g, function columns of 1024):
#   FILL  0      fold node: the fillRun trip count (> 0) or 0. The body is the node's callee, the
#                stored value operand 2 of the callee's ret `set` node, the fill's nodes all callee
#                nodes except that ret node, in order.
#   OWN   2816   lazyArms: the position (in its function) + 1 of the select a node is private to,
#                else 0
#   ARM   5632   1 / 2: the node belongs to the select's first / second arm (arm lists: the nodes
#                with OWN = that select, in node order)
#   OVER  8448   fold node: overwritesState 0 / 1
#   BORR  11264  set / put node (target operand 0) and fold / loop node (state operand 1) of an
#                aggregate type whose target operand is a parameter or a node defined by
#                arr rec set put: borrowLive(fn, that operand, j, selfRead) with selfRead set for
#                set / put, else 0. Every other node is 0: only these are queried (the rest of
#                mutableHere is the emitter's).
#   FUSED 14080  function column: 1 + the function that is the fused form of this function, else 0
#   SYN   15104  function column: 1 a synthetic fused body (never emitted by itself, only
#                inlined), 2 a fused function
#   MISS  16128  the count n, then n chunk function indices (16129..) whose rows have no body
#                (fns word 6 = 0) and whose body an analysis needed: end the chunk with code 7 and
#                these indices (the emitter appends its own requests to its own list)
#   TIO   17152  type column (8320 types): 1 when the type contains an io token
#   25472..      scalars: node, operand pair, function, type and tlist counts (used by fusion)
#
# Calls (pure; the shape table is threaded through folds as state). Tables: ty tl fns nodes args
# nt in the order of compiler/emit_wasm.a0 `wachunk` (types, tlist, fns, nodes, args, ntys).
#   shinit ty tl nty -> sh
#       the table with only TIO filled
#   shcounts sh nn na nf nty ntl -> sh
#       the free positions of the OPTIMIZED chunk tables (nodes, operand pairs, functions, types,
#       tlist words), kept in the scalars: fusion appends there (the optimizer leaves holes, so
#       these are the ends of the used regions, including its next free operand)
#   shpass sh ty tl fns nodes args nt f -> sh
#       FILL OWN ARM OVER BORR (and MISS) of function f; run it for every function that has a body
#       and may be emitted or inlined
#
# Loop fusion (src/optimize.ts fuseLoops with recordState, 8 rounds), per function f, stateless:
# the tables of the chunk stay as they are; the fused view is a modified COPY of them.
#   shfcheck ty tl fns nodes args nt sh f rs -> (found, missing)
#       cheap: is there a fusion site in f (rs: recordState, true for wasm), or the chunk function
#       whose body is needed and absent (4294967295 for none): call shfuse only when found
#   shfuse ty tl fns nodes args nt sh f rs -> (status, missing, nf1, ty, tl, fns, nodes, nt)
#   shfargs ty tl fns nodes args nt sh f rs -> args
#       the fused view in the tables' layout (two calls because one A0 value is at most 65536
#       words): function f is replaced IN PLACE (its rows, nodes and operands are overwritten, or
#       appended at the end when the fused body is larger), and each fusion appends a synthetic
#       function (fns rows nf0 .. nf1 - 1, nf0 = the nf given to shcounts: parameters at the
#       end of tlist, nodes and operands after the counts; fns word 0 = 1 + 2 literalIterations)
#       and, for a recurrence, its (state, previous element) record type. The synthetic bodies
#       are optimized with ozopt1 (compiler/optimize.a0), as src/optimize.ts finishBody does.
#       status 0 nothing fuses (the tables are f as it was), 1 fused, 4 a table is full (the
#       capacities of one chunk: 2816 nodes, 32768 operand pairs, 822 functions, 8320 types and
#       tlist words: the driver must leave headroom, about 64 nodes and 1024 pairs a fused
#       function plus the size of f when its body grows), 7 a body is needed (missing).
#   shfsh sh ty tl fns nodes args nt f nf0 nf1 -> sh
#       with the fused tables: shpass of f and of every synthetic function, SYN[f] = 2, SYN[g] = 1
#       for g in nf0 .. nf1 - 1, FUSED[f] = f + 1
# The emitter emits f from the fused view; if its code then calls a function with SYN = 1 out of
# line (a synthetic body that was not inlined: src/optimize.ts emitFused) it emits f from the
# original tables instead. Synthetic functions are never emitted by themselves.
#
use "optimize.a0"

fn zsh -> u32x128x200
z call zpage
t arr z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z
ret t
end
fn zcol -> u32x128x24
z call zpage
t arr z z z z z z z z z z z z z z z z z z z z z z z z
ret t
end
# ---------------------------------------------------------------------------------------------
# Types: which type indices contain an io token (column TIO of the shape table, 17152 + type)

fn shtiof u32 u32 u32x128x200 u32x128x65 u32 -> u32
i add p4 p1
f_a shr i 7
f_b get p3 f_a
f_c and i 127
f get f_b f_c
fi add f 17152
t_a shr fi 7
t_b get p2 t_a
t_c and fi 127
t get t_b t_c
r or p0 t
ret r
end
fn shtios u32x128x200 u32 u32x384x65 u32x128x65 -> u32x128x200
tag_a shr p1 7
tag_b get p2 tag_a
tag_l and p1 127
tag_m mul tag_l 3
tag_i add tag_m 0
tag get tag_b tag_i
ta_a shr p1 7
ta_b get p2 ta_a
ta_l and p1 127
ta_m mul ta_l 3
ta_i add ta_m 1
ta get ta_b ta_i
tb_a shr p1 7
tb_b get p2 tb_a
tb_l and p1 127
tb_m mul tb_l 3
tb_i add tb_m 2
tb get tb_b tb_i
isio eq p1 2
isarr eq tag 4
isrec eq tag 5
eidx select isarr tb 0
ei add eidx 17152
ev_a shr ei 7
ev_b get p0 ev_a
ev_c and ei 127
ev get ev_b ev_c
ev1 select isarr ev 0
nf select isrec tb 0
f0 fold shtiof nf 0 p0 p3 ta
r1 select isio 1 0
a1 or r1 ev1
b1 or a1 f0
ix add p1 17152
w_a shr ix 7
w_b get p0 w_a
w_c and ix 127
w_d set w_b w_c b1
w set p0 w_a w_d
ret w
end
# the shape table of a chunk with p2 types: only the io column is filled (shinit); the node
# columns are written by shpass
fn shinit u32x384x65 u32x128x65 u32 -> u32x128x200
z call zsh
r fold shtios p2 z p0 p1
ret r
end
# ---------------------------------------------------------------------------------------------
# storeOnly (src/optimize.ts): the ret node of function p3 when it is `set p0 p1 v` and p0 is
# otherwise unused, else 4294967295

# operand k of a node (args first p3): is it p0 where it is not the target of the set at jr?
fn shsoa u32 u32 u32x128x512 u32 u32 u32 -> u32
s add p3 p1
kd_m mul s 2
kd_i add kd_m 0
kd_a shr kd_i 7
kd_b get p2 kd_a
kd_c and kd_i 127
kd get kd_b kd_c
vl_m mul s 2
vl_i add vl_m 1
vl_a shr vl_i 7
vl_b get p2 vl_a
vl_c and vl_i 127
vl get vl_b vl_c
isp_a eq kd 2
isp_b eq vl 0
isp and isp_a isp_b
jj eq p4 p5
kk eq p1 0
tg and jj kk
b1 select tg false isp
b select b1 1 0
r or p0 b
ret r
end
fn shsoj u32 u32 u32x128x132 u32x128x512 u32 u32 -> u32
g add p4 p1
na_m mul g 6
na_i add na_m 2
na_a shr na_i 7
na_b get p2 na_a
na_c and na_i 127
na get na_b na_c
af_m mul g 6
af_i add af_m 3
af_a shr af_i 7
af_b get p2 af_a
af_c and af_i 127
af get af_b af_c
r fold shsoa na p0 p3 af p1 p5
ret r
end
fn shstore u32x128x132 u32x128x512 u32x128x45 u32 -> u32
fst_m mul p3 7
fst_i add fst_m 4
fst_a shr fst_i 7
fst_b get p2 fst_a
fst_c and fst_i 127
fst get fst_b fst_c
nfn_m mul p3 7
nfn_i add nfn_m 5
nfn_a shr nfn_i 7
