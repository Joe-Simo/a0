# ---------------------------------------------------------------------------------------------
# rewriteTop: function f without the producer (node pi), the consumer (node ci) replaced by the
# fused fold (kind 1 2) or by the three nodes rec, fold, at (kind 3), and without what only
# the producer used, as an image. Positions are of the combined list: old nodes in order
# without pi, and the replacement nodes at ci - 1 + r; the old consumer stands for the last
# replacement. INF (see shatx): word 11 the function index of the fused body.

# combined index of old node q (consumer ci, producer pi, R replacement nodes)
fn shoc u32 u32 u32 u32 -> u32
lt lt p0 p1
gt gt p0 p2
d select gt 1 0
a sub p0 d
b2 add p0 p3
b sub b2 2
r select lt a b
ret r
end
# operand j of replacement node r (kind p2; consumer first operand p5): (kind, value), kind 9 a
# replacement node
fn shrwo u32x128x2 u32x128x512 u32 u32 u32 u32 -> (u32,u32)
a mul p4 2
ix add 128 a
ix1 add ix 1
rak_a shr ix 7
rak_b get p0 rak_a
rak_c and ix 127
rak get rak_b rak_c
rav_a shr ix1 7
rav_b get p0 rav_a
rav_c and ix1 127
rav get rav_b rav_c
is3 eq p2 3
r0 eq p3 0
r1 eq p3 1
j0 eq p4 0
c1s add p5 1
c1_k_m mul c1s 2
c1_k_i add c1_k_m 0
c1_k_a shr c1_k_i 7
c1_k_b get p1 c1_k_a
c1_k_c and c1_k_i 127
c1_k get c1_k_b c1_k_c
c1_v_m mul c1s 2
c1_v_i add c1_v_m 1
c1_v_a shr c1_v_i 7
c1_v_b get p1 c1_v_a
c1_v_c and c1_v_i 127
c1_v get c1_v_b c1_v_c
q0k select j0 c1_k 3
q0v select j0 c1_v 0
q2k select j0 9 3
q2v select j0 1 0
k02 select r0 q0k q2k
v02 select r0 q0v q2v
kk3 select r1 rak k02
vv3 select r1 rav v02
k select is3 kk3 rak
v select is3 vv3 rav
r rec k v
