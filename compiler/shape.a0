# Entries around fusion.

# the counts of the chunk's tables (the free node, operand pair, function, type and tlist
# positions) into the shape table: fusion appends from there
fn shcounts u32x128x200 u32 u32 u32 u32 u32 -> u32x128x200
a_a shr 25472 7
a_b get p0 a_a
a_c and 25472 127
a_d set a_b a_c p1
a set p0 a_a a_d
b_a shr 25473 7
b_b get a b_a
b_c and 25473 127
b_d set b_b b_c p2
b set a b_a b_d
c_a shr 25474 7
c_b get b c_a
c_c and 25474 127
c_d set c_b c_c p3
c set b c_a c_d
d_a shr 25475 7
d_b get c d_a
d_c and 25475 127
d_d set d_b d_c p4
d set c d_a d_d
e_a shr 25476 7
e_b get d e_a
e_c and 25476 127
e_d set e_b e_c p5
e set d e_a e_d
ret e
end
# is there a fusion site in function f = p7? (found, a body that is needed and absent or 4294967295)
fn shfcheck u32x384x65 u32x128x65 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x128x200 u32 bool -> (u32,u32)
rsn select p8 1 0
sr call shfsearch p3 p4 p2 p0 p1 p5 p6 p7 rsn
fd at sr 0
ms at sr 3
r rec fd ms
ret r
end
# the shape columns of the fused function f and of the synthetic functions nf0 .. nf1 - 1 of the
# fused tables: SYN 1 for a synthetic body, 2 for f, FUSED[f] = f + 1
fn shfsh1 u32x128x200 u32 u32x384x65 u32x128x65 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32 -> u32x128x200
g add p8 p1
