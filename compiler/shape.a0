xp_a eq xk 2
xp_b eq xv 1
xp and xp_a xp_b
x0_a eq xk 3
x0_b eq xv 0
x0 and x0_a x0_b
yp_a eq yk 2
yp_b eq yv 1
yp and yp_a yp_b
