nfn get nfn_b nfn_c
rw_m mul p3 7
rw_i add rw_m 6
rw_a shr rw_i 7
rw_b get p2 rw_a
rw_c and rw_i 127
rw get rw_b rw_c
retk shr rw 28
retv and rw 268435455
isn eq retk 1
jr select isn retv 0
g add fst jr
op_m mul g 6
op_i add op_m 1
op_a shr op_i 7
op_b get p0 op_a
op_c and op_i 127
op get op_b op_c
af_m mul g 6
af_i add af_m 3
af_a shr af_i 7
af_b get p0 af_a
af_c and af_i 127
af get af_b af_c
k0_m mul af 2
k0_i add k0_m 0
k0_a shr k0_i 7
k0_b get p1 k0_a
k0_c and k0_i 127
k0 get k0_b k0_c
v0_m mul af 2
v0_i add v0_m 1
v0_a shr v0_i 7
v0_b get p1 v0_a
v0_c and v0_i 127
v0 get v0_b v0_c
af1 add af 1
k1_m mul af1 2
k1_i add k1_m 0
k1_a shr k1_i 7
k1_b get p1 k1_a
k1_c and k1_i 127
k1 get k1_b k1_c
v1_m mul af1 2
v1_i add v1_m 1
v1_a shr v1_i 7
v1_b get p1 v1_a
v1_c and v1_i 127
v1 get v1_b v1_c
isset eq op 26
a0ok_a eq k0 2
a0ok_b eq v0 0
a0ok and a0ok_a a0ok_b
a1ok_a eq k1 2
a1ok_b eq v1 1
a1ok and a1ok_a a1ok_b
c1 and isn isset
c2 and a0ok a1ok
good and c1 c2
bad fold shsoj nfn 0 p0 p1 fst jr
nobad eq bad 0
ok and good nobad
r select ok jr 4294967295
ret r
end

