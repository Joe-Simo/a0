vl_i add vl_m 1
vl_a shr vl_i 7
vl_b get p2 vl_a
vl_c and vl_i 127
vl get vl_b vl_c
isp_a eq kd 2
isp_b eq vl 0
isp and isp_a isp_b
jj eq p4 p5
kk eq p1 0
tg and jj kk
b1 select tg false isp
b select b1 1 0
r or p0 b
ret r
end
fn shsoj u32 u32 u32x128x128 u32x128x512 u32 u32 -> u32
g add p4 p1
na_m mul g 6
na_i add na_m 2
na_a shr na_i 7
na_b get p2 na_a
na_c and na_i 127
na get na_b na_c
af_m mul g 6
af_i add af_m 3
af_a shr af_i 7
af_b get p2 af_a
af_c and af_i 127
af get af_b af_c
r fold shsoa na p0 p3 af p1 p5
ret r
end
