# does consumer extra operand i equal operand 1 (p4 p5)?
fn shsq u32 u32 u32x128x512 u32 u32 u32 -> u32
a add p3 2
s add a p1
x_k_m mul s 2
x_k_i add x_k_m 0
x_k_a shr x_k_i 7
x_k_b get p2 x_k_a
x_k_c and x_k_i 127
x_k get x_k_b x_k_c
x_v_m mul s 2
x_v_i add x_v_m 1
x_v_a shr x_v_i 7
x_v_b get p2 x_v_a
x_v_c and x_v_i 127
x_v get x_v_b x_v_c
m_a eq x_k p4
m_b eq x_v p5
m and m_a m_b
b select m 1 0
r or p0 b
ret r
end

