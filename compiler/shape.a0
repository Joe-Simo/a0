ta_i add ta_m 1
ta get ta_b ta_i
tb_a shr p1 7
tb_b get p2 tb_a
tb_l and p1 127
tb_m mul tb_l 3
tb_i add tb_m 2
tb get tb_b tb_i
isr eq tag 5
two eq tb 2
f0_a shr ta 7
f0_b get p3 f0_a
f0_c and ta 127
f0 get f0_b f0_c
