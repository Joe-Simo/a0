# Arena symbol interner: all growth/probes/hashes/byte comparisons are A0.
# Entries are5 fullu32 fields: sourceHandle,start,length,hash,id. IDs start at0.
# Source handles/bytes must stay immutable and live for the invocation; FINISH frees all.
# Header is(vector,hashTableHandle,powerOfTwoSlots,used). Old headers are mutable views.
use "arena_vector.a0"
fn si_hashbyte u32 u32 u32x128 -> u32
q0 get p2 p1
q1 xor p0 q0
q2 mul q1 16777619
ret q2
end
fn si_hashok (u32,u32,io) u32 u32 u32 u32 -> bool
q0 at p0 0
q1 eq q0 0
ret q1
end
fn si_hashpage (u32,u32,io) u32 u32 u32 u32 -> (u32,u32,io)
base mul p1 128
rest sub p4 base
q0 gt rest 128
n select q0 128 rest
q1 at p0 2
q2 add p3 base
r call arena_load q1 p2 q2 n
q3 at r 0
q4 eq q3 0
count select q4 n 0
q5 at p0 1
q6 at r 1
hash fold si_hashbyte count q5 q6
q7 at r 0
q8 at r 2
q9 rec q7 hash q8
ret q9
end
fn si_hashrun (u32,u32,io) u32 u32 u32 u32 -> (u32,u32,io)
q0 div p4 128
q1 rem p4 128
q2 eq q1 0
q3 select q2 0 1
pages add q0 q3
q4 at p0 2
q5 rec 0 2166136261 q4
q6 loop si_hashok si_hashpage pages q5 p2 p3 p4
ret q6
end
fn si_hash io u32 u32 u32 -> (u32,u32,io)
q0 sub 4294967295 p2
valid le p3 q0
q1 select valid 1 0
q2 rec 3 0 p0
q3 fold si_hashrun q1 q2 p1 p2 p3
ret q3
end
fn si_eqbyte bool u32 u32x128 u32x128 -> bool
q0 get p2 p1
q1 get p3 p1
q2 eq q0 q1
q3 and p0 q2
ret q3
end
fn si_eqok (u32,bool,io) u32 u32 u32 u32 u32 u32 -> bool
q0 at p0 0
q1 eq q0 0
q2 at p0 1
q3 and q1 q2
ret q3
end
fn si_eqpage (u32,bool,io) u32 u32 u32 u32 u32 u32 -> (u32,bool,io)
base mul p1 128
rest sub p6 base
q0 gt rest 128
n select q0 128 rest
q1 at p0 2
q2 add p3 base
x call arena_load q1 p2 q2 n
q3 at x 2
q4 add p5 base
y call arena_load q3 p4 q4 n
q5 at x 0
q6 eq q5 0
q7 at y 0
q8 at x 0
code select q6 q7 q8
q9 eq code 0
q10 select q9 n 0
q11 at x 1
q12 at y 1
same fold si_eqbyte q10 true q11 q12
q13 at y 2
q14 rec code same q13
ret q14
end
fn si_compare (u32,bool,io) u32 u32 u32 u32 u32 u32 -> (u32,bool,io)
q0 div p6 128
q1 rem p6 128
q2 eq q1 0
q3 select q2 0 1
pages add q0 q3
q4 loop si_eqok si_eqpage pages p0 p2 p3 p4 p5 p6
ret q4
end
fn si_entry (u32,u32x128,io) u32 (u32,u32,u32) u32 -> (u32,u32x128,io)
q0 at p0 2
q1 mul p3 5
q2 call av_load q0 p2 q1 5
ret q2
end
fn si_probeok (u32,bool,bool,u32,u32,io) u32 (u32,u32,u32) u32 u32 u32 u32 u32 u32 -> bool
q0 at p0 0
q1 eq q0 0
q2 at p0 1
q3 xor q2 true
q4 and q1 q3
ret q4
