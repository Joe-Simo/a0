q7 at r 1
q8 at h 3
q9 at rehashed 0
q10 eq q9 0
q11 rec v q7 capacity q8
header select q10 q11 h
q12 at rehashed 0
q13 at rehashed 1
q14 rec q12 header q13
ret q14
end
fn si_doappend (u32,(u32,u32,u32),io) u32 u32x128 -> (u32,(u32,u32,u32),io)
q0 at p0 2
q1 at p0 1
q2 call av_append q0 q1 5 p2
ret q2
