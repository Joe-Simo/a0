ret r
end
# the bits of p0 below 2^15 set: the log2 of a power of two
fn xalogst u32 u32 u32 -> u32
s shr p2 p1
b and s 1
a add p0 b
ret a
end
fn xalog2 u32 -> u32
m sub p0 1
r fold xalogst 15 0 m
ret r
end
# the first four commas of [p3, ...): state (count, positions)
fn xazcst (u32,u32,u32,u32,u32) u32 u32x256 u32 -> (u32,u32,u32,u32,u32)
