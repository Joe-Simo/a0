sc6 shl scl 6
ixv select hasi idx 4
ix7 and ixv 7
ix3b shl ix7 3
sb1 or sc6 ix3b
sb2 or sb1 b7
e9 call xaap e8 sb2 sib1
md1 eq md 1
md2 eq md 2
dm1 and plain md1
dm2 and plain md2
e10 call xaap e9 dsp dm1
e11 call xaap4 e10 dsp dm2
ilo at p1 3
ihi at p1 4
i1 ge iz 1
i4 ge iz 4
i8 eq iz 8
e12 call xaap e11 ilo i1
lo1 shr ilo 8
e13 call xaap e12 lo1 i4
lo2 shr ilo 16
e14 call xaap e13 lo2 i4
lo3 shr ilo 24
e15 call xaap e14 lo3 i4
e16 call xaap4 e15 ihi i8
bfix at e16 1
e17 call xaap4 e16 0 brn
buf at e17 0
len at e17 1
symr eq sym 1
ripfix and ripm symr
k1 select ripfix 2 0
k select brn 1 k1
fx select brn bfix fixr
hasimm gt iz 0
bad and ripfix hasimm
r rec buf len fx k bad
ret r
end

# ---- the module state: (io, text, text length, name pool, its length, labels (hash, name
# start, name length, offset, defined), label count, defined labels in order, their count,
# fixups (field offset, kind 1 branch 2 rip + 4 numeric, line, label entry or number,
# definition index), their count, numeric label definitions (number, offset), their count, bss
# symbols (hash, name start, name length, offset), their count, bss size, bss alignment, error
# code, error line, line number, bytes left, section 0 text 1 bss 2 empty)
# record the first error: code p1 at line p2 when p3
fn xafail (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32 u32 bool -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
old at p0 17
ol at p0 18
none eq old 0
dofail and none p3
c select dofail p1 old
l select dofail p2 ol
g1 put p0 17 c
g2 put g1 18 l
ret g2
end
# append byte p1 to the text when p2
fn xaput (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32 bool -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
t at p0 1
n at p0 2
full ge n 65536
nf eq full false
dw and p2 nf
wi shr n 2
j and n 3
sh mul j 8
v and p1 255
sv shl v sh
old call xag128 t wi
nw or old sv
t2 call xas128 t wi nw
t3 select dw t2 t
n1 add n 1
n2 select dw n1 n
g1 put p0 1 t3
g2 put g1 2 n2
ln at p0 19
ef and full p2
g3 call xafail g2 2 ln ef
ret g3
end
fn xainsst (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32 u32x16 -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
b get p2 p1
r call xaput p0 b true
ret r
end
# text byte p1 of p0
fn xatget u32x128x128 u32 -> u32
wi shr p1 2
j and p1 3
sh mul j 8
w call xag128 p0 wi
v shr w sh
r and v 255
ret r
end
# text byte p1 of p0 set to p2
fn xatset u32x128x128 u32 u32 -> u32x128x128
wi shr p1 2
j and p1 3
sh mul j 8
w call xag128 p0 wi
m shl 255 sh
nm xor m 4294967295
cl and w nm
v and p2 255
sv shl v sh
nw or cl sv
r call xas128 p0 wi nw
ret r
end
# the name pool: byte p1
fn xapget u32x128x32 u32 -> u32
wi shr p1 2
j and p1 3
sh mul j 8
w call xag32 p0 wi
v shr w sh
r and v 255
ret r
end
fn xacpst u32x128x32 u32 u32x256 u32 u32 -> u32x128x32
ix add p3 p1
c get p2 ix
k add p4 p1
wi shr k 2
j and k 3
sh mul j 8
w call xag32 p0 wi
sv shl c sh
nw or w sv
r call xas32 p0 wi nw
ret r
end
fn xahst u32 u32 u32x256 u32 -> u32
ix add p3 p1
c get p2 ix
x xor p0 c
r mul x 16777619
ret r
end
# the name [p2, p3) of line p1 copied to the pool, line p4: (state, start, length)
fn xanm (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32x256 u32 u32 u32 -> ((io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32),u32,u32)
pool at p0 3
pl at p0 4
gtr gt p3 p2
d sub p3 p2
ln select gtr d 0
end1 add pl ln
over gt end1 16384
cp fold xacpst ln pool p1 p2 pl
pool2 select over pool cp
pl2 select over pl end1
g1 put p0 3 pool2
g2 put g1 4 pl2
g3 call xafail g2 2 p4 over
r rec g3 pl ln
ret r
end
# the pool name at p3 equals the line bytes from p5: state, byte p1
fn xaeqst bool u32 u32x128x32 u32 u32x256 u32 -> bool
k add p3 p1
a call xapget p2 k
ix add p5 p1
b get p4 ix
e eq a b
r and p0 e
ret r
end
# label entry p1 named by line bytes [p5, p5 + p6) with hash p7: state (found, entry)
fn xalfst (bool,u32) u32 u32x128x40 u32x128x32 u32x256 u32 u32 u32 -> (bool,u32)
fd at p0 0
ix at p0 1
k mul p1 5
h call xag40 p2 k
k1 add k 1
st call xag40 p2 k1
k2 add k 2
ln call xag40 p2 k2
he eq h p7
lq eq ln p6
nf eq fd false
c1 and he lq
cand and c1 nf
cnt select cand ln 0
same fold xaeqst cnt true p3 st p4 p5
hit and cand same
fd2 or fd hit
ix2 select hit p1 ix
r rec fd2 ix2
ret r
end
# the label entry of line bytes [p4, p5) with hash p6 among p1 entries: (found, entry)
fn xalfind u32x128x40 u32 u32x128x32 u32x256 u32 u32 u32 -> (bool,u32)
gtr gt p5 p4
d sub p5 p4
ln select gtr d 0
s0 rec false 0
r fold xalfst p1 s0 p0 p2 p3 p4 ln p6
ret r
end
# bss symbol p1 named like that: state (found, symbol)
fn xabfst (bool,u32) u32 u32x128x8 u32x128x32 u32x256 u32 u32 u32 -> (bool,u32)
fd at p0 0
ix at p0 1
k mul p1 4
h call xag8 p2 k
k1 add k 1
st call xag8 p2 k1
k2 add k 2
ln call xag8 p2 k2
he eq h p7
lq eq ln p6
nf eq fd false
c1 and he lq
cand and c1 nf
cnt select cand ln 0
same fold xaeqst cnt true p3 st p4 p5
hit and cand same
fd2 or fd hit
ix2 select hit p1 ix
r rec fd2 ix2
ret r
end
fn xabfind u32x128x8 u32 u32x128x32 u32x256 u32 u32 u32 -> (bool,u32)
gtr gt p5 p4
d sub p5 p4
ln select gtr d 0
s0 rec false 0
r fold xabfst p1 s0 p0 p2 p3 p4 ln p6
ret r
end
# the hash of line bytes [p1, p2)
fn xahash u32x256 u32 u32 -> u32
gtr gt p2 p1
d sub p2 p1
ln select gtr d 0
r fold xahst ln 2166136261 p0 p1
ret r
end
# a new label entry for [p3, p4) of line p2 (hash p5, defined p6, offset p7, line p8): state
# (state, entry)
fn xalnew ((io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32),u32) u32 u32x256 u32 u32 u32 u32 u32 u32 -> ((io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32),u32)
