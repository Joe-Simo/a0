r2 select s2 ix q2
r3 select s3 ix q3
r4 select s4 ix q4
na add n 1
nn select cm na n
r rec nn r1 r2 r3 r4
ret r
end
# [p1, p2) without surrounding whitespace
fn xatrim u32x256 u32 u32 -> (u32,u32)
s call xaskip p0 p2 p1
e call xartrim p0 s p2
r rec s e
ret r
end
# [p1, p2) is the word of table entry p3
fn xaword u32x256 u32 u32 u32 -> bool
pk call xapack p0 p1 p2
t call xadit
i call xalook t 16 pk
r eq i p3
ret r
end
# bss alignment 2^p1
fn xaalignb (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32 -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
