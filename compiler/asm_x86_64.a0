# ---- directives
# one byte of LLVM's nop padding of p2 bytes: byte p1
fn xanopst (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32 u32 -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
ch div p1 10
wi rem p1 10
c10 mul ch 10
left sub p2 c10
gt10 gt left 10
l select gt10 10 left
lm sub l 1
lp mul l lm
st div lp 2
ix add st wi
t call xanops
b get t ix
r call xaput p0 b true
ret r
end
# align to 2^p1 bytes (text: nops; bss: the size and the alignment)
fn xaalign (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32 -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
