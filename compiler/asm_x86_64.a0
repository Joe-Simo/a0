ns call xanm g p2 p3 p4 p8
g1 at ns 0
st at ns 1
ln at ns 2
lab at g1 5
nl at g1 6
full ge nl 1024
k mul nl 5
l1 call xas40 lab k p5
k1 add k 1
l2 call xas40 l1 k1 st
k2 add k 2
l3 call xas40 l2 k2 ln
k3 add k 3
l4 call xas40 l3 k3 p7
k4 add k 4
l5 call xas40 l4 k4 p6
lab2 select full lab l5
nl1 add nl 1
nl2 select full nl nl1
g2 put g1 5 lab2
g3 put g2 6 nl2
g4 call xafail g3 2 p8 full
r rec g4 nl
ret r
end
# the label entry named by [p2, p3) of line p1, created when absent (line p4): (state, entry)
fn xaref (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32x256 u32 u32 u32 -> ((io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32),u32)
