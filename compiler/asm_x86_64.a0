# numeric label p2 defined at offset p3 (line p4)
fn xadefnum (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32 u32 u32 u32 -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
