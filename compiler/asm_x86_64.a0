fn xastrst ((io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32),bool,bool) u32 u32x256 u32 -> ((io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32),bool,bool)
