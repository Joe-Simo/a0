g1 put p0 0 t2
g2 put g1 20 rm1
lno1 add lno 1
g3 put g2 19 lno1
g4 call xaproc g3 b ln lno1
ret g4
end

# ---- resolution: fixup p1 patched into the text (a label of the text section), or left for a
# relocation (any other named target); a numeric label with no definition is an error
fn xarsst (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) u32 -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
fx at p0 9
k mul p1 5
fa call xag80 fx k
k1 add k 1
kind call xag80 fx k1
k2 add k 2
line call xag80 fx k2
k3 add k 3
a call xag80 fx k3
k4 add k 4
b call xag80 fx k4
nb and kind 4
isnum ne nb 0
loc at p0 11
nl at p0 12
lab at p0 5
nlx select isnum nl 0
ls0 rec 0 false 0
lk fold xalkst2 nlx ls0 loc a b
lfd at lk 1
lof at lk 2
ka mul a 5
ka3 add ka 3
eof call xag40 lab ka3
ka4 add ka 4
edf call xag40 lab ka4
efd eq edf 1
found select isnum lfd efd
target select isnum lof eof
und eq found false
e1 and und isnum
a4 add fa 4
v sub target a4
t at p0 1
t1 call xatset t fa v
at1 add fa 1
v1 shr v 8
t2 call xatset t1 at1 v1
at2 add fa 2
v2 shr v 16
t3 call xatset t2 at2 v2
at3 add fa 3
v3 shr v 24
t4 call xatset t3 at3 v3
t5 select found t4 t
g1 put p0 1 t5
g2 call xafail g1 1 line e1
ret g2
end
fn xares (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) -> (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32)
er at p0 17
nf at p0 10
ok eq er 0
cnt select ok nf 0
g fold xarsst cnt p0
ret g
end

# ---- output
fn xawt io u32 u32x128x128 -> io
v call xatget p2 p1
w write p0 v
ret w
end
fn xawb io u32 u32x128x32 u32 -> io
i add p3 p1
v call xapget p2 i
w write p0 v
ret w
end
# the name of label entry p2 (pool p3)
fn xawname io u32x128x40 u32 u32x128x32 -> io
k mul p2 5
k1 add k 1
st call xag40 p1 k1
k2 add k 2
ln call xag40 p1 k2
w1 write p0 ln
w2 fold xawb ln w1 p3 st
ret w2
end
fn xawlab io u32 u32x128x8 u32x128x40 u32x128x32 -> io
ix call xag8 p2 p1
k mul ix 5
k3 add k 3
off call xag40 p3 k3
w1 write p0 off
w2 call xawname w1 p3 ix p4
ret w2
end
# fixup p1 is a relocation (a named target left undefined in the text)
fn xaisrel u32x128x80 u32 u32x128x40 -> bool
k mul p1 5
k1 add k 1
kind call xag80 p0 k1
k3 add k 3
a call xag80 p0 k3
nb and kind 4
named eq nb 0
ka mul a 5
ka4 add ka 4
edf call xag40 p2 ka4
und eq edf 0
r and named und
ret r
end
fn xacrel u32 u32 u32x128x80 u32x128x40 -> u32
r1 call xaisrel p2 p1 p3
a add p0 1
r select r1 a p0
ret r
end
fn xawrel1 io u32 u32 u32x128x80 u32x128x40 u32x128x32 -> io
k mul p2 5
fa call xag80 p3 k
k1 add k 1
kind call xag80 p3 k1
k3 add k 3
a call xag80 p3 k3
kk sub kind 1
w1 write p0 fa
w2 write w1 kk
w3 call xawname w2 p4 a p5
ret w3
end
fn xawrel io u32 u32x128x80 u32x128x40 u32x128x32 -> io
r1 call xaisrel p2 p1 p3
cn select r1 1 0
w fold xawrel1 cn p0 p1 p2 p3 p4
ret w
end
fn xawbss io u32 u32x128x8 u32x128x32 -> io
k mul p1 4
k1 add k 1
st call xag8 p2 k1
k2 add k 2
ln call xag8 p2 k2
k3 add k 3
off call xag8 p2 k3
w1 write p0 off
w2 write w1 ln
w3 fold xawb ln w2 p3 st
ret w3
end
# the module (see the head of the file): text p2 (p3 bytes), pool p4, labels p5, defined labels
# p6 (p7 of them), fixups p8 (p9 of them), bss symbols p10 (p11 of them), bss size p12 and
# alignment p13
fn xawok io u32 u32x128x128 u32 u32x128x32 u32x128x40 u32x128x8 u32 u32x128x80 u32 u32x128x8 u32 u32 u32 -> io
w0 write p0 0
w1 write w0 p3
w2 fold xawt p3 w1 p2
w3 write w2 p7
w4 fold xawlab p7 w3 p6 p5 p4
nr fold xacrel p9 0 p8 p5
w5 write w4 nr
w6 fold xawrel p9 w5 p8 p5 p4
w7 write w6 p11
w8 fold xawbss p11 w7 p10 p4
w9 write w8 p12
w10 write w9 p13
ret w10
end
fn xawerr io u32 u32 u32 -> io
w0 write p0 p2
w1 write w0 p3
ret w1
end
fn xaout (io,u32x128x128,u32,u32x128x32,u32,u32x128x40,u32,u32x128x8,u32,u32x128x80,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32) -> io
t at p0 0
tx at p0 1
nw at p0 2
pool at p0 3
lab at p0 5
dor at p0 7
nd at p0 8
fx at p0 9
nf at p0 10
bss at p0 13
nb at p0 14
bsz at p0 15
bal at p0 16
er at p0 17
el at p0 18
ok eq er 0
okc select ok 1 0
erc select ok 0 1
w1 fold xawok okc t tx nw pool lab dor nd fx nf bss nb bsz bal
w2 fold xawerr erc w1 er el
ret w2
end
# the entry: n, then the n bytes of the text (see the head of the file)
fn xasmio io -> u32
r read p0
n at r 0
t at r 1
z128 call xaz128
z32 call xaz32
z40 call xaz40
z8 call xaz8
z80 call xaz80
z16 call xaz16p
g0 rec t z128 0 z32 0 z40 0 z8 0 z80 0 z16 0 z8 0 0 0 0 0 0 n 0
cap add n 1
g1 loop xamorep xaline cap g0
g2 call xares g1
code at g2 17
w call xaout g2
ret code
end
