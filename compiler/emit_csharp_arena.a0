ret r
end

fn acs_scan_fn ((u32,(u32,u32,u32),io),u32) u32 u32x16 -> ((u32,(u32,u32,u32),io),u32)
s at p0 0
old at p0 1
fns get p2 2
base mul p1 10
off add base 9
r call acstext_get s fns off
code at r 0
out at r 1
flags at r 2
t at r 3
strict and flags 1
next or old strict
state rec code out t
result rec state next
ret result
end

fn acs_more (u32,(u32,u32,u32),io) u32 u32x16 u32 u32 -> bool
code at p0 0
r eq code 0
ret r
end

fn acs_emit_options io u32x16 u32 -> (u32,(u32,u32,u32),io)
nf get p1 11
nt get p1 12
nn get p1 13
small lt nt 3
empty eq nn 0
bad or small empty
unsupported ne p2 0
inside select bad 6 0
code select unsupported 8 inside
z rec 0 0 0
s rec code z p0
scanstate rec s 0
scan loop acs_scan_more acs_scan_fn nf scanstate p1
s1 at scan 0
strict at scan 1
ctx set p1 14 strict
count sub nn 1
checked loop acs_more acs_scan_node count s1 ctx 0 0
head call acs_prelude checked 0 ctx 0 0
runtime fold acs_strict_runtime strict head ctx 0 0
types sub nt 3
decls loop acs_more acs_decl types runtime ctx 0 0
body loop acs_more acs_function nf decls ctx 0 0
tail call acs_tail body 0 ctx 0 0
result call ew_public tail
ret result
end

fn acs_emit io u32x16 -> (u32,(u32,u32,u32),io)
r call acs_emit_options p0 p1 0
ret r
end
