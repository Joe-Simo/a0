fn acs_scan_node (u32,(u32,u32,u32),io) u32 u32x16 u32 u32 -> (u32,(u32,u32,u32),io)
x1 add p1 1
x2 mul x1 8
x3 add x2 0
x4 get p2 3
x5 call acstext_get p0 x4 x3
x6 at x5 0
x7 at x5 1
x8 at x5 2
x9 at x5 3
x10 rec x6 x7 x9
x11 eq x8 0
x12 gt x8 37
x13 or x11 x12
x14 at x10 0
x15 eq x14 0
