end
fn aw_io_write_body(s:(u32x128,u32x16,u32x128,u32x128,io)) -> (u32x128,u32x16,u32x128,u32x128,io)
 let output=(get(s#0,89)+2)*4
 let noutput=output+get(s#0,90)*4
 let a=aw_begin_body(s,0)
 let b=aw_mem(aw_getlocal(a,0),40,noutput)
 let c=aw_byte(aw_const(b,get(s#0,90)),73)
 let d=aw_byte(aw_byte(c,4),64)
 let e=aw_mem(aw_getlocal(aw_getlocal(d,0),0),40,noutput)
 let f=aw_byte(aw_byte(aw_const(e,4),108),106)
 let g=aw_mem(aw_getlocal(f,1),54,output)
 let h=aw_mem(aw_getlocal(aw_getlocal(g,0),0),40,noutput)
 let j=aw_mem(aw_byte(aw_const(h,1),106),54,noutput)
 let k=aw_byte(aw_byte(j,11),11)
 return aw_write_body(k,aw_vec(k#0,18))
end
fn aw_io_puts_body(s:(u32x128,u32x16,u32x128,u32x128,io)) -> (u32x128,u32x16,u32x128,u32x128,io)
 let a=aw_begin_body(s,1)
 let b=aw_call_index(aw_getlocal(aw_getlocal(a,0),2),1)
 let c=aw_setlocal(aw_const(b,0),3)
 let d=aw_byte(aw_byte(aw_byte(aw_byte(c,2),64),3),64)
 let e=aw_op_imm(aw_byte(aw_getlocal(aw_getlocal(d,3),2),79),13,1)
 let f=aw_getlocal(aw_getlocal(aw_getlocal(e,0),1),3)
 let g=aw_mem(aw_byte(aw_byte(aw_const(f,4),108),106),40,0)
 let h=aw_call_index(g,1)
 let j=aw_setlocal(aw_byte(aw_const(aw_getlocal(h,3),1),106),3)
 let k=aw_op_imm(j,12,0)
 let l=aw_byte(aw_byte(aw_byte(k,11),11),11)
 return aw_write_body(l,aw_vec(l#0,18))
