fn aw_rt_enter(s:(u32x128,u32x16,u32x128,u32x128,io)) -> (u32x128,u32x16,u32x128,u32x128,io)
 let chain=get(s#0,106)
 let node=get(s#0,107)
 let a=aw_begin_body(s,1)
 let b=aw_setlocal(aw_mem(aw_const(a,0),40,1040),1)
 let c=aw_mem(aw_getlocal(aw_rt_word(b,1),0),54,chain)
 let d=aw_mem(aw_const(aw_rt_word(c,1),0),54,node)
 let e=aw_getlocal(aw_const(d,0),1)
 let f=aw_mem(aw_byte(aw_const(e,1),106),54,1040)
 let g=aw_byte(f,11)
 return aw_write_body(g,aw_vec(g#0,18))
end
fn aw_rt_leave(s:(u32x128,u32x16,u32x128,u32x128,io)) -> (u32x128,u32x16,u32x128,u32x128,io)
