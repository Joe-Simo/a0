end
fn aw_rt_trap(s:(u32x128,u32x16,u32x128,u32x128,io)) -> (u32x128,u32x16,u32x128,u32x128,io)
 let node=get(s#0,107)
 let trips=get(s#0,108)
 let a=aw_begin_body(s,4)
 let b=aw_setlocal(aw_mem(aw_const(a,0),40,1040),1)
 let c=aw_setlocal(aw_const(b,4294967295),2)
 let d=aw_setlocal(aw_const(c,0),3)
 let e=aw_setlocal(aw_getlocal(d,1),4)
 let f=aw_byte(aw_byte(aw_byte(aw_byte(e,2),64),3),64)
 let g=aw_op_imm(aw_byte(aw_getlocal(f,4),69),13,1)
 let h=aw_setlocal(aw_byte(aw_const(aw_getlocal(g,4),1),107),4)
 let j=aw_byte(aw_byte(aw_mem(aw_rt_word(h,4),40,node),4),64)
 let k=aw_setlocal(aw_getlocal(j,4),2)
 let l=aw_setlocal(aw_mem(aw_rt_word(k,4),40,trips),3)
 let m=aw_op_imm(l,12,2)
 let n=aw_op_imm(aw_byte(m,11),12,0)
 let p=aw_byte(aw_byte(n,11),11)
 let q=aw_byte(aw_const(aw_getlocal(aw_const(p,0),0),8),108)
 let r=aw_mem(aw_byte(aw_const(q,1044),106),54,1024)
 let u=aw_mem(aw_getlocal(aw_const(r,0),1),54,1028)
 let v=aw_mem(aw_getlocal(aw_const(u,0),2),54,1032)
 let w=aw_mem(aw_getlocal(aw_const(v,0),3),54,1036)
 let x=aw_mem(aw_const(aw_const(w,0),0),54,1040)
 let y=aw_byte(aw_byte(x,0),11)
 return aw_write_body(y,aw_vec(y#0,18))
