 let b=aw_mem(aw_const(aw_const(a,0),0),40,1040)
 let c=aw_mem(aw_byte(aw_const(b,1),107),54,1040)
 let d=aw_byte(c,11)
 return aw_write_body(d,aw_vec(d#0,18))
end
fn aw_rt_frame_store(s:(u32x128,u32x16,u32x128,u32x128,io),offset:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let a=aw_begin_body(s,0)
 let b=aw_mem(aw_const(a,0),40,1040)
 let c=aw_byte(aw_const(b,1),107)
 let d=aw_byte(aw_const(c,2),116)
 let e=aw_mem(aw_getlocal(d,0),54,offset)
