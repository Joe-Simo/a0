fn aw_strict_bodies(s:(u32x128,u32x16,u32x128,u32x128,io),i:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let a=aw_rt_enter(s)
 let b=aw_rt_leave(a)
 let c=aw_rt_frame_store(b,get(b#0,107))
 let d=aw_rt_frame_store(c,get(c#0,108))
 let e=aw_rt_trap(d)
 return aw_io_sread_body(e)
end
