fn aw_trap_global_name(s:(u32x128,u32x16,u32x128,u32x128,io),index:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let a=aw_uleb(s,index>=4?(index==4?8:7):(index==1?9:(index==2?10:12)))
 let b=aw_byte(aw_byte(aw_byte(a,97),48),95)
 let c=fold(aw_trap_prefix,index<4?1:0,b)
 let d=fold(aw_trap_suffix,index<4?1:0,c,index)
 let e=fold(aw_trap_array_name,index>=4?1:0,d,index)
 return aw_uleb(aw_byte(e,3),index+2)
end
