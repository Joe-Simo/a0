fn aw_emit_iteration(s:(u32x128,u32x16,u32x128,u32x128,io),i:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let aggregate=get(s#0,79)>=3
 let a=fold(aw_iteration_scalar_init,bit(!aggregate),s)
 let b=fold(aw_iteration_aggregate_init,bit(aggregate),a)
 let marked=fold(aw_strict_mark,get(s#0,88)!=0?1:0,b)
 let c=aw_tempset(aw_const(marked,0),0)
 let d=aw_byte(aw_byte(aw_byte(aw_byte(c,2),64),3),64)
 let e=aw_byte(aw_push(aw_tempget(d,0),0),79)
 let f=aw_op_imm(e,13,1)
 let trip=fold(aw_strict_index,get(s#0,88)!=0?1:0,f)
 let g=fold(aw_iteration_predicate,get(s#0,80)==21?1:0,trip)
 let h=fold(aw_push_node,bit(aggregate),g)
 let j=aw_iteration_args(h)
 let k=aw_user_call(j,get(j#0,81))
 let l=fold(aw_set_node,bit(!aggregate),k)
 let m=aw_tempset(aw_byte(aw_const(aw_tempget(l,0),1),106),0)
 let n=aw_op_imm(m,12,0)
 let out=aw_byte(aw_byte(n,11),11)
 return fold(aw_strict_unmark,get(s#0,88)!=0?1:0,out)
end
