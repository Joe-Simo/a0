fn aw_emit_node(s:(u32x128,u32x16,u32x128,u32x128,io),local:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let a=aw_node(s,get(s#0,65)+local)
 let nd=a#3
 let m=set(a#0,75,get(a#0,67)+1+local)
 let m=set(m,76,get(a#0,65)+local)
 let m=set(m,77,nd[2])
 let m=set(m,78,nd[1])
 let m=set(m,79,nd[5])
 let m=set(m,80,nd[0])
 let m=set(m,81,nd[3])
 let m=set(m,82,nd[4])
 let op=nd[0]
 let aggregate=nd[5]>=3
 let borrow=(op==1)|(op==18)|(op==25)|(op==27)
 let b=fold(aw_push_node,0,(m,a#1,a#2,a#3,a#4))
 let c=aw_code(b,(op==0)|(op>37)?6:0)
 let d=fold(aw_bind_node,aggregate&!borrow?1:0,c)
 let e=fold(aw_emit_mov,op==1?1:0,d)
 let f=fold(aw_emit_binary,((op>=2)&(op<=9))|((op>=12)&(op<=17))?1:0,e)
 let g=fold(aw_emit_division,(op==10)|(op==11)?1:0,f)
 let h=fold(aw_emit_select,op==18?1:0,g)
 let j=fold(aw_emit_direct_call,op==19?1:0,h)
 let k=fold(aw_emit_iteration,(op==20)|(op==21)?1:0,j)
 let l=fold(aw_emit_literal,(op==22)|(op==23)|(op==24)?1:0,k)
 let m=fold(aw_emit_access,(op==25)|(op==27)?1:0,l)
 let n=fold(aw_emit_update,(op==26)|(op==28)?1:0,m)
 let p=fold(aw_emit_read,op==29?1:0,n)
 let q=fold(aw_emit_write,op==30?1:0,p)
 let r=fold(aw_emit_puts,op==31?1:0,q)
 let u=fold(aw_emit_checked_sum,(op==32)|(op==33)?1:0,r)
 let v=fold(aw_emit_checked_mul,op==34?1:0,u)
 let w=fold(aw_emit_checked_div,(op==35)|(op==36)?1:0,v)
 return fold(aw_emit_checked_get,op==37?1:0,w)
end

