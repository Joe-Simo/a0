fn aw_emit_function(s:(u32x128,u32x16,u32x128,u32x128,io),id:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let a=aw_fun(s,id)
 let funrow=a#3
 let b=aw_raw(a,get(a#0,9),id*16,5)
 let meta=b#3
 let m=set(b#0,64,id)
 let m=set(m,65,funrow[5])
 let m=set(m,66,funrow[6])
 let m=set(m,67,meta[1])
 let m=set(m,68,funrow[4])
 let m=set(m,69,meta[0])
 let m=set(m,70,meta[3])
 let m=set(m,71,meta[1])
 let m=set(m,72,meta[1]+1+funrow[6])
 let m=set(m,73,funrow[3])
 let m=set(m,74,funrow[9])
 let m=set(m,102,funrow[7])
 let m=set(m,103,funrow[8])
 let c=aw_begin_body((m,b#1,b#2,b#3,b#4),meta[2])
 let entered=fold(aw_strict_enter,get(c#0,88)!=0?1:0,c)
 let d=aw_byte(aw_const(aw_op_imm(entered,35,0),meta[3]),107)
 let e=aw_op_imm(aw_op_imm(d,34,meta[1]),36,0)
 let f=loop(aw_ok,aw_emit_node,funrow[6],e)
 let g=fold(aw_return_aggregate,meta[0],f)
 let left=fold(aw_strict_leave,get(g#0,88)!=0?1:0,g)
 let h=aw_restore_stack(left)
 let j=fold(aw_return_scalar,meta[0]==0?1:0,h)
 let k=aw_byte(j,11)
 let body=aw_vec(k#0,18)
 let l=aw_put(k,9,id*16+5,body#0)
 let n=aw_put(l,9,id*16+6,body#1)
 return aw_put(n,9,id*16+7,body#2)
end
fn aw_program_geometry(s:(u32x128,u32x16,u32x128,u32x128,io),id:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let a=aw_fun(s,id)
 let profile=get(a#3,9)&1
 let m=set(a#0,88,(get(a#0,88)!=0)|(profile!=0)?1:0)
 let b=(m,a#1,a#2,a#3,a#4)
 let c=aw_fnword(b,id,4)
 let depth=get(c#3,0)
 let old=get(c#0,87)
 return (set(c#0,87,depth>old?depth:old),c#1,c#2,c#3,c#4)
end
fn aw_emit_i32(s:(u32x128,u32x16,u32x128,u32x128,io),i:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
