fn aw_signature(s:(u32x128,u32x16,u32x128,u32x128,io),id:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let m=set(s#0,104,id==1?2:(id==2?3:(id==4?0:1)))
 let m=set(m,105,(id==0)|(id==8)?1:0)
 let a=fold(aw_signature_user,id>=m[85]?1:0,(m,s#1,s#2,s#3,s#4),id-m[85])
 let m=a#0
 let b=aw_uleb(aw_byte(a,96),m[104])
 let c=loop(aw_ok,aw_emit_i32,m[104],b)
 let d=aw_uleb(c,m[105])
 return fold(aw_emit_i32,m[105],d)
end
