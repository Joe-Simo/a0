fn aw_io_read_common(s:(u32x128,u32x16,u32x128,u32x128,io),strict:bool) -> (u32x128,u32x16,u32x128,u32x128,io)
 let input=get(s#0,89)*4
 let position=input+4
 let a=aw_begin_body(s,0)
 let b=aw_mem(aw_getlocal(a,0),40,position)
 let c=aw_mem(aw_getlocal(b,0),40,input)
 let d=aw_byte(c,73)
 let e=aw_mem(aw_getlocal(d,0),40,position)
 let f=aw_byte(aw_const(e,get(s#0,89)),73)
 let g=aw_byte(aw_byte(aw_byte(f,113),4),127)
 let h=aw_getlocal(aw_getlocal(g,0),0)
 let j=aw_mem(h,40,position)
 let k=aw_byte(aw_byte(aw_const(j,4),108),106)
 let l=aw_mem(k,40,0)
 let m=aw_getlocal(aw_getlocal(l,0),0)
 let n=aw_mem(m,40,position)
 let p=aw_byte(aw_const(n,1),106)
 let q=aw_mem(p,54,position)
 let exhausted=fold(aw_rt_read_exhausted,bit(strict),aw_byte(q,5))
 let r=aw_const(exhausted,0)
 let u=aw_byte(aw_byte(r,11),11)
 return aw_write_body(u,aw_vec(u#0,18))
end
fn aw_io_read_body(s:(u32x128,u32x16,u32x128,u32x128,io)) -> (u32x128,u32x16,u32x128,u32x128,io)
 return aw_io_read_common(s,false)
end
fn aw_io_sread_body(s:(u32x128,u32x16,u32x128,u32x128,io)) -> (u32x128,u32x16,u32x128,u32x128,io)
