fn aw_trap_suffix(s:(u32x128,u32x16,u32x128,u32x128,io),i:u32,index:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
 let a=fold(aw_trap_kind_suffix,index==0?1:0,s)
 let b=fold(aw_trap_n_suffix,index==1?1:0,a)
 let c=fold(aw_trap_at_suffix,index==2?1:0,b)
 return fold(aw_trap_trip_suffix,index==3?1:0,c)
end
fn aw_trap_array_name(s:(u32x128,u32x16,u32x128,u32x128,io),i:u32,index:u32) -> (u32x128,u32x16,u32x128,u32x128,io)
