fn sp_vec u32x128 u32 -> (u32,u32,u32)
q0 get p0 p1
q1 add p1 1
q2 get p0 q1
q3 add p1 2
q4 get p0 q3
q5 rec q0 q2 q4
ret q5
end

fn sp_setvec u32x128 u32 (u32,u32,u32) -> u32x128
q0 at p2 0
a set p0 p1 q0
q1 add p1 1
q2 at p2 1
b set a q1 q2
q3 add p1 2
q4 at p2 2
q5 set b q3 q4
ret q5
end

fn sp_setsy u32x128 u32 ((u32,u32,u32),u32,u32,u32) -> u32x128
q0 at p2 0
a call sp_setvec p0 p1 q0
q1 add p1 3
q2 at p2 1
b set a q1 q2
q3 add p1 4
q4 at p2 2
c set b q3 q4
q5 add p1 5
q6 at p2 3
q7 set c q5 q6
ret q7
end

fn sp_sy u32x128 u32 -> ((u32,u32,u32),u32,u32,u32)
q0 call sp_vec p0 p1
