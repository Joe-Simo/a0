q2 get p0 q1
q3 add p1 4
q4 get p0 q3
q5 add p1 5
q6 get p0 q5
q7 rec q0 q2 q4 q6
ret q7
end

fn sp_appendgo (u32x128,u32x128,io) u32 u32 u32 u32x128 -> (u32x128,u32x128,io)
p at p0 0
