q call sp_setvec p p2 q2
q3 at r 0
q4 set q 0 q3
q5 at p0 1
q6 at r 2
q7 rec q4 q5 q6
ret q7
end

fn sp_append (u32x128,u32x128,io) u32 u32 u32x128 -> (u32x128,u32x128,io)
p at p0 0
q0 get p 0
q1 eq q0 0
q2 select q1 1 0
q3 fold sp_appendgo q2 p0 p1 p2 p3
ret q3
end

