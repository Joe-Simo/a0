args call bodyargs alo narg fns0 names p1 toks ta tv ntok e4 et4
fcs at s1 7
fcu at s1 8
fcp at s2 1
fch at s3 19
fct at s3 5
fcl at s3 6
fcn at s5 4
ovr call fecap toks ntok fcs fcp fcu fch fct fcl fcn narg
pcode0 at s5 8
pcode select ovr 4 pcode0
# after a parse error the function count may be below p4: nothing is checked then
cfrom call cumin p4 nhc
ck call checkir types tlist fns nodes args p3 ntypes ntlist nhc cfrom
types2 at ck 0
tlist2 at ck 2
ntys at ck 4
fstat at ck 7
ntypes2 at ck 8
cerr at ck 10
ns127 add nsym 127
nsp shr ns127 7
z64 call z64
st0 rec z64 0
st fold cstpg nsp st0 sinfo
starts at st 0
z16 call z16
fnm fold cfnm nhc z16 fns sinfo starts
grew ne ntypes2 ntypes
added and grew p5
pok eq pcode 0
c1 select added 5 0
cok eq cerr 0
c2 select cok c1 cerr
code0 select pok c2 pcode
# a strict program or a checked op: no emitter implements them (structure, A0713)
prof at s1 16
unsup call refuse prof nodes fcn
ok0 eq code0 0
ref and ok0 unsup
code select ref 2 code0
ok eq code 0
go select ok 1 0
hw select p6 1 0
tfrom select p6 3 ntypes2
t fold cemit go p0 types2 tlist2 fns nodes args ntys pool fnm ntypes2 tfrom p4 nhc hw
r rec t code fstat nhc
ret r
end
# io front: read n then n source bytes (n is clamped to 131072); write the C bytes when lex,
# parse and check succeed. The result is the diagnostic code (0 when the C was written).
fn emitcio io -> u32
rs call readsrc p0
src at rs 0
n at rs 1
t1 at rs 2
z8 call z8
u call cunit t1 src n z8 0 false true
code at u 1
ret code
end
