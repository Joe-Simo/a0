k add p1 1
r call cprm p0 k p2 p3 p4
ret r
end
# In-place analysis (src/backends.ts `mutableHere`): a value (a node, or a parameter the
# variant owns: all of them except p0 of the ref variant) may be updated in place by the node
# at j when it is fresh (arr text rec set put, or a parameter), not returned, and every other
# use of it is a get/at of it (operand 0) before j. Use statistics per function, paged: word v
# (node v; parameter v at 4096 + v) holds 2^16 * (uses other than get/at operand 0) + (last
# user + 1).
# operand p3 + p1 (in args page p2) of the node at local index p5 whose operands start at p4;
# p6: it is a get or at
fn cusa u32x128x64 u32 u32x128 u32 u32 u32 bool -> u32x128x64
oi add p3 p1
xw mul oi 2
x2 and xw 127
kd get p2 x2
x3 add x2 1
vd get p2 x3
isn eq kd 1
isp eq kd 2
q add vd 4096
slot select isp q vd
sp shr slot 7
sl and slot 127
pg get p0 sp
w get pg sl
nb shr w 16
k0 eq oi p4
good and p6 k0
bad select good 0 1
nb2 add nb bad
hi shl nb2 16
j1 add p5 1
nw or hi j1
val or isn isp
out select val nw w
pg2 set pg sl out
r set p0 sp pg2
ret r
end
# args page p5 + p1 (64 operands) of the operands [p3, p4) of node p6 (p7: get or at)
fn cuspg u32x128x64 u32 u32x128x512 u32 u32 u32 u32 bool -> u32x128x64
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold cusa cnt p0 pg lo p3 p6 p7
ret r
end
# the operands of node p1 of the function whose first node is p4, a page at a time
