tlist1 fold cp1024 ntlist z1024 tlist
fns1 fold cp1024 nfns7 z1024 fns
nodes1 fold cp4096 nnodes6 z4096 nodes
args1 fold cp8192 nargs2 z8192 args
ck call check types1 tlist1 fns1 nodes1 args1 z256 ntypes ntlist nfns 0
types2 at ck 0
tlist2 at ck 1
ntypes2 at ck 4
ntys at ck 6
cerr at ck 10
pok eq pcode 0
code select pok cerr pcode
ok eq code 0
go select ok 1 0
t2 fold cemit go t1 types2 tlist2 fns1 nodes1 args1 ntys pool sym ntypes2 nfns
ret code
end
