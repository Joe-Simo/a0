# Borrowed reads (src/core.ts `borrowLive`): a get or at of an aggregate is a pointer into its
# container, so the container is updated in place only when no borrow of it is read after the
# update. Borrow table per function, paged like the use statistics: a borrow node j holds
# 2^31 + its container's slot (node v, parameter v at 4096 + v; a borrow of a borrow has the
# first one's container), a container 1 + the last node that reads one of its borrows (65535
# when one is returned).
# operand p3 + p1 (in args page p2) of node p4: a borrow read there marks its container
fn cbra u32x128x64 u32 u32x128 u32 u32 -> u32x128x64
oi add p3 p1
xw mul oi 2
x2 and xw 127
kd get p2 x2
x3 add x2 1
vd get p2 x3
isn eq kd 1
sp shr vd 7
sl and vd 127
pg get p0 sp
w get pg sl
fl shr w 31
isb eq fl 1
mk and isn isb
c and w 2147483647
cp shr c 7
cl and c 127
cg get p0 cp
j1 add p4 1
cw get cg cl
nw select mk j1 cw
cg2 set cg cl nw
r set p0 cp cg2
ret r
end
# args page p5 + p1 (64 operands) of the operands [p3, p4) of node p6
fn cbrpg u32x128x64 u32 u32x128x512 u32 u32 u32 u32 -> u32x128x64
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold cbra cnt p0 pg lo p6
ret r
end
