# (io types tlist fns nodes args ntys pool sym ntypes tfrom from to head): the prelude when
# head is 1, typedefs of types [tfrom, ntypes), functions [from, to)
fn emitc io u32x768 u32x1024 u32x1024 u32x4096 u32x8192 u32x1024 u32x512 u32x512 u32 u32 u32 u32 u32 -> io
a fold cpre p13 p0
nt sub p9 p10
b fold ctd nt a p1 p2 p10
nf sub p12 p11
c fold cfn nf b p4 p5 p6 p1 p2 p7 p8 p3 p11
ret c
end
fn cemit io u32 u32x768 u32x1024 u32x1024 u32x4096 u32x8192 u32x1024 u32x512 u32x512 u32 u32 -> io
r call emitc p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 3 0 p11 1
ret r
end
# io front: read n then n source bytes; write the C bytes when lex, parse and check succeed.
# The result is the diagnostic code (0 when the C was written).
fn emitcio io -> u32
r0 read p0
n0 at r0 0
t0 at r0 1
big lt 512 n0
n select big 512 n0
z call zeros512
s0 rec z t0
rd fold readbyte n s0
src at rd 0
t1 at rd 1
pr call parse src n
pcode at pr 0
pool at pr 2
sym at pr 3
types at pr 4
tlist at pr 5
fns at pr 6
nodes at pr 7
args at pr 8
ntypes at pr 12
ntlist at pr 13
nfns at pr 14
nnodes at pr 15
nargs at pr 16
ntypes3 mul ntypes 3
nfns7 mul nfns 7
nnodes6 mul nnodes 6
nargs2 mul nargs 2
z768 call zeros768
z1024 call zeros1024
z4096 call zeros4096
z8192 call zeros8192
z256 call zeros256
types1 fold cp768 ntypes3 z768 types
tlist1 fold cp1024 ntlist z1024 tlist
fns1 fold cp1024 nfns7 z1024 fns
nodes1 fold cp4096 nnodes6 z4096 nodes
args1 fold cp8192 nargs2 z8192 args
ck call check types1 tlist1 fns1 nodes1 args1 z256 ntypes ntlist nfns 0
types2 at ck 0
tlist2 at ck 1
ntypes2 at ck 4
ntys at ck 6
cerr at ck 10
pok eq pcode 0
code select pok cerr pcode
ok eq code 0
go select ok 1 0
t2 fold cemit go t1 types2 tlist2 fns1 nodes1 args1 ntys pool sym ntypes2 nfns
ret code
end
