# Shared exact short-word keys and operation codes. See src/wordkey.ts for the key rule.
# Bijective base 37 digits are 1..37; six digits fit in u32. Longer or invalid words key to 0.
fn wordkey_code u32 -> u32
lo ge p0 97
hi le p0 122
letter and lo hi
dl ge p0 48
dh le p0 57
digit and dl dh
underscore eq p0 95
lc sub p0 96
dc sub p0 21
l select letter lc 0
d select digit dc l
out select underscore 37 d
ret out
end

fn wordkey_step (u32,u32,bool) u32 u32x128 -> (u32,u32,bool)
byte get p2 p1
code call wordkey_code byte
key at p0 0
power at p0 1
oldvalid at p0 2
term mul code power
next add key term
nextpower mul power 37
known ne code 0
valid and oldvalid known
out rec next nextpower valid
ret out
end

fn wordkey u32x128 u32 -> u32
fits le p1 6
count select fits p1 0
initial rec 0 1 true
result fold wordkey_step count initial p0
valid at result 2
key at result 0
out select valid key 0
ret out
end

# operation codes of DESIGN.md 7a
fn opcode u32 -> u32
k1 eq p0 30686
r1 select k1 1 0
k2 eq p0 5625
r2 select k2 2 r1
k3 eq p0 3534
r3 select k3 3 r2
k4 eq p0 17218
r4 select k4 4 r3
k5 eq p0 5995
r5 select k5 5 r4
k6 eq p0 681
r6 select k6 6 r5
k7 eq p0 25221
r7 select k7 7 r6
k8 eq p0 16743
r8 select k8 8 r7
k9 eq p0 24957
r9 select k9 9 r8
k10 eq p0 30455
r10 select k10 10 r9
k11 eq p0 18000
r11 select k11 11 r10
k12 eq p0 634
r12 select k12 12 r11
k13 eq p0 199
r13 select k13 13 r12
k14 eq p0 752
r14 select k14 14 r13
k15 eq p0 197
r15 select k15 15 r14
k16 eq p0 747
r16 select k16 16 r15
k17 eq p0 192
r17 select k17 17 r16
k18 eq p0 1392771520
r18 select k18 18 r17
k19 eq p0 624304
r19 select k19 19 r18
k20 eq p0 219601
r20 select k20 20 r19
k21 eq p0 831550
r21 select k21 21 r20
k22 eq p0 25309
r22 select k22 22 r21
k23 eq p0 4310
r23 select k23 23 r22
k24 eq p0 1046121
r24 select k24 24 r23
k25 eq p0 27572
r25 select k25 25 r24
k26 eq p0 27584
r26 select k26 26 r25
k27 eq p0 741
r27 select k27 27 r26
k28 eq p0 28173
r28 select k28 28 r27
k29 eq p0 204184
r29 select k29 29 r28
k30 eq p0 10396875
r30 select k30 30 r29
k31 eq p0 990580
r31 select k31 31 r30
# accepted spellings: udiv is div, urem is rem (every integer op is unsigned)
k32 eq p0 1126856
r32 select k32 10 r31
k33 eq p0 666021
r33 select k33 11 r32
# the checked operations (cadd csub cmul cdiv crem cget), 32 to 37: valid in both profiles, never
# trapping, a (u32,bool) result; no emitter implements them (the drivers refuse them)
k34 eq p0 208128
r34 select k34 32 r33
k35 eq p0 130761
r35 select k35 33 r34
k36 eq p0 637069
r36 select k36 34 r35
k37 eq p0 1126838
r37 select k37 35 r36
k38 eq p0 666003
r38 select k38 36 r37
k39 eq p0 1020167
r39 select k39 37 r38
ret r39
end
