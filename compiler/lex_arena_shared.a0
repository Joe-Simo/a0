use "arena_shared.a0"

fn al_isdigit u32 -> bool
lo ge p0 48
hi le p0 57
r and lo hi
ret r
end

fn al_isword u32 -> bool
lo ge p0 97
hi le p0 122
a and lo hi
b eq p0 95
c call al_isdigit p0
q or a b
r or q c
ret r
end

fn al_isspace u32 -> bool
s eq p0 32
lo ge p0 9
hi le p0 13
q and lo hi
r or s q
ret r
end

fn al_lexstep u32 u32 u32 u32 u32 -> (bool,u32,u32,u32,u32,u32,u32)
c mov p2
isw call al_isword c
isnl eq c 10
isq eq c 34
isbs eq c 92
ishash eq c 35
isminus eq c 45
isgt eq c 62
isat eq c 64
issp call al_isspace c
k1 eq p0 1
k2 eq p0 2
k3 eq p0 3
k6 eq p0 6
k8 eq p0 8
k5 eq p0 5
k7 eq p0 7
k9 eq p0 9
# close: a word at a non-word byte, a string at an unescaped quote, a comment at a newline,
# a one-byte token at any byte; a minus followed by '>' is an arrow
inw or k1 k2
notw select isw false true
wclose and inw notw
escd eq p4 1
notesc select escd false true
sq and k3 isq
sclose and sq notesc
cclose and k8 isnl
s57 or k5 k7
single or s57 k9
arrow and k6 isgt
e0 or wclose sclose
e1 or e0 single
emit or e1 k6
c0 or e0 cclose
c1 or c0 single
closed or c1 k6
consumed or sclose arrow
ek0 select k6 6 p0
ek1 select arrow 4 ek0
ek select sclose 3 ek1
s1 add p1 1
es select sclose s1 p1
wl sub p3 p1
sl sub wl 1
l0 select arrow 2 1
l1 select sclose sl l0
el select wclose wl l1
# start: with nothing pending, the byte begins a token (or is a space)
k0 eq p0 0
none or k0 closed
notcons select consumed false true
free and none notcons
isd call al_isdigit c
wk select isd 2 1
n0 select issp 0 9
n1 select isat 7 n0
n2 select isminus 6 n1
n3 select isnl 5 n2
n4 select ishash 8 n3
n5 select isq 3 n4
n6 select isw wk n5
cont select closed 0 p0
nk select free n6 cont
ns select free p3 p1
# a backslash in a string escapes the next byte
e2 select isbs 1 0
e3 select escd 0 e2
esc select k3 e3 0
r rec emit ek es el nk ns esc
ret r
end

# Inline whitespace encoding length. p1<=125 provides two lookahead bytes in p0.
# p2 is remaining logical source bytes, so padding cannot complete a partial sequence.
fn al_white u32x128 u32 u32 -> u32
a get p0 p1
i1 add p1 1
i2 add p1 2
b get p0 i1
c get p0 i2
sp eq a 32
lo ge a 9
hi le a 13
nl ne a 10
w0 and lo hi
w1 and w0 nl
ascii or sp w1
a2 eq a 194
b2 eq b 160
p2n ge p2 2
q2 and a2 b2
w2 and q2 p2n
a3a eq a 225
b3a eq b 154
c3a eq c 128
q3a and a3a b3a
v3a and q3a c3a
a3b eq a 226
b3b eq b 128
c3blo ge c 128
c3bhi le c 138
c3br and c3blo c3bhi
c3b28 eq c 168
c3b29 eq c 169
c3b2f eq c 175
c3bx or c3b28 c3b29
c3by or c3bx c3b2f
c3bz or c3br c3by
q3b and a3b b3b
v3b and q3b c3bz
b3c eq b 129
c3c eq c 159
q3c and a3b b3c
v3c and q3c c3c
a3d eq a 227
b3d eq b 128
c3d eq c 128
q3d and a3d b3d
v3d and q3d c3d
a3e eq a 239
b3e eq b 187
c3e eq c 191
q3e and a3e b3e
v3e and q3e c3e
v30 or v3a v3b
v31 or v30 v3c
v32 or v31 v3d
v33 or v32 v3e
p3n ge p2 3
w3 and v33 p3n
r0 select ascii 1 0
r1 select w2 2 r0
r select w3 3 r1
ret r
end

# One byte; bounded window (<=378 words per126-byte source page).
# State: window,fill,pendingKind,pendingStart,escape,remainingWhitespaceBytes.
fn al_byte (u32x128x4,u32,u32,u32,u32,u32) u32 u32x128 u32 u32 -> (u32x128x4,u32,u32,u32,u32,u32)
w at p0 0
f at p0 1
pk at p0 2
ps at p0 3
esc at p0 4
skip at p0 5
raw get p2 p1
i add p3 p1
remaining sub p4 i
wl call al_white p2 p1 remaining
str eq pk 3
comment eq pk 8
inside or str comment
outside select inside false true
len select outside wl 0
more gt skip 0
white gt len 0
convert or more white
c select convert 32 raw
less sub skip 1
l1 sub len 1
lgt gt len 1
ln select lgt l1 0
nextskip select more less ln
d call al_lexstep pk ps c i esc
emit at d 0
ek at d 1
es at d 2
el at d 3
h0 shr f 7
l0 and f 127
g0 get w h0
g0b set g0 l0 ek
w1 set w h0 g0b
f1 add f 1
h1 shr f1 7
l1w and f1 127
g1 get w1 h1
g1b set g1 l1w es
w2 set w1 h1 g1b
f2 add f 2
h2 shr f2 7
l2 and f2 127
g2 get w2 h2
g2b set g2 l2 el
w3 set w2 h2 g2b
f3 add f 3
fill select emit f3 f
nk at d 4
ns at d 5
ne at d 6
r rec w3 fill nk ns ne nextskip
ret r
end

fn al_flush_ok (u32,io) u32 u32x128x4 u32 u32 u32 -> bool
code at p0 0
ok eq code 0
base mul p1 128
has lt base p3
r and ok has
ret r
end

fn al_flush_chunk (u32,io) u32 u32x128x4 u32 u32 u32 -> (u32,io)
t at p0 1
base mul p1 128
rest sub p3 base
big gt rest 128
n select big 128 rest
page get p2 p1
off add p5 base
r call arena_store t p4 off n page
ret r
end

# State: status,outputHandle,outputWordCount,kind,start,escape,skip,io.
fn al_page_ok (u32,u32,u32,u32,u32,u32,u32,io) u32 u32 u32 -> bool
code at p0 0
ok eq code 0
ret ok
end

fn al_page (u32,u32,u32,u32,u32,u32,u32,io) u32 u32 u32 -> (u32,u32,u32,u32,u32,u32,u32,io)
out at p0 1
nout at p0 2
pk at p0 3
ps at p0 4
esc at p0 5
skip at p0 6
t at p0 7
base mul p1 126
rest sub p3 base
big gt rest 128
loadn select big 128 rest
r call arena_load t p2 base loadn
code at r 0
page at r 1
t1 at r 2
ok eq code 0
more gt rest 126
cnt0 select more 126 rest
cnt select ok cnt0 0
z call arena_zero
win arr z z z z
s0 rec win 0 pk ps esc skip
s fold al_byte cnt s0 page base p3
words at s 0
fill at s 1
nk at s 2
ns at s 3
ne at s 4
sk at s 5
st rec code t1
fl loop al_flush_ok al_flush_chunk 4 st words fill out nout
fc at fl 0
t2 at fl 1
success eq fc 0
newout add nout fill
nw select success newout nout
state rec fc out nw nk ns ne sk t2
ret state
end

# Errors return handle0,count0; empty success keeps a valid arena handle.
fn al_finish (u32,u32,u32,u32,u32,u32,u32,io) u32 -> (u32,u32,u32,io)
code at p0 0
handle at p0 1
words at p0 2
kind at p0 3
start at p0 4
t at p0 7
w1 eq kind 1
w2 eq kind 2
word or w1 w2
s5 eq kind 5
s6 eq kind 6
s7 eq kind 7
s9 eq kind 9
s0 or s5 s6
s1 or s0 s7
single or s1 s9
pending or word single
ok eq code 0
emit and ok pending
n select emit 3 0
rawlen sub p1 start
len select word rawlen 1
z call arena_zero
a set z 0 kind
b set a 1 start
c set b 2 len
win arr c z z z
st rec code t
fl loop al_flush_ok al_flush_chunk 1 st win n handle words
status at fl 0
t1 at fl 1
success eq status 0
total add words n
count div total 3
h select success handle 0
nt select success count 0
out rec status h nt t1
ret out
end

fn al_run (u32,u32,u32,io) u32 u32 u32 -> (u32,u32,u32,io)
t at p0 3
np1 add p3 125
pages div np1 126
words1 add p3 1
words mul words1 3
r call arena_alloc t words
code at r 0
handle at r 1
t1 at r 2
s rec code handle 0 0 0 0 0 t1
scan loop al_page_ok al_page pages s p2 p3
out call al_finish scan p3
ret out
end

# Source logical length is bytes, not token/identifier length. No source clamping.
# Status6 is the declared2MiB source limit; runtime failures preserve statuses1..5.
fn arena_lex io u32 u32 -> (u32,u32,u32,io)
fits le p2 2097152
n select fits 1 0
s rec 6 0 0 p0
r fold al_run n s p1 p2
ret r
end
