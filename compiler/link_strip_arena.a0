end
fn link_strip io u32 u32 u32 -> (u32,(u32,u32,u32),(u32,u32,u32),io)
z call arena_zero
p set z 1 p2
p_1 set p 2 p3
q0 rec 0 0 0
q1 eq p2 0
q2 select q1 0 4
r call av_append p0 q0 q2 p_1
q3 at r 0
q4 eq q3 0
q5 select q4 1 0
q6 at r 0
q7 rec 0 0 0
q8 at r 1
q9 at r 2
q10 rec q6 q7 q8 q9
first fold st_first q5 q10 p1 p2
q11 at first 0
q12 eq q11 0
q13 select q12 1 0
second fold st_second q13 first
q14 at second 0
q15 at second 0
q16 eq q15 0
q17 at second 1
q18 rec 0 0 0
q19 select q16 q17 q18
q20 at second 0
q21 eq q20 0
q22 at second 2
q23 rec 0 0 0
q24 select q21 q22 q23
q25 at second 3
q26 rec q14 q19 q24 q25
ret q26
end
