# Strip parsed header directives, preserving physical LF and copied-byte origins.
use "arena_vector.a0"
fn st_appendgo (u32x128,io) u32 u32 u32 u32x128 -> (u32x128,io)
p at p0 0
q0 at p0 1
q1 get p p2
q2 add p2 1
q3 get p q2
q4 add p2 2
q5 get p q4
q6 rec q1 q3 q5
r call av_append q0 q6 p3 p4
q7 at r 1
q8 at q7 0
m1_a set p p2 q8
q9 add p2 1
q10 at q7 1
m1_b set m1_a q9 q10
q11 add p2 2
q12 at q7 2
q13 set m1_b q11 q12
q14 at r 0
q15 set q13 0 q14
q16 at r 2
q17 rec q15 q16
ret q17
end
fn st_append (u32x128,io) u32 u32 u32x128 -> (u32x128,io)
p at p0 0
q0 get p 0
q1 eq q0 0
q2 select q1 1 0
q3 fold st_appendgo q2 p0 p1 p2 p3
ret q3
end
fn st_checkbyte u32 u32 u32x128 -> u32
q0 eq p0 0
q1 get p2 p1
q2 gt q1 255
q3 and q0 q2
q4 select q3 6 p0
ret q4
end
fn st_copy_ok (u32x128,io) u32 u32 u32 -> bool
p at p0 0
q0 get p 0
q1 eq q0 0
ret q1
end
fn st_copy_page (u32x128,io) u32 u32 u32 -> (u32x128,io)
p at p0 0
off mul p1 128
rest sub p3 off
q0 gt rest 128
n select q0 128 rest
q1 at p0 1
q2 get p 1
q3 add p2 off
r call arena_load q1 q2 q3 n
q4 at r 0
q5 at r 1
code fold st_checkbyte n q4 q5
q6 set p 0 code
q7 at r 2
q8 rec q6 q7
q9 at r 1
q10 call st_append q8 16 n q9
ret q10
end
fn st_map_ok (u32x128,io) u32 -> bool
p at p0 0
q0 get p 0
q1 eq q0 0
q2 get p 40
q3 get p 41
q4 lt q2 q3
q5 and q1 q4
ret q5
end
fn st_map_step (u32x128,io) u32 -> (u32x128,io)
p at p0 0
q0 at p0 1
q1 get p 22
q2 get p 23
q3 get p 24
q4 rec q1 q2 q3
q5 get p 8
q6 mul q5 4
r call av_load q0 q4 q6 4
row at r 1
q7 get row 0
q8 get row 1
endpos add q7 q8
q9 get p 40
skip le endpos q9
q10 get row 0
q11 get p 40
gap gt q10 q11
q12 at r 0
q13 eq q12 0
q14 select gap 3 0
q15 at r 0
code select q13 q14 q15
q16 get p 41
q17 lt endpos q16
q18 get p 41
endchunk select q17 endpos q18
q19 get p 40
n sub endchunk q19
z call arena_zero
q20 get p 42
q21 get p 40
q22 add q20 q21
q23 get p 43
q24 sub q22 q23
z_1 set z 0 q24
z_2 set z_1 1 n
q25 get row 2
z_3 set z_2 2 q25
q26 get row 3
q27 get p 40
q28 add q26 q27
q29 get row 0
q30 sub q28 q29
z_4 set z_3 3 q30
q set p 0 code
q31 at r 2
q32 rec q q31
q33 select skip 0 4
a call st_append q32 19 q33 z_4
q_1 at a 0
q34 get p 40
q35 select skip q34 endchunk
q_2 set q_1 40 q35
q36 eq endchunk endpos
q37 or skip q36
q38 get p 8
q39 add q38 1
q40 get p 8
q41 select q37 q39 q40
q_3 set q_2 8 q41
q42 at a 1
q43 rec q_3 q42
ret q43
end
fn st_copy_range (u32x128,io) u32 u32 -> (u32x128,io)
p at p0 0
q set p 40 p1
q_1 set q 41 p2
q0 get p 17
q_2 set q_1 42 q0
q_3 set q_2 43 p1
count sub p2 p1
q1 div count 128
q2 rem count 128
q3 eq q2 0
q4 select q3 0 1
q5 add q1 q4
q6 at p0 1
q7 rec q_3 q6
copied loop st_copy_ok st_copy_page q5 q7 p1 count
q8 get p 23
q9 div q8 4
q10 add q9 1
result loop st_map_ok st_map_step q10 copied
q_4 at result 0
q11 get q_4 0
q12 eq q11 0
q13 get q_4 40
q14 ne q13 p2
q15 and q12 q14
q16 get q_4 0
code select q15 3 q16
q17 set q_4 0 code
q18 at result 1
q19 rec q17 q18
ret q19
end
fn hs_comment_copy (u32x128,io) u32 u32 u32 -> (u32x128,io)
q0 add p2 p3
q1 call st_copy_range p0 p2 q0
ret q1
end
fn hs_comment (u32x128,io) u32 u32x128 u32 -> (u32x128,io)
q0 at p0 1
q1 get p2 38
q2 get p2 39
q3 get p2 40
q4 rec q1 q2 q3
q5 mul p3 3
r call av_load q0 q4 q5 3
q6 at p0 0
q7 at r 0
p set q6 0 q7
c at r 1
q8 get c 0
q9 get c 1
q10 add q8 q9
q11 get p 5
trim lt q10 q11
q12 get p 5
q13 get c 0
q14 select trim q12 q13
p_1 set p 5 q14
q15 select trim 1 0
q16 at r 2
q17 rec p_1 q16
q18 get c 0
q19 get c 1
q20 fold hs_comment_copy q15 q17 q18 q19
ret q20
end
fn hs_end (u32x128,io) u32 u32 -> (u32x128,io)
p at p0 0
q0 at p0 1
q1 get p 1
q2 sub p2 1
r call arena_load q0 q1 q2 1
q3 at r 0
p_1 set p 0 q3
q4 at r 1
q5 get q4 0
cr eq q5 13
q6 select cr 1 0
q7 sub p2 q6
q8 set p_1 5 q7
q9 at r 2
q10 rec q8 q9
ret q10
end
fn hs_strip_line (u32x128,io) u32 u32x128 u32x128 -> (u32x128,io)
p at p0 0
q0 get p 5
q1 get p3 1
a call st_copy_range p0 q0 q1
q2 get p3 1
q3 get p3 2
q4 add q2 q3
b call hs_end a 0 q4
q5 at b 0
q6 get q5 0
q7 eq q6 0
q8 get p3 7
q9 ne q8 4294967295
q10 and q7 q9
q11 select q10 1 0
q12 get p3 7
q13 fold hs_comment q11 b p2 q12
ret q13
end
fn hs_line_ok (u32x128,io) u32 u32x128 -> bool
q0 at p0 0
q1 get q0 0
q2 eq q1 0
ret q2
end
fn hs_line (u32x128,io) u32 u32x128 -> (u32x128,io)
q0 at p0 1
q1 get p2 32
q2 get p2 33
q3 get p2 34
q4 rec q1 q2 q3
q5 mul p1 10
r call av_load q0 q4 q5 10
q6 at p0 0
q7 at r 0
p set q6 0 q7
row at r 1
q8 get p 0
q9 eq q8 0
q10 get row 6
q11 ne q10 0
q12 and q9 q11
q13 select q12 1 0
q14 at r 2
q15 rec p q14
q16 fold hs_strip_line q13 q15 p2 row
ret q16
end
fn hs_first_fn (u32x128,u32,io) u32 u32x128 -> (u32x128,u32,io)
q0 at p0 2
q1 get p2 41
q2 get p2 42
q3 get p2 43
q4 rec q1 q2 q3
r call av_load q0 q4 0 8
q5 at p0 0
q6 at r 0
p set q5 0 q6
q7 at r 1
q8 get q7 7
q9 at r 2
q10 rec p q8 q9
ret q10
end
fn link_strip io u32 u32 u32 u32 -> (u32,(u32,u32,u32),(u32,u32,u32),io)
loaded call arena_load p0 p4 0 128
ps at loaded 1
z call arena_zero
q0 set z 1 p2
identity set q0 2 p3
q1 at loaded 2
q2 rec 0 0 0
q3 eq p2 0
q4 select q3 0 4
map call av_append q1 q2 q4 identity
q5 at loaded 0
q6 eq q5 0
q7 at map 0
q8 at loaded 0
q9 select q6 q7 q8
p set z 0 q9
p_1 set p 1 p1
p_2 set p_1 2 p2
q10 at map 1
q11 at q10 0
m0_a set p_2 22 q11
q12 at q10 1
m0_b set m0_a 23 q12
q13 at q10 2
q14 set m0_b 24 q13
q15 get ps 33
q16 div q15 10
q17 at map 2
q18 get q14 0
q19 eq q18 0
q20 get ps 42
q21 ne q20 0
q22 and q19 q21
q23 select q22 1 0
q24 rec q14 q16 q17
range fold hs_first_fn q23 q24 ps
q25 at range 1
q26 at range 0
q27 at range 2
q28 rec q26 q27
scanned loop hs_line_ok hs_line q25 q28 ps
q29 at scanned 0
q30 get q29 5
copied call st_copy_range scanned q30 p2
q at copied 0
q31 get q 0
q32 get q 16
q33 get q 17
q34 get q 18
q35 rec q32 q33 q34
q36 get q 19
q37 get q 20
q38 get q 21
q39 rec q36 q37 q38
q40 at copied 1
q41 rec q31 q35 q39 q40
ret q41
end
