end
fn sv_pre_pump(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let a=sv_eval_checked(q)
