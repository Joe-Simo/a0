raw # Ordered spec verification. Parse all source, then body/types/evaluation/publication per function.
raw # Service state holds original IR, grammar, typed contracts, and the resumable evaluator separately.
raw use "spec_types_arena.a0"
raw use "eval_arena.a0"
extern arena_zero() -> u32x128
extern av_load(io,(u32,u32,u32),u32,u32) -> (u32,u32x128,io)
extern av_append(io,(u32,u32,u32),u32,u32x128) -> (u32,(u32,u32,u32),io)
extern ac_zeros((u32x128,io),u32,u32) -> (u32x128,io)
extern ac_function_body((u32x128,io),u32) -> (u32x128,io)
extern ac_publish_function((u32x128,io),u32) -> (u32x128,io)
extern arena_spec_types(io,u32x128,u32) -> (u32,u32x128,u32x128,io)
extern arena_parse(io,u32,u32) -> (u32,u32x128,io)
extern ae_empty(u32x128,io,u32,u32,bool,u32,u32) -> (u32x128,u32x128,io)
extern ae_contract_view((u32x128,u32x128,io),u32,u32x128,(u32,u32,u32),(u32,u32,u32),u32,u32) -> (u32x128,u32x128,io)
extern ae_run_begin((u32x128,u32x128,io),u32,(u32,u32,u32)) -> (u32x128,u32x128,io)
extern ae_equal_request((u32x128,u32x128,io),u32,u32,u32,u32) -> (u32x128,u32x128,io)
extern ae_pump((u32x128,u32x128,io),u32) -> (u32x128,u32x128,io)
def sv_vec(p:u32x128,o:u32) -> (u32,u32,u32)
 return (p[o],p[o+1],p[o+2])
end
def sv_setvec(p:u32x128,o:u32,v:(u32,u32,u32)) -> u32x128
 let a=set(p,o,v#0)
 let b=set(a,o+1,v#1)
 return set(b,o+2,v#2)
end
def sv_ae(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),a:(u32x128,u32x128,io)) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 return (q#0,q#1,q#2,q#3,a#0,a#1,a#2)
end
def sv_a(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)) -> (u32x128,u32x128,io)
 return (q#4,q#5,q#6)
end
def sv_io(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),t:io) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 return (q#0,q#1,q#2,q#3,q#4,q#5,t)
end
fn sv_phase(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),phase:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=set(q#0,1,phase)
 return (v,q#1,q#2,q#3,q#4,q#5,q#6)
end
fn sv_runtime(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),code:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let active=(v[0]==0)&(code!=0)
 let v=set(v,0,active?code:v[0])
 let v=set(v,1,active?11:v[1])
 let m=set(q#1,0,active?code:get(q#1,0))
 return (v,m,q#2,q#3,q#4,q#5,q#6)
end
fn sv_appendgo(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32,off:u32,n:u32,page:u32x128) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let r=av_append(q#6,sv_vec(q#0,off),n,page)
 let v=sv_setvec(q#0,off,r#1)
 return sv_runtime((v,q#1,q#2,q#3,q#4,q#5,r#2),r#0)
end
fn sv_append(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),off:u32,n:u32,page:u32x128) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 return fold(sv_appendgo,v[0]==0?1:0,q,off,n,page)
end
fn sv_semantic(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),id:u32,kind:u32,phase:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let active=(v[0]==0)&(id!=0)
 let v=set(v,0,active?8:v[0])
 let v=set(v,1,active?11:v[1])
 let v=set(v,13,active?get(q#4,1):v[13])
 let v=set(v,14,active?kind:v[14])
 let v=set(v,20,active?id:v[20])
 let v=set(v,21,active?(id==719?1:phase):v[21])
 let v=set(v,23,active?((id==719)&(phase!=1)?0:1):v[23])
 let m=set(q#1,0,active?8:get(q#1,0))
 let m=set(m,1,active?id:m[1])
 let m=set(m,2,active?0:m[2])
 let m=set(m,3,active?0:m[3])
 let m=set(m,4,active?0:m[4])
 let m=set(m,5,active?kind:m[5])
 return (v,m,q#2,q#3,q#4,q#5,q#6)
end
fn sv_body(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let r=ac_function_body((q#1,q#6),v[2])
 let a=sv_runtime((v,r#0,q#2,q#3,q#4,q#5,r#1),get(r#0,0))
 let v=a#0
 return sv_phase(a,v[0]==0?1:v[1])
end
fn sv_types(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let r=arena_spec_types(q#6,q#1,v[2])
 let f=av_load(r#3,sv_vec(r#1,41),v[2]*14,4)
 let a=sv_runtime((v,r#1,q#2,r#2,q#4,q#5,f#2),r#0==0?f#0:r#0)
 let row=f#1
 let v=a#0
 let b=a#3
 let v=set(v,10,4294967295)
 let v=set(v,11,4294967295)
 let v=set(v,3,0)
 let v=set(v,15,row[0])
 let v=set(v,19,row[3])
 let v=set(v,31,row[2])
 let v=set(v,16,get(a#1,8))
 let v=sv_setvec(v,38,(0,0,0))
 let v=sv_setvec(v,41,(0,0,0))
 let phase=b[33]==0?10:2
 return sv_phase((v,a#1,a#2,b,a#4,a#5,a#6),v[0]==0?phase:v[1])
end
fn sv_import_start(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let p=q#2
 let b=q#3
 let r=av_load(q#6,sv_vec(p,62),b[112]*5,5)
 let dir=r#1
 let last=av_load(r#2,sv_vec(p,41),(dir[1]+dir[2]-1)*8,8)
 let ex=last#1
 let a=sv_runtime(sv_io(q,last#2),r#0==0?last#0:r#0)
 let v=set(a#0,4,dir[2])
 let v=set(v,5,dir[1])
 let e=ae_empty(a#1,a#6,0,1086556160,false,0,0)
 let m=sv_setvec(e#0,50,(p[32],(ex[4]+1)*6,p[34]))
 let m=sv_setvec(m,53,sv_vec(p,35))
 let m=sv_setvec(m,56,sv_vec(v,32))
 let m=set(m,16,v[33]/2)
 let m=set(m,12,3)
 return sv_phase((v,a#1,p,a#3,m,e#1,e#2),v[0]==0?3:v[1])
end
fn sv_pump(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let a=ae_pump(sv_a(q),256)
 return sv_runtime(sv_ae(q,a),get(a#0,0)==9?0:get(a#0,0))
end
fn sv_import_pump(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let a=sv_pump(q)
 let v=sv_setvec(a#0,32,sv_vec(a#4,56))
 let m=a#4
 let a=sv_runtime((v,a#1,a#2,a#3,m,a#5,a#6),m[0]==9?3:0)
 let v=a#0
 return sv_phase(a,(v[0]==0)&(m[12]==0)?4:v[1])
end
fn sv_copy_more(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32,source:(u32,u32,u32),first:u32,n:u32,off:u32) -> bool
 let v=q#0
 return v[0]==0
end
fn sv_copy_step(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32,source:(u32,u32,u32),first:u32,n:u32,off:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let at=i*128
 let count=n-at>128?128:n-at
 let r=av_load(q#6,source,first+at,count)
 let a=sv_runtime(sv_io(q,r#2),r#0)
 return sv_append(a,off,count,r#1)
end
fn sv_copy(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),source:(u32,u32,u32),first:u32,n:u32,off:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 return loop(sv_copy_more,sv_copy_step,n/128+(n%128==0?0:1),q,source,first,n,off)
end
fn sv_overlay_more(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> bool
 let v=q#0
 return v[0]==0
end
fn sv_overlay(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let b=q#3
 let r=av_load(q#6,sv_vec(b,50),i*12,12)
 let c=r#1
 let n=av_load(r#2,sv_vec(b,47),c[5]*14,14)
 let node=n#1
 let p=q#2
 let sr=av_load(n#2,sv_vec(p,44),c[2]*7,7)
 let syntax=sr#1
 let code=r#0==0?(n#0==0?sr#0:n#0):r#0
 let a=sv_runtime(sv_io(q,sr#2),code)
 let v=set(a#0,45,0)
 let v=set(v,48,0)
 let v=set(v,c[1]==2?26:27,syntax[2])
 let v=set(v,c[1]==2?28:29,c[2])
 let a=sv_copy((v,a#1,a#2,b,a#4,a#5,a#6),sv_vec(b,41),node[2]*5,node[3]*5,44)
 let a=sv_copy(a,sv_vec(b,44),c[3],c[4],47)
 let e=ae_empty(a#1,a#6,0,1086556160,false,0,0)
 let e=ae_contract_view(e,get(a#0,2),node,sv_vec(a#0,44),sv_vec(a#0,47),c[7],c[8])
 let a=sv_runtime(sv_ae(a,e),get(e#0,0)==9?3:get(e#0,0))
 let v=set(a#0,c[1]==2?10:11,get(e#0,17))
 return sv_append((v,a#1,a#2,a#3,a#4,a#5,a#6),c[1]==2?38:41,128,e#1)
end
fn sv_overlays(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let r=loop(sv_overlay_more,sv_overlay,get(q#3,51)/12,q)
 let v=r#0
 return sv_phase(r,v[0]==0?5:v[1])
end
fn sv_example_arg_more(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32,example:u32x128) -> bool
 return get(q#0,0)==0
end
fn sv_example_arg(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32,example:u32x128) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let root=av_load(q#6,sv_vec(q#2,38),example[2]+i,1)
 let id=get(root#1,0)
 let value=av_load(root#2,sv_vec(q#0,32),id*2,2)
 let a=sv_runtime(sv_io(q,value#2),root#0==0?value#0:root#0)
 return sv_append(a,35,2,value#1)
end
fn sv_runstartgo(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32,phase:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let ir=av_load(q#6,sv_vec(v,phase==2?38:41),0,phase==1?0:128)
 let a=sv_runtime(sv_io(q,ir#2),ir#0)
 let e=ae_empty(phase==1?a#1:ir#1,a#6,0,1086556160,false,0,0)
 let callfn=phase==1?v[2]:(phase==2?v[10]:v[11])
 let e=ae_run_begin(e,callfn,sv_vec(v,35))
 let v=set(a#0,12,phase)
 return sv_phase((v,a#1,a#2,a#3,e#0,e#1,e#2),v[0]==0?(phase==1?7:(phase==2?6:9)):v[1])
end
fn sv_runstart(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),phase:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 return fold(sv_runstartgo,get(q#0,0)==0?1:0,q,phase)
end
fn sv_example_start(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let r=av_load(q#6,sv_vec(q#2,41),(v[5]+v[3])*8,8)
 let ex=r#1
 let expected=av_load(r#2,sv_vec(v,32),ex[4]*2,2)
 let a=sv_runtime(sv_io(q,expected#2),r#0==0?expected#0:r#0)
 let v=set(a#0,36,0)
 let v=set(v,6,ex[4])
 let v=set(v,9,ex[3])
 let v=set(v,17,get(expected#1,0))
 let v=set(v,18,get(expected#1,1))
 let v=set(v,22,ex[5])
 let v=set(v,24,ex[6])
 let v=set(v,25,ex[7])
 let a=loop(sv_example_arg_more,sv_example_arg,ex[3],(v,a#1,a#2,a#3,a#4,a#5,a#6),ex)
 return sv_runstart(a,v[10]==4294967295?1:2)
end
fn sv_eval_fault(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let m=q#4
 let fuel=m[1]==701
 let id=fuel?719:(v[12]==1?715:716)
 return sv_semantic(q,id,fuel?4:2,v[12])
end
fn sv_eval_checked(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let a=sv_pump(q)
 let v=a#0
 let e=a#4
 return fold(sv_eval_fault,(v[0]==0)&(e[0]==9)?1:0,a)
end
fn sv_pre_finished(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let e=q#4
 let held=(e[9]==1)&(e[10]==1)
 let a=sv_semantic(q,held?0:716,1,2)
