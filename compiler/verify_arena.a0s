fn sv_equal_finished(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let equal=get(q#4,21)!=0
 let a=sv_semantic(q,equal?0:715,3,1)
 let v=a#0
 let post=(v[0]==0)&(v[11]!=4294967295)
 let a=fold(sv_post_start,post?1:0,a)
 return fold(sv_advance_example,((v[0]==0)&!post)?1:0,a)
end
fn sv_equal_pump(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
