end
fn sv_post_finished(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let e=q#4
 let held=(e[9]==1)&(e[10]==1)
