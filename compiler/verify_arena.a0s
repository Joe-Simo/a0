 return fold(sv_post_finished,(get(a#0,0)==0)&(e[12]==0)?1:0,a)
end
fn sv_publish(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let r=ac_publish_function((q#1,q#6),v[2])
 let a=sv_runtime((v,r#0,q#2,q#3,q#4,q#5,r#1),get(r#0,0))
 let v=set(a#0,2,v[2]+1)
 return sv_phase((v,a#1,a#2,a#3,a#4,a#5,a#6),v[0]==0?(v[2]>=get(a#1,42)/14?11:0):v[1])
end
fn sv_step(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let v=q#0
 let phase=v[0]==0?v[1]:11
 let a=fold(sv_body,phase==0?1:0,q)
 let a=fold(sv_types,phase==1?1:0,a)
 let a=fold(sv_import_start,phase==2?1:0,a)
 let a=fold(sv_import_pump,phase==3?1:0,a)
 let a=fold(sv_overlays,phase==4?1:0,a)
 let a=fold(sv_example_start,phase==5?1:0,a)
 let a=fold(sv_pre_pump,phase==6?1:0,a)
 let a=fold(sv_body_pump,phase==7?1:0,a)
 let a=fold(sv_equal_pump,phase==8?1:0,a)
 let a=fold(sv_post_pump,phase==9?1:0,a)
 return fold(sv_publish,phase==10?1:0,a)
end
fn sv_more(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> bool
 let v=q#0
 return (v[0]==0)&(v[1]!=11)
end
fn arena_verify_status(v:u32x128) -> u32
 return v[0]!=0?v[0]:(v[1]==11?0:7)
end
fn arena_verify_resume(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),quantum:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 return loop(sv_more,sv_step,quantum,q)
end
fn sv_init(q:(u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io),i:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let m=set(q#1,0,0)
 let m=set(m,96,1)
 let m=sv_setvec(m,84,(0,0,0))
 let m=sv_setvec(m,97,(0,0,0))
 let m=sv_setvec(m,100,(0,0,0))
 let m=sv_setvec(m,103,(0,0,0))
 let m=sv_setvec(m,106,(0,0,0))
 let m=sv_setvec(m,115,(0,0,0))
 let m=sv_setvec(m,118,(0,0,0))
 let m=sv_setvec(m,121,(0,0,0))
 let m=sv_setvec(m,124,(0,0,0))
 let a=ac_zeros((m,q#6),118,m[67])
 let b=ac_zeros(a,121,m[67])
 let a=sv_runtime((q#0,b#0,q#2,q#3,q#4,q#5,b#1),get(b#0,0))
 let v=a#0
 return sv_phase(a,(get(a#1,42)==0)|(v[0]!=0)?11:0)
end
fn arena_verify_begin(t:io,parsed:u32x128) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let z=arena_zero()
 let v=set(z,30,1)
 let v=set(v,1,11)
 let present=parsed[60]==128
 let r=av_load(t,sv_vec(parsed,59),0,present?128:0)
 let p=r#1
 let complete=(parsed[0]==0)|((parsed[0]==7)&present&(p[92]==1)&(p[0]==0))
 let code=complete?(parsed[93]==1?r#0:3):parsed[0]
 let v=set(v,0,code)
 let q=(v,parsed,p,z,z,z,r#2)
 return fold(sv_init,complete&(code==0)?1:0,q)
end
fn arena_parse_verify_begin(t:io,source:u32,length:u32) -> (u32x128,u32x128,u32x128,u32x128,u32x128,u32x128,io)
 let p=arena_parse(t,source,length)
 return arena_verify_begin(p#2,p#1)
end
