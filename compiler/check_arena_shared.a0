# Validate a symbol with the same word classifier used by source grammar.
# p2 selects function-name flag0 or node-identifier flag1; p3 is the checker diagnostic.
fn ac_name_scan (u32x128,io) u32 u32x128 u32 u32 -> (u32x128,io)
