# the bodies, given the functions (p0), the name map (p1) and the error so far (p7 p8); the
# operand table holds the 16384 operands from p9 on (a body's operands are written by two
# runs, from 0 and from 16384: `bodyargs`)
fn pass5 u32x128x45 u32x128x64 u32x512x64 u32x128x384 u32x128x128 u32x128x128 u32 u32 u32 u32 -> (u32x128x45,u32x128x128,u32x128x256,u32x128x64,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,bool)
