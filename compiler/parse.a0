# header p1: its fns entry and its name in the name map ((fn+1)<<12 | node+1); a name
# already defined is an error at its token. state (fns names err errtok)
fn p4hdr (u32x128x45,u32x128x64,u32,u32) u32 u32x128x33 u32 -> (u32x128x45,u32x128x64,u32,u32)
