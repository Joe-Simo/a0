ok eq p5 0
n select ok p4 0
s fold p3chunk n s0 p0 p1 p2 p3
mode at s 10
err at s 11
open ne mode 0
e0 eq err 0
eof and e0 open
err2 select eof 1 err
et at s 12
et2 select eof p7 et
s1 put s 11 err2
s2 put s1 12 et2
ret s2
end
