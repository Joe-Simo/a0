# --- pass 5: bodies --------------------------------------------------------------------
# The tokens are taken in segments that end at a page end or at a string: the nodes and args
# of a segment go to small windows over the tables (5 and 3 pages) that are copied back after
# it, and a text literal's bytes, which have no bound, are decoded into args between segments.
# byte p1 of a text literal segment: state (two-page args window, fill, esc); the pair (3 v)
# is written at the fill (words past it are unused) and kept unless the byte is a backslash
fn txtb (u32x128x2,u32,u32) u32 u32x128 u32x128 u32 -> (u32x128x2,u32,u32)
w at p0 0
f at p0 1
esc at p0 2
q add p4 p1
qh shr q 7
ql and q 127
isl eq qh 0
cl get p2 ql
ch get p3 ql
c select isl cl ch
isbs eq c 92
e1 eq esc 1
isn eq c 110
ist eq c 116
m0 select isn 10 c
m1 select ist 9 m0
v select e1 m1 c
skip select e1 false isbs
h0 shr f 7
l0 and f 127
g0 get w h0
g0b set g0 l0 3
w1 set w h0 g0b
f1 add f 1
h1 shr f1 7
l1 and f1 127
g1 get w1 h1
g1b set g1 l1 v
w2 set w1 h1 g1b
f2 add f 2
fn1 select skip f f2
esc1 select isbs 1 0
esc2 select e1 0 esc1
r rec w2 fn1 esc2
ret r
end
# 64-byte segment p1 of the text literal at p3 of length p4: state (args nargs esc)
fn txtseg (u32x128x256,u32,u32) u32 u32x128x128 u32 u32 -> (u32x128x256,u32,u32)
args at p0 0
