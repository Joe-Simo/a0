ret r
end
# p0 hout, p1 named headers, p2 complete ones: (fns names duperr duptok)
fn pass4 u32x128x33 u32 u32 -> (u32x128x45,u32x128x64,u32,u32)
z45 call z45
z64 call z64
s0 rec z45 z64 0 0
s fold p4hdr p1 s0 p0 p2
ret s
