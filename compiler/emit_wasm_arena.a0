q8 get m 60
q9 at r 1
q10 at q9 0
m1_a set m q8 q10
q11 add q8 1
q12 at q9 1
m1_b set m1_a q11 q12
q13 add q8 2
q14 at q9 2
q15 set m1_b q13 q14
q16 at p0 1
q17 at p0 2
q18 at p0 3
