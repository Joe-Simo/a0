fn bc_bound_nodes (u32,(u32,u32,u32),io) u32 u32x16 u32 u32 u32 -> (u32,(u32,u32,u32),io)
x1 fold bc_bound_node 1 p0 p2 p3 p1 p5
ret x1
end


fn bc_bound_level (u32,(u32,u32,u32),io) u32 u32x16 u32 u32 -> (u32,(u32,u32,u32),io)
x1 get p2 13
x2 add p1 1
x3 fold bc_bound_nodes x1 p0 p2 p3 p4 x2
ret x3
end


fn bc_bound_init (u32,(u32,u32,u32),io) u32 u32x16 u32 u32 -> (u32,(u32,u32,u32),io)
