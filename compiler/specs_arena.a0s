raw # Standalone specification phase using the shared source grammar.
raw use "source_grammar.a0"
extern arena_zero() -> u32x128
extern sp_sy(u32x128,u32) -> ((u32,u32,u32),u32,u32,u32)
extern sp_setsy(u32x128,u32,((u32,u32,u32),u32,u32,u32)) -> u32x128
extern sp_raw((u32x128,u32x128,io),u32,u32x128) -> (u32x128,u32x128,io)
extern sp_finishfunction((u32x128,u32x128,io),u32) -> (u32x128,u32x128,io)

fn sp_rawok(s:(u32x128,u32x128,io),i:u32,parser:u32x128) -> bool
 let p=s#0
 return p[0]==0
end
fn arena_specs(t:io,parser:u32x128) -> (u32,u32x128,io)
 let z=arena_zero()
 let q=set(z,0,((parser[0]==0)|(parser[0]==7))?0:parser[0])
 let q=set(q,6,parser[6])
 let q=set(q,24,4294967295)
 let q=sp_setsy(q,80,sp_sy(parser,62))
 let q=set(q,92,1)
 let r=loop(sp_rawok,sp_raw,parser[57]/6,(q,z,t),parser)
 let p=r#0
 let out=fold(sp_finishfunction,(p[0]==0)&(p[24]!=4294967295)?1:0,r)
 let a=out#0
 return (a[0],a,out#2)
end
