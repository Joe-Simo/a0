pg2 set pg o v
h31 mul h 31
h2 add h31 v
s rec pg2 t h2
ret s
end
# page p4 + p1 of the words [p2, p3) of the table
fn wkrdpg (u32x128x500,io,u32) u32 u32 u32 u32 -> (u32x128x500,io,u32)
tb at p0 0
tk at p0 1
h at p0 2
pi add p4 p1
pb mul pi 128
s call umax p2 pb
e add pb 128
hi call cumin p3 e
cnt sub hi s
off sub s pb
pg get tb pi
s0 rec pg tk h
x fold wkrdw cnt s0 off
