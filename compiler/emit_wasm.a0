fn wxpsz u32 u32 u32x128x512 u32x128x132 u32 -> u32
i add p4 p1
a add 3392 i
g_gp shr a 7
g_gw and a 127
g_gg get p2 g_gp
g get g_gg g_gw
na call wxnw p3 g 2
n add na 1
r add p0 n
ret r
end
# one variant's META (parameters, result, locals, v128 locals, 0, the markers, 0, bytes): p1 the
# machine table, p2 its code table, p3 whether it is the value variant of an aggregate-free function
fn wxmv io u32x128x512 u32x128x512 bool -> io
nw_gp shr 65533 7
nw_gw and 65533 127
nw_gg get p2 nw_gp
nw get nw_gg nw_gw
nl_gp shr 65534 7
nl_gw and 65534 127
nl_gg get p2 nl_gp
nl get nl_gg nl_gw
nv_gp shr 65535 7
nv_gw and 65535 127
nv_gg get p2 nv_gp
nv get nv_gg nv_gw
np_fa mul 0 128
np_fb add np_fa 128
np_fc add np_fb 4
np_fp shr np_fc 7
np_fw and np_fc 127
np_fg get p1 np_fp
np get np_fg np_fw
pb_gp shr 10 7
pb_gw and 10 127
pb_gg get p1 pb_gp
pb get pb_gg pb_gw
pc add pb np
res select p3 1 0
mk fold wxcm nw 0 p2
nb sub nw mk
a write p0 pc
b write a res
c write b nl
d write c nv
e write d 0
f fold wxwm nw e p2
g write f 0
h write g nb
ret h
end
# the META of a variant that is not a value variant with a scalar result (a fold trip of 1)
fn wxmvf io u32 u32x128x512 u32x128x512 -> io
r call wxmv p0 p2 p3 false
ret r
end
# name byte p3 + p1 of the name pool p2
fn wxnmb io u32 u32x128x400 u32 -> io
i add p3 p1
pg shr i 7
g get p2 pg
w and i 127
v get g w
r write p0 v
ret r
end
# call table word p2 := p3 (u32x128x16: index and stack depth per function, words 2f and 2f + 1)
fn wxdts u32x128x16 u32 u32 u32 -> u32x128x16
pi shr p2 7
wi and p2 127
pg get p0 pi
pg2 set pg wi p3
r set p0 pi pg2
ret r
end
# miss entry p1 of machine table p2 appended to the chunk's list (count, table)
fn wxmg (u32,u32x128x8) u32 u32x128x512 -> (u32,u32x128x8)
n at p0 0
t at p0 1
a add 32 p1
e_gp shr a 7
e_gw and a 127
e_gg get p2 e_gp
e get e_gg e_gw
pi shr n 7
wi and n 127
pg get t pi
pg2 set pg wi e
t2 set t pi pg2
n1 add n 1
r rec n1 t2
ret r
end
# function p0 + p1 of the chunk (first function p2): the record of its variants (see above)
# state (io, variants so far, call table, misses, miss list, error)
fn wxfun (io,u32,u32x128x16,u32,u32x128x8,u32) u32 u32 u32 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x200 u32x128x400 u32x128x16 -> (io,u32,u32x128x16,u32,u32x128x8,u32)
io at p0 0
nvar at p0 1
dt at p0 2
nm at p0 3
ml at p0 4
er at p0 5
f add p2 p1
own call waown p5 p10 p9 f
ownu select own 1 0
