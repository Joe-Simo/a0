# --- module writers (state (io,u32,u32,u32); field 2 is a running variant index where one is needed)
fn wkcusb (io,u32,u32,u32) u32 u32x128 bool -> (io,u32,u32,u32)
a get p2 p1
b call wab p0 a p3
ret b
end
# the custom section's payload: name "a0", the version bytes
fn wkcus (io,u32,u32,u32) u32x128 u32 bool -> (io,u32,u32,u32)
a call wab3 p0 2 97 48 p3
b fold wkcusb p2 a p1 p3
ret b
end
fn wktyadd (u32x256,u32x256,u32) u32 -> (u32x256,u32x256,u32)
a at p0 0
b at p0 1
c at p0 2
d get a p1
e eq d 0
f add c 1
g select e f d
h set a p1 g
i select e c 255
j set b i p1
k select e f c
l rec h j k
ret l
end
# the signatures of the io helpers (keys 2 params + result: 3, 4, 6)
fn wktyh (u32x256,u32x256,u32) u32 -> (u32x256,u32x256,u32)
a call wktyadd p0 3
b call wktyadd a 4
c call wktyadd b 6
ret c
end
fn wkkey u32x128x256 u32 -> u32
a mul p1 8
b shr a 7
c get p0 b
d and a 127
e get c d
f and e 65535
g shr e 16
h mul f 2
i add h g
ret i
end
fn wktyv (u32x256,u32x256,u32) u32 u32x128x256 -> (u32x256,u32x256,u32)
a call wkkey p2 p1
b call wktyadd p0 a
ret b
end
fn wab7f (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
a call wab p0 127 p2
ret a
end
fn wktyone (io,u32,u32,u32) u32 u32x256 bool -> (io,u32,u32,u32)
a get p2 p1
b shr a 1
c and a 1
d call wab p0 96 p3
e call waul d b p3
f fold wab7f b e p3
g eq c 1
h select g 1 0
i select g 0 1
j fold wab2st h f 1 127 p3
k fold wabst i j 0 p3
ret k
end
fn wktypes (io,u32,u32,u32) u32x256 u32 bool -> (io,u32,u32,u32)
a call waul p0 p2 p3
b fold wktyone p2 a p1 p3
ret b
end
fn wkfnone (io,u32,u32,u32) u32 u32x128x256 u32x256 bool -> (io,u32,u32,u32)
a call wkkey p2 p1
b get p3 a
c sub b 1
d call waul p0 c p4
ret d
end
fn wkfnh (io,u32,u32,u32) u32 u32x256 bool -> (io,u32,u32,u32)
a get p2 3
b sub a 1
c get p2 4
d sub c 1
e get p2 6
f sub e 1
g call waul p0 b p3
h call waul g d p3
i call waul h f p3
ret i
end
fn wkfuncs (io,u32,u32,u32) u32x128x256 u32 u32x256 bool bool -> (io,u32,u32,u32)
a select p4 3 0
b select p4 1 0
c add a p2
d call waul p0 c p5
e fold wkfnh b d p3 p5
f fold wkfnone p2 e p1 p3 p5
ret f
end
fn wklnb (io,u32,u32,u32) u32 u32x128x64 u32 bool -> (io,u32,u32,u32)
