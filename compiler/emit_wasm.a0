k_gw and ad 127
k_gg get p0 k_gp
k get k_gg k_gw
ad1 add ad 1
x_gp shr ad1 7
x_gw and ad1 127
x_gg get p0 x_gp
x get x_gg x_gw
ad2 add ad 2
y_gp shr ad2 7
y_gw and ad2 127
y_gg get p0 y_gp
y get y_gg y_gw
ad3 add ad 3
z_gp shr ad3 7
z_gw and ad3 127
z_gg get p0 z_gp
z get z_gg z_gw
