b1 add b0 24
kd call wxcg p0 p2 b1
b2 add b1 2
lit call wxcg p0 p2 b2
bl call wxcg p0 p2 34
ck call wxcg p0 p2 18
cv call wxcg p0 p2 19
k0 eq kd 0
k1 eq kd 1
k2 eq kd 2
cn1_m1 select k0 1 0
m1 fold wxpsh cn1_m1 p0 p2 ck cv
cn2_m2 select k1 1 0
m2 fold wxkc cn2_m2 m1 lit
cn3_m3 select k2 1 0
m3 fold wxlg cn3_m3 m2 bl
ret m3
end
# the loop of frame p2 starts phase p3 (`counted`): a block when it can be left (a guard on the
# counter, or a predicate), the guard, the loop; the first trip follows
fn wxlst u32x128x512 u32 u32 u32 -> u32x128x512
b0 mul p3 5
b1 add b0 24
b2 add b1 1
b3 add b1 2
b4 add b1 3
lf call wxcg p0 p2 b2
lit call wxcg p0 p2 b3
from call wxcg p0 p2 b4
pr call wxcg p0 p2 6
ic call wxcg p0 p2 1
g1 ne lf 0
g2 gt lit from
g3 and g1 g2
guard select g3 false true
pq ne pr 0
exit or guard pq
cn1_m1 select exit 1 0
m1 fold wxe cn1_m1 p0 14 64
cn2_m2 select guard 1 0
m2 fold wxlg cn2_m2 m1 ic
cn3_m3 select guard 1 0
m3 fold wxlim cn3_m3 m2 p2 p3
cn4_m4 select guard 1 0
m4 fold wxop cn4_m4 m3 79
cn5_m5 select guard 1 0
m5 fold wxe cn5_m5 m4 12 0
m6 fold wxe 1 m5 8 0
m7 fold wxcs 1 m6 p2 22 0
m8 fold wxpu 1 m7 9 p2 0 0
