b eq p0 1
c eq p0 2
d eq p1 1
e and c d
f call wxrun p0 p1 p2 p3 p4
g or a b
h or g e
r or h f
ret r
end
# the operand is of type u32: a node (node types p2, first node p3), a parameter (tlist p4, first
# parameter type p5), a u32 literal
