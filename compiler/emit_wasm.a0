i2 eq v1 p3
init and i1 i2
rt call wxrg p0 p2 user 3
ali ne rt 0
oa add 8448 ug
ov call wxsh p6 oa
over ne ov 0
t1 eq tot 1
nr select isret false true
c1 and t1 nr
c2 and c1 init
c3 and c2 ali
c4 and c3 over
d select c4 1 0
r fold wxs 1 p0 27 d
ret r
end
