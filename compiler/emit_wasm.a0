# ---------------------------------------------------------------------------------------------
# Readers of the checked tables (the layout of compiler/emit_c.a0 / tools/selfhost-wasm.ts):
# the nodes table has 6 words a node (0, op, operand count, first operand, callee, predicate),
# the operand table (u32x128x512) holds (kind, value) pairs (kind 1 node, 2 parameter, 3 u32
# literal, 4 bool literal), the fns table 7 words a function (0 opaque if no body, parameter
# count, first parameter type in tlist, result type, first node, node count, packed ret word).
# Types are triples (tag 1 u32, 2 bool, 3 io, 4 array (length, element), 5 record (first field
# in tlist, count)) and `info` holds bytes | contains-io << 31 per type.

# word p2 of node p1
fn wxnw u32x128x128 u32 u32 -> u32
b mul p1 6
i add b p2
pg shr i 7
w and i 127
g get p0 pg
v get g w
ret v
end
# kind / value of operand pair p1
fn wxok u32x128x512 u32 -> u32
x mul p1 2
pg shr x 7
w and x 127
g get p0 pg
v get g w
ret v
end
fn wxov u32x128x512 u32 -> u32
x mul p1 2
y add x 1
pg shr y 7
w and y 127
g get p0 pg
v get g w
ret v
end
# word p2 of function p1
fn wxfw u32x128x45 u32 u32 -> u32
b mul p1 7
r call cfw p0 b p2
ret r
end
# word p2 of type p1 (tag, a, b)
fn wxty u32x384x65 u32 u32 -> u32
r call wat p0 p1 p2
ret r
end
# the tag of type p1
fn wxtag u32x384x65 u32 -> u32
r call wat p0 p1 0
ret r
end
# the byte size of type p1
fn wxbyt u32x128x65 u32 -> u32
w call wa65 p0 p1
r and w 2147483647
ret r
end
# does type p1 contain io
fn wxio u32x128x65 u32 -> u32
w call wa65 p0 p1
r shr w 31
ret r
end
# word p1 of the shape table
fn wxsh u32x128x200 u32 -> u32
pg shr p1 7
w and p1 127
g get p0 pg
v get g w
ret v
end
# log2 of a power of two (the number of shifts down to 1)
fn wxl2s u32 u32 u32 -> u32
k add p1 1
s shr p2 k
nz ne s 0
a select nz 1 0
r add p0 a
ret r
end
fn wxlog2 u32 -> u32
r fold wxl2s 31 0 p0
ret r
end
# is p0 a power of two (including 1)
fn wxpow2 u32 -> bool
m sub p0 1
a and p0 m
r eq a 0
ret r
end
# the type of operand (kind p1, value p2) of the function with first parameter type p5 in tlist
# and nodes starting at p6: a node's type (nty), a parameter's, a literal's
fn wxopty u32 u32 u32x128x24 u32x128x65 u32 u32 -> u32
isn eq p0 1
isp eq p0 2
isb eq p0 4
g add p5 p1
nt call wa24 p2 g
pi add p4 p1
pt call wa65 p3 pi
bt select isb 1 0
a select isp pt bt
r select isn nt a
ret r
end
# ---------------------------------------------------------------------------------------------
# Operands in a frame (src/wasm.ts `#constOf`, `#paramSource`, `localOf`, `push`). A fold of one
# trip (M, trip, frame d, kind, value) leaves in register 16 whether the operand is a known
# constant (1: a literal, a folded node, or a parameter bound to a literal by the host) and in
# 17 its value, or (16 = 0) the local that holds it: a node's own (or its alias root's), a
# parameter's (the host's local for it in an inlined frame, else first parameter + index).
fn wxres u32x128x512 u32 u32 u32 u32 -> u32x128x512
isn eq p3 1
isp eq p3 2
l3 eq p3 3
l4 eq p3 4
lit or l3 l4
j select isn p4 0
fl call wxrg p0 p2 j 2
hc and fl 1
hcb ne hc 0
cv call wxrg p0 p2 j 1
rt call wxrg p0 p2 j 3
rk shr rt 28
rv and rt 268435455
rp eq rk 2
rpn and isn rp
anypar or rpn isp
pi0 select isp p4 rv
pidx select anypar pi0 0
x2 mul pidx 2
sk0 add x2 32
sk call wxfg p0 p2 sk0
sv0 add x2 33
sv call wxfg p0 p2 sv0
hh gt p2 0
hs and hh anypar
issv eq sk 1
srcv and hs issv
rz eq rt 0
rnode select rz j rv
nl call wxrg p0 p2 rnode 0
pb call wxg p0 10
pl add pb pidx
plocal select hh sv pl
loc select anypar plocal nl
cb and isn hcb
c1 or lit cb
isc or c1 srcv
v1 select cb cv sv
v2 select lit p4 v1
val select isc v2 loc
isc1 select isc 1 0
m1 fold wxs 1 p0 16 isc1
m2 fold wxs 1 m1 17 val
ret m2
end
# emit the push of a resolved operand (constant flag p2, value or local p3)
fn wxpr u32x128x512 u32 u32 u32 -> u32x128x512
c ne p2 0
k select c 2 3
r fold wxe 1 p0 k p3
ret r
end
# push operand (kind p3, value p4) of frame p2
fn wxpsh u32x128x512 u32 u32 u32 u32 -> u32x128x512
m1 fold wxres 1 p0 p2 p3 p4
c call wxg m1 16
v call wxg m1 17
r fold wxpr 1 m1 c v
ret r
end
# the node's local, bound to a fresh local now, and `local.set` of it (src/wasm.ts `set`):
# (M, trip, frame, node); the local is left in register 16
fn wxset u32x128x512 u32 u32 u32 -> u32x128x512
m1 fold wxnl 1 p0
l call wxg m1 16
m2 fold wxrs 1 m1 p2 p3 0 l
m3 fold wxe 1 m2 4 l
ret m3
end
# a node's local bound to p4 (frame p2, node p3)
fn wxbind u32x128x512 u32 u32 u32 u32 -> u32x128x512
r fold wxrs 1 p0 p2 p3 0 p4
ret r
end
# i32.const p2
fn wxkc u32x128x512 u32 u32 -> u32x128x512
r fold wxe 1 p0 2 p2
ret r
end
# local.get p2 / local.set p2
fn wxlg u32x128x512 u32 u32 -> u32x128x512
r fold wxe 1 p0 3 p2
ret r
end
fn wxls u32x128x512 u32 u32 -> u32x128x512
r fold wxe 1 p0 4 p2
ret r
end
# a byte opcode
fn wxop u32x128x512 u32 u32 -> u32x128x512
r fold wxe 1 p0 1 p2
ret r
end
# memory.copy of p2 bytes (destination and source already pushed)
fn wxcp u32x128x512 u32 u32 -> u32x128x512
m1 fold wxe 1 p0 2 p2
m2 fold wxe 1 m1 16 0
ret m2
end
# i32.load / i32.store at offset p2
fn wxld u32x128x512 u32 u32 -> u32x128x512
r fold wxe 1 p0 10 p2
ret r
end
fn wxst u32x128x512 u32 u32 -> u32x128x512
r fold wxe 1 p0 11 p2
ret r
end
# `i32.const p2; i32.add` (a non-zero static offset on an address)
fn wxadd u32x128x512 u32 u32 -> u32x128x512
m1 fold wxe 1 p0 2 p2
m2 fold wxe 1 m1 1 106
ret m2
end
# the address of element (index operand p5 p6) of the array operand (p3 p4) of frame p2 with
# p7 elements of p8 bytes: the array pushed, then the dynamic index (masked or reduced to the
# length unless it is the host's trip index below the host's literal bound, scaled by the element
# size, added); a literal index leaves only the array and the static byte offset in register 16
fn wxea u32x128x512 u32 u32 u32 u32 u32 u32 u32 u32 -> u32x128x512
m1 fold wxpsh 1 p0 p2 p3 p4
lit eq p5 3
isd select lit false true
lo0 rem p6 p7
off mul lo0 p8
cn1_m2 select isd 1 0
m2 fold wxpsh cn1_m2 m1 p2 p5 p6
isp1a eq p5 2
isp1b eq p6 1
isp1 and isp1a isp1b
bf call wxfg m2 p2 22
bv call wxfg m2 p2 23
hb ne bf 0
bok le bv p7
in1 and isp1 hb
inr and in1 bok
inrange and inr isd
p2l call wxpow2 p7
lm sub p7 1
nr select inrange false true
dyn and isd nr
mk and dyn p2l
nmk select p2l false true
rmq and dyn nmk
cn2_m3 select mk 1 0
m3 fold wxkc cn2_m3 m2 lm
cn3_m4 select mk 1 0
m4 fold wxop cn3_m4 m3 113
cn4_m5 select rmq 1 0
m5 fold wxkc cn4_m5 m4 p7
cn5_m6 select rmq 1 0
m6 fold wxop cn5_m6 m5 112
e1 ne p8 1
sc and isd e1
lgs call wxlog2 p8
ip call wxpow2 p8
shf and sc ip
nsh select ip false true
mul1 and sc nsh
cn6_m7 select shf 1 0
m7 fold wxkc cn6_m7 m6 lgs
cn7_m8 select shf 1 0
m8 fold wxop cn7_m8 m7 116
cn8_m9 select mul1 1 0
m9 fold wxkc cn8_m9 m8 p8
cn9_m10 select mul1 1 0
m10 fold wxop cn9_m10 m9 108
cn10_m11 select isd 1 0
m11 fold wxop cn10_m11 m10 106
off1 select lit off 0
m12 fold wxs 1 m11 16 off1
ret m12
end
# store operand (kind p3, value p4) of frame p2 (type tag p5, bytes p6) at the pushed address
# plus the static offset p7 (`storeAt`)
fn wxsa u32x128x512 u32 u32 u32 u32 u32 u32 u32 -> u32x128x512
prim lt p5 4
nprim select prim false true
nz ne p7 0
agg and nprim nz
cn1_m1 select agg 1 0
m1 fold wxadd cn1_m1 p0 p7
m2 fold wxpsh 1 m1 p2 p3 p4
cn2_m3 select prim 1 0
m3 fold wxst cn2_m3 m2 p7
cn3_m4 select nprim 1 0
m4 fold wxcp cn3_m4 m3 p6
ret m4
end
# ---------------------------------------------------------------------------------------------
# Analysis of a frame's function (src/wasm.ts `mutableHere`, `#analyse`, `#retSlot`). Use
# statistics, paged like emit_c.a0 `cusn`: word v (node v; parameter v at 4096 + v) holds
# 2^16 * (operand uses other than operand 0 of a get/at) + (last user + 1). A value may be
# updated in place by node j at its target operand when it is fresh (arr text rec set put) or
# the owned parameter, is not the ret, its only such use is that operand, no later node uses
# it, and no borrow of it is read later (the shape table's BORR column).

# operand p3 + p1 (args page p2) of node p5 whose operands start at p4; p6: the node is a get/at
# word p1 of use statistics p0
fn wxu64 u32x128x64 u32 -> u32
pg shr p1 7
w and p1 127
g get p0 pg
v get g w
ret v
end
fn wxusa u32x128x64 u32 u32x128 u32 u32 u32 bool -> u32x128x64
oi add p3 p1
xw mul oi 2
x2 and xw 127
kd get p2 x2
x3 add x2 1
vd get p2 x3
isn eq kd 1
isp eq kd 2
q add vd 4096
slot select isp q vd
w_p shr slot 7
w_g get p0 w_p
w_w and slot 127
w get w_g w_w
nb0 shr w 16
nb and nb0 3
tt0 shr w 18
tt and tt0 3
k0 eq oi p4
good and p6 k0
bad select good 0 1
nb2 add nb bad
nb3 call cumin nb2 3
tt2 add tt 1
tt3 call cumin tt2 3
hb shl nb3 16
ht shl tt3 18
j1 add p5 1
nw0 or hb ht
nw or nw0 j1
val or isn isp
out select val nw w
r_h set w_g w_w out
r set p0 w_p r_h
ret r
end
fn wxuspg u32x128x64 u32 u32x128x512 u32 u32 u32 u32 bool -> u32x128x64
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold wxusa cnt p0 pg lo p3 p6 p7
ret r
end
# node p1 (first node p4) of the nodes p2 with operands p3
fn wxusn u32x128x64 u32 u32x128x128 u32x128x512 u32 -> u32x128x64
g add p4 p1
op call wxnw p2 g 1
na call wxnw p2 g 2
fa call wxnw p2 g 3
isg eq op 25
isa eq op 27
ga or isg isa
hi add fa na
has lt fa hi
lp shr fa 6
h1 sub hi 1
hp shr h1 6
d sub hp lp
np add d 1
n select has np 0
r fold wxuspg n p0 p3 fa hi lp p1 ga
ret r
end

fn wxroot u32x128x512 u32 u32 u32 u32 u32x128x64 u32 u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x200 -> u32x128x512
g add p3 p1
op call wxnw p8 g 1
fa call wxnw p8 g 3
t call wa24 p10 g
tag call wxtag p11 t
agg ge tag 4
o1 eq op 1
o26 eq op 26
o28 eq op 28
o20 eq op 20
o21 eq op 21
sp or o26 o28
fl or o20 o21
isa1 or sp fl
fa1 add fa 1
ik0 call wxok p9 fa
iv0 call wxov p9 fa
ik1 call wxok p9 fa1
iv1 call wxov p9 fa1
uk select fl ik1 ik0
uv select fl iv1 iv0
isn eq uk 1
isp eq uk 2
ug add p3 uv
dop call wxnw p8 ug 1
d22 eq dop 22
d23 eq dop 23
d24 eq dop 24
d26 eq dop 26
d28 eq dop 28
f1 or d22 d23
f2 or f1 d24
f3 or f2 d26
fresh or f3 d28
fr1 and isn fresh
ow eq p4 1
v0 eq uv 0
own0 and ow v0
own1 and isp own0
okk or fr1 own1
rk1 eq uk p6
rv1 eq uv p7
rs and rk1 rv1
nrs select rs false true
us0 add uv 4096
us1 select isp us0 uv
w call wxu64 p5 us1
nb0 shr w 16
nb and nb0 3
lu and w 65535
c1 eq nb 1
j1 add p1 1
c2 le lu j1
bg add 11264 g
bor call wxsh p12 bg
nbor eq bor 0
u1 and okk nrs
u2 and u1 c1
u3 and u2 c2
mut and u3 nbor
a1 and isa1 mut
a2 and a1 agg
a3 and agg o1
ali or a2 a3
uvn select isn uv 0
rr call wxrg p0 p2 uvn 3
rz eq rr 0
nrt add 268435456 uv
rootn select rz nrt rr
pw add 536870912 uv
tr select isn rootn pw
val select ali tr 0
nuse call wxu64 p5 p1
m1 fold wxrs 1 p0 p2 p1 3 val
r fold wxrs 1 m1 p2 p1 1 nuse
ret r
end
# ---------------------------------------------------------------------------------------------
# Node emission (src/wasm.ts `emitNode`). The node context (28 u32): 0 frame, 1 node (index in
# its function), 2 global node, 3 op, 4 operand count, 5 first operand, 6 callee, 7 predicate,
# 8 type, 9 its tag, 10 its bytes, 11-16 the kinds and values of operands 0-2, 17-22 for each of
# them a known-constant flag and its value or local (`wxres`), 23 24 the types of operands 0
# and 1, 25 1 when the node aliases storage, 26 27 unused.

# a node's storage (`bindSlot`, node p3 of frame p2, byte size p4): the result address for the
# result slot, else the frame pointer (the first slot) or the frame pointer plus the offset; its
# local is left in register 16
fn wxslot u32x128x512 u32 u32 u32 u32 -> u32x128x512
rs call wxg p0 11
isr eq rs p3
d0 eq p2 0
isr0 and isr d0
sret call wxg p0 9
off call wxg p0 3
nrs select isr0 false true
al add p4 3
alg and al 4294967292
fr2 add off alg
cn1_m1 select nrs 1 0
m1 fold wxs cn1_m1 p0 3 fr2
z eq off 0
first and nrs z
nfirst select first false true
other and nrs nfirst
cn2_m2 select first 1 0
m2 fold wxfp cn2_m2 m1
fpl call wxg m2 16
cn3_m3 select other 1 0
m3 fold wxnl cn3_m3 m2
nl call wxg m3 16
fp call wxg m3 4
cn4_m4 select other 1 0
m4 fold wxlg cn4_m4 m3 fp
cn5_m5 select other 1 0
m5 fold wxkc cn5_m5 m4 off
cn6_m6 select other 1 0
m6 fold wxop cn6_m6 m5 106
cn7_m7 select other 1 0
m7 fold wxls cn7_m7 m6 nl
l1 select first fpl nl
loc select isr0 sret l1
m8 fold wxrs 1 m7 p2 p3 0 loc
m9 fold wxs 1 m8 16 loc
ret m9
end
# the binary operator byte of op p0 (add sub mul and or xor shl shr; eq ne lt le gt ge)
fn wxbop u32 -> u32
e2 eq p0 2
e3 eq p0 3
e4 eq p0 4
e5 eq p0 5
e6 eq p0 6
e7 eq p0 7
e8 eq p0 8
e9 eq p0 9
e12 eq p0 12
e13 eq p0 13
e14 eq p0 14
e15 eq p0 15
e16 eq p0 16
e17 eq p0 17
r0 mov 0
r2 select e2 106 r0
r3 select e3 107 r2
r4 select e4 108 r3
r5 select e5 113 r4
r6 select e6 114 r5
r7 select e7 115 r6
r8 select e8 116 r7
r9 select e9 118 r8
r12 select e12 70 r9
r13 select e13 71 r12
r14 select e14 73 r13
r15 select e15 77 r14
r16 select e16 75 r15
r17 select e17 79 r16
ret r17
end
# the value of the binary op p0 on u32 p1 and p2 (`evalOp`; comparisons are 0 / 1)
fn wxeval u32 u32 u32 -> u32
a2 add p1 p2
a3 sub p1 p2
a4 mul p1 p2
a5 and p1 p2
a6 or p1 p2
a7 xor p1 p2
a8 shl p1 p2
a9 shr p1 p2
c12 eq p1 p2
c13 ne p1 p2
c14 lt p1 p2
c15 le p1 p2
c16 gt p1 p2
c17 ge p1 p2
b12 select c12 1 0
b13 select c13 1 0
b14 select c14 1 0
b15 select c15 1 0
b16 select c16 1 0
b17 select c17 1 0
e2 eq p0 2
e3 eq p0 3
e4 eq p0 4
e5 eq p0 5
e6 eq p0 6
e7 eq p0 7
e8 eq p0 8
e9 eq p0 9
e12 eq p0 12
e13 eq p0 13
e14 eq p0 14
e15 eq p0 15
e16 eq p0 16
e17 eq p0 17
r0 mov 0
r2 select e2 a2 r0
r3 select e3 a3 r2
r4 select e4 a4 r3
r5 select e5 a5 r4
r6 select e6 a6 r5
r7 select e7 a7 r6
r8 select e8 a8 r7
r9 select e9 a9 r8
r12 select e12 b12 r9
r13 select e13 b13 r12
r14 select e14 b14 r13
r15 select e15 b15 r14
r16 select e16 b16 r15
r17 select e17 b17 r16
ret r17
end
# mov (op 1) of a scalar: push the operand, set
fn wxhmov u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) -> u32x128x512
d at p2 0
j at p2 1
c0 at p2 17
s0 at p2 18
m1 fold wxpr 1 p0 c0 s0
