nl_gw and 16 127
nl_gg get m1 nl_gp
nl get nl_gg nl_gw
fp select none nl f
cn2_m2 select none 1 0
m2__gcondb ne cn2_m2 0
m2__pg shr 4 7
m2__w and 4 127
m2__g get m1 m2__pg
m2__g2 set m2__g m2__w fp
m2__r_o get m1 m2__pg
m2__r_s select m2__gcondb m2__g2 m2__r_o
m2__r set m1 m2__pg m2__r_s
m3__pg shr 16 7
m3__w and 16 127
m3__g get m2__r m3__pg
m3__g2 set m3__g m3__w fp
m3__r set m2__r m3__pg m3__g2
ret m3__r
end
# push an item (kind p2, a p3, b p4, c p5) on the work stack (512 items)
fn wxpu u32x128x512 u32 u32 u32 u32 u32 -> u32x128x512
