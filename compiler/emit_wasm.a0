# ---------------------------------------------------------------------------------------------
# Readers of the checked tables (the layout of compiler/emit_c.a0 / tools/selfhost-wasm.ts):
# the nodes table has 6 words a node (0, op, operand count, first operand, callee, predicate),
# the operand table (u32x128x512) holds (kind, value) pairs (kind 1 node, 2 parameter, 3 u32
# literal, 4 bool literal), the fns table 7 words a function (0 opaque if no body, parameter
# count, first parameter type in tlist, result type, first node, node count, packed ret word).
# Types are triples (tag 1 u32, 2 bool, 3 io, 4 array (length, element), 5 record (first field
# in tlist, count)) and `info` holds bytes | contains-io << 31 per type.

# word p2 of node p1
fn wxnw u32x128x132 u32 u32 -> u32
b mul p1 6
i add b p2
pg shr i 7
w and i 127
g get p0 pg
v get g w
ret v
end
# kind / value of operand pair p1
fn wxok u32x128x512 u32 -> u32
x mul p1 2
pg shr x 7
w and x 127
g get p0 pg
v get g w
ret v
end
fn wxov u32x128x512 u32 -> u32
x mul p1 2
y add x 1
pg shr y 7
w and y 127
g get p0 pg
v get g w
ret v
end
# word p2 of function p1
fn wxfw u32x128x45 u32 u32 -> u32
b mul p1 7
r call cfw p0 b p2
ret r
end
# word p2 of type p1 (tag, a, b)
fn wxty u32x384x65 u32 u32 -> u32
r call wat p0 p1 p2
ret r
end
# the tag of type p1
fn wxtag u32x384x65 u32 -> u32
r call wat p0 p1 0
ret r
end
# the byte size of type p1
fn wxbyt u32x128x65 u32 -> u32
w call wa65 p0 p1
r and w 2147483647
ret r
end
# does type p1 contain io
fn wxio u32x128x65 u32 -> u32
w call wa65 p0 p1
r shr w 31
ret r
end
# word p1 of the shape table
fn wxsh u32x128x200 u32 -> u32
pg shr p1 7
w and p1 127
g get p0 pg
v get g w
ret v
end
# log2 of a power of two (the number of shifts down to 1)
fn wxl2s u32 u32 u32 -> u32
k add p1 1
s shr p2 k
nz ne s 0
a select nz 1 0
r add p0 a
ret r
end
fn wxlog2 u32 -> u32
r fold wxl2s 31 0 p0
ret r
end
# is p0 a power of two (including 1)
fn wxpow2 u32 -> bool
m sub p0 1
a and p0 m
r eq a 0
ret r
end
# the type of operand (kind p1, value p2) of the function with first parameter type p5 in tlist
# and nodes starting at p6: a node's type (nty), a parameter's, a literal's
fn wxopty u32 u32 u32x128x24 u32x128x65 u32 u32 -> u32
isn eq p0 1
isp eq p0 2
isb eq p0 4
g add p5 p1
nt call wa24 p2 g
pi add p4 p1
pt call wa65 p3 pi
bt select isb 1 0
a select isp pt bt
r select isn nt a
ret r
end
# ---------------------------------------------------------------------------------------------
# Operands in a frame (src/wasm.ts `#constOf`, `#paramSource`, `localOf`, `push`). A fold of one
# trip (M, trip, frame d, kind, value) leaves in register 16 whether the operand is a known
# constant (1: a literal, a folded node, or a parameter bound to a literal by the host) and in
# 17 its value, or (16 = 0) the local that holds it: a node's own (or its alias root's), a
# parameter's (the host's local for it in an inlined frame, else first parameter + index).
fn wxres u32x128x512 u32 u32 u32 u32 -> u32x128x512
isn eq p3 1
isp eq p3 2
l3 eq p3 3
l4 eq p3 4
lit or l3 l4
j select isn p4 0
fl_t1 eq p2 0
fl_t2 mul j 4
fl_t3 add fl_t2 5440
fl_t4 sub p2 1
fl_t5 mul fl_t4 128
fl_t6 add fl_t5 16704
fl_t7 add fl_t6 fl_t2
fl_t8 select fl_t1 fl_t3 fl_t7
fl_t9 add fl_t8 2
fl_rp shr fl_t9 7
fl_rw and fl_t9 127
fl_rg get p0 fl_rp
fl get fl_rg fl_rw
hc and fl 1
hcb ne hc 0
cv_t1 eq p2 0
cv_t2 mul j 4
cv_t3 add cv_t2 5440
cv_t4 sub p2 1
cv_t5 mul cv_t4 128
cv_t6 add cv_t5 16704
cv_t7 add cv_t6 cv_t2
cv_t8 select cv_t1 cv_t3 cv_t7
cv_t9 add cv_t8 1
cv_rp shr cv_t9 7
cv_rw and cv_t9 127
cv_rg get p0 cv_rp
cv get cv_rg cv_rw
rt_t1 eq p2 0
rt_t2 mul j 4
rt_t3 add rt_t2 5440
rt_t4 sub p2 1
rt_t5 mul rt_t4 128
rt_t6 add rt_t5 16704
rt_t7 add rt_t6 rt_t2
rt_t8 select rt_t1 rt_t3 rt_t7
rt_t9 add rt_t8 3
rt_rp shr rt_t9 7
rt_rw and rt_t9 127
rt_rg get p0 rt_rp
rt get rt_rg rt_rw
rk shr rt 28
rv and rt 268435455
rp eq rk 2
rpn and isn rp
anypar or rpn isp
pi0 select isp p4 rv
pidx select anypar pi0 0
x2 mul pidx 2
sk0 add x2 32
sk_fa mul p2 128
sk_fb add sk_fa 128
sk_fc add sk_fb sk0
sk_fp shr sk_fc 7
sk_fw and sk_fc 127
sk_fg get p0 sk_fp
sk get sk_fg sk_fw
sv0 add x2 33
sv_fa mul p2 128
sv_fb add sv_fa 128
sv_fc add sv_fb sv0
sv_fp shr sv_fc 7
sv_fw and sv_fc 127
sv_fg get p0 sv_fp
sv get sv_fg sv_fw
hh gt p2 0
hs and hh anypar
issv eq sk 1
srcv and hs issv
rz eq rt 0
rnode select rz j rv
nl_t1 eq p2 0
nl_t2 mul rnode 4
nl_t3 add nl_t2 5440
nl_t4 sub p2 1
nl_t5 mul nl_t4 128
nl_t6 add nl_t5 16704
nl_t7 add nl_t6 nl_t2
nl_t8 select nl_t1 nl_t3 nl_t7
nl_t9 add nl_t8 0
nl_rp shr nl_t9 7
nl_rw and nl_t9 127
nl_rg get p0 nl_rp
nl get nl_rg nl_rw
pb_gp shr 10 7
pb_gw and 10 127
pb_gg get p0 pb_gp
pb get pb_gg pb_gw
pl add pb pidx
plocal select hh sv pl
loc select anypar plocal nl
cb and isn hcb
c1 or lit cb
isc or c1 srcv
v1 select cb cv sv
v2 select lit p4 v1
val select isc v2 loc
isc1 select isc 1 0
m1__pg shr 16 7
m1__w and 16 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w isc1
m1__r set p0 m1__pg m1__g2
m2__pg shr 17 7
m2__w and 17 127
m2__g get m1__r m2__pg
m2__g2 set m2__g m2__w val
m2__r set m1__r m2__pg m2__g2
ret m2__r
end
# emit the push of a resolved operand (constant flag p2, value or local p3)
fn wxpr u32x128x512 u32 u32 u32 -> u32x128x512
c ne p2 0
k select c 2 3
r__g0 get p0 0
r__n get r__g0 0
r__e8 get r__g0 8
r__full ge r__n 22528
r__okn select r__full 0 1
r__n1 add r__n r__okn
r__e2 select r__full 1 r__e8
r__g0a set r__g0 0 r__n1
r__g0b set r__g0a 8 r__e2
r__m1 set p0 0 r__g0b
r__a mul r__n 2
r__ad add r__a 20480
r__pg shr r__ad 7
r__w and r__ad 127
r__g get r__m1 r__pg
r__w1 add r__w 1
r__g1 set r__g r__w k
r__g2 set r__g1 r__w1 p3
r__okb eq r__full false
r__g3 select r__okb r__g2 r__g
r__m2 set r__m1 r__pg r__g3
ret r__m2
end
# push operand (kind p3, value p4) of frame p2
fn wxpsh u32x128x512 u32 u32 u32 u32 -> u32x128x512
m1 fold wxres 1 p0 p2 p3 p4
c_gp shr 16 7
c_gw and 16 127
c_gg get m1 c_gp
c get c_gg c_gw
v_gp shr 17 7
v_gw and 17 127
v_gg get m1 v_gp
v get v_gg v_gw
r fold wxpr 1 m1 c v
ret r
end
# the node's local, bound to a fresh local now, and `local.set` of it (src/wasm.ts `set`):
# (M, trip, frame, node); the local is left in register 16
fn wxset u32x128x512 u32 u32 u32 -> u32x128x512
m1 fold wxnl 1 p0
l_gp shr 16 7
l_gw and 16 127
l_gg get m1 l_gp
l get l_gg l_gw
m2 fold wxrs 1 m1 p2 p3 0 l
m3__g0 get m2 0
m3__n get m3__g0 0
m3__e8 get m3__g0 8
m3__full ge m3__n 22528
m3__okn select m3__full 0 1
m3__n1 add m3__n m3__okn
m3__e2 select m3__full 1 m3__e8
m3__g0a set m3__g0 0 m3__n1
m3__g0b set m3__g0a 8 m3__e2
m3__m1 set m2 0 m3__g0b
m3__a mul m3__n 2
m3__ad add m3__a 20480
m3__pg shr m3__ad 7
m3__w and m3__ad 127
m3__g get m3__m1 m3__pg
m3__w1 add m3__w 1
m3__g1 set m3__g m3__w 4
m3__g2 set m3__g1 m3__w1 l
m3__okb eq m3__full false
m3__g3 select m3__okb m3__g2 m3__g
m3__m2 set m3__m1 m3__pg m3__g3
ret m3__m2
end
# a node's local bound to p4 (frame p2, node p3)
fn wxbind u32x128x512 u32 u32 u32 u32 -> u32x128x512
r fold wxrs 1 p0 p2 p3 0 p4
ret r
end
