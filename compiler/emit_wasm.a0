end
fn wkmodst io u32 u32x128x256 u32x128x64 u32x128x64 u32x128x32 u32x128x500 u32x128 u32 u32 u32 u32 u32 u32 u32 u32 -> io
r call wkmod p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15
ret r
end
# mode 3: the module
fn walink io -> (io,u32)
r1 call wardw p0
vlen at r1 0
t1 at r1 1
zp call zpage
v0 rec zp t1
vr fold rbyte vlen v0
ver at vr 0
t2 at vr 1
r3 call wardw t2
inc at r3 0
t3 at r3 1
r4 call wardw t3
outc at r4 0
t4 at r4 1
r5 call wardw t4
nf at r5 0
t5 at r5 1
