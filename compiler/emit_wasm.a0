# the three helpers, each with its size first
fn wkhelp (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
a at p0 0
b at p0 1
c rec a 0 0 0
d call wkhrd c p2 false
e at d 1
f at d 0
g rec f b 0 0
h call waul g e p4
i call wkhrd h p2 p4
j at i 0
k at i 1
l rec j 0 0 0
m call wkhwr l p2 p3 false
n at m 1
o at m 0
p rec o k 0 0
q call waul p n p4
r call wkhwr q p2 p3 p4
s at r 0
t at r 1
u rec s 0 0 0
v call wkhpu u false
w at v 1
x at v 0
y rec x t 0 0
z call waul y w p4
aa call wkhpu z p4
ret aa
end
# the helpers' code section bytes (sizes included)
fn wkhsum io u32 u32 -> (io,u32)
a rec p0 0 0 0
b call wkhelp a 0 p1 p2 false
c at b 0
d at b 1
e rec c d
ret e
end
