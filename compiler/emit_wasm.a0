m2__g2 set m2__g m2__w p3
m2__r_o get m1__r m2__pg
m2__r_s select m2__gcondb m2__g2 m2__r_o
m2__r set m1__r m2__pg m2__r_s
ad2 add ad 2
m3__gcondb ne ok 0
m3__pg shr ad2 7
m3__w and ad2 127
m3__g get m2__r m3__pg
m3__g2 set m3__g m3__w p4
m3__r_o get m2__r m3__pg
m3__r_s select m3__gcondb m3__g2 m3__r_o
m3__r set m2__r m3__pg m3__r_s
ad3 add ad 3
m4__gcondb ne ok 0
m4__pg shr ad3 7
m4__w and ad3 127
m4__g get m3__r m4__pg
m4__g2 set m4__g m4__w p5
m4__r_o get m3__r m4__pg
m4__r_s select m4__gcondb m4__g2 m4__r_o
m4__r set m3__r m4__pg m4__r_s
sp1 add sp 1
m5__gcondb ne ok 0
m5__pg shr 7 7
m5__w and 7 127
m5__g get m4__r m5__pg
m5__g2 set m5__g m5__w sp1
m5__r_o get m4__r m5__pg
m5__r_s select m5__gcondb m5__g2 m5__r_o
m5__r set m4__r m5__pg m5__r_s
cn1_m6 select full 1 0
m6__gcondb ne cn1_m6 0
m6__pg shr 8 7
m6__w and 8 127
m6__g get m5__r m6__pg
m6__g2 set m6__g m6__w 1
m6__r_o get m5__r m6__pg
m6__r_s select m6__gcondb m6__g2 m6__r_o
m6__r set m5__r m6__pg m6__r_s
ret m6__r
