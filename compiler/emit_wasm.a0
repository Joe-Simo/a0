m11__e2 select m11__full 1 m11__e8
m11__g0a set m11__g0 0 m11__n1
m11__g0b set m11__g0a 8 m11__e2
m11__m1_o get m10 0
m11__m1_s select m11__gcondb m11__g0b m11__m1_o
m11__m1 set m10 0 m11__m1_s
m11__a mul m11__n 2
m11__ad add m11__a 20480
m11__pg shr m11__ad 7
m11__w and m11__ad 127
m11__g get m11__m1 m11__pg
m11__w1 add m11__w 1
m11__g1 set m11__g m11__w 15
m11__g2 set m11__g1 m11__w1 127
m11__okb eq m11__full false
m11__g3 select m11__okb m11__g2 m11__g
m11__m2_o get m11__m1 m11__pg
m11__m2_s select m11__gcondb m11__g3 m11__m2_o
m11__m2 set m11__m1 m11__pg m11__m2_s
cn10_m12 select lazy 1 0
m12 fold wxpu cn10_m12 m11__m2 7 d j 0
cn11_m13 select lazy 1 0
m13 fold wxpu cn11_m13 m12 4 1 11 0
cn12_m14 select lazy 1 0
m14 fold wxpu cn12_m14 m13 3 d k2 v2
cn13_m15 select lazy 1 0
m15 fold wxpu cn13_m15 m14 6 d j 1
cn14_m16 select lazy 1 0
m16 fold wxpu cn14_m16 m15 4 1 5 0
cn15_m17 select lazy 1 0
m17 fold wxpu cn15_m17 m16 3 d k1 v1
cn16_m18 select lazy 1 0
m18 fold wxpu cn16_m18 m17 6 d j 0
ret m18
end
# the first node at or after node p5 of the frame (first node p2) owned by select p3 in ARM column
# value p4 (1 or 2); p0 is the node found so far (4294967295: none): node p1 + p5
fn wxfnd u32 u32 u32 u32 u32 u32 u32x128x200 -> u32
j add p5 p1
g add p2 j
a add 2816 g
own call wxsh p6 a
b add 5632 g
arm call wxsh p6 b
j1 add p3 1
o1 eq own j1
a2 eq arm p4
none eq p0 4294967295
h1 and o1 a2
hit and h1 none
r select hit j p0
ret r
end
# ---------------------------------------------------------------------------------------------
# Frames. A frame is an emitter of one function (variant p4: 0 value, 1 owned): frame 0 the
# function being emitted, frame d + 1 a body or callee inlined by frame d (INLINE_DEPTH 3).

# frame p2's description of function p3 (variant p4): first node, node count, parameter count
# and ret operand from the fns table p5 and the operand table p6; the host's words are kept
fn wxfset u32x128x512 u32 u32 u32 u32 u32x128x45 u32x128x512 -> u32x128x512
g0 call wxfw p5 p3 4
nn call wxfw p5 p3 5
np call wxfw p5 p3 1
rw call wxfw p5 p3 6
rop call waretop p6 rw
rk at rop 0
rv at rop 1
hh gt p2 0
hhv select hh 1 0
m1 fold wxfs 1 p0 p2 0 p3
m2 fold wxfs 1 m1 p2 1 p4
m3 fold wxfs 1 m2 p2 2 g0
m4 fold wxfs 1 m3 p2 3 nn
m5 fold wxfs 1 m4 p2 4 np
m6 fold wxfs 1 m5 p2 5 rk
m7 fold wxfs 1 m6 p2 6 rv
m8 fold wxfs 1 m7 p2 7 hhv
ret m8
end
# clear the row (and the induction and use words) of node p1 of inline frame p2
fn wxclr u32x128x512 u32 u32 -> u32x128x512
m1__a call wxrw p2 p1 0
m1__r__pg shr m1__a 7
m1__r__w and m1__a 127
m1__r__g get p0 m1__r__pg
m1__r__g2 set m1__r__g m1__r__w 0
m1__r__r set p0 m1__r__pg m1__r__g2
m2__a call wxrw p2 p1 1
m2__r__pg shr m2__a 7
m2__r__w and m2__a 127
m2__r__g get m1__r__r m2__r__pg
m2__r__g2 set m2__r__g m2__r__w 0
m2__r__r set m1__r__r m2__r__pg m2__r__g2
m3__a call wxrw p2 p1 2
m3__r__pg shr m3__a 7
m3__r__w and m3__a 127
m3__r__g get m2__r__r m3__r__pg
m3__r__g2 set m3__r__g m3__r__w 0
m3__r__r set m2__r__r m3__r__pg m3__r__g2
m4__a call wxrw p2 p1 3
m4__r__pg shr m4__a 7
m4__r__w and m4__a 127
m4__r__g get m3__r__r m4__r__pg
m4__r__g2 set m4__r__g m4__r__w 0
m4__r__r set m3__r__r m4__r__pg m4__r__g2
m5__a call wxbk p2 p1 0
m5__r__pg shr m5__a 7
m5__r__w and m5__a 127
m5__r__g get m4__r__r m5__r__pg
m5__r__g2 set m5__r__g m5__r__w 0
m5__r__r set m4__r__r m5__r__pg m5__r__g2
m6__a call wxbk p2 p1 1
m6__r__pg shr m6__a 7
m6__r__w and m6__a 127
m6__r__g get m5__r__r m6__r__pg
m6__r__g2 set m6__r__g m6__r__w 0
m6__r__r set m5__r__r m6__r__pg m6__r__g2
ret m6__r__r
end
# register 18 := 1 when node p1 (first node p3) of frame p2 needs frame storage: an aggregate
# that is not an alias, not in the scalar state chain, and not a get at select mov
fn wxnf u32x128x512 u32 u32 u32 u32x128x132 u32x128x24 u32x384x65 -> u32x128x512
g add p3 p1
op call wxnw p4 g 1
t call wa24 p5 g
tag call wxtag p6 t
agg ge tag 4
rt_t1 eq p2 0
rt_t2 mul p1 4
rt_t3 add rt_t2 5440
rt_t4 sub p2 1
rt_t5 mul rt_t4 128
rt_t6 add rt_t5 16704
rt_t7 add rt_t6 rt_t2
rt_t8 select rt_t1 rt_t3 rt_t7
rt_t9 add rt_t8 3
rt_rp shr rt_t9 7
rt_rw and rt_t9 127
rt_rg get p0 rt_rp
rt get rt_rg rt_rw
fl_t1 eq p2 0
fl_t2 mul p1 4
fl_t3 add fl_t2 5440
fl_t4 sub p2 1
fl_t5 mul fl_t4 128
fl_t6 add fl_t5 16704
fl_t7 add fl_t6 fl_t2
fl_t8 select fl_t1 fl_t3 fl_t7
fl_t9 add fl_t8 2
fl_rp shr fl_t9 7
fl_rw and fl_t9 127
fl_rg get p0 fl_rp
fl get fl_rg fl_rw
ch and fl 2
na eq rt 0
nch eq ch 0
o25 eq op 25
o27 eq op 27
o18 eq op 18
o1 eq op 1
x1 or o25 o27
x2 or x1 o18
x3 or x2 o1
nox select x3 false true
a1 and agg na
a2 and a1 nch
a3 and a2 nox
cn1_m1 select a3 1 0
m1__gcondb ne cn1_m1 0
m1__pg shr 18 7
m1__w and 18 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w 1
m1__r_o get p0 m1__pg
m1__r_s select m1__gcondb m1__g2 m1__r_o
m1__r set p0 m1__pg m1__r_s
ret m1__r
end
# register 19 := 1 when parameter p1 (first parameter type p2 of tlist p3, info p4) / node p1
# (first node p2, node types p3, info p4) contains io
fn wxiop u32x128x512 u32 u32 u32x128x65 u32x128x65 -> u32x128x512
i add p2 p1
t call wa65 p3 i
io call wxio p4 t
a ne io 0
cn1_m1 select a 1 0
m1__gcondb ne cn1_m1 0
m1__pg shr 19 7
m1__w and 19 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w 1
m1__r_o get p0 m1__pg
m1__r_s select m1__gcondb m1__g2 m1__r_o
m1__r set p0 m1__pg m1__r_s
ret m1__r
end
fn wxion u32x128x512 u32 u32 u32x128x24 u32x128x65 -> u32x128x512
g add p2 p1
t call wa24 p3 g
io call wxio p4 t
a ne io 0
cn1_m1 select a 1 0
m1__gcondb ne cn1_m1 0
m1__pg shr 19 7
m1__w and 19 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w 1
m1__r_o get p0 m1__pg
m1__r_s select m1__gcondb m1__g2 m1__r_o
m1__r set p0 m1__pg m1__r_s
ret m1__r
end
# ---------------------------------------------------------------------------------------------
# Scalar replacement of small fold state (src/wasm.ts `scalarState`): can the state p0 of a body
# live in locals? Register 22 := 0 when not; the chain nodes (updates and rebuilds of the state)
# get bit 1 of their row flags in frame p2. Steps: the state type, then every node, the ret, the
# uses of the chain nodes.

# the state type of the function with first parameter type p2 (tlist p3, types p4): an aggregate of
# at most 8 scalar words; register 24 := its width, 25 := the record's first field and 26 the
# count (0 for an array)
fn wxsm0 u32x128x512 u32 u32 u32x128x65 u32x384x65 -> u32x128x512
t call wa65 p3 p2
tag call wxtag p4 t
a call wxty p4 t 1
b call wxty p4 t 2
agg ge tag 4
isa eq tag 4
n select isa a b
nok le n 8
el le b 1
eok select isa el true
o1 and agg nok
ok and o1 eok
okv select ok 1 0
nr select isa 0 b
m1__pg shr 22 7
m1__w and 22 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w okv
m1__r set p0 m1__pg m1__g2
m2__pg shr 24 7
m2__w and 24 127
m2__g get m1__r m2__pg
m2__g2 set m2__g m2__w n
m2__r set m1__r m2__pg m2__g2
m3__pg shr 25 7
m3__w and 25 127
m3__g get m2__r m3__pg
m3__g2 set m3__g m3__w a
m3__r set m2__r m3__pg m3__g2
m4__pg shr 26 7
m4__w and 26 127
m4__g get m3__r m4__pg
m4__g2 set m4__g m4__w nr
m4__r set m3__r m4__pg m4__g2
ret m4__r
end
# field p1 of the record whose first field is p2 (tlist p3) is a scalar
fn wxsm1 u32x128x512 u32 u32 u32x128x65 -> u32x128x512
i add p2 p1
t call wa65 p3 i
bad gt t 1
cn1_m1 select bad 1 0
m1__gcondb ne cn1_m1 0
m1__pg shr 22 7
m1__w and 22 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w 0
m1__r_o get p0 m1__pg
m1__r_s select m1__gcondb m1__g2 m1__r_o
m1__r set p0 m1__pg m1__r_s
ret m1__r
end
# operand p1 of a node whose operands start at p3: register 23 |= is p0 or a chain node (not for
# operand 0), 24 |= the same (operands 0 included); frame p2
fn wxchs u32x128x512 u32 u32 u32 u32x128x512 -> u32x128x512
o add p3 p1
k call wxok p4 o
v call wxov p4 o
isp1 eq k 2
isp2 eq v 0
isp and isp1 isp2
isn eq k 1
vn select isn v 0
fl_t1 eq p2 0
fl_t2 mul vn 4
fl_t3 add fl_t2 5440
fl_t4 sub p2 1
fl_t5 mul fl_t4 128
fl_t6 add fl_t5 16704
fl_t7 add fl_t6 fl_t2
fl_t8 select fl_t1 fl_t3 fl_t7
fl_t9 add fl_t8 2
fl_rp shr fl_t9 7
fl_rw and fl_t9 127
fl_rg get p0 fl_rp
fl get fl_rg fl_rw
c1 and fl 2
c2 ne c1 0
inc and isn c2
hit or isp inc
h1 select hit 1 0
a24_gp shr 24 7
a24_gw and 24 127
a24_gg get p0 a24_gp
a24 get a24_gg a24_gw
n24 or a24 h1
m1__pg shr 24 7
m1__w and 24 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w n24
m1__r set p0 m1__pg m1__g2
a23_gp shr 23 7
a23_gw and 23 127
a23_gg get m1__r a23_gp
a23 get a23_gg a23_gw
n23 or a23 h1
nz ne p1 0
w23 select nz n23 a23
m2__pg shr 23 7
m2__w and 23 127
m2__g get m1__r m2__pg
m2__g2 set m2__g m2__w w23
m2__r set m1__r m2__pg m2__g2
ret m2__r
end
# node p1 (first node p3) of frame p2, its type p6 the state type p7: the first loop of `scalarState`
fn wxch1 u32x128x512 u32 u32 u32 u32x128x132 u32x128x512 u32x128x24 u32 -> u32x128x512
g add p3 p1
op call wxnw p4 g 1
na call wxnw p4 g 2
fa call wxnw p4 g 3
t call wa24 p6 g
fa1 add fa 1
k0 call wxok p5 fa
v0 call wxov p5 fa
k1 call wxok p5 fa1
isp1 eq k0 2
isp2 eq v0 0
isp and isp1 isp2
isn eq k0 1
vn select isn v0 0
fl_t1 eq p2 0
fl_t2 mul vn 4
fl_t3 add fl_t2 5440
fl_t4 sub p2 1
fl_t5 mul fl_t4 128
fl_t6 add fl_t5 16704
fl_t7 add fl_t6 fl_t2
fl_t8 select fl_t1 fl_t3 fl_t7
fl_t9 add fl_t8 2
fl_rp shr fl_t9 7
fl_rw and fl_t9 127
fl_rg get p0 fl_rp
fl get fl_rg fl_rw
c1 and fl 2
c2 ne c1 0
inc and isn c2
a0 or isp inc
o26 eq op 26
o28 eq op 28
o25 eq op 25
o27 eq op 27
upd or o26 o28
rd or o25 o27
ur or upd rd
cond1 and ur a0
m1__pg shr 23 7
m1__w and 23 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w 0
m1__r set p0 m1__pg m1__g2
m2__pg shr 24 7
m2__w and 24 127
m2__g get m1__r m2__pg
m2__g2 set m2__g m2__w 0
m2__r set m1__r m2__pg m2__g2
m3 fold wxchs na m2__r p2 fa p5
any1v_gp shr 23 7
any1v_gw and 23 127
any1v_gg get m3 any1v_gp
any1v get any1v_gg any1v_gw
anyv_gp shr 24 7
anyv_gw and 24 127
anyv_gg get m3 anyv_gp
anyv get anyv_gg anyv_gw
any1 ne any1v 0
anyall ne anyv 0
nk3 ne k1 3
nisp select isp false true
rdn and rd nisp
f1a or nk3 rdn
f1 or f1a any1
fail1 and cond1 f1
o22 eq op 22
o23 eq op 23
o24 eq op 24
r1 or o22 o23
r2 or r1 o24
tst eq t p7
r3 and r2 tst
ncond select cond1 false true
rebuild and ncond r3
cadd1 and cond1 upd
cadd or cadd1 rebuild
nreb select rebuild false true
f2a and ncond nreb
fail2 and f2a anyall
fail or fail1 fail2
cn1_m4 select cadd 1 0
m4__gcondb ne cn1_m4 0
m4__a call wxrw p2 p1 2
m4__r__gcondb ne cn1_m4 0
m4__r__pg shr m4__a 7
m4__r__w and m4__a 127
m4__r__g get m3 m4__r__pg
m4__r__g2 set m4__r__g m4__r__w 2
m4__r__r_o get m3 m4__r__pg
m4__r__r_s select m4__r__gcondb m4__r__g2 m4__r__r_o
m4__r__r set m3 m4__r__pg m4__r__r_s
cn2_m5 select fail 1 0
m5__gcondb ne cn2_m5 0
m5__pg shr 22 7
m5__w and 22 127
m5__g get m4__r__r m5__pg
m5__g2 set m5__g m5__w 0
m5__r_o get m4__r__r m5__pg
m5__r_s select m5__gcondb m5__g2 m5__r_o
m5__r set m4__r__r m5__pg m5__r_s
ret m5__r
end
# operand p1 of a node (first operand p3, update op p4): a chain node used other than as the base
# of an update fails (register 22 := 0); every node operand counts a use (block word 1)
fn wxch3 u32x128x512 u32 u32 u32 u32 u32x128x512 -> u32x128x512
o add p3 p1
k call wxok p5 o
v call wxov p5 o
isn eq k 1
vn select isn v 0
fl_t1 eq p2 0
fl_t2 mul vn 4
fl_t3 add fl_t2 5440
fl_t4 sub p2 1
fl_t5 mul fl_t4 128
fl_t6 add fl_t5 16704
fl_t7 add fl_t6 fl_t2
fl_t8 select fl_t1 fl_t3 fl_t7
fl_t9 add fl_t8 2
fl_rp shr fl_t9 7
fl_rw and fl_t9 127
fl_rg get p0 fl_rp
fl get fl_rg fl_rw
c1 and fl 2
c2 ne c1 0
inc and isn c2
z eq p1 0
updb ne p4 0
base and updb z
nb select base false true
bad and inc nb
cn1_m1 select bad 1 0
m1__gcondb ne cn1_m1 0
m1__pg shr 22 7
m1__w and 22 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w 0
m1__r_o get p0 m1__pg
m1__r_s select m1__gcondb m1__g2 m1__r_o
m1__r set p0 m1__pg m1__r_s
us call wxbk p2 vn 1
u0_gp shr us 7
u0_gw and us 127
u0_gg get m1__r u0_gp
u0 get u0_gg u0_gw
u1 add u0 1
cn2_m2 select isn 1 0
m2__gcondb ne cn2_m2 0
m2__pg shr us 7
m2__w and us 127
m2__g get m1__r m2__pg
m2__g2 set m2__g m2__w u1
m2__r_o get m1__r m2__pg
m2__r_s select m2__gcondb m2__g2 m2__r_o
m2__r set m1__r m2__pg m2__r_s
ret m2__r
end
fn wxch2 u32x128x512 u32 u32 u32 u32x128x132 u32x128x512 -> u32x128x512
g add p3 p1
op call wxnw p4 g 1
na call wxnw p4 g 2
fa call wxnw p4 g 3
o26 eq op 26
o28 eq op 28
upd or o26 o28
u1 select upd 1 0
r fold wxch3 na p0 p2 fa u1 p5
ret r
end
# chain node p1 of frame p2 used more than once
fn wxch4 u32x128x512 u32 u32 -> u32x128x512
fl_t1 eq p2 0
fl_t2 mul p1 4
fl_t3 add fl_t2 5440
fl_t4 sub p2 1
fl_t5 mul fl_t4 128
fl_t6 add fl_t5 16704
fl_t7 add fl_t6 fl_t2
fl_t8 select fl_t1 fl_t3 fl_t7
fl_t9 add fl_t8 2
fl_rp shr fl_t9 7
fl_rw and fl_t9 127
fl_rg get p0 fl_rp
fl get fl_rg fl_rw
c1 and fl 2
c2 ne c1 0
us call wxbk p2 p1 1
n_gp shr us 7
n_gw and us 127
n_gg get p0 n_gp
n get n_gg n_gw
many gt n 1
bad and c2 many
cn1_m1 select bad 1 0
m1__gcondb ne cn1_m1 0
m1__pg shr 22 7
m1__w and 22 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w 0
m1__r_o get p0 m1__pg
m1__r_s select m1__gcondb m1__g2 m1__r_o
m1__r set p0 m1__pg m1__r_s
ret m1__r
end
# can the state of function p3 (nodes p4, ...) live in locals: register 22 (frame p2's rows must
# be clear); on success p2's chain nodes are marked
fn wxsmall u32x128x512 u32 u32 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x65 -> u32x128x512
nn call wxfw p4 p3 5
g0 call wxfw p4 p3 4
fp call wxfw p4 p3 2
rw call wxfw p4 p3 6
rop call waretop p6 rw
rk at rop 0
rv at rop 1
st call wa65 p9 fp
m1 fold wxsm0 1 p0 fp p9 p8
fa1_gp shr 25 7
fa1_gw and 25 127
fa1_gg get m1 fa1_gp
fa1 get fa1_gg fa1_gw
nfl_gp shr 26 7
nfl_gw and 26 127
nfl_gg get m1 nfl_gp
nfl get nfl_gg nfl_gw
m2 fold wxsm1 nfl m1 fa1 p9
m3 fold wxch1 nn m2 p2 g0 p5 p6 p7 st
m4 fold wxch2 nn m3 p2 g0 p5 p6
rp1 eq rk 2
rp2 eq rv 0
rp and rp1 rp2
rn eq rk 1
rvn select rn rv 0
rfl_t1 eq p2 0
rfl_t2 mul rvn 4
rfl_t3 add rfl_t2 5440
rfl_t4 sub p2 1
rfl_t5 mul rfl_t4 128
rfl_t6 add rfl_t5 16704
rfl_t7 add rfl_t6 rfl_t2
rfl_t8 select rfl_t1 rfl_t3 rfl_t7
rfl_t9 add rfl_t8 2
rfl_rp shr rfl_t9 7
rfl_rw and rfl_t9 127
rfl_rg get m4 rfl_rp
rfl get rfl_rg rfl_rw
rc1 and rfl 2
rc2 ne rc1 0
rinc and rn rc2
rok or rp rinc
nrok select rok false true
cn1_m5 select nrok 1 0
m5__gcondb ne cn1_m5 0
m5__pg shr 22 7
m5__w and 22 127
m5__g get m4 m5__pg
m5__g2 set m5__g m5__w 0
m5__r_o get m4 m5__pg
m5__r_s select m5__gcondb m5__g2 m5__r_o
m5__r set m4 m5__pg m5__r_s
rus call wxbk p2 rvn 1
ru0_gp shr rus 7
ru0_gw and rus 127
ru0_gg get m5__r ru0_gp
ru0 get ru0_gg ru0_gw
ru1 add ru0 1
cn2_m6 select rn 1 0
m6__gcondb ne cn2_m6 0
m6__pg shr rus 7
m6__w and rus 127
m6__g get m5__r m6__pg
m6__g2 set m6__g m6__w ru1
m6__r_o get m5__r m6__pg
m6__r_s select m6__gcondb m6__g2 m6__r_o
m6__r set m5__r m6__pg m6__r_s
m7 fold wxch4 nn m6__r p2
ret m7
end
# ---------------------------------------------------------------------------------------------
# The analysis of frame p2's function p3 (variant p4): the alias root of every node, from the use
# statistics and the shape table
fn wxana u32x128x512 u32 u32 u32 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x200 -> u32x128x512
g0 call wxfw p5 p3 4
nn call wxfw p5 p3 5
rw call wxfw p5 p3 6
