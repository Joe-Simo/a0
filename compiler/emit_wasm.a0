fr0 get fr0_gg fr0_gw
fr1x_gp shr 3 7
fr1x_gw and 3 127
fr1x_gg get m1 fr1x_gp
fr1x get fr1x_gg fr1x_gw
fr1 select own fr1x 0
f0a add fr0 15
f0 and f0a 4294967280
f1a add fr1 15
f1b and f1a 4294967280
fz select own f1b 0
fm call umax f0 fz
md0_gp shr 12 7
md0_gw and 12 127
md0_gg get m0 md0_gp
md0 get md0_gg md0_gw
md1x_gp shr 12 7
md1x_gw and 12 127
md1x_gg get m1 md1x_gp
md1x get md1x_gg md1x_gw
md1 select own md1x 0
md call umax md0 md1
dep add fm md
e0_gp shr 8 7
e0_gw and 8 127
e0_gg get m0 e0_gp
e0 get e0_gg e0_gw
e1_gp shr 8 7
e1_gw and 8 127
e1_gg get m1 e1_gp
e1 get e1_gg e1_gw
e01 call umax e0 e1
er2 call umax er e01
fio call waio p5 p10 p8 p11 f
