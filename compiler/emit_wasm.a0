# ---------------------------------------------------------------------------------------------
# Readers of the checked tables (the layout of compiler/emit_c.a0 / tools/selfhost-wasm.ts):
# the nodes table has 6 words a node (0, op, operand count, first operand, callee, predicate),
# the operand table (u32x128x512) holds (kind, value) pairs (kind 1 node, 2 parameter, 3 u32
# literal, 4 bool literal), the fns table 7 words a function (0 opaque if no body, parameter
# count, first parameter type in tlist, result type, first node, node count, packed ret word).
# Types are triples (tag 1 u32, 2 bool, 3 io, 4 array (length, element), 5 record (first field
# in tlist, count)) and `info` holds bytes | contains-io << 31 per type.

# word p2 of node p1
fn wxnw u32x128x132 u32 u32 -> u32
a mul p1 6
b add a p2
c shr b 7
d and b 127
e get p0 c
f get e d
ret f
end
# kind / value of operand pair p1
fn wxok u32x128x512 u32 -> u32
a mul p1 2
b shr a 7
c and a 127
d get p0 b
e get d c
ret e
end
fn wxov u32x128x512 u32 -> u32
a mul p1 2
b add a 1
c shr b 7
d and b 127
e get p0 c
f get e d
ret f
end
# word p2 of function p1
fn wxfw u32x128x45 u32 u32 -> u32
a mul p1 7
b call cfw p0 a p2
ret b
end
# word p2 of type p1 (tag, a, b)
fn wxty u32x384x65 u32 u32 -> u32
a call wat p0 p1 p2
ret a
end
# the tag of type p1
fn wxtag u32x384x65 u32 -> u32
a call wat p0 p1 0
ret a
end
# the byte size of type p1
fn wxbyt u32x128x65 u32 -> u32
a call wa65 p0 p1
b and a 2147483647
ret b
end
# does type p1 contain io
fn wxio u32x128x65 u32 -> u32
a call wa65 p0 p1
b shr a 31
ret b
end
# word p1 of the shape table
fn wxsh u32x128x310 u32 -> u32
a shr p1 7
b and p1 127
c get p0 a
d get c b
ret d
end
# log2 of a power of two (the number of shifts down to 1)
fn wxl2s u32 u32 u32 -> u32
a add p1 1
b shr p2 a
c ne b 0
d select c 1 0
e add p0 d
ret e
end
fn wxlog2 u32 -> u32
a fold wxl2s 31 0 p0
ret a
end
# is p0 a power of two (including 1)
fn wxpow2 u32 -> bool
a sub p0 1
b and p0 a
c eq b 0
ret c
end
# the type of operand (kind p1, value p2) of the function with first parameter type p5 in tlist
# and nodes starting at p6: a node's type (nty), a parameter's, a literal's
fn wxopty u32 u32 u32x128x24 u32x128x65 u32 u32 -> u32
a eq p0 1
b eq p0 2
c eq p0 4
d add p5 p1
e call wa24 p2 d
f add p4 p1
g call wa65 p3 f
h select c 1 0
i select b g h
j select a e i
ret j
end
