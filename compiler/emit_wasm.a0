# A0 wasm32 emitter and module linker, written in A0 (DESIGN.md 7a): the port of src/wasm.ts.
# Its output for a program is byte-identical to `compile(program, 'wasm', { optimize: false })`
# (the TypeScript emitter on the unoptimized program; tools/selfhost-wasm.ts checks it).
#
# The work is split the way src/wasm.ts splits it (per-function emission, then assembly), so a
# program of any size is compiled a chunk of functions at a time:
# - `wachunk` emits the functions [from, to) of a chunk from the checked paged IR (the tables of
#   the 16384-byte front end, with the operand table widened to u32x128x512: 32768 operands).
#   The chunk comes from source through the A0 front end (`wasunit`, entry mode 1) or as the
#   tables themselves (`wairchunk`, mode 2). Per function it writes the literal pool entries
#   (POOL), a record of its variants (META) and their code (CODE); code bytes are one byte per
#   word, and a call or a pool address is one marker word: 256 + h for the io helper h (0 read,
#   1 write, 2 puts), 259 + index for an A0 function (its index among the variants, before the
#   io helpers are counted: value variant `a0_f`, then the owned `a0o_f`), 2^31 + k for the
#   k-th pool literal of the function. After the three parts: the POOL and META word counts,
#   the index and stack depth of each chunk function, the chunk's variant count and the
#   function count k (a trailer, like the iteration bounds of compiler/boot.a0).
# - `walink` (mode 3) reads the header, every chunk's POOL, then every META, then every CODE
#   (the driver only concatenates them in that order), deduplicates the pool across the
#   program, computes every section size first, and writes the module one byte per word.
# Code is emitted twice per variant with the same functions: once uncounted (`on` false: only
# the markers are written, into META, with the byte count) and once written, so sizes are
# known before any byte of a section is. Every writer takes the flag and writes nothing when it
# is false (a fold of 0 or 1 trips; there is no control flow). The write state is
# (io, bytes, pool literal counter, markers).
#
# Representation (as src/wasm.ts): every value is 32-bit words; scalars and io tokens are i32
# locals, aggregates live on the shadow stack (global 0, growing down) and a node holding one
# has a local with its address. The in-place rule is src/wasm.ts `mutableHere`: only a get/at
# with a scalar result is a read that does not share. Per variant the analysis table (`waana`,
# u32x128x100) holds, per node j: its local (j), its frame offset (3072 + j), its root
# (6144 + j: 2^28 + node or 2^29 + parameter), its second local (9216 + j: the zero test of a
# div/rem, the counter of a fold/loop); then the next local (12288), the frame (12289), the
# frame pointer local (12290, 4294967295 for none) and the node that is the result slot
# (12291, 4294967295 for none). Operand lists are walked a page of 64 operands at a time.

use "emit_c.a0"

# ---------------------------------------------------------------------------------------------
# Paged tables

fn wa24 u32x128x24 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa65 u32x128x65 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa128 u32x128x128 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa16 u32x128x16 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa100 u32x128x100 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa512 u32x128x512 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
# word p2 of the triple (tag a b) of type p1
fn wat u32x384x65 u32 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_l and p1 127
v_m mul v_l 3
v_i add v_m p2
v get v_g v_i
ret v
end
fn z100 -> u32x128x100
z call zpage
t arr z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z
ret t
end
fn z512 -> u32x128x512
z call zpage
t arr z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z
ret t
end
# the front end's operand table (u32x128x256) in the widened one
fn wawpg u32x128x512 u32 u32x128x256 -> u32x128x512
pg get p2 p1
r set p0 p1 pg
ret r
end
fn wawide u32x128x256 -> u32x128x512
z call z512
r fold wawpg 256 z p0
ret r
end

# ---------------------------------------------------------------------------------------------
# Writers. The state (io,u32,u32,u32) is (io, bytes counted, pool literals so far, markers written).

# write p2 (run 0 or 1 times)
fn wawr io u32 u32 -> io
w write p0 p2
ret w
end
# byte (or word) p1, written when p2, counted either way
fn wab (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
t at p0 0
c at p0 1
l at p0 2
m at p0 3
n select p2 1 0
t2 fold wawr n t p1
c2 add c 1
o rec t2 c2 l m
ret o
end
fn wab2 (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call wab p0 p1 p3
b call wab a p2 p3
ret b
end
fn wab3 (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
a call wab p0 p1 p4
b call wab a p2 p4
c call wab b p3 p4
ret c
end
# a marker word (always written, not counted as a byte)
fn waref (io,u32,u32,u32) u32 -> (io,u32,u32,u32)
t at p0 0
c at p0 1
l at p0 2
m at p0 3
t2 write t p1
m2 add m 1
o rec t2 c l m2
ret o
end
# the address of the next pool literal of the function (a marker)
fn wapool (io,u32,u32,u32) -> (io,u32,u32,u32)
t at p0 0
c at p0 1
l at p0 2
m at p0 3
k add 2147483648 l
t2 write t k
l2 add l 1
m2 add m 1
o rec t2 c l2 m2
ret o
end
# byte p1 of the LEB128 of p2 in p3 bytes (p4: the sign bits of a negative fifth byte)
fn walebb (io,u32,u32,u32) u32 u32 u32 u32 bool -> (io,u32,u32,u32)
s mul p1 7
v shr p2 s
lo and v 127
k1 add p1 1
more lt k1 p3
hb select more 128 0
k4 eq p1 4
x select k4 p4 0
b1 or lo hb
b or b1 x
r call wab p0 b p5
ret r
end
# unsigned LEB128 of p1
fn waul (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
a ge p1 128
b ge p1 16384
c ge p1 2097152
d ge p1 268435456
na select a 1 0
nb select b 1 0
nc select c 1 0
nd select d 1 0
s1 add na nb
s2 add s1 nc
s3 add s2 nd
n add s3 1
r fold walebb n p0 p1 n 0 p2
ret r
end
# signed LEB128 of the int32 whose bit pattern is p1
fn wasl (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
ng ge p1 2147483648
nv xor p1 4294967295
m select ng nv p1
a ge m 64
b ge m 8192
c ge m 1048576
d ge m 134217728
na select a 1 0
nb select b 1 0
nc select c 1 0
nd select d 1 0
s1 add na nb
s2 add s1 nc
s3 add s2 nd
n add s3 1
x select ng 112 0
r fold walebb n p0 p1 n x p2
ret r
end
# the size of the unsigned / signed LEB128 of p0
fn wauln u32 -> u32
a ge p0 128
b ge p0 16384
c ge p0 2097152
d ge p0 268435456
na select a 1 0
nb select b 1 0
nc select c 1 0
nd select d 1 0
s1 add na nb
s2 add s1 nc
s3 add s2 nd
n add s3 1
ret n
end
fn wasln u32 -> u32
ng ge p0 2147483648
nv xor p0 4294967295
m select ng nv p0
a ge m 64
b ge m 8192
c ge m 1048576
d ge m 134217728
na select a 1 0
nb select b 1 0
nc select c 1 0
nd select d 1 0
s1 add na nb
s2 add s1 nc
s3 add s2 nd
n add s3 1
ret n
end
fn waulst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call waul p0 p2 p3
ret r
end
fn waslst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call wasl p0 p2 p3
ret r
end
# i32.const p1
fn waci (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
a call wab p0 65 p2
b call wasl a p1 p2
ret b
end
fn wacist (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call waci p0 p2 p3
ret r
end
# opcode p1 with the unsigned immediate p2 (local.get 32, local.set 33, local.tee 34, call 16)
fn walx (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call wab p0 p1 p3
b call waul a p2 p3
ret b
end
fn walxst (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
r call walx p0 p2 p3 p4
ret r
end
# i32.load (40) / i32.store (54) with alignment 2 and offset p2
fn wamem (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call wab2 p0 p1 2 p3
b call waul a p2 p3
ret b
end
# i32.const p2; i32.add
fn waaddst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call waci p0 p2 p3
b call wab a 106 p3
ret b
end
# memory.copy of p1 bytes (destination and source already pushed)
fn wacopy (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
a call waci p0 p1 p2
b call wab2 a 252 10 p2
c call wab2 b 0 0 p2
ret c
end
fn wacopyst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call wacopy p0 p2 p3
ret r
end
# push an operand (kind p1 value p2, local p3): a node or parameter's local, else the literal
fn wapush (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
k1 eq p1 1
k2 eq p1 2
lc or k1 k2
op select lc 32 65
a call wab p0 op p4
nl select lc 1 0
nc select lc 0 1
b fold waulst nl a p3 p4
c fold waslst nc b p2 p4
ret c
end
fn wapushst (io,u32,u32,u32) u32 u32 u32 u32 bool -> (io,u32,u32,u32)
r call wapush p0 p2 p3 p4 p5
ret r
end

# ---------------------------------------------------------------------------------------------
# Type info: bytes | contains-io << 31 per type (u32 bool io 4 bytes; components come first)

# field p1 of the record tlist p3 from p4: (bytes, io) with the info table p2
fn wafi (u32,u32) u32 u32x128x65 u32x128x65 u32 -> (u32,u32)
s at p0 0
o at p0 1
i add p4 p1
t call wa65 p3 i
w call wa65 p2 t
sz and w 2147483647
fio shr w 31
s2 add s sz
o2 or o fio
r rec s2 o2
ret r
end
fn wainfost u32x128x65 u32 u32x384x65 u32x128x65 -> u32x128x65
tag call wat p2 p1 0
a call wat p2 p1 1
b call wat p2 p1 2
t3 eq tag 3
t4 eq tag 4
t5 eq tag 5
eb call wa65 p0 b
esz and eb 2147483647
eio shr eb 31
asz mul a esz
n5 select t5 b 0
z rec 0 0
rs fold wafi n5 z p0 p3 a
rsz at rs 0
rio at rs 1
s1 select t4 asz 4
sz select t5 rsz s1
i1 select t3 1 0
i2 select t4 eio i1
iof select t5 rio i2
hi shl iof 31
w or sz hi
r_p shr p1 7
r_g get p0 r_p
r_w and p1 127
r_h set r_g r_w w
r set p0 r_p r_h
ret r
end
fn wainfo u32x384x65 u32x128x65 u32 -> u32x128x65
z call z65
r fold wainfost p2 z p0 p1
ret r
end
# the byte offset of field p3 of the record whose fields are tlist p1 from p2
fn wafo u32x128x65 u32x128x65 u32 u32 -> u32
z rec 0 0
r fold wafi p3 z p1 p0 p2
o at r 0
ret o
end

# ---------------------------------------------------------------------------------------------
# Analysis (src/wasm.ts `mutableHere`, `#analyse`, `#retSlot`, and the local order of
# `emitNode`). Use statistics, paged like emit_c.a0 `cusn`: word v (node v; parameter v at
# 4096 + v) holds 2^16 * (uses other than operand 0 of a get/at with a scalar result) + (last
# user + 1).

# operand p3 + p1 (args page p2) of node p5 whose operands start at p4; p6: the node is a
# get/at with a scalar result
fn wausa u32x128x64 u32 u32x128 u32 u32 u32 bool -> u32x128x64
oi add p3 p1
xw mul oi 2
x2 and xw 127
kd get p2 x2
x3 add x2 1
vd get p2 x3
isn eq kd 1
isp eq kd 2
q add vd 4096
slot select isp q vd
w_p shr slot 7
w_g get p0 w_p
w_w and slot 127
w get w_g w_w
nb shr w 16
k0 eq oi p4
good and p6 k0
bad select good 0 1
nb2 add nb bad
hi shl nb2 16
j1 add p5 1
nw or hi j1
val or isn isp
out select val nw w
r_p shr slot 7
r_g get p0 r_p
r_w and slot 127
r_h set r_g r_w out
r set p0 r_p r_h
ret r
end
fn wauspg u32x128x64 u32 u32x128x512 u32 u32 u32 u32 bool -> u32x128x64
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold wausa cnt p0 pg lo p3 p6 p7
ret r
end
# the operands of node p1 of the function whose first node is p6
fn wausn u32x128x64 u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32 -> u32x128x64
g add p6 p1
b6 mul g 6
b1 add b6 1
op_p shr b1 7
op_g get p2 op_p
op_w and b1 127
op get op_g op_w
b2 add b6 2
na_p shr b2 7
na_g get p2 na_p
na_w and b2 127
na get na_g na_w
b3 add b6 3
fa_p shr b3 7
fa_g get p2 fa_p
fa_w and b3 127
fa get fa_g fa_w
t_p shr g 7
t_g get p4 t_p
t_w and g 127
t get t_g t_w
tag_p shr t 7
tag_g get p5 tag_p
tag_l and t 127
tag_m mul tag_l 3
tag_i add tag_m 0
tag get tag_g tag_i
sc lt tag 4
isg eq op 25
isa eq op 27
ga or isg isa
good and ga sc
hi add fa na
has lt fa hi
lp shr fa 6
h1 sub hi 1
hp shr h1 6
d sub hp lp
np add d 1
n select has np 0
r fold wauspg n p0 p3 fa hi lp p1 good
ret r
end
# The root of node p1 (first node p7, variant p8, use statistics p6, ret operand (p9 p10)):
# mov of an aggregate aliases its operand; a set/put (target operand 0) or a fold/loop with
# aggregate state (target operand 1) aliases its target when that may be updated in place.
fn waroot u32x128x100 u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x64 u32 u32 u32 u32 -> u32x128x100
g add p7 p1
b6 mul g 6
b1 add b6 1
op_p shr b1 7
op_g get p2 op_p
op_w and b1 127
op get op_g op_w
b3 add b6 3
fa_p shr b3 7
fa_g get p2 fa_p
fa_w and b3 127
fa get fa_g fa_w
t_p shr g 7
t_g get p4 t_p
t_w and g 127
t get t_g t_w
tag_p shr t 7
tag_g get p5 tag_p
tag_l and t 127
tag_m mul tag_l 3
tag_i add tag_m 0
tag get tag_g tag_i
agg ge tag 4
s26 eq op 26
s28 eq op 28
isst or s26 s28
f20 eq op 20
f21 eq op 21
it or f20 f21
isfl and it agg
o1 eq op 1
mv and o1 agg
slot select isfl 1 0
x add fa slot
x2 mul x 2
kd_p shr x2 7
kd_g get p3 kd_p
kd_w and x2 127
kd get kd_g kd_w
x3 add x2 1
vd_p shr x3 7
vd_g get p3 vd_p
vd_w and x3 127
vd get vd_g vd_w
isn eq kd 1
isp eq kd 2
dg add p7 vd
d6 mul dg 6
d1 add d6 1
dop_p shr d1 7
dop_g get p2 dop_p
dop_w and d1 127
dop get dop_g dop_w
q22 eq dop 22
q23 eq dop 23
q24 eq dop 24
q26 eq dop 26
q28 eq dop 28
f1 or q22 q23
f2 or f1 q24
f3 or f2 q26
fr or f3 q28
fn1 and isn fr
v0 eq vd 0
ow eq p8 1
own0 and v0 ow
fp1 and isp own0
okk or fn1 fp1
e1 eq kd p9
e2 eq vd p10
rs and e1 e2
nrs select rs false true
us0 add vd 4096
us1 select isp us0 vd
w_p shr us1 7
w_g get p6 w_p
w_w and us1 127
w get w_g w_w
nb shr w 16
lu and w 65535
c1 eq nb 1
j1 add p1 1
c2 eq lu j1
cand or isst isfl
i1 and cand okk
i2 and i1 nrs
i3 and i2 c1
inp and i3 c2
ali or inp mv
rn add 6144 vd
rr_p shr rn 7
rr_g get p0 rr_p
rr_w and rn 127
rr get rr_g rr_w
pw add 536870912 vd
res select isn rr pw
self add 268435456 p1
nw select ali res self
ri add 6144 p1
r_p shr ri 7
r_g get p0 r_p
r_w and ri 127
r_h set r_g r_w nw
r set p0 r_p r_h
ret r
end
# the result slot: the node the ret operand (p3 p4) resolves to, when p5 (the value variant of
# a function with an aggregate result) and that node owns storage (not get at select mov)
fn waret u32x128x100 u32x128x128 u32 u32 u32 bool -> u32
isn eq p3 1
ri add 6144 p4
r_p shr ri 7
r_g get p0 r_p
r_w and ri 127
r get r_g r_w
rk shr r 28
rv and r 268435455
rn eq rk 1
g add p2 rv
b6 mul g 6
b1 add b6 1
op_p shr b1 7
op_g get p1 op_p
op_w and b1 127
op get op_g op_w
o25 eq op 25
o27 eq op 27
o18 eq op 18
o1 eq op 1
x1 or o25 o27
x2 or x1 o18
bad or x2 o1
good select bad false true
a1 and p5 isn
a2 and a1 rn
ok and a2 good
res select ok rv 4294967295
ret res
end
# the locals and the frame slot of node p1 (first node p6) in `emitNode` order: the zero test
# of a div/rem, the node's own local (none when it aliases), the frame pointer on the first
# frame slot, the counter of a fold/loop
fn walcl u32x128x100 u32 u32x128x128 u32x128x24 u32x384x65 u32x128x65 u32 -> u32x128x100
g add p6 p1
b6 mul g 6
b1 add b6 1
op_p shr b1 7
op_g get p2 op_p
op_w and b1 127
op get op_g op_w
t_p shr g 7
t_g get p3 t_p
t_w and g 127
t get t_g t_w
tag_p shr t 7
tag_g get p4 tag_p
tag_l and t 127
tag_m mul tag_l 3
tag_i add tag_m 0
tag get tag_g tag_i
iw_p shr t 7
iw_g get p5 iw_p
iw_w and t 127
iw get iw_g iw_w
sz and iw 2147483647
agg ge tag 4
ri add 6144 p1
root_p shr ri 7
root_g get p0 root_p
root_w and ri 127
root get root_g root_w
self add 268435456 p1
ali ne root self
nali select ali false true
n_p shr 12288 7
n_g get p0 n_p
n_w and 12288 127
n get n_g n_w
fr_p shr 12289 7
fr_g get p0 fr_p
fr_w and 12289 127
fr get fr_g fr_w
fp_p shr 12290 7
fp_g get p0 fp_p
fp_w and 12290 127
fp get fp_g fp_w
rs_p shr 12291 7
rs_g get p0 rs_p
rs_w and 12291 127
rs get rs_g rs_w
o10 eq op 10
o11 eq op 11
isdiv or o10 o11
o19 eq op 19
o20 eq op 20
o21 eq op 21
isit or o20 o21
cf or o19 isit
s1 and cf agg
o22 eq op 22
o23 eq op 23
o24 eq op 24
o26 eq op 26
o28 eq op 28
o29 eq op 29
q1 or o22 o23
q2 or q1 o24
q3 or q2 o26
q4 or q3 o28
q5 or q4 o29
bs or s1 q5
bind and nali bs
zd and nali isdiv
nz select zd 1 0
n1 add n nz
na select nali 1 0
n2 add n1 na
isrs eq p1 rs
nrs select isrs false true
bslot and bind nrs
fr2a add fr sz
fr2 select bslot fr2a fr
nofp eq fp 4294967295
needfp and bslot nofp
fp2 select needfp n2 fp
nf select needfp 1 0
n3 add n2 nf
il select isit n3 n
ni select isit 1 0
n4 add n3 ni
a_p shr p1 7
a_g get p0 a_p
a_w and p1 127
a_h set a_g a_w n1
a set p0 a_p a_h
oi add 3072 p1
b_p shr oi 7
b_g get a b_p
b_w and oi 127
b_h set b_g b_w fr
b set a b_p b_h
ii add 9216 p1
c_p shr ii 7
c_g get b c_p
c_w and ii 127
c_h set c_g c_w il
c set b c_p c_h
d_p shr 12288 7
d_g get c d_p
d_w and 12288 127
d_h set d_g d_w n4
d set c d_p d_h
e_p shr 12289 7
e_g get d e_p
e_w and 12289 127
e_h set e_g e_w fr2
e set d e_p e_h
f_p shr 12290 7
f_g get e f_p
f_w and 12290 127
f_h set f_g f_w fp2
f set e f_p f_h
ret f
end
# the analysis table of variant p8 (0 value, 1 owned) of function p7
fn waana u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x45 u32 u32 -> u32x128x100
fb mul p7 7
np call cfw p6 fb 1
rt call cfw p6 fb 3
fn0 call cfw p6 fb 4
cnt call cfw p6 fb 5
rw call cfw p6 fb 6
rk shr rw 28
rv and rw 268435455
rtag_p shr rt 7
rtag_g get p3 rtag_p
rtag_l and rt 127
rtag_m mul rtag_l 3
rtag_i add rtag_m 0
rtag get rtag_g rtag_i
ragg ge rtag 4
v0 eq p8 0
sret and v0 ragg
pb select sret 1 0
z64 call z64
us fold wausn cnt z64 p0 p1 p2 p3 fn0
z0 call z100
ro fold waroot cnt z0 p0 p1 p2 p3 us fn0 p8 rk rv
rs call waret ro p0 fn0 rk rv sret
n0 add pb np
a1_p shr 12288 7
a1_g get ro a1_p
a1_w and 12288 127
a1_h set a1_g a1_w n0
a1 set ro a1_p a1_h
a2_p shr 12289 7
a2_g get a1 a2_p
a2_w and 12289 127
a2_h set a2_g a2_w 0
a2 set a1 a2_p a2_h
a3_p shr 12290 7
a3_g get a2 a3_p
a3_w and 12290 127
a3_h set a3_g a3_w 4294967295
a3 set a2 a3_p a3_h
a4_p shr 12291 7
a4_g get a3 a4_p
a4_w and 12291 127
a4_h set a4_g a4_w rs
a4 set a3 a4_p a4_h
lc fold walcl cnt a4 p0 p2 p3 p5 fn0
ret lc
end
# the frame of an analysed variant, rounded to 16
fn wafrm u32x128x100 -> u32
f_p shr 12289 7
f_g get p0 f_p
f_w and 12289 127
f get f_g f_w
x add f 15
r and x 4294967280
ret r
end
# function p3 is an iteration body over aggregate state (it gets the owned variant too)
fn waown u32x128x45 u32x128x65 u32x384x65 u32 -> bool
fb mul p3 7
np call cfw p0 fb 1
fp call cfw p0 fb 2
rt call cfw p0 fb 3
t0 call wa65 p1 fp
fp1 add fp 1
t1 call wa65 p1 fp1
tag0_p shr t0 7
tag0_g get p2 tag0_p
tag0_l and t0 127
tag0_m mul tag0_l 3
tag0_i add tag0_m 0
tag0 get tag0_g tag0_i
ag ge tag0 4
i1 eq t1 0
n2 ge np 2
a and ag i1
b and a n2
so eq rt t0
r and b so
ret r
end

# ---------------------------------------------------------------------------------------------
# Node code (src/wasm.ts `emitNode`). The node context (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32): 0 index, 1 op, 2 operand count,
# 3 first operand, 4 callee, 5 predicate, 6 type, 7 its tag, 8 its bytes, 9-14 the kinds and
# values of operands 0-2, 15-17 their locals, 18 the parameter base (1 with a result address),
# 19 the node's local, 20 its second local, 21 its frame offset, 22 1 when it is the result
# slot, 23 the frame pointer local, 24 25 the types of operands 0 and 1, 26 1 when it aliases.

# the local of operand (kind p0, value p1): a parameter's, or its root's (roots p2, base p3)
fn waloc u32 u32 u32x128x100 u32 -> u32
isp eq p0 2
ri add 6144 p1
r_p shr ri 7
r_g get p2 r_p
r_w and ri 127
r get r_g r_w
rk shr r 28
rv and r 268435455
rp eq rk 2
nl_p shr rv 7
nl_g get p2 nl_p
nl_w and rv 127
nl get nl_g nl_w
pl add p3 rv
nd select rp pl nl
pp add p3 p1
res select isp pp nd
ret res
end
# the marker of a call to chunk function p1 (its index in the table p0), owned when p2
fn wamk u32x128x16 u32 u32 -> u32
x mul p1 2
i_p shr x 7
i_g get p0 i_p
i_w and x 127
i get i_g i_w
a add 259 i
r add a p2
ret r
end
fn warefst (io,u32,u32,u32) u32 u32 -> (io,u32,u32,u32)
r call waref p0 p2
ret r
end
fn wabst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call wab p0 p2 p3
ret r
end
fn wab2st (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
r call wab2 p0 p2 p3 p4
ret r
end
fn wab3st (io,u32,u32,u32) u32 u32 u32 u32 bool -> (io,u32,u32,u32)
r call wab3 p0 p2 p3 p4 p5
ret r
end
fn wamemst (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
r call wamem p0 p2 p3 p4
ret r
end
# a node's storage (`bindSlot`): the result address or the frame pointer plus the offset
fn waslot (io,u32,u32,u32) (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) bool -> (io,u32,u32,u32)
rs at p1 22
lc at p1 19
off at p1 21
fp at p1 23
isr ne rs 0
nz ne off 0
x select isr 0 fp
a call walx p0 32 x p2
nrs select isr false true
ad and nrs nz
n select ad 1 0
b fold waaddst n a off p2
c call walx b 33 lc p2
ret c
end
fn waslotst (io,u32,u32,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) bool -> (io,u32,u32,u32)
r call waslot p0 p2 p3
ret r
end
# operand p5 + p1 of args page p2, pushed (roots p3, parameter base p4)
fn walop (io,u32,u32,u32) u32 u32x128 u32x128x100 u32 u32 bool -> (io,u32,u32,u32)
oi add p5 p1
xw mul oi 2
x and xw 127
k get p2 x
x1 add x 1
v get p2 x1
l call waloc k v p3 p4
r call wapush p0 k v l p6
ret r
end
fn walpg (io,u32,u32,u32) u32 u32x128x512 u32 u32 u32 u32x128x100 u32 bool -> (io,u32,u32,u32)
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold walop cnt p0 pg p6 p7 lo p8
ret r
end
# push the operands [p2, p3)
fn walist (io,u32,u32,u32) u32x128x512 u32 u32 u32x128x100 u32 bool -> (io,u32,u32,u32)
has lt p2 p3
lp shr p2 6
h1 sub p3 1
hp shr h1 6
d sub hp lp
np add d 1
n select has np 0
r fold walpg n p0 p1 p2 p3 lp p4 p5 p6
ret r
end
# (every operand of [p1, p1 + p2) is a literal, every one is 0)
fn walitop (bool,bool) u32 u32x128 u32 -> (bool,bool)
oi add p3 p1
xw mul oi 2
x and xw 127
k get p2 x
x1 add x 1
v get p2 x1
k3 eq k 3
k4 eq k 4
lk or k3 k4
z eq v 0
a at p0 0
b at p0 1
a2 and a lk
b2 and b z
r rec a2 b2
ret r
end
fn walitpg (bool,bool) u32 u32x128x512 u32 u32 u32 -> (bool,bool)
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold walitop cnt p0 pg lo
ret r
end
fn walits u32x128x512 u32 u32 -> (bool,bool)
hi add p1 p2
has lt p1 hi
lp shr p1 6
h1 sub hi 1
hp shr h1 6
d sub hp lp
np add d 1
n select has np 0
s0 rec true true
r fold walitpg n s0 p0 p1 hi lp
ret r
end
fn walitsst (bool,bool) u32 u32x128x512 u32 u32 -> (bool,bool)
r call walits p2 p3 p4
ret r
end
# `storeAt`: operand (p3 p4, local p5) of a type with tag p1 and p2 bytes at the pushed address
# plus p6
fn wastp (io,u32,u32,u32) u32 u32 u32 u32 u32 bool -> (io,u32,u32,u32)
a call wapush p0 p2 p3 p4 p6
b call wamem a 54 p5 p6
ret b
end
fn wastc (io,u32,u32,u32) u32 u32 u32 u32 u32 bool -> (io,u32,u32,u32)
a call wapush p0 p2 p3 p4 p6
b call wacopy a p5 p6
ret b
end
fn wast (io,u32,u32,u32) u32 u32 u32 u32 u32 u32 bool -> (io,u32,u32,u32)
prim lt p1 4
np select prim 1 0
na select prim 0 1
nz ne p6 0
nprim select prim false true
ag and nprim nz
ng select ag 1 0
a fold wastp np p0 p3 p4 p5 p6 p7
b fold waaddst ng a p6 p7
c fold wastc na b p3 p4 p5 p2 p7
ret c
end
# `elementAddress` of the array operand (p1 p2, local p3) at the index (p4 p5, local p6) of an
# array of p7 elements of p8 bytes; `waeaoff` is the static offset it leaves
fn waeadyn (io,u32,u32,u32) u32 u32 u32 u32 u32 u32 bool -> (io,u32,u32,u32)
a call wapush p0 p2 p3 p4 p7
lm sub p5 1
pw and p5 lm
p2z eq pw 0
c select p2z lm p5
b call waci a c p7
op select p2z 113 112
d call wab b op p7
e call waci d p6 p7
f call wab e 108 p7
g call wab f 106 p7
ret g
end
fn waea (io,u32,u32,u32) u32 u32 u32 u32 u32 u32 u32 u32 bool -> (io,u32,u32,u32)
a call wapush p0 p1 p2 p3 p9
lit eq p4 3
nd select lit 0 1
b fold waeadyn nd a p4 p5 p6 p7 p8 p9
ret b
end
fn waeaoff u32 u32 u32 u32 -> u32
lit eq p0 3
m rem p1 p2
o mul m p3
r select lit o 0
ret r
end
fn wabinop u32 -> u32
r0 mov 0
e2 eq p0 2
r2 select e2 106 r0
e3 eq p0 3
r3 select e3 107 r2
e4 eq p0 4
r4 select e4 108 r3
e5 eq p0 5
r5 select e5 113 r4
e6 eq p0 6
r6 select e6 114 r5
e7 eq p0 7
r7 select e7 115 r6
e8 eq p0 8
r8 select e8 116 r7
e9 eq p0 9
r9 select e9 118 r8
e12 eq p0 12
r12 select e12 70 r9
e13 eq p0 13
r13 select e13 71 r12
e14 eq p0 14
r14 select e14 73 r13
e15 eq p0 15
r15 select e15 77 r14
e16 eq p0 16
r16 select e16 75 r15
e17 eq p0 17
r17 select e17 79 r16
ret r17
end

# The node groups, each run once for its ops: (state, trip, context, roots, args, types, tlist,
# info, callee table, on).
# mov (op 1) of a scalar
fn wgmov (io,u32,u32,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x100 u32x128x512 u32x384x65 u32x128x65 u32x128x65 u32x128x16 bool -> (io,u32,u32,u32)
k0 at p2 9
v0 at p2 10
l0 at p2 15
lc at p2 19
a call wapush p0 k0 v0 l0 p9
b call walx a 33 lc p9
ret b
end
# ops 2-9 and 12-17
fn wgbin (io,u32,u32,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x100 u32x128x512 u32x384x65 u32x128x65 u32x128x65 u32x128x16 bool -> (io,u32,u32,u32)
op at p2 1
k0 at p2 9
v0 at p2 10
k1 at p2 11
v1 at p2 12
l0 at p2 15
l1 at p2 16
lc at p2 19
a call wapush p0 k0 v0 l0 p9
b call wapush a k1 v1 l1 p9
oc call wabinop op
c call wab b oc p9
d call walx c 33 lc p9
ret d
end
# div (10) and rem (11): a zero divisor becomes 1 and the total result is selected
fn wgdiv (io,u32,u32,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x100 u32x128x512 u32x384x65 u32x128x65 u32x128x65 u32x128x16 bool -> (io,u32,u32,u32)
op at p2 1
k0 at p2 9
v0 at p2 10
k1 at p2 11
v1 at p2 12
l0 at p2 15
l1 at p2 16
lc at p2 19
il at p2 20
isd eq op 10
a call wapush p0 k1 v1 l1 p9
b call wab a 69 p9
c call walx b 33 il p9
nd select isd 1 0
nr select isd 0 1
d fold wacist nd c 4294967295 p9
e fold wapushst nr d k0 v0 l0 p9
f call wapush e k0 v0 l0 p9
g call wapush f k1 v1 l1 p9
h call walx g 32 il p9
i call wab h 114 p9
oc select isd 110 112
jj call wab i oc p9
k call walx jj 32 il p9
l call wab k 27 p9
m call walx l 33 lc p9
ret m
end
# select (18)
fn wgsel (io,u32,u32,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x100 u32x128x512 u32x384x65 u32x128x65 u32x128x65 u32x128x16 bool -> (io,u32,u32,u32)
k0 at p2 9
v0 at p2 10
k1 at p2 11
v1 at p2 12
k2 at p2 13
v2 at p2 14
l0 at p2 15
l1 at p2 16
l2 at p2 17
lc at p2 19
a call wapush p0 k1 v1 l1 p9
b call wapush a k2 v2 l2 p9
c call wapush b k0 v0 l0 p9
d call wab c 27 p9
e call walx d 33 lc p9
ret e
end
# call (19): a scalar result to the local, an aggregate one written to the node's storage
fn wgcall (io,u32,u32,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x100 u32x128x512 u32x384x65 u32x128x65 u32x128x65 u32x128x16 bool -> (io,u32,u32,u32)
tag at p2 7
agg ge tag 4
fa at p2 3
na at p2 2
ce at p2 4
lc at p2 19
pb at p2 18
hi add fa na
nag select agg 1 0
nsc select agg 0 1
a fold waslotst nag p0 p2 p9
b fold walxst nag a 32 lc p9
c call walist b p4 fa hi p3 pb p9
m call wamk p8 ce 0
d call waref c m
e fold walxst nsc d 33 lc p9
ret e
end
# the arguments of a fold/loop body or predicate: state, counter, extra operands [p4, p5)
fn waiargs (io,u32,u32,u32) u32 u32 u32x128x512 u32 u32 u32x128x100 u32 bool -> (io,u32,u32,u32)
a call walx p0 32 p1 p8
b call walx a 32 p2 p8
c call walist b p3 p4 p5 p6 p7 p8
ret c
end
fn waiargsst (io,u32,u32,u32) u32 u32 u32 u32x128x512 u32 u32 u32x128x100 u32 bool -> (io,u32,u32,u32)
r call waiargs p0 p2 p3 p4 p5 p6 p7 p8 p9
ret r
end
# fold (20) and loop (21): a counted loop calling the body (the owned variant for aggregate
# state), the predicate first for a loop
fn wgiter (io,u32,u32,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x100 u32x128x512 u32x384x65 u32x128x65 u32x128x65 u32x128x16 bool -> (io,u32,u32,u32)
j at p2 0
op at p2 1
na at p2 2
fa at p2 3
ce at p2 4
pr at p2 5
tag at p2 7
size at p2 8
k0 at p2 9
v0 at p2 10
k1 at p2 11
v1 at p2 12
l0 at p2 15
l1 at p2 16
pb at p2 18
il at p2 20
ali at p2 26
agg ge tag 4
isal ne ali 0
nali select isal false true
sl call waloc 1 j p3 pb
ag1 and agg nali
n1 select ag1 1 0
a fold waslotst n1 p0 p2 p9
b fold walxst n1 a 32 sl p9
c fold wapushst n1 b k1 v1 l1 p9
d fold wacopyst n1 c size p9
nsc select agg 0 1
e fold wapushst nsc d k1 v1 l1 p9
f fold walxst nsc e 33 sl p9
g call waci f 0 p9
h call walx g 33 il p9
i call wab2 h 2 64 p9
k call wab2 i 3 64 p9
l call walx k 32 il p9
m call wapush l k0 v0 l0 p9
o call wab m 79 p9
q call wab2 o 13 1 p9
isl eq op 21
nl select isl 1 0
lo add fa 2
hi add fa na
r fold waiargsst nl q sl il p4 lo hi p3 pb p9
pm call wamk p8 pr 0
s fold warefst nl r pm
u fold wab3st nl s 69 13 1 p9
w call waiargs u sl il p4 lo hi p3 pb p9
own select agg 1 0
bm call wamk p8 ce own
x call waref w bm
y fold walxst nsc x 33 sl p9
z1 call walx y 32 il p9
z2 call waci z1 1 p9
z3 call wab z2 106 p9
z4 call walx z3 33 il p9
z5 call wab2 z4 12 0 p9
z6 call wab2 z5 11 11 p9
ret z6
end
# arr (22) and text (24): a literal of four or more scalars is filled (all zero) or copied from
# the pool, anything else is stored element by element
fn wazfill (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call waci p0 0 p3
b call waci a p2 p3
c call wab3 b 252 11 0 p3
ret c
end
fn wapoolcp (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call wapool p0
b call wacopy a p2 p3
ret b
end
# element p3 + p1 (args page p2) of a list starting at p4: stored at local p5 plus its offset
fn waelop (io,u32,u32,u32) u32 u32x128 u32 u32 u32 u32 u32 u32x128x100 u32 bool -> (io,u32,u32,u32)
oi add p3 p1
xw mul oi 2
x and xw 127
k get p2 x
x1 add x 1
v get p2 x1
l call waloc k v p8 p9
e sub oi p4
off mul e p7
a call walx p0 32 p5 p10
b call wast a p6 p7 k v l off p10
ret b
end
fn waelpg (io,u32,u32,u32) u32 u32x128x512 u32 u32 u32 u32 u32 u32 u32 u32x128x100 u32 bool -> (io,u32,u32,u32)
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold waelop cnt p0 pg lo p6 p7 p8 p9 p10 p11 p12
ret r
end
fn waelems (io,u32,u32,u32) u32 u32x128x512 u32 u32 u32 u32 u32 u32x128x100 u32 bool -> (io,u32,u32,u32)
has lt p3 p4
lp shr p3 6
h1 sub p4 1
hp shr h1 6
d sub hp lp
np add d 1
n select has np 0
r fold waelpg n p0 p2 p3 p4 lp p3 p5 p6 p7 p8 p9 p10
ret r
end
fn wgarr (io,u32,u32,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x100 u32x128x512 u32x384x65 u32x128x65 u32x128x65 u32x128x16 bool -> (io,u32,u32,u32)
t at p2 6
na at p2 2
fa at p2 3
size at p2 8
lc at p2 19
pb at p2 18
et_p shr t 7
et_g get p5 et_p
et_l and t 127
et_m mul et_l 3
et_i add et_m 2
et get et_g et_i
etag_p shr et 7
etag_g get p5 etag_p
