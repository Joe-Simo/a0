a get gs sq
na add 10240 nv
nb sub nv p4
ni select nin na nb
np shr ni 7
nq and ni 127
ha get p2 np
hb get p3 np
hs select nin ha hb
b get hs nq
e eq a b
r and p0 e
ret r
end
