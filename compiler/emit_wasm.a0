cn2_m2 select cf 1 0
m2 fold wxrs cn2_m2 m1 d j 2 1
cn3_m3 select ncf 1 0
m3 fold wxpr cn3_m3 m2 c0 s0
cn4_m4 select ncf 1 0
m4 fold wxpr cn4_m4 m3 c1 s1
cn5_m5 select ncf 1 0
m5 fold wxop cn5_m5 m4 bo
cn6_m6 select ncf 1 0
m6 fold wxset cn6_m6 m5 d j
ret m6
end
# div (10) and rem (11): a zero divisor becomes 1 and the total result is selected
fn wxhdiv u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) -> u32x128x512
d at p2 0
j at p2 1
op at p2 3
c0 at p2 17
s0 at p2 18
c1 at p2 19
s1 at p2 20
m1 fold wxnl 1 p0
zl call wxg m1 16
m2 fold wxpr 1 m1 c1 s1
m3 fold wxop 1 m2 69
m4 fold wxls 1 m3 zl
isd eq op 10
nd select isd false true
cn1_m5 select isd 1 0
m5 fold wxkc cn1_m5 m4 4294967295
cn2_m6 select nd 1 0
