sp_gw and 7 127
sp_gg get p0 sp_gp
sp get sp_gg sp_gw
full ge sp 512
ok select full 0 1
a mul sp 4
ad add a 1344
m1__gcondb ne ok 0
m1__pg shr ad 7
m1__w and ad 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w p2
m1__r_o get p0 m1__pg
m1__r_s select m1__gcondb m1__g2 m1__r_o
