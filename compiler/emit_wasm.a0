fn wanmb (io,u32,u32,u32) u32 u32x128x400 u32 -> (io,u32,u32,u32)
a add p3 p1
b shr a 7
c get p2 b
d and a 127
e get c d
f call wab p0 e true
ret f
end
fn watrail io u32 u32x128x16 u32x128x8 u32 -> io
a add p4 p1
b mul a 2
c shr b 7
d get p2 c
e and b 127
f get d e
g add b 1
h shr g 7
i get p2 h
j and g 127
k get i j
l shr a 7
m get p3 l
n and a 127
o get m n
p write p0 f
q write p k
r write q o
ret r
end
# ---------------------------------------------------------------------------------------------
# Functions and chunks. Per function the chunk writes one record: three words (the POOL, META
# and CODE word counts), then those words (the driver concatenates every record's POOL, then
# every META, then every CODE: tools/selfhost-wasm.ts). POOL: per pool occurrence of the function
# (src/wasm.ts `#poolEntry`) its element count and the elements; META: literal count, io flag,
# stack depth, name length and bytes, variant count, per variant (parameters, result, locals,
# v128 locals, 0, the marker words, 0, byte count); CODE: each variant's body, a byte per
# word, a call or pool address as one marker word (256 + helper, 259 + variant index, 2^31 + the
# occurrence).

# page p1 + 160 of the machine table (the instruction pages)
fn wxpg u32x128x512 u32 -> u32x128
a add p1 160
b get p0 a
ret b
end
# the instruction table of machine table p2: page p1 of it is page 160 + p1
fn wxcpi u32x128x352 u32 u32x128x512 -> u32x128x352
a call wxpg p2 p1
b set p0 p1 a
ret b
end
# word p1 of a code table is a marker word (>= 256)
fn wxcm u32 u32 u32x128x512 -> u32
a shr p1 7
b and p1 127
c get p2 a
d get c b
e ge d 256
f select e 1 0
g add p0 f
ret g
end
# write word p1 of the code table when it is a marker
fn wxwm io u32 u32x128x512 -> io
a shr p1 7
b and p1 127
c get p2 a
d get c b
e ge d 256
f select e 1 0
g fold wawr f p0 d
ret g
end
# write word p1 of the code table
fn wxwc io u32 u32x128x512 -> io
a shr p1 7
b and p1 127
c get p2 a
d get c b
e write p0 d
ret e
end
# operand p1 (from p2, table p3) of a pool literal: its value
fn wxpel io u32 u32 u32x128x512 -> io
a add p2 p1
b call wxov p3 a
c write p0 b
ret c
end
# pool occurrence p5 + p1 of machine table p2 (nodes p3, operands p4): its element count and elements
fn wxpoc io u32 u32x128x512 u32x128x132 u32x128x512 u32 -> io
a add p5 p1
b add 3392 a
c shr b 7
d and b 127
e get p2 c
f get e d
g call wxnw p3 f 2
h call wxnw p3 f 3
i write p0 g
j fold wxpel g i h p4
ret j
end
# the word count of the pool occurrences [p2, p3) of machine table p1: (count, trip) state
fn wxpsz u32 u32 u32x128x512 u32x128x132 u32 -> u32
a add p4 p1
b add 3392 a
c shr b 7
d and b 127
e get p2 c
f get e d
g call wxnw p3 f 2
h add g 1
i add p0 h
ret i
end
# one variant's META (parameters, result, locals, v128 locals, 0, the markers, 0, bytes): p1 the
# machine table, p2 its code table, p3 whether it is the value variant of an aggregate-free function
fn wxmv io u32x128x512 u32x128x512 bool -> io
a shr 65533 7
b and 65533 127
c get p2 a
d get c b
e shr 65534 7
f and 65534 127
g get p2 e
h get g f
i shr 65535 7
j and 65535 127
k get p2 i
l get k j
m mul 0 128
n add m 128
o add n 4
p shr o 7
q and o 127
r get p1 p
s get r q
t shr 10 7
u and 10 127
v get p1 t
w get v u
x add w s
y select p3 1 0
z fold wxcm d 0 p2
aa sub d z
ab write p0 x
ac write ab y
ad write ac h
ae write ad l
af write ae 0
ag fold wxwm d af p2
ah write ag 0
ai write ah aa
ret ai
end
# the META of a variant that is not a value variant with a scalar result (a fold trip of 1)
fn wxmvf io u32 u32x128x512 u32x128x512 -> io
a call wxmv p0 p2 p3 false
ret a
end
# name byte p3 + p1 of the name pool p2
fn wxnmb io u32 u32x128x400 u32 -> io
a add p3 p1
b shr a 7
c get p2 b
d and a 127
e get c d
f write p0 e
ret f
end
# page p1 of machine table p2 into code table p0 (a dump of the machine state, for tests)
fn wxdmq u32x128x512 u32 u32x128x512 -> u32x128x512
a get p2 p1
b set p0 p1 a
ret b
end
# page p1 of instruction table p2 into code table p0 (a dump of the instruction list, for tests)
fn wxdmp u32x128x512 u32 u32x128x352 -> u32x128x512
a get p2 p1
b set p0 p1 a
ret b
end
# call table word p2 := p3 (u32x128x16: index and stack depth per function, words 2f and 2f + 1)
fn wxdts u32x128x16 u32 u32 u32 -> u32x128x16
a shr p2 7
b and p2 127
c get p0 a
d set c b p3
e set p0 a d
ret e
end
# miss entry p1 of machine table p2 appended to the chunk's list (count, table)
fn wxmg (u32,u32x128x8) u32 u32x128x512 -> (u32,u32x128x8)
a at p0 0
b at p0 1
c add 32 p1
d shr c 7
e and c 127
f get p2 d
g get f e
h shr a 7
i and a 127
j get b h
k set j i g
l set b h k
m add a 1
n rec m l
ret n
end
