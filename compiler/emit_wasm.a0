nlz select lz 0 1
n0 select lz 1 0
c fold wabst n0 a 0 true
d fold wabst nlz c 1 true
e fold waulst nlz d lc true
f fold wabst nlz e 127 true
fz eq fr 0
nf select fz 0 1
g fold wab2st nf f 35 0 true
h fold wacist nf g fr true
i fold wabst nf h 107 true
j fold walxst nf i 34 fp true
k fold wab2st nf j 36 0 true
nw add nb nr
n127 add nw 127
np shr n127 7
l fold wkcpg np k nw p3 nh
m fold walxst nf l 32 fp true
n fold wacist nf m fr true
o fold wabst nf n 106 true
q fold wab2st nf o 36 0 true
r call wab q 11 true
ret r
end
# function p1's variants (field 2 of the state: the index of its first variant)
fn wkcfn (io,u32,u32,u32) u32 u32x128x256 u32x128x64 u32x128x32 bool -> (io,u32,u32,u32)
b mul p1 4
b2 add b 2
nv_p shr b2 7
nv_g get p3 nv_p
nv_w and b2 127
nv get nv_g nv_w
b3 add b 3
ob_p shr b3 7
ob_g get p3 ob_p
ob_w and b3 127
ob get ob_g ob_w
fo call wkfocc p4 ob
vi at p0 2
r fold wkcvar nv p0 p2 fo vi p5
t at r 0
c at r 1
m at r 3
vi2 add vi nv
o rec t c vi2 m
ret o
end
# the pool: the words of page 80 + p1 as bytes
fn wkdw (io,u32,u32,u32) u32 u32x128 bool -> (io,u32,u32,u32)
w get p2 p1
b0 and w 255
s1 shr w 8
b1 and s1 255
s2 shr w 16
b2 and s2 255
b3 shr w 24
a call wab2 p0 b0 b1 p3
b call wab2 a b2 b3 p3
ret b
end
fn wkdpg (io,u32,u32,u32) u32 u32x128x500 u32 bool -> (io,u32,u32,u32)
pi add 80 p1
pg get p2 pi
base mul p1 128
rest sub p3 base
big gt rest 128
cnt select big 128 rest
r fold wkdw cnt p0 pg p4
ret r
end
fn wkdata (io,u32,u32,u32) u32 u32x128x500 u32 bool -> (io,u32,u32,u32)
