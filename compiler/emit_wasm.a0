ac call wab2 ab 11 11 p2
ret ac
end
fn wkhwr (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a add p1 2
b mul a 4
c mul p2 4
d add b c
e call wab p0 0 p3
f call walx e 32 0 p3
g call wamem f 40 d p3
h call waci g p2 p3
i call wab h 73 p3
j call wab2 i 4 64 p3
k call walx j 32 0 p3
l call walx k 32 0 p3
m call wamem l 40 d p3
n call waci m 4 p3
o call wab2 n 108 106 p3
p call walx o 32 1 p3
q call wamem p 54 b p3
r call walx q 32 0 p3
s call walx r 32 0 p3
t call wamem s 40 d p3
u call waci t 1 p3
v call wab u 106 p3
w call wamem v 54 d p3
x call wab2 w 11 11 p3
ret x
end
fn wkhpu (io,u32,u32,u32) bool u32 -> (io,u32,u32,u32)
a call wab3 p0 1 1 127 p1
b call walx a 32 0 p1
c call walx b 32 2 p1
d call walx c 16 p2 p1
e call waci d 0 p1
f call walx e 33 3 p1
g call wab2 f 2 64 p1
h call wab2 g 3 64 p1
i call walx h 32 3 p1
j call walx i 32 2 p1
k call wab j 79 p1
l call wab2 k 13 1 p1
m call walx l 32 0 p1
n call walx m 32 1 p1
o call walx n 32 3 p1
p call waci o 4 p1
q call wab2 p 108 106 p1
r call wamem q 40 0 p1
s call walx r 16 p2 p1
t call walx s 32 3 p1
u call waci t 1 p1
v call wab u 106 p1
w call walx v 33 3 p1
x call wab2 w 12 0 p1
y call wab3 x 11 11 11 p1
ret y
end
# one io helper: its size, then its body (state in and out: io, bytes so far)
fn wkhr1 (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a at p0 0
b at p0 1
c rec a 0 0 0
d call wkhrd c p2 false
e at d 1
f at d 0
g rec f b 0 0
h call waul g e p3
i call wkhrd h p2 p3
j at i 0
k at i 1
l rec j k 0 0
ret l
end
fn wkhw1 (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
a at p0 0
b at p0 1
c rec a 0 0 0
d call wkhwr c p2 p3 false
e at d 1
f at d 0
g rec f b 0 0
h call waul g e p4
i call wkhwr h p2 p3 p4
j at i 0
k at i 1
l rec j k 0 0
ret l
end
# p2: the function index of io:write
fn wkhp1 (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a at p0 0
b at p0 1
c rec a 0 0 0
d call wkhpu c false p2
e at d 1
f at d 0
g rec f b 0 0
h call waul g e p3
i call wkhpu h p3 p2
ret i
end
# the three helpers, each with its size first
# the kept io helpers (p5 read, p6 write, p7 puts: 1 when kept), each with its size first
fn wkhelp (io,u32,u32,u32) u32 u32 u32 bool u32 u32 u32 -> (io,u32,u32,u32)
r1 fold wkhr1 p5 p0 p2 p4
r2 fold wkhw1 p6 r1 p2 p3 p4
r3 fold wkhp1 p7 r2 p5 p4
ret r3
end
# the helpers' code section bytes (sizes included)
fn wkhsum io u32 u32 u32 u32 u32 -> (io,u32)
a rec p0 0 0 0
b call wkhelp a 0 p1 p2 false p3 p4 p5
c at b 0
d at b 1
e rec c d
ret e
end
# body size of variant p1 (p2: the io helpers are present)
fn wkbsz u32x128x256 u32 bool -> u32
a mul p1 8
b add a 1
c shr b 7
d get p0 c
e and b 127
f get d e
g add a 2
h shr g 7
i get p0 h
j and g 127
k get i j
l add a 3
m shr l 7
n get p0 m
o and l 127
p get n o
q add a 4
r shr q 7
s get p0 r
t and q 127
u get s t
v add a 6
w shr v 7
x get p0 w
y and v 127
z get x y
aa add a 7
ab shr aa 7
ac get p0 ab
ad and aa 127
ae get ac ad
af eq f 0
ag eq k 0
ah call wauln f
ai call wauln k
aj add ah 1
ak add ai 1
al select af 0 aj
am select ag 0 ak
an add al am
ao add an 1
ap select p2 ae z
aq add ao u
ar add aq ap
as add ar 1
ret as
end
fn wkcsz u32 u32 u32x128x256 bool -> u32
a call wkbsz p2 p1 p3
b call wauln a
c add b a
d add p0 c
ret d
end
fn wkcszg u32 u32 u32 u32x128x256 bool -> u32
a call wkcsz p0 p2 p3 p4
ret a
end
# the size of variant p1's body (with its length prefix) when the plan p4 keeps it
fn wkcszt u32 u32 u32x128x256 bool u32x128x64 -> u32
a add p1 3
tv call wk64g p4 a
kk ne tv 4294967295
cnt select kk 1 0
r fold wkcszg cnt p0 p1 p2 p3
ret r
end
# word p1 of a page of code: a byte, a call marker or a pool marker (literal addresses p3,
# p4 the io helper count)
fn wkcw (io,u32,u32,u32) u32 u32x128 u32x128x8 u32x128x64 bool -> (io,u32,u32,u32)
a get p2 p1
b lt a 256
c ge a 2147483648
d ge a 259
e select c false true
f and d e
g select b false true
h select f false true
i and g e
j and i h
k select b 1 0
l fold wabst k p0 a p5
m sub a 259
m3 add m 3
tv call wk64g p4 m3
o sub a 256
th call wk64g p4 o
p select f tv th
q or f j
r select q 1 0
s fold walxst r l 16 p p5
t and a 2147483647
u shr t 7
v get p3 u
w and t 127
x get v w
y select c 1 0
z fold wacist y s x p5
ret z
end
# page p1 of a variant's p2 code words, read and written
fn wkcpg (io,u32,u32,u32) u32 u32 u32x128x8 u32x128x64 bool -> (io,u32,u32,u32)
a at p0 0
b at p0 1
c at p0 2
d at p0 3
e mul p1 128
f sub p2 e
g gt f 128
h select g 128 f
i call zpage
j rec i a
k fold rbyte h j
l at k 0
m at k 1
n rec m b c d
o fold wkcw h n l p3 p4 p5
ret o
end
# the literal addresses of a function: occurrences [p1, p1 + 1024)
fn wkfow u32x128 u32 u32x128 u32x128 u32 -> u32x128
a add p4 p1
b ge a 128
c and a 127
d get p2 c
e get p3 c
f select b e d
g set p0 p1 f
ret g
end
fn wkfop u32x128x8 u32 u32x128x32 u32 -> u32x128x8
a mul p1 128
b add p3 a
c shr b 7
d and b 127
e add c 1
f get p2 c
g get p2 e
h call zpage
i fold wkfow 128 h f g d
j set p0 p1 i
ret j
end
fn wkfocc u32x128x32 u32 -> u32x128x8
a call z8
b fold wkfop 8 a p0 p1
ret b
end
# variant p4 + p1: size, local groups (i32, v128), code, end
fn wkcvar (io,u32,u32,u32) u32 u32x128x256 u32x128x8 u32 u32x128x64 -> (io,u32,u32,u32)
a add p4 p1
a3 add a 3
tv call wk64g p5 a3
kk ne tv 4294967295
b call wkbsz p2 a false
d mul a 8
e add d 1
f shr e 7
g get p2 f
h and e 127
i get g h
j add d 2
k shr j 7
l get p2 k
m and j 127
n get l m
o add d 3
p shr o 7
q get p2 p
r and o 127
s get q r
t add d 4
u shr t 7
v get p2 u
w and t 127
x get v w
y add d 5
z shr y 7
aa get p2 z
ab and y 127
ac get aa ab
ad call waul p0 b kk
ae eq i 0
af eq n 0
ag select ae 0 1
ah select af 0 1
ai add ag ah
aj call wab ad ai kk
ak fold waulst ag aj i kk
al fold wabst ag ak 127 kk
am fold waulst ah al n kk
an fold wabst ah am 123 kk
ao add x ac
ap add ao 127
aq shr ap 7
ar fold wkcpg aq an ao p3 p5 kk
as call wab ar 11 kk
ret as
end
# function p1's variants (field 2 of the state: the index of its first variant)
fn wkcfn (io,u32,u32,u32) u32 u32x128x256 u32x128x64 u32x128x32 u32x128x64 -> (io,u32,u32,u32)
a mul p1 4
b add a 2
c shr b 7
d get p3 c
e and b 127
f get d e
g add a 3
h shr g 7
i get p3 h
j and g 127
k get i j
l call wkfocc p4 k
m at p0 2
n fold wkcvar f p0 p2 l m p5
o at n 0
p at n 1
q at n 3
r add m f
s rec o p r q
ret s
end
# the pool: word p1 of the page starting at virtual word p6 (A p2, B p3, bank boundary p4) as bytes
fn wkdw (io,u32,u32,u32) u32 u32x128x512 u32x128x512 u32 bool u32 -> (io,u32,u32,u32)
v add p6 p1
sin lt v p4
sa add 10240 v
sb sub v p4
si select sin sa sb
sp shr si 7
sq and si 127
ga get p2 sp
gb get p3 sp
gs select sin ga gb
a get gs sq
b and a 255
c shr a 8
d and c 255
e shr a 16
f and e 255
g shr a 24
h call wab2 p0 b d p5
i call wab2 h f g p5
ret i
end
fn wkdpg (io,u32,u32,u32) u32 u32x128x512 u32 bool u32x128x512 u32 -> (io,u32,u32,u32)
c mul p1 128
d sub p3 c
e gt d 128
f select e 128 d
g fold wkdw f p0 p2 p5 p6 p4 c
ret g
end
fn wkdata (io,u32,u32,u32) u32 u32x128x512 u32 bool u32x128x512 u32 -> (io,u32,u32,u32)
a mul p3 4
b call wab p0 11 true
c call wauln a
d add c a
e add d 6
f call waul b e true
g call wab3 f 1 0 65 true
h call wasl g 1024 true
i call wab h 11 true
j call waul i a true
k add p3 127
l shr k 7
m fold wkdpg l j p2 p3 true p5 p6
ret m
end
fn wkhsumst (io,u32) u32 u32 u32 u32 u32 u32 -> (io,u32)
a at p0 0
b call wkhsum a p2 p3 p4 p5 p6
ret b
end
fn wkhelpst (io,u32,u32,u32) u32 u32 u32 u32 u32 u32 -> (io,u32,u32,u32)
a call wkhelp p0 0 p2 p3 true p4 p5 p6
ret a
end
fn wkdatast (io,u32,u32,u32) u32 u32x128x512 u32 u32x128x512 u32 -> (io,u32,u32,u32)
a call wkdata p0 0 p2 p3 true p4 p5
ret a
end
# the module (io lv lf ln occ lt version vlen incap outcap functions variants depth io words)
fn wkmod io u32x128x256 u32x128x64 u32x128x64 u32x128x32 u32x128x512 u32x128 u32 u32 u32 u32 u32 u32 u32 u32 u32x128x64 u32x128x16 u32 u32 u32x128x512 u32 -> io
ph0 call wk64g p15 0
ph1 call wk64g p15 1
ph2 call wk64g p15 2
pg0 ne ph0 4294967295
pg1 ne ph1 4294967295
pg2 ne ph2 4294967295
pk0 select pg0 1 0
pk1 select pg1 1 0
pk2 select pg2 1 0
phk1 add pk0 pk1
phk add phk1 pk2
d add phk p18
e rec p0 0 0 0
f call wab3 e 0 97 115 true
g call wab3 f 109 1 0 true
h call wab2 g 0 0 true
i add 3 p7
j call wab h 0 true
k call waul j i true
l call wkcus k p6 p7 true
m call zk256
n rec m m 0
o0 fold wktyk pk0 n 3
o1 fold wktyk pk1 o0 4
o fold wktyk pk2 o1 6
p fold wktyvt p11 o p1 p15
q at p 0
r at p 1
s at p 2
t at l 0
u rec t 0 0 0
v call wktypes u r s false
w at v 1
x at v 0
y rec x 0 0 0
z call wab y 1 true
aa call waul z w true
ab call wktypes aa r s true
ac at ab 0
ad rec ac 0 0 0
ae call wkfuncs ad p1 p11 q p18 pk0 pk1 pk2 p15 false
af at ae 1
ag at ae 0
ah rec ag 0 0 0
ai call wab ah 3 true
aj call waul ai af true
ak call wkfuncs aj p1 p11 q p18 pk0 pk1 pk2 p15 true
al mul p14 4
am add 1024 al
an add am 15
ao and an 4294967280
ap add p12 15
aq and ap 4294967280
ar lt aq 16
as select ar 16 aq
au add ao as
av add au 65535
aw shr av 16
ax eq aw 0
ay select ax 1 aw
az call wauln ay
a0 add az 2
a1 call wab ak 5 true
a2 call waul a1 a0 true
a3 call wab2 a2 1 0 true
a4 call waul a3 ay true
a5 call wasln au
a6 add a5 4
a7 mul a6 2
a8 add a7 1
a9 call wab a4 6 true
ba call waul a9 a8 true
bb call wab ba 2 true
bc call wab3 bb 127 1 65 true
bd call wasl bc au true
be call wab bd 11 true
bf call wab3 be 127 0 65 true
bg call wasl bf au true
bh call wab bg 11 true
bi at bh 0
bj rec bi 0 0 0
bk call wkexports bj p10 p2 p3 p15 p16 p17 false
bl at bk 1
bm at bk 0
bn rec bm 0 0 0
bo call wab bn 7 true
bp call waul bo bl true
bq call wkexports bp p10 p2 p3 p15 p16 p17 true
br at bq 0
bs rec br 0
bt fold wkhsumst 1 bs p8 p9 pk0 pk1 pk2
bu at bt 0
bv at bt 1
bw fold wkcszt p11 0 p1 false p15
bx call wauln d
by add bx bv
bz add by bw
b0 rec bu 0 0 0
b1 call wab b0 10 true
b2 call waul b1 bz true
b3 call waul b2 d true
b4 fold wkhelpst 1 b3 p8 p9 pk0 pk1 pk2
b5 at b4 0
b6 at b4 1
b7 rec b5 b6 0 0
b8 fold wkcfn p10 b7 p1 p2 p4 p15
b9 ne p14 0
ca select b9 1 0
cb fold wkdatast ca b8 p5 p14 p19 p20
cc at cb 0
ret cc
end
fn wkmodst io u32 u32x128x256 u32x128x64 u32x128x64 u32x128x32 u32x128x512 u32x128 u32 u32 u32 u32 u32 u32 u32 u32 u32x128x64 u32x128x16 u32 u32 u32x128x512 u32 -> io
a call wkmod p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15 p16 p17 p18 p19 p20 p21
ret a
end
# ---------------------------------------------------------------------------------------------
# Export pruning (src/wasm.ts `assembleWasm` with `layout.exports`). The plan: K, a table of
# 64 pages whose word 0-2 are the io helpers (read, write, puts) and word 3 + v variant v, 1 when
# the function it stands for is kept. Without a list (the input word 0) every variant, and the
# io helpers when the program uses io, are kept and every function is exported. With a list of
# n names (the word n + 1) the roots are the first variant (the value variant) of each function
# named, and what the roots reach through call markers is kept: the markers of a variant (the
# calls and helper markers of its META) are in the edge table E (u32x128x500), each variant's
# markers then a 0, in variant order. T is K turned into the function index each kept variant
# and helper gets in the module (the kept helpers first, then the kept variants in order;
# 4294967295 for one left out). R: 1 for each exported function. The stack and the constant pool
# are those of the whole program, as in src/wasm.ts.
# one export name into X (names, from p3) and its start and length into Y: (X, Y, io, offset)
fn wkxrd (u32x128x64,u32x128x16,io,u32) u32 -> (u32x128x64,u32x128x16,io,u32)
xx at p0 0
yy at p0 1
tok at p0 2
off at p0 3
r call wardw tok
len at r 0
tok2 at r 1
xi rec xx tok2
xr call wkrdln xi off len
xx2 at xr 0
tok3 at xr 1
e2 mul p1 2
yy1 call wk16s yy e2 off
e3 add e2 1
yy2 call wk16s yy1 e3 len
off2 add off len
o rec xx2 yy2 tok3 off2
ret o
end
# the index of the first variant of every function (FV, running count)
fn wkfv (u32x128x16,u32) u32 u32x128x64 -> (u32x128x16,u32)
fvt at p0 0
run at p0 1
fvt2 call wk16s fvt p1 run
fi4 mul p1 4
fi5 add fi4 2
cnt call wk64g p2 fi5
run2 add run cnt
r rec fvt2 run2
ret r
end
# byte p1 of the name of function (at p3 in N p2) is byte p1 of the export name (at p5 in X p4)
fn wkeqb bool u32 u32x128x64 u32 u32x128x64 u32 -> bool
ni add p3 p1
nb call wk64g p2 ni
xi add p5 p1
xb call wk64g p4 xi
e eq nb xb
r and p0 e
ret r
end
# function p1 against export p7: a name match roots the function (state K, R, matches)
fn wkrootf (u32x128x64,u32x128x16,u32) u32 u32x128x64 u32x128x64 u32x128x64 u32x128x16 u32x128x16 u32 -> (u32x128x64,u32x128x16,u32)
kt at p0 0
rt at p0 1
fd at p0 2
f4 mul p1 4
ns call wk64g p2 f4
f41 add f4 1
nl call wk64g p2 f41
e2 mul p7 2
xs call wk16g p5 e2
e3 add e2 1
xl call wk16g p5 e3
leq eq nl xl
cnt select leq nl 0
same fold wkeqb cnt true p3 ns p4 xs
hit and leq same
fv call wk16g p6 p1
kidx add fv 3
widx select hit kidx 8190
kt2 call wk64s kt widx 1
ro call wk16g rt p1
rn select hit 1 ro
rt2 call wk16s rt p1 rn
hitn select hit 1 0
fd2 add fd hitn
o rec kt2 rt2 fd2
ret o
end
# export p1: every function against it; whether every export so far named a function
fn wkroote (u32x128x64,u32x128x16,bool) u32 u32 u32x128x64 u32x128x64 u32x128x64 u32x128x16 u32x128x16 -> (u32x128x64,u32x128x16,bool)
kt at p0 0
rt at p0 1
okb at p0 2
s rec kt rt 0
r fold wkrootf p2 s p3 p4 p5 p6 p7 p1
kt2 at r 0
rt2 at r 1
fd at r 2
found ne fd 0
ok2 and okb found
o rec kt2 rt2 ok2
ret o
end
fn wkallk u32x128x64 u32 -> u32x128x64
c add p1 3
r call wk64s p0 c 1
ret r
end
fn wkallr u32x128x16 u32 -> u32x128x16
r call wk16s p0 p1 1
ret r
end
# the markers of variant (state: K, position in E, changed, whether the variant is kept, done)
fn wkrcgo (u32x128x64,u32,u32,u32,bool) u32 u32x128x500 -> bool
a at p0 4
b select a false true
ret b
end
fn wkrcst (u32x128x64,u32,u32,u32,bool) u32 u32x128x500 -> (u32x128x64,u32,u32,u32,bool)
kt at p0 0
pos at p0 1
ch at p0 2
kept at p0 3
w call wk500g p2 pos
isend eq w 0
iscall ge w 259
ishelp1 ge w 256
ishelp2 lt w 259
ishelp and ishelp1 ishelp2
isedge or iscall ishelp
wm sub w 259
t1 add wm 3
t2 sub w 256
tg select iscall t1 t2
cur call wk64g kt tg
kb eq kept 1
apply and kb isedge
widx select apply tg 8190
kt2 call wk64s kt widx 1
curz eq cur 0
chg and apply curz
chgn select chg 1 0
ch2 or ch chgn
pos2 add pos 1
o rec kt2 pos2 ch2 kept isend
ret o
end
fn wkrcv (u32x128x64,u32,u32) u32 u32x128x500 -> (u32x128x64,u32,u32)
kt at p0 0
pos at p0 1
ch at p0 2
i3 add p1 3
kept call wk64g kt i3
s rec kt pos ch kept false
r loop wkrcgo wkrcst 65536 s p2
kt2 at r 0
pos2 at r 1
ch2 at r 2
o rec kt2 pos2 ch2
ret o
end
# one pass over the variants: those kept keep what they call (state: K, changed)
fn wkrcgo2 (u32x128x64,u32) u32 u32x128x500 u32 -> bool
a at p0 1
b ne a 0
ret b
end
fn wkrcpass (u32x128x64,u32) u32 u32x128x500 u32 -> (u32x128x64,u32)
kt at p0 0
s rec kt 0 0
r fold wkrcv p3 s p2
kt2 at r 0
ch at r 2
o rec kt2 ch
ret o
end
# io:puts calls io:write
fn wkputw u32x128x64 -> u32x128x64
p call wk64g p0 2
w call wk64g p0 1
both or p w
r call wk64s p0 1 both
ret r
end
# variant p1: its function index (the kept helpers p3 first) or 4294967295; (T, kept so far)
fn wkrank (u32x128x64,u32) u32 u32x128x64 u32 -> (u32x128x64,u32)
tt at p0 0
cnt at p0 1
i3 add p1 3
kv call wk64g p2 i3
kk eq kv 1
nv add p3 cnt
val select kk nv 4294967295
tt2 call wk64s tt i3 val
cn select kk 1 0
cnt2 add cnt cn
o rec tt2 cnt2
ret o
end
fn wksumr u32 u32 u32x128x16 -> u32
v call wk16g p2 p1
r add p0 v
ret r
end
# the marker bytes of a kept variant change with the function indexes: the call markers of the
# variant (from E at the position) cost uleb(index) + 1 each (state: position, bytes before,
# bytes after, done); the old index is the variant's + p4 (3 helpers when the program has io)
fn wkmgo (u32,u32,u32,bool) u32 u32x128x500 u32x128x64 u32 -> bool
a at p0 3
b select a false true
ret b
end
fn wkmst (u32,u32,u32,bool) u32 u32x128x500 u32x128x64 u32 -> (u32,u32,u32,bool)
pos at p0 0
os at p0 1
ns at p0 2
w call wk500g p2 pos
isend eq w 0
iscall ge w 259
s sub w 259
oi add s p4
ob call wauln oi
ob1 add ob 1
s3 add s 3
ni call wk64g p3 s3
nb call wauln ni
nb1 add nb 1
od select iscall ob1 0
nd select iscall nb1 0
os2 add os od
ns2 add ns nd
pos2 add pos 1
o rec pos2 os2 ns2 isend
ret o
end
# p1 variant, p2 E, p3 T, p4 old helper count, p5 cap (0: the markers are not walked)
fn wkmdv (u32x128x256,u32) u32 u32x128x500 u32x128x64 u32 u32 -> (u32x128x256,u32)
vt at p0 0
pos at p0 1
s rec pos 0 0 false
r loop wkmgo wkmst p5 s p2 p3 p4
