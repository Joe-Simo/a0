# ---------------------------------------------------------------------------------------------
# Handlers of the nodes whose emission does not run another frame. Each is a fold body
# (M, trip, context, tables...) run once when its case applies; the context is described above
# `wxslot`.

# (a node bound to a loop's induction variable) its local is the induction local
fn wxhind u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) -> u32x128x512
