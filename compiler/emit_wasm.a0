# select (18): a known condition picks its arm; an arm with nodes of its own (the shape table's
# OWN and ARM columns: `lazyArms`) becomes an if/else around those nodes; else `select`
# register 20 counts the nodes owned by select p3 (frame first node p2)
fn wxown u32x128x512 u32 u32 u32 u32x128x200 -> u32x128x512
g add p2 p1
a add 2816 g
own call wxsh p4 a
j1 add p3 1
hit eq own j1
cnt call wxg p0 20
c2 add cnt 1
cn1_r select hit 1 0
r fold wxs cn1_r p0 20 c2
ret r
end
fn wxhsel u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x200 -> u32x128x512
