ret r
end
fn walitnst u32 u32 u32x128x128 u32x128x24 u32x384x65 u32x128x512 u32 -> u32
q call walitq p2 p3 p4 p5 p6 p1
n select q 1 0
r add p0 n
ret r
end
# POOL: the words of a literal (its length, then its elements)
fn wavop (io,u32,u32,u32) u32 u32x128 u32 -> (io,u32,u32,u32)
oi add p3 p1
xw mul oi 2
x and xw 127
x1 add x 1
v get p2 x1
r call wab p0 v true
ret r
end
fn wavpg (io,u32,u32,u32) u32 u32x128x512 u32 u32 u32 -> (io,u32,u32,u32)
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold wavop cnt p0 pg lo
ret r
end
fn wawlit (io,u32,u32,u32) u32 u32x128x512 u32 u32 -> (io,u32,u32,u32)
a call wab p0 p4 true
hi add p3 p4
has lt p3 hi
lp shr p3 6
h1 sub hi 1
hp shr h1 6
d sub hp lp
np add d 1
n select has np 0
r fold wavpg n a p2 p3 hi lp
ret r
end
fn wapoolnd (io,u32,u32,u32) u32 u32x128x128 u32x128x24 u32x384x65 u32x128x512 u32 -> (io,u32,u32,u32)
q call walitq p2 p3 p4 p5 p6 p1
nq select q 1 0
g add p6 p1
b6 mul g 6
b2 add b6 2
na_p shr b2 7
na_g get p2 na_p
na_w and b2 127
na get na_g na_w
b3 add b6 3
fa_p shr b3 7
fa_g get p2 fa_p
fa_w and b3 127
fa get fa_g fa_w
r fold wawlit nq p0 p5 fa na
ret r
end
fn wapoolfn (io,u32,u32,u32) u32 u32x128x128 u32x128x24 u32x384x65 u32x128x512 u32x128x45 u32 -> (io,u32,u32,u32)
f add p7 p1
fb mul f 7
fn0 call cfw p6 fb 4
cnt call cfw p6 fb 5
r fold wapoolnd cnt p0 p2 p3 p4 p5 fn0
ret r
end
# whether function p4 carries an io token anywhere in its types
fn waiop bool u32 u32x128x65 u32x128x65 u32 -> bool
i add p4 p1
t call wa65 p2 i
w call wa65 p3 t
x shr w 31
b eq x 1
r or p0 b
ret r
end
fn waion bool u32 u32x128x24 u32x128x65 u32 -> bool
g add p4 p1
t call wa24 p2 g
w call wa65 p3 t
x shr w 31
b eq x 1
r or p0 b
ret r
end
fn waio u32x128x45 u32x128x65 u32x128x24 u32x128x65 u32 -> u32
fb mul p4 7
np call cfw p0 fb 1
fp call cfw p0 fb 2
rt call cfw p0 fb 3
fn0 call cfw p0 fb 4
cnt call cfw p0 fb 5
w call wa65 p3 rt
x shr w 31
r0 eq x 1
a fold waiop np r0 p1 p3 fp
b fold waion cnt a p2 p3 fn0
r select b 1 0
ret r
end
# the name bytes pool[p3..p3+p4)
fn wanmb (io,u32,u32,u32) u32 u32x128x129 u32 -> (io,u32,u32,u32)
i add p3 p1
v_p shr i 7
v_g get p2 v_p
v_w and i 127
v get v_g v_w
r call wab p0 v true
ret r
end
# META of a variant: params, result, locals, frame, frame pointer, its markers, 0, its bytes
fn wametav (io,u32,u32,u32) u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x16 u32x128x45 u32 u32 -> (io,u32,u32,u32)
fb mul p9 7
np call cfw p8 fb 1
rt call cfw p8 fb 3
rtag_p shr rt 7
rtag_g get p4 rtag_p
rtag_l and rt 127
rtag_m mul rtag_l 3
rtag_i add rtag_m 0
rtag get rtag_g rtag_i
ragg ge rtag 4
v0 eq p10 0
sret and v0 ragg
pb select sret 1 0
params add pb np
nag select ragg false true
res0 and v0 nag
res select res0 1 0
an call waana p1 p2 p3 p4 p5 p6 p8 p9 p10
nx_p shr 12288 7
nx_g get an nx_p
nx_w and 12288 127
nx get nx_g nx_w
locals sub nx params
frm call wafrm an
fp_p shr 12290 7
fp_g get an fp_p
fp_w and 12290 127
fp get fp_g fp_w
a call wab p0 params true
b call wab a res true
c call wab b locals true
d call wab c frm true
e call wab d fp true
t at e 0
m at e 1
sa rec t 0 0 0
ra call wavar sa p1 p2 p3 p4 p5 p6 an p7 p8 p9 p10 false
t2 at ra 0
nb at ra 1
nr at ra 3
m2 add m nr
s3 rec t2 m2 0 0
g call wab s3 0 true
h call wab g nb true
ret h
end
fn wametavst (io,u32,u32,u32) u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x16 u32x128x45 u32 u32 -> (io,u32,u32,u32)
r call wametav p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11
ret r
end
# META of function p12 + p1: literal count, io, stack depth, name, variant count, variants
fn wametafn (io,u32,u32,u32) u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x45 u32x128x16 u32x128x129 u32x128x16 u32 -> (io,u32,u32,u32)
f add p12 p1
fb mul f 7
fn0 call cfw p8 fb 4
cnt call cfw p8 fb 5
nl fold walitnst cnt 0 p2 p4 p5 p3 fn0
fio call waio p8 p6 p4 p7 f
x mul f 2
x1 add x 1
dep_p shr x1 7
dep_g get p9 dep_p
dep_w and x1 127
dep get dep_g dep_w
ns_p shr x 7
ns_g get p11 ns_p
ns_w and x 127
ns get ns_g ns_w
nlen_p shr x1 7
nlen_g get p11 nlen_p
nlen_w and x1 127
nlen get nlen_g nlen_w
own call waown p8 p6 p5 f
no select own 1 0
nv add no 1
a call wab p0 nl true
b call wab a fio true
c call wab b dep true
d call wab c nlen true
e fold wanmb nlen d p10 ns
g call wab e nv true
h call wametav g p2 p3 p4 p5 p6 p7 p9 p8 f 0
k fold wametavst no h p2 p3 p4 p5 p6 p7 p9 p8 f 1
ret k
end
# CODE of a variant, and of function p10 + p1
fn wacodev (io,u32,u32,u32) u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x16 u32x128x45 u32 u32 -> (io,u32,u32,u32)
an call waana p1 p2 p3 p4 p5 p6 p8 p9 p10
t at p0 0
m at p0 1
sa rec t 0 0 0
ra call wavar sa p1 p2 p3 p4 p5 p6 an p7 p8 p9 p10 true
t2 at ra 0
s rec t2 m 0 0
ret s
end
fn wacodevst (io,u32,u32,u32) u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x16 u32x128x45 u32 u32 -> (io,u32,u32,u32)
r call wacodev p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11
ret r
end
fn wacodefn (io,u32,u32,u32) u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x16 u32x128x45 u32 -> (io,u32,u32,u32)
f add p10 p1
own call waown p9 p6 p5 f
no select own 1 0
a call wacodev p0 p2 p3 p4 p5 p6 p7 p8 p9 f 0
b fold wacodevst no a p2 p3 p4 p5 p6 p7 p8 p9 f 1
ret b
end
# The call table (index and stack depth, words 2f and 2f + 1): given for the functions before
# the chunk's, computed here for its own. The depth is the function's largest frame plus the
# deepest depth among its callees (src/wasm.ts `depthOf`).
fn wacdep u32 u32 u32x128x128 u32x128x16 u32 -> u32
g add p4 p1
b6 mul g 6
b1 add b6 1
op_p shr b1 7
op_g get p2 op_p
op_w and b1 127
op get op_g op_w
b4 add b6 4
ce_p shr b4 7
ce_g get p2 ce_p
ce_w and b4 127
ce get ce_g ce_w
b5 add b6 5
pr_p shr b5 7
pr_g get p2 pr_p
pr_w and b5 127
pr get pr_g pr_w
o19 eq op 19
o20 eq op 20
o21 eq op 21
c1 or o19 o20
isc or c1 o21
x mul ce 2
x1 add x 1
dc_p shr x1 7
dc_g get p3 dc_p
dc_w and x1 127
dc get dc_g dc_w
y mul pr 2
y1 add y 1
dp_p shr y1 7
dp_g get p3 dp_p
dp_w and y1 127
dp get dp_g dp_w
m1 call umax p0 dc
m2 select isc m1 p0
m3 call umax m2 dp
m4 select o21 m3 m2
ret m4
end
fn wafrv u32 u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x45 u32 -> u32
an call waana p2 p3 p4 p5 p6 p7 p8 p9 1
f call wafrm an
r call umax p0 f
ret r
end
fn wadep (u32x128x16,u32) u32 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x45 u32 -> (u32x128x16,u32)
dt at p0 0
nx at p0 1
f add p9 p1
fb mul f 7
fn0 call cfw p8 fb 4
cnt call cfw p8 fb 5
own call waown p8 p6 p5 f
no select own 1 0
nv add no 1
a0 call waana p2 p3 p4 p5 p6 p7 p8 f 0
f0 call wafrm a0
fr fold wafrv no f0 p2 p3 p4 p5 p6 p7 p8 f
cd fold wacdep cnt 0 p2 dt fn0
dep add fr cd
x mul f 2
d1_p shr x 7
d1_g get dt d1_p
d1_w and x 127
d1_h set d1_g d1_w nx
d1 set dt d1_p d1_h
x1 add x 1
d2_p shr x1 7
d2_g get d1 d2_p
d2_w and x1 127
d2_h set d2_g d2_w dep
d2 set d1 d2_p d2_h
nx2 add nx nv
r rec d2 nx2
ret r
end
fn watrail io u32 u32x128x16 u32x128x8 u32 -> io
f add p4 p1
x mul f 2
a_p shr x 7
a_g get p2 a_p
a_w and x 127
a get a_g a_w
x1 add x 1
b_p shr x1 7
b_g get p2 b_p
b_w and x1 127
b get b_g b_w
c_p shr f 7
c_g get p3 c_p
c_w and f 127
c get c_g c_w
w1 write p0 a
w2 write w1 b
w3 write w2 c
ret w3
end
# The chunk: functions [p12, p13) of the checked tables (p11 types), the call table p9 (given
# for the functions before p12), the iteration bounds p10, p14 the variant count before the
# chunk. Writes POOL, META, CODE, then the POOL and META word counts, (index, depth, iteration
# bound) of each function, the chunk's variant count and its function count.
fn wachunk io u32x384x65 u32x128x65 u32x128x45 u32x128x128 u32x128x512 u32x128x24 u32x128x129 u32x128x16 u32x128x16 u32x128x8 u32 u32 u32 u32 -> io
info call wainfo p1 p2 p11
k sub p13 p12
d0 rec p9 p14
dd fold wadep k d0 p4 p5 p6 p1 p2 info p3 p12
dt at dd 0
tot at dd 1
s0 rec p0 0 0 0
sp fold wapoolfn k s0 p4 p6 p1 p5 p3 p12
pc at sp 1
t1 at sp 0
sm0 rec t1 0 0 0
sm fold wametafn k sm0 p4 p5 p6 p1 p2 info p3 dt p7 p8 p12
mc at sm 1
t2 at sm 0
sc0 rec t2 0 0 0
sc fold wacodefn k sc0 p4 p5 p6 p1 p2 info dt p3 p12
t3 at sc 0
w1 write t3 pc
w2 write w1 mc
w3 fold watrail k w2 dt p10 p12
nv sub tot p14
w4 write w3 nv
w5 write w4 k
ret w5
end
fn wachunkst io u32 u32x384x65 u32x128x65 u32x128x45 u32x128x128 u32x128x512 u32x128x24 u32x128x129 u32x128x16 u32x128x16 u32x128x8 u32 u32 u32 u32 -> io
r call wachunk p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15
ret r
end

# ---------------------------------------------------------------------------------------------
# Chunk input. Mode 1: source through the A0 front end (`wasunit`, called by compiler/boot.a0);
# mode 2 (`wairchunk`): the tables themselves, each preceded by its count: base, from, the
# call table (2 from words), types (triples), tlist, fns (7 words each), nodes (6 words each),
# the node types, operands (pairs), name bytes, fnm (2 words per function). A table is read a
# page at a time into a page, then stored.

fn wardw io -> (u32,io)
r read p0
ret r
end
fn wart16 (u32x128x16,io) u32 u32 -> (u32x128x16,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn16 io u32 -> (u32x128x16,io)
z call z16
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart16 np s0 p1
ret s
end
fn wart24 (u32x128x24,io) u32 u32 -> (u32x128x24,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn24 io u32 -> (u32x128x24,io)
z call z24
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart24 np s0 p1
ret s
end
fn wart45 (u32x128x45,io) u32 u32 -> (u32x128x45,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn45 io u32 -> (u32x128x45,io)
z call z45
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart45 np s0 p1
ret s
end
fn wart65 (u32x128x65,io) u32 u32 -> (u32x128x65,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn65 io u32 -> (u32x128x65,io)
z call z65
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart65 np s0 p1
ret s
end
fn wart128 (u32x128x128,io) u32 u32 -> (u32x128x128,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn128 io u32 -> (u32x128x128,io)
z call zsrc
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart128 np s0 p1
ret s
end
fn wart129 (u32x128x129,io) u32 u32 -> (u32x128x129,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn129 io u32 -> (u32x128x129,io)
z call z129
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart129 np s0 p1
ret s
end
fn wart512 (u32x128x512,io) u32 u32 -> (u32x128x512,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn512 io u32 -> (u32x128x512,io)
z call z512
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart512 np s0 p1
ret s
end
fn warb384 (u32x384,io) u32 -> (u32x384,io)
buf at p0 0
tk at p0 1
r read tk
v at r 0
t at r 1
nb set buf p1 v
out rec nb t
ret out
end
fn wartty (u32x384x65,io) u32 u32 -> (u32x384x65,io)
src at p0 0
tk at p0 1
base mul p1 384
rest sub p2 base
big gt rest 384
cnt select big 384 rest
zp call z384
s0 rec zp tk
s fold warb384 cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warnty io u32 -> (u32x384x65,io)
z call zty
n383 add p1 383
np div n383 384
s0 rec z p0
s fold wartty np s0 p1
ret s
end
# mode 2: a chunk as tables
fn wairchunk io -> (io,u32)
r1 call wardw p0
base at r1 0
t1 at r1 1
r2 call wardw t1
from at r2 0
t2 at r2 1
nd mul from 2
rd call warn16 t2 nd
dt at rd 0
t3 at rd 1
r4 call wardw t3
nty at r4 0
t4 at r4 1
ntw mul nty 3
rt call warnty t4 ntw
ty at rt 0
t5 at rt 1
r6 call wardw t5
ntl at r6 0
t6 at r6 1
rl call warn65 t6 ntl
tl at rl 0
t7 at rl 1
r8 call wardw t7
nf at r8 0
t8 at r8 1
nfw mul nf 7
rf call warn45 t8 nfw
fs at rf 0
t9 at rf 1
r10 call wardw t9
nn at r10 0
t10 at r10 1
nnw mul nn 6
rn call warn128 t10 nnw
nds at rn 0
t11 at rn 1
ry call warn24 t11 nn
nty2 at ry 0
t12 at ry 1
r13 call wardw t12
no at r13 0
t13 at r13 1
now mul no 2
ra call warn512 t13 now
ar at ra 0
t14 at ra 1
r15 call wardw t14
npl at r15 0
t15 at r15 1
rp call warn129 t15 npl
pl at rp 0
t16 at rp 1
nfm mul nf 2
rm call warn16 t16 nfm
fm at rm 0
t17 at rm 1
z8 call z8
w call wachunk t17 ty tl fs nds ar nty2 pl fm dt z8 nty from nf base
r rec w 0
ret r
end
# mode 1: `cunit` (compiler/emit_c.a0) with this emitter. Lex, parse and check the source p1
# of p2 bytes, functions [p4, nfns) given the iteration bounds p3; with no diagnostic, the
# chunk (call table p5 for the functions before p4, p6 variants before it). (io code)
fn wasunit io u32x128x128 u32 u32x128x8 u32 u32x128x16 u32 -> (io,u32)
lx call lexsrc p1 p2
toks at lx 0
nw at lx 1
ntok div nw 3
s1 call pass1 p1 toks ntok
sinfo at s1 1
ta at s1 2
tv at s1 3
hdrs at s1 5
nsym at s1 7
umode at s1 10
uerr at s1 11
uetok at s1 12
nhdr at s1 15
uopen ne umode 0
uerr0 eq uerr 0
ueof and uerr0 uopen
e1 select ueof 1 uerr
et1 select ueof ntok uetok
s2 call pass2 p1 sinfo nsym
pool at s2 0
s3 call pass3 p1 toks ta hdrs nhdr e1 et1 ntok
types at s3 0
tlist at s3 2
hout at s3 4
ntypes at s3 5
ntlist at s3 6
e3 at s3 11
et3 at s3 12
nhc at s3 18
nhn at s3 19
s4 call pass4 hout nhn nhc
fns0 at s4 0
names at s4 1
derr at s4 2
dtok at s4 3
dup ne derr 0
e4 select dup derr e3
et4 select dup dtok et3
s5 call pass5 fns0 names p1 toks ta tv ntok e4 et4
fns at s5 0
nodes at s5 1
args at s5 2
pcode at s5 8
# after a parse error the function count may be below p4: nothing is checked then
cfrom call cumin p4 nhc
ck call checkir types tlist fns nodes args p3 ntypes ntlist nhc cfrom
types2 at ck 0
tlist2 at ck 2
ntys at ck 4
fstat at ck 7
ntypes2 at ck 8
cerr at ck 10
ns127 add nsym 127
nsp shr ns127 7
z64 call z64
st0 rec z64 0
st fold cstpg nsp st0 sinfo
starts at st 0
z16 call z16
fnm fold cfnm nhc z16 fns sinfo starts
pok eq pcode 0
code select pok cerr pcode
ok eq code 0
go select ok 1 0
wide call wawide args
t fold wachunkst go p0 types2 tlist2 fns nodes wide ntys pool fnm p5 fstat ntypes2 p4 nhc p6
r rec t code
ret r
end

# ---------------------------------------------------------------------------------------------
# The module linker (src/wasm.ts `assembleWasm`), mode 3. Input: the version (length, bytes),
# the io input and output capacities, the function count, every chunk's POOL then a 0, every
# chunk's META, every chunk's CODE. Output: the module, one byte per word; the result is 0, or
# 4 when a table below is full.
# The pool table u32x128x500: the address of every literal occurrence (words 0-4095), a hash table of
# the distinct literals (2048 slots of hash, start, length from 4096), the distinct literals'
# words (from 10240; 53632 words), a scratch word (63999) for writes that do not apply.

fn z500 -> u32x128x500
z call zpage
