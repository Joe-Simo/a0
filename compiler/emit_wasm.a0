np shr n127 7
g fold wkdpg np f p2 p3 true
ret g
end
fn wkhsumst (io,u32) u32 u32 u32 -> (io,u32)
t at p0 0
r call wkhsum t p2 p3
ret r
end
fn wkhelpst (io,u32,u32,u32) u32 u32 u32 -> (io,u32,u32,u32)
r call wkhelp p0 0 p2 p3 true
ret r
end
fn wkdatast (io,u32,u32,u32) u32 u32x128x500 u32 -> (io,u32,u32,u32)
r call wkdata p0 0 p2 p3 true
ret r
