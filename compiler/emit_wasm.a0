# simd128 reductions (src/wasm.ts `reduceRun`, `#vectorReduce`): a scalar fold whose body is
# `acc op f(p1, ...)` (op add xor or and) with lane operations for f runs four trips a vector
# trip while every lane's read is in range, then the scalar loop finishes from the counter the
# vector loop left. Scratch words of M as the fill runs: 19008 + j the lanes of body node j,
# 19072 + p the splat of parameter p, 19104 the index vector, 19110 the host frame, 19111 the first
# extra operand of the fold, 19112 the body's first node.

# the type of parameter p1 of a body whose first parameter type is word p2 of tlist p0
fn wxrpt u32x128x65 u32 u32 -> u32
a add p2 p1
b call wa65 p0 a
ret b
end
# the operand (p0 kind, p1 value) is the same in every lane: a u32 literal, or an extra (p1 >= 2,
# below the p4 parameters) of type u32 (tlist p2, first parameter type p3)
fn wxrun u32 u32 u32x128x65 u32 u32 -> bool
a eq p0 3
b eq p0 2
c ge p1 2
d lt p1 p4
e call wxrpt p2 p1 p3
f eq e 0
g and b c
h and g d
i and h f
r or a i
ret r
end
# a lane operand: a literal, the index p1, a uniform extra, or a node
fn wxrlo u32 u32 u32x128x65 u32 u32 -> bool
