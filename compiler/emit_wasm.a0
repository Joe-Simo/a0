# A0 wasm32 emitter and module linker, written in A0 (DESIGN.md 7a): the port of src/wasm.ts.
# Its output for a program is byte-identical to `compile(program, 'wasm', { optimize: false })`
# (the TypeScript emitter on the unoptimized program), and with the optimizer of
# compiler/optimize.a0 and the shape analyses of compiler/shape.a0 in front of it to
# `compile(program, 'wasm')`.
#
# Per-function emission (`wachunk`, `wxfun`) follows src/wasm.ts `FunctionEmitter`: a body is built
# as a list of instructions with symbolic locals in the machine table M (see `wxg`), by a step
# machine with an explicit work stack (A0 has no recursion, and the emitter inlines small fold
# bodies, predicates and scalar callees up to INLINE_DEPTH 3 deep); `Code.finish` is
# compiler/wasm_code.a0 `wfzfin` (stackification, tees, dead stores, live-range local sharing).
# The in-place rule is `mutableHere` with the shape table's BORR column (`borrowLive`). The shape
# table `sh` (u32x128x200, compiler/shape.a0) holds per node FILL (fill run count), OWN and ARM
# (lazy select arms), OVER (`overwritesState`), BORR, as columns of 2816 words from 0, 2816,
# 5632, 8448, 11264.
#
# A chunk's output (`wachunk`): per function a record (the word counts of its POOL, META and
# CODE, then those words; see `wxfun`), then (index, stack depth, iteration bound) per function,
# the chunk's variant count and its function count; the driver concatenates every record's POOL,
# then every META, then every CODE for the linker (`walink`, mode 3). Result code 7: bodies of the
# chunk functions it writes (followed by their count) are needed, run again with them.
use "emit_c.a0"
use "wasm_code.a0"
# ---------------------------------------------------------------------------------------------
# Paged tables

fn wa24 u32x128x24 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa65 u32x128x65 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa128 u32x128x128 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa16 u32x128x16 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa100 u32x128x100 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
fn wa512 u32x128x512 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_w and p1 127
v get v_g v_w
ret v
end
# word p2 of the triple (tag a b) of type p1
fn wat u32x384x65 u32 u32 -> u32
v_p shr p1 7
v_g get p0 v_p
v_l and p1 127
v_m mul v_l 3
v_i add v_m p2
v get v_g v_i
ret v
end
fn z100 -> u32x128x100
z call zpage
t arr z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z
ret t
end
fn z512 -> u32x128x512
z call zpage
t arr z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z
ret t
end
# ---------------------------------------------------------------------------------------------
# Writers. The state (io,u32,u32,u32) is (io, bytes counted, pool literals so far, markers written).

# write p2 (run 0 or 1 times)
fn wawr io u32 u32 -> io
w write p0 p2
ret w
end
# byte (or word) p1, written when p2, counted either way
fn wab (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
t at p0 0
c at p0 1
l at p0 2
m at p0 3
n select p2 1 0
t2 fold wawr n t p1
c2 add c 1
o rec t2 c2 l m
ret o
end
fn wab2 (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call wab p0 p1 p3
b call wab a p2 p3
ret b
end
fn wab3 (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
a call wab p0 p1 p4
b call wab a p2 p4
c call wab b p3 p4
ret c
end
# a marker word (always written, not counted as a byte)
fn waref (io,u32,u32,u32) u32 -> (io,u32,u32,u32)
t at p0 0
c at p0 1
l at p0 2
m at p0 3
t2 write t p1
m2 add m 1
o rec t2 c l m2
ret o
end
# the address of the next pool literal of the function (a marker)
fn wapool (io,u32,u32,u32) -> (io,u32,u32,u32)
t at p0 0
c at p0 1
l at p0 2
m at p0 3
k add 2147483648 l
t2 write t k
l2 add l 1
m2 add m 1
o rec t2 c l2 m2
ret o
end
# byte p1 of the LEB128 of p2 in p3 bytes (p4: the sign bits of a negative fifth byte)
fn walebb (io,u32,u32,u32) u32 u32 u32 u32 bool -> (io,u32,u32,u32)
s mul p1 7
v shr p2 s
lo and v 127
k1 add p1 1
more lt k1 p3
hb select more 128 0
k4 eq p1 4
x select k4 p4 0
b1 or lo hb
b or b1 x
r call wab p0 b p5
ret r
end
# unsigned LEB128 of p1
fn waul (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
a ge p1 128
b ge p1 16384
c ge p1 2097152
d ge p1 268435456
na select a 1 0
nb select b 1 0
nc select c 1 0
nd select d 1 0
s1 add na nb
s2 add s1 nc
s3 add s2 nd
n add s3 1
r fold walebb n p0 p1 n 0 p2
ret r
end
# signed LEB128 of the int32 whose bit pattern is p1
fn wasl (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
ng ge p1 2147483648
nv xor p1 4294967295
m select ng nv p1
a ge m 64
b ge m 8192
c ge m 1048576
d ge m 134217728
na select a 1 0
nb select b 1 0
nc select c 1 0
nd select d 1 0
s1 add na nb
s2 add s1 nc
s3 add s2 nd
n add s3 1
x select ng 112 0
r fold walebb n p0 p1 n x p2
ret r
end
# the size of the unsigned / signed LEB128 of p0
fn wauln u32 -> u32
a ge p0 128
b ge p0 16384
c ge p0 2097152
d ge p0 268435456
na select a 1 0
nb select b 1 0
nc select c 1 0
nd select d 1 0
s1 add na nb
s2 add s1 nc
s3 add s2 nd
n add s3 1
ret n
end
fn wasln u32 -> u32
ng ge p0 2147483648
nv xor p0 4294967295
m select ng nv p0
a ge m 64
b ge m 8192
c ge m 1048576
d ge m 134217728
na select a 1 0
nb select b 1 0
nc select c 1 0
nd select d 1 0
s1 add na nb
s2 add s1 nc
s3 add s2 nd
n add s3 1
ret n
end
fn waulst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call waul p0 p2 p3
ret r
end
fn waslst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call wasl p0 p2 p3
ret r
end
# i32.const p1
fn waci (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
a call wab p0 65 p2
b call wasl a p1 p2
ret b
end
fn wacist (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call waci p0 p2 p3
ret r
end
# opcode p1 with the unsigned immediate p2 (local.get 32, local.set 33, local.tee 34, call 16)
fn walx (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call wab p0 p1 p3
b call waul a p2 p3
ret b
end
fn walxst (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
r call walx p0 p2 p3 p4
ret r
end
# i32.load (40) / i32.store (54) with alignment 2 and offset p2
fn wamem (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call wab2 p0 p1 2 p3
b call waul a p2 p3
ret b
end
# i32.const p2; i32.add
fn waaddst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
a call waci p0 p2 p3
b call wab a 106 p3
ret b
end
# memory.copy of p1 bytes (destination and source already pushed)
fn wacopy (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
a call waci p0 p1 p2
b call wab2 a 252 10 p2
c call wab2 b 0 0 p2
ret c
end
fn wacopyst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call wacopy p0 p2 p3
ret r
end
# push an operand (kind p1 value p2, local p3): a node or parameter's local, else the literal
fn wapush (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
k1 eq p1 1
k2 eq p1 2
lc or k1 k2
op select lc 32 65
a call wab p0 op p4
nl select lc 1 0
nc select lc 0 1
b fold waulst nl a p3 p4
c fold waslst nc b p2 p4
ret c
end
fn wapushst (io,u32,u32,u32) u32 u32 u32 u32 bool -> (io,u32,u32,u32)
r call wapush p0 p2 p3 p4 p5
ret r
end

# ---------------------------------------------------------------------------------------------
# Type info: bytes | contains-io << 31 per type (u32 bool io 4 bytes; components come first)

# field p1 of the record tlist p3 from p4: (bytes, io) with the info table p2
fn wafi (u32,u32) u32 u32x128x65 u32x128x65 u32 -> (u32,u32)
s at p0 0
o at p0 1
i add p4 p1
t call wa65 p3 i
w call wa65 p2 t
sz and w 2147483647
fio shr w 31
s2 add s sz
o2 or o fio
r rec s2 o2
ret r
end
fn wainfost u32x128x65 u32 u32x384x65 u32x128x65 -> u32x128x65
tag call wat p2 p1 0
a call wat p2 p1 1
b call wat p2 p1 2
t3 eq tag 3
t4 eq tag 4
t5 eq tag 5
eb call wa65 p0 b
esz and eb 2147483647
eio shr eb 31
asz mul a esz
n5 select t5 b 0
z rec 0 0
rs fold wafi n5 z p0 p3 a
rsz at rs 0
rio at rs 1
s1 select t4 asz 4
sz select t5 rsz s1
i1 select t3 1 0
i2 select t4 eio i1
iof select t5 rio i2
hi shl iof 31
w or sz hi
r_p shr p1 7
r_g get p0 r_p
r_w and p1 127
r_h set r_g r_w w
r set p0 r_p r_h
ret r
end
fn wainfo u32x384x65 u32x128x65 u32 -> u32x128x65
z call z65
r fold wainfost p2 z p0 p1
ret r
end
# the byte offset of field p3 of the record whose fields are tlist p1 from p2
fn wafo u32x128x65 u32x128x65 u32 u32 -> u32
z rec 0 0
r fold wafi p3 z p1 p0 p2
o at r 0
ret o
end

# the ret operand of the packed word p1 (kind * 2^28 + value): kind 5 is the operand at args
# pair value (a u32 literal of 2^28 or more, as compiler/optimize.a0 writes it)
fn waretop u32x128x512 u32 -> (u32,u32)
rk shr p1 28
rv and p1 268435455
k5 eq rk 5
x mul rv 2
x_p shr x 7
x_g get p0 x_p
x_w and x 127
xk get x_g x_w
x1 add x_w 1
xv get x_g x1
k select k5 xk rk
v select k5 xv rv
r rec k v
ret r
end
# function p3 is an iteration body over aggregate state (it gets the owned variant too)
fn waown u32x128x45 u32x128x65 u32x384x65 u32 -> bool
fb mul p3 7
np call cfw p0 fb 1
fp call cfw p0 fb 2
rt call cfw p0 fb 3
t0 call wa65 p1 fp
fp1 add fp 1
t1 call wa65 p1 fp1
tag0_p shr t0 7
tag0_g get p2 tag0_p
tag0_l and t0 127
tag0_m mul tag0_l 3
tag0_i add tag0_m 0
tag0 get tag0_g tag0_i
ag ge tag0 4
i1 eq t1 0
n2 ge np 2
a and ag i1
b and a n2
so eq rt t0
r and b so
ret r
end
fn warefst (io,u32,u32,u32) u32 u32 -> (io,u32,u32,u32)
r call waref p0 p2
ret r
end
fn wabst (io,u32,u32,u32) u32 u32 bool -> (io,u32,u32,u32)
r call wab p0 p2 p3
ret r
end
fn wab2st (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
r call wab2 p0 p2 p3 p4
ret r
end
fn wab3st (io,u32,u32,u32) u32 u32 u32 u32 bool -> (io,u32,u32,u32)
r call wab3 p0 p2 p3 p4 p5
ret r
end
fn wamemst (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
r call wamem p0 p2 p3 p4
ret r
end
# ---------------------------------------------------------------------------------------------
# The emission machine (src/wasm.ts `FunctionEmitter`). One variant of one function is emitted
# into the machine table M (u32x128x512, the state of every mutating step: nothing else holds
# mutable state, since one value is at most 65536 words). M's words:
#   0-127 registers: 0 instruction count (starts at 5: slots 0-4 are the frame prologue, filled
#     after the body), 1 next i32 local id, 2 next v128 local id, 3 frame bytes, 4 frame pointer
#     local (4294967295: none), 5 pool occurrences, 6 frame depth, 7 work stack items, 8 error
#     (1 capacity, 2 unsupported), 9 result address local (4294967295: none), 10 first parameter
#     local, 11 node that is the result slot (4294967295: none), 12 deepest callee stack depth,
#     13 simd option, 14 unroll option, 15 missing bodies, 16-31 results of the last step (T0..),
#     32-63 the functions whose bodies are missing
#   128-639 frames: frame d at 128 + 128 d (d 0..3, INLINE_DEPTH 3): 0 function, 1 variant (0
#     value, 1 owned), 2 first node, 3 node count, 4 parameter count, 5 6 the ret operand (kind,
#     value), 7 has a host (d > 0), 9 width of scalar-replaced state (0 none), 10-17 its locals,
#     18 carry flag, 19 20 21 carry get node, set node, local, 22 23 index bound flag and value,
#     32-95 the host's parameter sources (kind 0 local / 1 literal value, value) for 32 parameters
#   640-1279 loop contexts: context d at 640 + 160 d (see `wxiter`)
#   1280-3327 work stack: item i at 1280 + 4 i (kind, a, b, c), 512 items
#   3328-5375 pool occurrences (global node index of each literal array emitted from the pool)
#   5376-17023 node rows (4 words: local, constant value, flags bit0 known constant bit1 member
#     of the scalar state chain, root: 0 itself, 2^28 + node, 2^29 + parameter): frame 0 from 5376 (2816 nodes), frame d from 16640 + 128 (d - 1)
#   17024-18943 inline-frame node blocks (20 words per node: 0 induction local + 1, 4-19 the
#     words of a chain node: 8 fields of (kind, value)), frame d from 17024 + 640 (d - 1)
#   20480-65535 instructions: 22528 of 2 words (kind, value; the kinds of compiler/wasm_code.a0)
# A step that mutates M is a fold body (M, trip, ...) -> M run with one trip (or 0: not run);
# what it computes for its caller is left in registers 16.. (no function takes M but the tiny
# readers below, so M is never copied).

# word p1 of M
fn wxg u32x128x512 u32 -> u32
pg shr p1 7
w and p1 127
g get p0 pg
v get g w
ret v
end
# M[p2] := p3
fn wxs u32x128x512 u32 u32 u32 -> u32x128x512
pg shr p2 7
w and p2 127
g get p0 pg
g2 set g w p3
r set p0 pg g2
ret r
end
# M[p2] := M[p2] + p3
fn wxad u32x128x512 u32 u32 u32 -> u32x128x512
v_gp shr p2 7
v_gw and p2 127
v_gg get p0 v_gp
v get v_gg v_gw
n add v p3
r__pg shr p2 7
r__w and p2 127
r__g get p0 r__pg
r__g2 set r__g r__w n
r__r set p0 r__pg r__g2
ret r__r
end
# the address of word p2 of frame p1 / of loop context p1 / of word p3 of node p2 in frame p1
fn wxfr u32 u32 -> u32
a mul p0 128
b add a 128
r add b p1
ret r
end
fn wxcx u32 u32 -> u32
a mul p0 176
b add a 640
r add b p1
ret r
end
fn wxrw u32 u32 u32 -> u32
top eq p0 0
a mul p1 4
t add a 5440
d1 sub p0 1
b mul d1 128
c add b 16704
i add c a
ad select top t i
r add ad p2
ret r
end
# word p2 of the block of node p1 of inline frame p0
fn wxbk u32 u32 u32 -> u32
d1 sub p0 1
a mul d1 640
b mul p1 20
c add a 17088
d add c b
r add d p2
ret r
end
# frame p0's word p1 / loop context word / node row word of M
fn wxfg u32x128x512 u32 u32 -> u32
a call wxfr p1 p2
r call wxg p0 a
ret r
end
fn wxcg u32x128x512 u32 u32 -> u32
a call wxcx p1 p2
r call wxg p0 a
ret r
end
fn wxrg u32x128x512 u32 u32 u32 -> u32
a call wxrw p1 p2 p3
r call wxg p0 a
ret r
end
# frame d word k := v, loop context, node row: (M, trip, d, k, v) and (M, trip, d, j, k, v)
fn wxfs u32x128x512 u32 u32 u32 u32 -> u32x128x512
a call wxfr p2 p3
r__pg shr a 7
r__w and a 127
r__g get p0 r__pg
r__g2 set r__g r__w p4
r__r set p0 r__pg r__g2
ret r__r
end
fn wxcs u32x128x512 u32 u32 u32 u32 -> u32x128x512
a call wxcx p2 p3
r__pg shr a 7
r__w and a 127
r__g get p0 r__pg
r__g2 set r__g r__w p4
r__r set p0 r__pg r__g2
ret r__r
end
fn wxrs u32x128x512 u32 u32 u32 u32 u32 -> u32x128x512
a call wxrw p2 p3 p4
r__pg shr a 7
r__w and a 127
r__g get p0 r__pg
r__g2 set r__g r__w p5
r__r set p0 r__pg r__g2
ret r__r
end
fn wxbs u32x128x512 u32 u32 u32 u32 u32 -> u32x128x512
a call wxbk p2 p3 p4
r__pg shr a 7
r__w and a 127
r__g get p0 r__pg
r__g2 set r__g r__w p5
r__r set p0 r__pg r__g2
ret r__r
end
# the instruction (kind p2, value p3) appended (a fold of one trip); capacity 22528, then the
# error register is set and nothing is written. The register page first, then the page of the
# instruction: a chain of sets, each on the result of the previous one
fn wxe u32x128x512 u32 u32 u32 -> u32x128x512
g0 get p0 0
n get g0 0
e8 get g0 8
full ge n 22528
okn select full 0 1
n1 add n okn
e2 select full 1 e8
g0a set g0 0 n1
g0b set g0a 8 e2
m1 set p0 0 g0b
a mul n 2
ad add a 20480
pg shr ad 7
w and ad 127
g get m1 pg
w1 add w 1
g1 set g w p2
g2 set g1 w1 p3
okb eq full false
g3 select okb g2 g
m2 set m1 pg g3
ret m2
end
# a fresh i32 local id into register 16 (ids from 8192 are a capacity error)
fn wxnl u32x128x512 u32 -> u32x128x512
n_gp shr 1 7
n_gw and 1 127
n_gg get p0 n_gp
n get n_gg n_gw
big ge n 8192
m1__pg shr 16 7
m1__w and 16 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w n
m1__r set p0 m1__pg m1__g2
n1 add n 1
m2__pg shr 1 7
m2__w and 1 127
m2__g get m1__r m2__pg
m2__g2 set m2__g m2__w n1
m2__r set m1__r m2__pg m2__g2
cn1_m3 select big 1 0
m3__gcondb ne cn1_m3 0
m3__pg shr 8 7
m3__w and 8 127
m3__g get m2__r m3__pg
m3__g2 set m3__g m3__w 1
m3__r_o get m2__r m3__pg
m3__r_s select m3__gcondb m3__g2 m3__r_o
m3__r set m2__r m3__pg m3__r_s
ret m3__r
end
# a fresh v128 local id (2^20 + k) into register 16
fn wxnv u32x128x512 u32 -> u32x128x512
n_gp shr 2 7
n_gw and 2 127
n_gg get p0 n_gp
n get n_gg n_gw
big ge n 128
id add n 1048576
m1__pg shr 16 7
m1__w and 16 127
m1__g get p0 m1__pg
m1__g2 set m1__g m1__w id
m1__r set p0 m1__pg m1__g2
n1 add n 1
m2__pg shr 2 7
m2__w and 2 127
m2__g get m1__r m2__pg
m2__g2 set m2__g m2__w n1
m2__r set m1__r m2__pg m2__g2
cn1_m3 select big 1 0
m3__gcondb ne cn1_m3 0
m3__pg shr 8 7
m3__w and 8 127
