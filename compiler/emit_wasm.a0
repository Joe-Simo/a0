st call wxcg p0 p2 0
ic call wxcg p0 p2 1
ne call wxcg p0 p2 17
lf call wxcg p0 p2 3
lv call wxcg p0 p2 4
wd call wxcg p0 p2 12
cf call wxcg p0 p2 13
cg call wxcg p0 p2 14
cs call wxcg p0 p2 15
cl call wxcg p0 p2 16
isb eq p3 1
isp eq p3 2
bp or isb isp
wdv select bp wd 0
cfv select isb cf 0
cgv select isb cg 0
csv select isb cs 0
clv select isb cl 0
m1 fold wxfs 1 p0 dn 32 0
m2 fold wxfs 1 m1 dn 33 st
m3 fold wxfs 1 m2 dn 34 0
m4 fold wxfs 1 m3 dn 35 ic
m5 fold wxfs 1 m4 dn 9 wdv
m6 fold wxfs 1 m5 dn 18 cfv
m7 fold wxfs 1 m6 dn 19 cgv
m8 fold wxfs 1 m7 dn 20 csv
m9 fold wxfs 1 m8 dn 21 clv
m10 fold wxfs 1 m9 dn 22 lf
m11 fold wxfs 1 m10 dn 23 lv
m12 fold wxhx ne m11 p2
m13 fold wxhf wdv m12 p2
ret m13
end
# the bound on the counter of phase p3 of loop p2: the count operand (limit kind 0), the constant
# of the phase (1) or the bound local (2)
fn wxlim u32x128x512 u32 u32 u32 -> u32x128x512
