m5 fold wxfs 1 m4 p2 4 np
m6 fold wxfs 1 m5 p2 5 rk
m7 fold wxfs 1 m6 p2 6 rv
m8 fold wxfs 1 m7 p2 7 hhv
ret m8
end
# clear the row (and the induction and use words) of node p1 of inline frame p2
fn wxclr u32x128x512 u32 u32 -> u32x128x512
