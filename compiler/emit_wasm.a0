x mul f 2
a_p shr x 7
a_g get p2 a_p
a_w and x 127
a get a_g a_w
x1 add x 1
b_p shr x1 7
b_g get p2 b_p
b_w and x1 127
b get b_g b_w
c_p shr f 7
c_g get p3 c_p
c_w and f 127
c get c_g c_w
w1 write p0 a
w2 write w1 b
w3 write w2 c
ret w3
end
# ---------------------------------------------------------------------------------------------
# Functions and chunks. Per function the chunk writes one record: three words (the POOL, META
# and CODE word counts), then those words (the driver concatenates every record's POOL, then
# every META, then every CODE: tools/selfhost-wasm.ts). POOL: per pool occurrence of the function
# (src/wasm.ts `#poolEntry`) its element count and the elements; META: literal count, io flag,
# stack depth, name length and bytes, variant count, per variant (parameters, result, locals,
# v128 locals, 0, the marker words, 0, byte count); CODE: each variant's body, a byte per
# word, a call or pool address as one marker word (256 + helper, 259 + variant index, 2^31 + the
# occurrence).

# page p1 + 160 of the machine table (the instruction pages)
fn wxpg u32x128x512 u32 -> u32x128
i add p1 160
r get p0 i
ret r
end
# the instruction table of machine table p2: page p1 of it is page 160 + p1
fn wxcpi u32x128x352 u32 u32x128x512 -> u32x128x352
pg call wxpg p2 p1
r set p0 p1 pg
ret r
end
# word p1 of a code table is a marker word (>= 256)
fn wxcm u32 u32 u32x128x512 -> u32
w call wxg p2 p1
a ge w 256
n select a 1 0
r add p0 n
ret r
end
# write word p1 of the code table when it is a marker
fn wxwm io u32 u32x128x512 -> io
w call wxg p2 p1
a ge w 256
n select a 1 0
r fold wawr n p0 w
ret r
end
# write word p1 of the code table
fn wxwc io u32 u32x128x512 -> io
w call wxg p2 p1
r write p0 w
ret r
end
# operand p1 (from p2, table p3) of a pool literal: its value
fn wxpel io u32 u32 u32x128x512 -> io
o add p2 p1
v call wxov p3 o
r write p0 v
ret r
end
# pool occurrence p5 + p1 of machine table p2 (nodes p3, operands p4): its element count and elements
fn wxpoc io u32 u32x128x512 u32x128x128 u32x128x512 u32 -> io
i add p5 p1
a add 3392 i
g call wxg p2 a
na call wxnw p3 g 2
fa call wxnw p3 g 3
w1 write p0 na
r fold wxpel na w1 fa p4
ret r
end
# the word count of the pool occurrences [p2, p3) of machine table p1: (count, trip) state
fn wxpsz u32 u32 u32x128x512 u32x128x128 u32 -> u32
i add p4 p1
a add 3392 i
g call wxg p2 a
na call wxnw p3 g 2
n add na 1
r add p0 n
ret r
end
# one variant's META (parameters, result, locals, v128 locals, 0, the markers, 0, bytes): p1 the
# machine table, p2 its code table, p3 whether it is the value variant of an aggregate-free function
fn wxmv io u32x128x512 u32x128x512 bool -> io
nw call wxg p2 65533
nl call wxg p2 65534
nv call wxg p2 65535
np call wxfg p1 0 4
pb call wxg p1 10
pc add pb np
res select p3 1 0
mk fold wxcm nw 0 p2
nb sub nw mk
a write p0 pc
b write a res
c write b nl
d write c nv
e write d 0
f fold wxwm nw e p2
g write f 0
h write g nb
ret h
end
# the META of a variant that is not a value variant with a scalar result (a fold trip of 1)
fn wxmvf io u32 u32x128x512 u32x128x512 -> io
r call wxmv p0 p2 p3 false
ret r
end
# name byte p3 + p1 of the name pool p2
fn wxnmb io u32 u32x128x400 u32 -> io
i add p3 p1
pg shr i 7
g get p2 pg
w and i 127
v get g w
r write p0 v
ret r
end
# call table word p2 := p3 (u32x128x16: index and stack depth per function, words 2f and 2f + 1)
fn wxdts u32x128x16 u32 u32 u32 -> u32x128x16
pi shr p2 7
wi and p2 127
pg get p0 pi
pg2 set pg wi p3
r set p0 pi pg2
ret r
end
# miss entry p1 of machine table p2 appended to the chunk's list (count, table)
fn wxmg (u32,u32x128x8) u32 u32x128x512 -> (u32,u32x128x8)
n at p0 0
t at p0 1
a add 32 p1
e call wxg p2 a
pi shr n 7
wi and n 127
pg get t pi
pg2 set pg wi e
t2 set t pi pg2
n1 add n 1
r rec n1 t2
ret r
end
# function p0 + p1 of the chunk (first function p2): the record of its variants (see above)
# state (io, variants so far, call table, misses, miss list, error)
fn wxfun (io,u32,u32x128x16,u32,u32x128x8,u32) u32 u32 u32 u32 u32x128x45 u32x128x128 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x200 u32x128x400 u32x128x16 -> (io,u32,u32x128x16,u32,u32x128x8,u32)
io at p0 0
nvar at p0 1
dt at p0 2
nm at p0 3
ml at p0 4
er at p0 5
f add p2 p1
own call waown p5 p10 p9 f
ownu select own 1 0
z call z512
m0 fold wxemit 1 z f 0 0 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 dt
n0 call wxg m0 0
np0 call wxfg m0 0 4
pb0 call wxg m0 10
pc0 add pb0 np0
zi call z352
i0 fold wxcpi 352 zi m0
c0 call wfzfin i0 n0 pc0
npl0 call wxg m0 5
z2 call z512
m1 fold wxemit ownu z2 f 1 npl0 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 dt
n1 call wxg m1 0
np1 call wxfg m1 0 4
pb1 call wxg m1 10
pc1 add pb1 np1
zi1 call z352
i1 fold wxcpi 352 zi1 m1
c1 call wfzfin i1 n1 pc1
npl1 call wxg m1 5
plt select own npl1 npl0
nw0 call wxg c0 65533
nw1x call wxg c1 65533
nw1 select own nw1x 0
mk0 fold wxcm nw0 0 c0
mk1x fold wxcm nw1 0 c1
fr0 call wxg m0 3
fr1x call wxg m1 3
fr1 select own fr1x 0
f0a add fr0 15
f0 and f0a 4294967280
f1a add fr1 15
f1b and f1a 4294967280
fz select own f1b 0
fm call umax f0 fz
md0 call wxg m0 12
md1x call wxg m1 12
md1 select own md1x 0
md call umax md0 md1
dep add fm md
e0 call wxg m0 8
e1 call wxg m1 8
e01 call umax e0 e1
er2 call umax er e01
fio call waio p5 p10 p8 p11 f
fb mul f 2
ns call wa16 p14 fb
fb1 add fb 1
nlen call wa16 p14 fb1
ps0 fold wxpsz npl0 0 m0 p6 0
nl1 sub npl1 npl0
ps1x fold wxpsz nl1 0 m1 p6 npl0
ps1 select own ps1x 0
psz add ps0 ps1
nmk0 add mk0 7
nmk1x add mk1x 7
nmk1 select own nmk1x 0
mh0 add nlen 5
mh1 add mh0 nmk0
msz add mh1 nmk1
csz add nw0 nw1
ownn select own 1 0
nv add ownn 1
w1 write io psz
w2 write w1 msz
w3 write w2 csz
w4 fold wxpoc npl0 w3 m0 p6 p7 0
w5 fold wxpoc nl1 w4 m1 p6 p7 npl0
w6 write w5 plt
w7 write w6 fio
w8 write w7 dep
w9 write w8 nlen
w10 fold wxnmb nlen w9 p13 ns
w11 write w10 nv
rt call wxfw p5 f 3
rtag call wxtag p9 rt
rprim lt rtag 4
w12 call wxmv w11 m0 c0 rprim
w13 fold wxmvf ownn w12 m1 c1
w14 fold wxwc nw0 w13 c0
w15 fold wxwc nw1 w14 c1
mc0 call wxg m0 15
mc1x call wxg m1 15
mc1 select own mc1x 0
ms0 rec nm ml
ms1 fold wxmg mc0 ms0 m0
ms2 fold wxmg mc1 ms1 m1
nm2 at ms2 0
ml2 at ms2 1
dtn0 fold wxdts 1 dt fb nvar
dtn1 fold wxdts 1 dtn0 fb1 dep
nvar2 add nvar nv
r rec w15 nvar2 dtn1 nm2 ml2 er2
ret r
end
# the p1-th requested function's chunk index
fn wxwq io u32 u32x128x8 -> io
pi shr p1 7
wi and p1 127
pg get p2 pi
v get pg wi
r write p0 v
ret r
end
# The chunk: functions [p12, p13) of the checked tables (p1 types, p2 tlist, p3 fns, p4 nodes, p5
# operands, p6 node types, p7 name bytes, p8 fnm, p9 the call table (given for the functions
# before p12), p10 the iteration bounds, p11 the type count, p14 the variant count before the
# chunk, p15 the shape table, p16 p17 the simd and unroll options). Writes the records of
# `wxfun`, then (index, depth, bound) of each function, the chunk's variant count and its
# function count; or, when a body is missing (code 7), the chunk functions wanted and their count;
# or code 4 (a capacity) / 5 (an unsupported shape)
fn wachunk io u32x384x65 u32x128x65 u32x128x45 u32x128x128 u32x128x512 u32x128x24 u32x128x400 u32x128x16 u32x128x16 u32x128x8 u32 u32 u32 u32 u32x128x200 u32 u32 -> (io,u32)
info call wainfo p1 p2 p11
k sub p13 p12
zm call z8
st0 rec p0 p14 p9 0 zm 0
sf fold wxfun k st0 p12 p16 p17 p3 p4 p5 p6 p1 p2 info p15 p7 p8
io at sf 0
nvar at sf 1
dt at sf 2
nm at sf 3
ml at sf 4
er at sf 5
miss gt nm 0
nmiss select miss false true
bad gt er 0
nbad select bad false true
ok and nmiss nbad
oku select ok 1 0
missu select miss 1 0
nmu select miss nm 0
kk select ok k 0
w1 fold wxwq nmu io ml
w2 fold wawr missu w1 nm
t1 fold watrail kk w2 dt p10 p12
nv sub nvar p14
t2 fold wawr oku t1 nv
t3 fold wawr oku t2 k
ec1 eq er 1
ec select ec1 4 5
cb select bad ec 0
code select miss 7 cb
r rec t3 code
ret r
end
# ---------------------------------------------------------------------------------------------
# Chunk input. Mode 1: source through the A0 front end (`wasunit`, called by compiler/boot.a0);
# mode 2 (`wairchunk`): the tables themselves, each preceded by its count: base, from, the
# call table (2 from words), types (triples), tlist, fns (7 words each), nodes (6 words each),
# the node types, operands (pairs), name bytes, fnm (2 words per function). A table is read a
# page at a time into a page, then stored.

fn wardw io -> (u32,io)
r read p0
ret r
end
fn wart16 (u32x128x16,io) u32 u32 -> (u32x128x16,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn16 io u32 -> (u32x128x16,io)
z call z16
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart16 np s0 p1
ret s
end
fn wart24 (u32x128x24,io) u32 u32 -> (u32x128x24,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn24 io u32 -> (u32x128x24,io)
z call z24
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart24 np s0 p1
ret s
end
