# Full-word arena checker. Canonical output is authoritative A0; this is a development source.
use "parse_arena.a0"
use "check_arena_shared.a0"

fn ac_function (u32x128,io) u32 -> (u32x128,io)
body call ac_function_body p0 p1
out call ac_publish_function body p1
ret out
end

fn arena_check io u32x128 -> (u32,u32x128,io)
q0 get p1 0
q1 eq q0 0
q2 get p1 93
q3 ne q2 1
q4 and q1 q3
q5 get p1 0
q6 select q4 3 q5
a set p1 0 q6
a_1 set a 96 1
z call arena_zero
q7 rec 0 0 0
m0_a set a_1 84 0
m0_b set m0_a 85 0
q8 set m0_b 86 0
q9 rec 0 0 0
m1_a set q8 97 0
m1_b set m1_a 98 0
q10 set m1_b 99 0
q11 rec 0 0 0
m2_a set q10 100 0
m2_b set m2_a 101 0
q12 set m2_b 102 0
q13 rec 0 0 0
m3_a set q12 103 0
m3_b set m3_a 104 0
q14 set m3_b 105 0
q15 rec 0 0 0
m4_a set q14 106 0
m4_b set m4_a 107 0
q16 set m4_b 108 0
q17 rec 0 0 0
m5_a set q16 115 0
m5_b set m5_a 116 0
q18 set m5_b 117 0
q19 rec 0 0 0
m6_a set q18 118 0
m6_b set m6_a 119 0
q20 set m6_b 120 0
q21 rec 0 0 0
m7_a set q20 121 0
m7_b set m7_a 122 0
q22 set m7_b 123 0
q23 rec 0 0 0
m8_a set q22 124 0
m8_b set m8_a 125 0
q24 set m8_b 126 0
q25 rec q24 p0
q26 get p1 67
init call ac_zeros q25 118 q26
q27 get p1 67
init_1 call ac_zeros init 121 q27
q28 get p1 42
q29 div q28 14
checked loop ac_more ac_function q29 init_1
out at checked 0
q30 get out 0
q31 at checked 1
q32 rec q30 out q31
ret q32
end

fn arena_parse_check io u32 u32 -> (u32,u32x128,io)
parsed call arena_parse p0 p1 p2
q0 at parsed 2
q1 at parsed 1
q2 call arena_check q0 q1
ret q2
end
