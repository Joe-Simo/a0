use "arena_shared.a0"

fn av_valid (u32,u32,u32) -> bool
h at p0 0
len at p0 1
cap at p0 2
within le len cap
zh eq h 0
zc eq cap 0
same eq zh zc
r and within same
ret r
end

fn av_span (u32,u32,u32) u32 u32 -> bool
valid call av_valid p0
len at p0 1
bounded le p2 128
start le p1 len
remaining sub len p1
fits le p2 remaining
a and valid bounded
b and start fits
r and a b
ret r
end

# Saturating geometric growth. The loop takes at most32 doublings from1.
fn av_growth_more u32 u32 u32 -> bool
r lt p0 p2
ret r
end

fn av_growth_step u32 u32 u32 -> u32
safe le p0 2147483647
doubled mul p0 2
r select safe doubled 4294967295
ret r
end

fn av_growth u32 u32 -> u32
zero eq p0 0
start select zero 1 p0
r loop av_growth_more av_growth_step 32 start p1
ret r
end

fn av_new_alloc (u32,(u32,u32,u32),io) u32 u32 -> (u32,(u32,u32,u32),io)
old at p0 1
t at p0 2
r call arena_alloc t p2
code at r 0
h at r 1
t1 at r 2
v rec h 0 p2
ok eq code 0
outv select ok v old
out rec code outv t1
ret out
end

fn av_new io u32 -> (u32,(u32,u32,u32),io)
v rec 0 0 0
s rec 0 v p0
nonzero ne p1 0
n select nonzero 1 0
r fold av_new_alloc n s p1
ret r
end

fn av_load_valid (u32,u32x128,io) u32 (u32,u32,u32) u32 u32 -> (u32,u32x128,io)
t at p0 2
h at p2 0
r call arena_load t h p3 p4
ret r
end

fn av_load io (u32,u32,u32) u32 u32 -> (u32,u32x128,io)
valid call av_span p1 p2 p3
code select valid 0 3
z call arena_zero
s rec code z p0
nonzero ne p3 0
go and valid nonzero
n select go 1 0
r fold av_load_valid n s p1 p2 p3
ret r
end

fn av_store_valid (u32,io) u32 (u32,u32,u32) u32 u32 u32x128 -> (u32,io)
t at p0 1
h at p2 0
r call arena_store t h p3 p4 p5
ret r
end

fn av_store io (u32,u32,u32) u32 u32 u32x128 -> (u32,io)
valid call av_span p1 p2 p3
code select valid 0 3
s rec code p0
nonzero ne p3 0
go and valid nonzero
n select go 1 0
r fold av_store_valid n s p1 p2 p3 p4
ret r
end

# Copy [0,length) from old to fresh handle, one128-word request at a time.
fn av_copy_store (u32,io) u32 u32 u32 u32 u32x128 -> (u32,io)
t at p0 1
r call arena_store t p2 p3 p4 p5
ret r
end

fn av_copy_ok (u32,io) u32 u32 u32 u32 -> bool
code at p0 0
r eq code 0
ret r
end

fn av_copy_page (u32,io) u32 u32 u32 u32 -> (u32,io)
t at p0 1
off shl p1 7
remaining sub p4 off
big gt remaining 128
count select big 128 remaining
r call arena_load t p2 off count
code at r 0
page at r 1
t1 at r 2
s rec code t1
ok eq code 0
n select ok 1 0
out fold av_copy_store n s p3 off count page
ret out
end

fn av_reserve_alloc (u32,(u32,u32,u32),io) u32 u32 -> (u32,(u32,u32,u32),io)
old at p0 1
t at p0 2
oldh at old 0
len at old 1
cap at old 2
newcap call av_growth cap p2
r call arena_alloc t newcap
code at r 0
newh at r 1
t1 at r 2
whole shr len 7
tail and len 127
has_tail ne tail 0
extra select has_tail 1 0
pages add whole extra
s rec code t1
copy loop av_copy_ok av_copy_page pages s oldh newh len
status at copy 0
t2 at copy 1
fresh rec newh len newcap
ok eq status 0
v select ok fresh old
out rec status v t2
ret out
end

fn av_reserve io (u32,u32,u32) u32 -> (u32,(u32,u32,u32),io)
valid call av_valid p1
code select valid 0 3
s rec code p1 p0
cap at p1 2
larger gt p2 cap
go and valid larger
n select go 1 0
r fold av_reserve_alloc n s p2
ret r
end

fn av_append_store (u32,io) u32 (u32,u32,u32) u32 u32 u32x128 -> (u32,io)
t at p0 1
h at p2 0
r call arena_store t h p3 p4 p5
ret r
end

fn av_append_valid (u32,(u32,u32,u32),io) u32 u32 u32x128 -> (u32,(u32,u32,u32),io)
old at p0 1
t at p0 2
len at old 1
needed add len p2
r call av_reserve t old needed
code at r 0
reserved at r 1
t1 at r 2
s rec code t1
ok eq code 0
n select ok 1 0
st fold av_append_store n s reserved len p2 p3
status at st 0
t2 at st 1
h at reserved 0
cap at reserved 2
fresh rec h needed cap
success eq status 0
v select success fresh old
out rec status v t2
ret out
end

fn av_append io (u32,u32,u32) u32 u32x128 -> (u32,(u32,u32,u32),io)
valid call av_valid p1
bounded le p2 128
len at p1 1
needed add len p2
no_overflow ge needed len
a and valid bounded
safe and a no_overflow
code select safe 0 3
s rec code p1 p0
nonzero ne p2 0
go and safe nonzero
n select go 1 0
r fold av_append_valid n s p2 p3
ret r
end
