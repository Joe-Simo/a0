fn jv_cacherecord(s: (u32,(u32,u32,u32),io), i: u32, c: u32x16, d: u32x128, f: u32, n: u32, t:u32,a:u32,b:u32) -> ((u32,(u32,u32,u32),io),u32,u32,u32)
 let j1 = bg_fail(s,b>254?7:0)
 let j2 = loop(jv_cmore,jv_cchild,b,(j1,0,0),c,t,a,0,0)
 let j3 = j2#0
 let j4 = jv_cap(2+jv_dig(b)+(b==0?0:b-1),j2#1)
 let j5 = jv_cap(13,j4)
 let j6 = bg_fail(j3,(j5>65535)|(jv_cap(3,j2#2)>65535)?7:0)
 let j7 = loop(jv_cmore,jv_cchild,b,(j6,0,0),c,t,a,j4,j5*2)
 let j8 = j7#0
 return (j8,j4,j5,0)
end

