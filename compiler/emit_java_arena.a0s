fn jv_cchild(a:((u32,(u32,u32,u32),io),u32,u32),i:u32,c:u32x16,parent:u32,first:u32,m:u32,dlen:u32) -> ((u32,(u32,u32,u32),io),u32,u32)
 let r=bg_word(a#0,c[1],first+i)
 let s=bg_fail(r#0,r#1>=parent?6:0)
 let q=bg_row(s,c[6],r#1,3)
 let cm=q#1[0]
 let cd=q#1[1]
 let s=bg_fail(q#0,(jv_cap(jv_cap(2,dlen),cd)>65535)|(jv_cap(jv_cap(10,m),jv_dig(i))>65535)|(jv_cap(2,cd)>65535)?7:0)
 return (s,jv_cap(a#1,cm),jv_cap(a#2,cd))
end

fn jv_cachearray(s: (u32,(u32,u32,u32),io), i: u32, c: u32x16, d: u32x128, f: u32, n: u32, t:u32,a:u32,b:u32) -> ((u32,(u32,u32,u32),io),u32,u32,u32)
 let j1 = bg_fail(s,b>=t?6:0)
 let j2 = bg_row(j1,c[6],b,3)
 let j3 = j2#0
 let j4 = jv_cap(2+jv_dig(a),j2#1[0])
 let j5 = jv_cap(1,j2#1[1])
 let j6 = j2#1[2]+1
 let j7 = bg_fail(j3,(j6>255)|(jv_cap(9,j4)>65535)|(jv_cap(3+j5*2,j2#1[1])>65535)?7:0)
 return (j7,j4,j5,j6)
end

fn jv_fdesc(a:((u32,(u32,u32,u32),io),u32),i:u32,c:u32x16,first:u32) -> ((u32,(u32,u32,u32),io),u32)
 let r=bg_word(a#0,c[1],first+i)
 let q=bg_word(r#0,c[6],r#1*3+1)
 return (q#0,jv_cap(a#1,q#1))
end

fn jv_mstep(a: ((u32,(u32,u32,u32),io),(u32,u32,u32)), i:u32,c:u32x16,d:u32x128,f:u32,n:u32) -> ((u32,(u32,u32,u32),io),(u32,u32,u32))
 let j1 = a#0
 let j2 = a#1
 let j3 = j2#1-1
 let j4 = bg_word(j1,j2#0,j3)
 let j5 = j4#0
 let j6 = j4#1
 let j7 = j6==0?0:j6-1
 let j8 = bg_word(j5,c[0],(j7)*3+0)
 let j9 = j8#0
 let j10 = j8#1
 let j11 = bg_word(j9,c[0],(j7)*3+1)
 let j12 = j11#0
 let j13 = j11#1
 let j14 = bg_word(j12,c[0],(j7)*3+2)
 let j15 = j14#0
 let j16 = j14#1
 let j17 = fold(jvl0,bit(j6==0),j15,c,d,f,n)
 let j18 = fold(jvl1,bit((j6!=0)&(j10==1)),j17,c,d,f,n)
 let j19 = fold(jvl2,bit((j6!=0)&(j10==2)),j18,c,d,f,n)
 let j20 = fold(jvl3,bit((j6!=0)&(j10==3)),j19,c,d,f,n)
 let j21 = fold(jvl4,bit((j6!=0)&(j10==4)),j20,c,d,f,n)
 let j22 = fold(jv_number,bit((j6!=0)&(j10==4)),j21,c,d,f,n,j13)
 let j23 = fold(jvl5,bit((j6!=0)&(j10==5)),j22,c,d,f,n)
 let j24 = fold(jv_number,bit((j6!=0)&(j10==5)),j23,c,d,f,n,j16)
 let j25 = fold(jvl0,bit((j6!=0)&(j10>=4)),j24,c,d,f,n)
 let j26 = (j25,(j2#0,j3,j2#2))
 let j27 = fold(jv_marray,bit((j6!=0)&(j10==4)),j26,j16)
 let j28 = fold(jv_mchild,(j6!=0)&(j10==5)?j16:0,j27,c,j13,j16)
 return j28
end

