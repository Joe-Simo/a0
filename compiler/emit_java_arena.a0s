fn java_emit_options(t:io,c:u32x16,d:u32x128,inputCapacity:u32,outputCapacity:u32) -> (u32,(u32,u32,u32),io)
 let valid=(d[0]==0)&(d[8]<=1)&(d[1]==1093681731)&(d[2]==1)&(d[9]==c[11])&(d[11]==c[12])&(d[10]==c[13])&(d[16]==c[0])&(d[19]==c[1])&(d[22]==c[2])&(d[25]==c[3])&(d[28]==c[4])&(d[31]==c[5])
 let s=(valid?0:6,(0,0,0),t)
 let s=bg_fail(s,(inputCapacity>2147483647)|(outputCapacity>2147483647)?7:0)
 let c=set(set(c,14,inputCapacity),15,outputCapacity)
 let s=bg_fail(s,c[12]>1431655765?7:0)
 let cache=bg_alloc(s,c[12]*3)
 let s=cache#0
 let c=set(c,6,cache#1)
 let s=loop(jv_more,jv_scantype,c[12],s,c,d,0,0)
 let s=loop(jv_more,jv_scanfn,c[11],s,c,d,0,0)
 let s=loop(jv_more,jv_scandescriptor,c[11],s,c,d,0,0)
 let s=fold(jv_emitbody,bit(s#0==0),s,c,d,0,0)
 return ew_public(s)
end

fn java_emit(t:io,c:u32x16,d:u32x128) -> (u32,(u32,u32,u32),io)
 return java_emit_options(t,c,d,256,1024)
end
