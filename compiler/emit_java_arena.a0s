fn jv_munder(a:((u32,(u32,u32,u32),io),(u32,u32,u32)),i:u32) -> ((u32,(u32,u32,u32),io),(u32,u32,u32))
 return jv_push(a,0)
end

fn jv_marray(a:((u32,(u32,u32,u32),io),(u32,u32,u32)),i:u32,t:u32) -> ((u32,(u32,u32,u32),io),(u32,u32,u32))
 return jv_push(a,t+1)
end

fn jv_scanfn(s: (u32,(u32,u32,u32),io), i: u32, c: u32x16, d: u32x128, f: u32, n: u32) -> (u32,(u32,u32,u32),io)
 let f=i
 let j1 = bg_word(s,c[2],(f)*10+5)
 let j2 = j1#0
 let j3 = j1#1
 let j4 = bg_word(j2,c[2],(f)*10+6)
 let j5 = j4#0
 let j6 = j4#1
 let j7 = bg_word(j5,c[2],(f)*10+2)
 let j8 = j7#0
 let j9 = j7#1
 let j10 = bg_word(j8,c[2],(f)*10+0)
 let j11 = j10#0
 let j12 = j10#1
 let j13 = bg_word(j11,c[2],(f)*10+1)
 let j14 = j13#0
 let j15 = j13#1
 let j16 = bg_word(j14,c[2],(f)*10+9)
 let j17 = j16#0
 let j18 = j16#1
 let j19 = bg_fail(j17,j9>255?7:0)
 let j20 = bg_read(j19,c[5],j12,jv_min(j15,12))
 let j21 = j20#0
 let j22 = j20#1
 let j23 = jv_kw0(j22,j15) | jv_kw1(j22,j15) | jv_kw2(j22,j15) | jv_kw3(j22,j15) | jv_kw4(j22,j15) | jv_kw5(j22,j15) | jv_kw6(j22,j15) | jv_kw7(j22,j15) | jv_kw8(j22,j15)
 let j24 = (j9==0)&(((j15==4)&(j22[0]==119)&(j22[1]==97)&(j22[2]==105)&(j22[3]==116)) | ((j15==6)&(j22[0]==110)&(j22[1]==111)&(j22[2]==116)&(j22[3]==105)&(j22[4]==102)&(j22[5]==121)) | ((j15==5)&(j22[0]==99)&(j22[1]==108)&(j22[2]==111)&(j22[3]==110)&(j22[4]==101)) | ((j15==8)&(j22[0]==102)&(j22[1]==105)&(j22[2]==110)&(j22[3]==97)&(j22[4]==108)&(j22[5]==105)&(j22[6]==122)&(j22[7]==101)))
 let j25 = bg_fail(j21,(j23|j24)?7:0)
 let j26 = bg_fail(j25,j18!=d[8]?6:0)
 let j27 = bg_row(j26,d[37],f,12)
 let j28 = j27#0
 let j29 = bg_fail(j28,j27#1[0]!=f?6:0)
 let n=j3
 let j30 = fold(jv_scannode,j6,j29,c,d,f,n)
 return j30
end

def jv_cap(a:u32,b:u32) -> u32
 return jv_min(65536,a+b)
end

fn jv_mchild(a:((u32,(u32,u32,u32),io),(u32,u32,u32)),i:u32,c:u32x16,first:u32,count:u32) -> ((u32,(u32,u32,u32),io),(u32,u32,u32))
 let k=count-i-1
 let r=bg_word(a#0,c[1],first+k)
 let b=(r#0,a#1)
 let b=jv_push(b,r#1+1)
 let b=fold(jv_munder,bit(k!=0),b)
 return b
end

fn jv_brackets(s: (u32,(u32,u32,u32),io), i: u32, c: u32x16, d: u32x128, f: u32, n: u32) -> (u32,(u32,u32,u32),io)
 let j1 = fold(jvl10,1,s,c,d,f,n)
 return j1
end

fn jv_operand(s: (u32,(u32,u32,u32),io), i: u32, c: u32x16, d: u32x128, f: u32, n: u32, kind:u32,value:u32) -> (u32,(u32,u32,u32),io)
 let j1 = fold(jvl11,bit(kind==1),s,c,d,f,n)
 let j2 = fold(jvl12,bit(kind==2),j1,c,d,f,n)
 let j3 = fold(jv_number,bit((kind==1)|(kind==2)),j2,c,d,f,n,value)
 let j4 = fold(jvl13,bit(kind==3),j3,c,d,f,n)
 let j5 = fold(jv_number,bit(kind==3),j4,c,d,f,n,value)
 let j6 = fold(jvl14,bit(kind==3),j5,c,d,f,n)
 let j7 = fold(jvl15,bit((kind==4)&(value==0)),j6,c,d,f,n)
 let j8 = fold(jvl16,bit((kind==4)&(value!=0)),j7,c,d,f,n)
 return j8
end

fn jv_prelude(s: (u32,(u32,u32,u32),io), i: u32, c: u32x16, d: u32x128, f: u32, n: u32) -> (u32,(u32,u32,u32),io)
 let j1 = fold(jvl18,1,s,c,d,f,n)
 let j2 = bxtext_num(j1,c[14])
 let j3 = fold(jvl19,1,j2,c,d,f,n)
 let j4 = bxtext_num(j3,c[15])
 let j5 = fold(jvl20,1,j4,c,d,f,n)
 let j6 = bxtext_num(j5,c[14])
 let j7 = fold(jvl21,1,j6,c,d,f,n)
 let j8 = bxtext_num(j7,c[15])
 let j9 = fold(jvl22,1,j8,c,d,f,n)
 return j9
end

fn jv_oldfield(s: (u32,(u32,u32,u32),io), i: u32, c: u32x16, d: u32x128, f: u32, n: u32, k:u32) -> (u32,(u32,u32,u32),io)
 let j1 = fold(jvl25,1,s,c,d,f,n)
 let j2 = bxtext_num(j1,k)
 let j3 = fold(jvl26,1,j2,c,d,f,n)
 return j3
