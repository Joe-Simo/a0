use "arena_shared.a0"

fn arena_hello io -> (u32,io)
r call arena_reply p0
status at r 0
count at r 1
a at r 2
t at r 3
code call arena_expect status count 2
magic get a 0
version get a 1
m ne magic 1093681490
v ne version 1
bad or m v
ok eq code 0
both and ok bad
outcode select both 1 code
out rec outcode t
ret out
end

fn arena_emit_valid (u32,io) u32 u32 u32x128 -> (u32,io)
t at p0 1
a write t 4
n add p2 1
b write a n
c write b p2
d fold arena_write_word p2 c p3
r call arena_ack d
ret r
end

fn arena_emit io u32 u32x128 -> (u32,io)
ok le p1 128
n select ok 1 0
s rec 3 p0
r fold arena_emit_valid n s p1 p2
ret r
end

fn arena_finish io u32 -> (u32,io)
a write p0 5
b write a 1
c write b p1
r call arena_ack c
ret r
end
