# The mask of a type token: 1 for `u32`, 2 for `bool`, the descriptor of an array of u32 or bool of one or two
# dimensions (the lexer computes it: nv), else 8.
fn tycls (u32,u32,u32,u32,u32,u32,u32,u32) -> u32
kd at p0 0
nv at p0 6
fl at p0 7
