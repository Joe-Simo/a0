# A written parameter (entry p3 + i of the table p2): its tokens are a type.
fn tvspan bool u32 (u32,u32)x128x16 u32 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 -> bool
ix add p3 p1
pe call ptget p2 ix
ps at pe 0
pn at pe 1
cn0 sub pn ps
cnt add cn0 1
z rec 0 0 true 0 0 0 0 0 0 0 0 0
st fold tvtok cnt z p4 ps
d at st 0
ex at st 1
ok at st 2
lw at st 3
d0 eq d 0
e1 eq ex 1
a and d0 e1
v0 and a ok
wok le lw 2097152
v and v0 wok
nv eq v false
r or p0 nv
ret r
end

# The mask of the written parameter j (p4) of a function whose parameter spans start at p1 of the
# table p0 (p2 parameters written, or 4294967295 when none): `u32`, `bool` or another type; an
# implicit parameter and one past the written ones are u32.
fn ptyp (u32,u32)x128x16 u32 u32 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32 -> u32
expl ne p2 4294967295
inr lt p4 p2
usd and expl inr
ix add p1 p4
ix2 select usd ix 0
pe call ptget p0 ix2
ps at pe 0
pn at pe 1
one eq ps pn
tk call tkget p3 ps
c call tycls tk
c2 select one c 8
r select usd c2 1
ret r
end

# The mask of an operand (kind p1, value p2) of a node of a function whose first node is p3, given the
# masks of its earlier nodes p0 and the parameters (spans, first span, count written, tokens, functions) p4.
fn tyopd u32x128x16 u32 u32 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> u32
isn eq p1 1
isp eq p1 2
isbl eq p1 4
ge1 ge p2 p3
li sub p2 p3
lt1 lt li 2048
gn0 and isn ge1
gn and gn0 lt1
lis select gn li 0
tpg shr lis 7
tpa get p0 tpg
tlo and lis 127
tn get tpa tlo
pp at p4 0
pf at p4 1
pnp at p4 2
ptk at p4 3
pj select isp p2 0
tp call ptyp pp pf pnp ptk pj
r1 select isbl 2 1
r2 select isp tp r1
r select isn tn r2
ret r
end

# One argument of a call, fold, loop or array in the pool (argument p4 + i): the state (an error possible, a
# non-error possible for each so far, the mask of the first argument, the mask of the second argument).
fn tyarg (bool,bool,u32,u32) u32 u32x128x16 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 u32 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> (bool,bool,u32,u32)
ae at p0 0
an at p0 1
t0 at p0 2
t1 at p0 3
ix add p4 p1
e call pget p3 ix
k at e 0
v at e 1
t call tyopd p2 k v p5 p6
te and t 4
tee ne te 0
tn and t 11
tnn ne tn 0
ae2 or ae tee
an2 and an tnn
is0 eq p1 0
is1 eq p1 1
t02 select is0 t t0
t12 select is1 t t1
r rec ae2 an2 t02 t12
ret r
end

