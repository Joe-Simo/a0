fn zpw -> u32x10
pw arr 1 10 100 1000 10000 100000 1000000 10000000 100000000 1000000000
ret pw
end

# One byte appended to the output.
fn ob (u32x128x128,u32) u32 -> (u32x128x128,u32)
out at p0 0
pos at p0 1
ix shr pos 7
pg get out ix
lo and pos 127
pg2 set pg lo p1
o2 set out ix pg2
np add pos 1
r rec o2 np
ret r
end

fn putcb (u32x128x128,u32) u32 u32x256 u32 -> (u32x128x128,u32)
ix add p3 p1
b get p2 ix
r call ob p0 b
ret r
end

# n bytes of the constant text from offset off.
fn putc (u32x128x128,u32) u32x256 u32 u32 -> (u32x128x128,u32)
r fold putcb p3 p0 p1 p2
ret r
end

fn putsb (u32x128x128,u32) u32 u32x128x128 u32 -> (u32x128x128,u32)
x add p3 p1
xp shr x 7
pg get p2 xp
b get pg x
r call ob p0 b
ret r
end

# n bytes of the source from byte start.
fn putsrc (u32x128x128,u32) u32x128x128 u32 u32 -> (u32x128x128,u32)
r fold putsb p3 p0 p1 p2
ret r
end

fn putwb (u32x128x128,u32) u32 u32 u32 -> (u32x128x128,u32)
q1 sub p3 1
q2 sub q1 p1
q3 mul q2 8
v shr p2 q3
b and v 255
r call ob p0 b
ret r
end

# n bytes of the packed word w, most significant first.
fn putw (u32x128x128,u32) u32 u32 -> (u32x128x128,u32)
r fold putwb p2 p0 p1 p2
ret r
end

fn dcnb u32 u32 u32x10 u32 -> u32
ix add p1 1
pwi get p2 ix
g2 ge p3 pwi
inc select g2 1 0
r add p0 inc
ret r
end

fn putnb (u32x128x128,u32) u32 u32x10 u32 u32 -> (u32x128x128,u32)
e1 sub p4 1
e sub e1 p1
pwv get p2 e
dv div p3 pwv
dm rem dv 10
ch add dm 48
r call ob p0 ch
ret r
end

# The decimal digits of v when gate, else nothing.
fn putnum (u32x128x128,u32) u32 bool -> (u32x128x128,u32)
pw call zpw
dc fold dcnb 9 1 pw p1
ng select p2 dc 0
r fold putnb ng p0 pw p1 dc
ret r
end

# The name of the candidate j in the default sequence a, b, ..., z, aa, ...: (length, packed).
fn cnstep (u32,u32,u32) u32 -> (u32,u32,u32)
nn at p0 0
lw at p0 1
ll at p0 2
pos0 gt nn 0
nm1 sub nn 1
dd rem nm1 26
nx div nm1 26
ch add dd 97
sh mul ll 8
one mov 1
pwr shl one sh
term mul ch pwr
lw2 add lw term
ll2 add ll 1
nn2 select pos0 nx nn
lw3 select pos0 lw2 lw
ll3 select pos0 ll2 ll
r rec nn2 lw3 ll3
ret r
end

fn cname u32 -> (u32,u32)
n0 add p0 1
r0 rec n0 0 0
fin fold cnstep 4 r0
lw at fin 1
ll at fin 2
out rec ll lw
ret out
end

