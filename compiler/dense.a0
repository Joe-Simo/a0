fn arity u32 -> u32
a0 mov 0
e1 eq p0 1
x1 select e1 1 a0
g0a ge p0 2
g0b le p0 15
g0c and g0a g0b
y0 select g0c 2 x1
g1a ge p0 16
g1b le p0 16
g1c and g1a g1b
y1 select g1c 3 y0
g2a ge p0 19
g2b le p0 19
g2c and g2a g2b
y2 select g2c 2 y1
g3a ge p0 20
g3b le p0 20
g3c and g3a g3b
y3 select g3c 3 y2
g4a ge p0 21
g4b le p0 22
g4c and g4a g4b
y4 select g4c 2 y3
ret y4
end


# Pass 2: tokens to functions and nodes. A statement is a prefix expression over fixed arities,
# read forward with a frame stack; a node is created when its last operand completes, so the
# nodes come in canonical order. A parenthesized group is a record (or a single operand).
# Frames: (op, need, have, comma, k0, v0, k1, v1, k2, v2, k3, v3); op 99 is a group.
# Functions: (name token, parameter count or 4294967295 when implicit, first parameter span,
# result token span or 4294967295 for u32, first node, return kind, return value).

fn tkget (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32 -> (u32,u32,u32,u32,u32,u32,u32,u32)
ix shr p1 7
pg get p0 ix
r get pg p1
ret r
end

fn bget u32x128x16 u32 -> u32
ix shr p1 7
pg get p0 ix
r get pg p1
ret r
end

fn ntget (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x16 u32 -> (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)
ix shr p1 7
pg get p0 ix
r get pg p1
ret r
end

fn ntset (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x16 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) -> (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x16
ix shr p1 7
pg get p0 ix
lo and p1 127
pg2 set pg lo p2
r set p0 ix pg2
ret r
end

fn ftget (u32,u32,u32,u32,u32,u32,u32,u32)x128x4 u32 -> (u32,u32,u32,u32,u32,u32,u32,u32)
ix shr p1 7
pg get p0 ix
r get pg p1
ret r
end

fn ftset (u32,u32,u32,u32,u32,u32,u32,u32)x128x4 u32 (u32,u32,u32,u32,u32,u32,u32,u32) -> (u32,u32,u32,u32,u32,u32,u32,u32)x128x4
ix shr p1 7
pg get p0 ix
lo and p1 127
pg2 set pg lo p2
r set p0 ix pg2
ret r
end

fn ptget (u32,u32)x128x16 u32 -> (u32,u32)
ix shr p1 7
pg get p0 ix
r get pg p1
