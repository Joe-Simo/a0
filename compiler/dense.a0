# An operand: a node (its id), a parameter (p + index), a u32 literal, or a bool.
fn emitop (u32x128x128,u32) u32 u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32) bool -> (u32x128x128,u32)
