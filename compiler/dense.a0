ret s5
end

# A fold or loop spec (kind p1: 5 a function, value p2 its index; 7 an inline body, p3 its number among
# the bodies of the function p8): its name. A lifted body is named like the function, an underscore and
# its number.
fn pspec (u32x128x128,u32) u32 u32 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32x128x128 u32x256 u32 -> (u32x128x128,u32)
is5 eq p1 5
is7 eq p1 7
v5 select is5 p2 0
fe5 call ftget p4 v5
nm5 at fe5 0
tk5 call tkget p5 nm5
st5 at tk5 2
ln5 at tk5 1
g5 select is5 ln5 0
o1 call putsrc p0 p6 st5 g5
feo call ftget p4 p8
nmo at feo 0
tko call tkget p5 nmo
sto at tko 2
lno at tko 1
g7 select is7 lno 0
o2 call putsrc o1 p6 sto g7
us select is7 1 0
o3 call putc o2 p7 117 us
o4 call putnum o3 p3 is7
ret o4
end

# One argument: a space and the operand, when the kind is not 0.
fn emitarg (u32x128x128,u32) u32 u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32) -> (u32x128x128,u32)
nz ne p1 0
n1 select nz 1 0
csta at p3 7
s1 call putc p0 csta 3 n1
s2 call emitop s1 p1 p2 p3 nz
ret s2
end

# One argument of a call: its pool entry (kind, value), written as an argument.
fn cargs (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32) -> (u32x128x128,u32)
ix add p3 p1
e call pget p2 ix
k at e 0
v at e 1
r call emitarg p0 k v p4
ret r
end

# One node line: `id op args`.
fn nodeline (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32) -> (u32x128x128,u32)
ix add p1 p3
nd call ntget p2 ix
op at nd 0
na at nd 2
k0 at nd 3
v0 at nd 4
k1 at nd 5
v1 at nd 6
k2 at nd 7
v2 at nd 8
k3 at nd 9
v3 at nd 10
isc1 ge op 24
isc2 le op 26
isc and isc1 isc2
isl eq op 26
ip2 le op 27
ispool and isc1 ip2
nac select ispool 0 na
q0 gt nac 0
q1 gt nac 1
q2 gt nac 2
q3 gt nac 3
kg0 select q0 k0 0
kg1 select q1 k1 0
kg2 select q2 k2 0
kg3 select q3 k3 0
csta at p4 7
fta at p4 8
toka at p4 5
srca at p4 6
s0 call emitid p0 p1 p4 true
s1 call putc s0 csta 3 1
oo arr 37 37 40 43 46 49 52 54 57 60 63 65 67 69 71 73 75 81 84 87 89 92 95 98 101 105 109 118
ol arr 0 3 3 3 3 3 2 3 3 3 2 2 2 2 2 2 6 3 3 2 3 3 3 3 4 4 4 3
ofs get oo op
olen get ol op
s2 call putc s1 csta ofs olen
own at p4 9
sb0 sub k2 6
sb shr sb0 3
predseq add sb 1
pdp select isl 1 0
pdk select isl k3 0
pd1 call putc s2 csta 3 pdp
pd2 call pspec pd1 pdk v3 predseq fta toka srca csta own
pinl eq k3 7
pnn select pinl 1 0
bodyseq add predseq pnn
bodyk select isc k0 0
csp select isc 1 0
sc1 call putc pd2 csta 3 csp
sc2 call pspec sc1 bodyk v0 bodyseq fta toka srca csta own
cna select ispool na 0
sc3 fold cargs cna sc2 p2 v2 p4
s3 call emitarg sc3 kg0 v0 p4
s4 call emitarg s3 kg1 v1 p4
s5 call emitarg s4 kg2 v2 p4
s6 call emitarg s5 kg3 v3 p4
s7 call putc s6 csta 11 1
ret s7
end

# A parameter of an explicit list: a space and the span of its type tokens.
fn parem (u32x128x128,u32) u32 (u32,u32)x128x16 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32x128x128 u32x256 u32 -> (u32x128x128,u32)
pix add p6 p1
pe call ptget p2 pix
ps at pe 0
pn at pe 1
bs call tkget p3 ps
bst at bs 2
ee call tkget p3 pn
eb at ee 2
el at ee 1
enb add eb el
nb sub enb bst
sp1 call putc p0 p5 3 1
r call putsrc sp1 p4 bst nb
ret r
end

# An implicit parameter: a space and u32.
fn impem (u32x128x128,u32) u32 u32x256 -> (u32x128x128,u32)
sp1 call putc p0 p2 3 1
r call putc sp1 p2 8 3
ret r
end

# The id context of a function or an inline body: ids (explicit, retval, default), default names. The
# nodes are p5 + 0 .. p6 - 1; p7 is the function that owns them.
fn pctx (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32x128x128 u32x256 (u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4 u32 u32 u32 -> (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32)
za call z2048
zb call z2048
ids0 rec za zb 0
ids fold idfold p6 ids0 p0 p5
idk at ids 0
idv at ids 1
zc call z2048
zd call z2048
dns0 rec zc zd 0
nlc add p6 64
dns fold dncand nlc dns0 idk idv p1 p6
dnw at dns 0
dnl at dns 1
ctx rec idk idv dnw dnl p5 p1 p2 p3 p4 p7
ret ctx
end

# The node lines, the result line and `end` of a function or body, then the separator (p7 bytes from
# offset p8 of the constant text p9). The nodes are p3 + 0 .. p4 - 1, the result is (p5, p6).
fn plines (u32x128x128,u32) (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32) u32 u32 u32 u32 u32 u32 u32x256 -> (u32x128x128,u32)
ln0 fold nodeline p4 p0 p1 p3 p2
r1 call putc ln0 p9 17 4
r2 call emitop r1 p5 p6 p2 true
r3 call putc r2 p9 11 1
e1 call putc r3 p9 14 3
e2 call putc e1 p9 p8 p7
ret e2
end

# A mask as a type: u32 or bool.
fn ptm (u32x128x128,u32) u32 u32x256 -> (u32x128x128,u32)
is1 eq p1 1
is2 eq p1 2
n1 select is1 3 0
n2 select is2 4 0
a call putc p0 p2 8 n1
b call putc a p2 113 n2
ret b
end

# Parameter j of a lifted function (the fold or loop node has its operands from pool argument p3): a space
# and its type. It is the mask of the state operand (j = 0), u32 (j = 1), or the mask of the operand j.
fn plpar (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 u32 u32x128x16 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) u32x256 -> (u32x128x128,u32)
j0 eq p1 0
ai select j0 1 p1
ix add p3 ai
e call pget p2 ix
k at e 0
v at e 1
m call tyopd p4 k v p5 p6
j1 eq p1 1
mm select j1 1 m
sp call putc p0 p7 3 1
r call ptm sp mm p7
ret r
end

# One lifted function: the body p11 of the fold or loop node whose operands start at pool argument p7 (p8
# of them), as the function number p10 of the function p4 (its nodes from p5, with the masks p3). p9 is 0
# for a predicate and 1 for a body.
fn plf (u32x128x128,u32) (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 ((u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,(u32,u32)x128x16,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256) u32x128x16 u32 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) u32 u32 u32 u32 u32 -> (u32x128x128,u32)
ft at p2 0
tk at p2 2
src at p2 3
cst at p2 4
h1 call putc p0 cst 0 3
nm call pspec h1 7 0 p10 ft tk src cst p4
pf fold plpar p8 nm p1 p7 p3 p5 p6 cst
ar call putc pf cst 4 4
ix1 add p7 1
e1 call pget p1 ix1
k1 at e1 0
v1 at e1 1
m1 call tyopd p3 k1 v1 p5 p6
ispred eq p9 0
rm select ispred 2 m1
rt call ptm ar rm cst
nl call putc rt cst 11 1
dix add 4579 p11
de call ntget p1 dix
first at de 0
cnt at de 1
rk at de 2
rv at de 3
ctx call pctx p1 tk src cst ft first cnt p4
r call plines nl p1 ctx first cnt rk rv 2 12 cst
ret r
end

# plf as a fold step (a count of 0 prints nothing).
fn plff (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 ((u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,(u32,u32)x128x16,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256) u32x128x16 u32 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) u32 u32 u32 u32 u32 -> (u32x128x128,u32)
r call plf p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12
ret r
end

# The lifted functions of the fold and loop nodes of the function p5 (nodes from p6, masks p4): for the
# node p1, the predicate and then the body, each when it is an inline body.
fn plnode (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 ((u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,(u32,u32)x128x16,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256) u32x128x16 u32 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> (u32x128x128,u32)
ix add p6 p1
nd call ntget p2 ix
op at nd 0
na at nd 2
k0 at nd 3
v0 at nd 4
k2 at nd 7
v2 at nd 8
k3 at nd 9
v3 at nd 10
ge25 ge op 25
le26 le op 26
isfl and ge25 le26
pin0 eq k3 7
bin0 eq k0 7
pin and isfl pin0
bin and isfl bin0
pc select pin 1 0
bc select bin 1 0
sb0 sub k2 6
sb shr sb0 3
s1 add sb 1
pnn select pin 1 0
s2 add s1 pnn
o1 fold plff pc p0 p2 p3 p4 p5 p6 p7 v2 na 0 s1 v3
o2 fold plff bc o1 p2 p3 p4 p5 p6 p7 v2 na 1 s2 v0
ret o2
end

# The flag, set when the node p1 of the function (from p3) is a fold or loop with an inline body.
fn hasinl bool u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 u32 -> bool
ix add p3 p1
nd call ntget p2 ix
op at nd 0
k0 at nd 3
k3 at nd 9
ge25 ge op 25
le26 le op 26
isfl and ge25 le26
a eq k0 7
b eq k3 7
c or a b
d and isfl c
r or p0 d
ret r
end

# One function: its lifted functions, its header, node lines, ret line and end; then the separator to the
# next.
fn pfn (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x40 (u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4 (u32,u32)x128x16 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32x128x128 u32x256 u32 u32 -> (u32x128x128,u32)
fr call ftget p3 p1
fnm at fr 0
npar at fr 1
pfs at fr 2
rss at fr 3
rse at fr 4
nfi at fr 5
rk at fr 6
rv at fr 7
f1 add p1 1
nxt call ftget p3 f1
nxf at nxt 5
lastf eq f1 p8
nfend select lastf p9 nxf
nl0 sub nfend nfi
lt3 lt nfi nfend
nl select lt3 nl0 0
ctx call pctx p2 p5 p6 p7 p3 nfi nl p1
need0 fold needfold nl 0 p2 nfi
rk2 eq rk 2
rv1 add rv 1
rkm select rk2 rv1 0
gneed gt need0 rkm
needed select gneed need0 rkm
ex0 eq npar 4294967295
expl ne npar 4294967295
nexp select expl npar 0
env rec p3 p4 p5 p6 p7
tyc rec p4 pfs npar p5 p3
hin fold hasinl nl false p2 nfi
tcn select hin nl 0
ta call tyfold p2 nfi tcn tyc
lo fold plnode tcn p0 p2 env ta p1 nfi tyc
h1 call putc lo p7 0 3
ftk call tkget p5 fnm
nst at ftk 2
nln at ftk 1
h2 call putsrc h1 p6 nst nln
h3 fold parem nexp h2 p4 p5 p6 p7 pfs
hn select expl 0 needed
h4 fold impem hn h3 p7
h5 call putc h4 p7 4 4
expl2 ne rss 4294967295
rtk call tkget p5 rss
rst at rtk 2
rtk2 call tkget p5 rse
rend2 at rtk2 2
rlen2 at rtk2 1
rsum add rend2 rlen2
rnb0 sub rsum rst
rn select expl2 rnb0 0
h6 call putsrc h5 p6 rst rn
rty at fr 8
isbo eq rty 2
imp eq expl2 false
nbo eq isbo false
ru0 and imp nbo
ru select ru0 3 0
rbb and imp isbo
rb select rbb 4 0
h7 call putc h6 p7 8 ru
h7b call putc h7 p7 113 rb
h8 call putc h7b p7 11 1
sepn select lastf 1 2
sepo select lastf 11 12
r call plines h8 p2 ctx nfi nl rk rv sepn sepo p7
ret r
end

# One byte of a name (byte p3 + k of the source p2): the state (in a run of digits after an underscore,
# digits in it).
fn usbyte (bool,u32) u32 u32x128x128 u32 -> (bool,u32)
x add p3 p1
pg shr x 7
pa get p2 pg
lo and x 127
c get pa lo
isu eq c 95
d1 ge c 48
d2 le c 57
dg and d1 d2
inr at p0 0
cnt at p0 1
c1 add cnt 1
dgin and dg inr
nin0 select dg false false
inr1 select dgin true nin0
inr2 select isu true inr1
cn1 select dgin c1 0
cn2 select isu 0 cn1
r rec inr2 cn2
ret r
end

# The flag, set when the name of function p1 ends with an underscore and digits (CALLER_N is the name
# of an inline body: such a name could be one).
fn usfn bool u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32x128x128 -> bool
fe call ftget p2 p1
nm at fe 0
t call tkget p3 nm
st at t 2
ln at t 1
z rec false 0
f fold usbyte ln z p4 st
inr at f 0
cnt at f 1
pos ne cnt 0
hit and inr pos
r or p0 hit
ret r
end

# The canonical text of one source: the tables of the lexer and the parser, then every function.
fn canonfn u32x128x128 u32 -> ((u32x128x128,u32),bool)
lx call lexall p0 p1
nb at lx 3
bd at lx 2
tk at lx 0
g00 call zg
g0 call seedg g00 nb bd tk
gl fold lnstep nb g0 bd tk
g call fin gl tk
gnt at g 0
gnn at g 1
gft at g 2
gnf at g 3
gpt at g 4
cst text "fn   -> u32\n\n\nendret retvalptruefalsemovaddsubmulandorxorshlshreqneltlegtgeselectgetsetatputdivremreccallfoldloopbool_arr                                                                                                                                       "
zo call zout
o0 rec zo 0
o1 fold pfn gnf o0 gnt gft gpt tk p0 cst gnf gnn
lxe at lx 4
gge at g 6
gnp at g 5
mfin call ntget gnt 2048
nbod at mfin 7
hasb ne nbod 0
usn select hasb gnf 0
usb fold usfn usn false gft tk p0
cap1 gt p1 16384
ov1 gt gnn 2048
ov2 gt gnf 512
ov3 gt gnp 2048
opos at o1 1
ov4 gt opos 16384
e01 or lxe gge
e02 or e01 cap1
e03 or e02 ov1
e04 or e03 ov2
e05 or e04 ov3
e06 or e05 ov4
e07 or e06 usb
res rec o1 e07
ret res
end
