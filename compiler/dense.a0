tst at tk 2
tln at tk 1
n1 select g1 tln 0
s2 call putsrc s1 srca tst n1
n2 select g2 6 0
s3 call putc s2 csta 21 n2
ret s3
end

# An operand: a node (its id), a parameter (p + index), a u32 literal, or a bool.
fn emitop (u32x128x128,u32) u32 u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) bool -> (u32x128x128,u32)
is1 eq p1 1
is2 eq p1 2
is3 eq p1 3
is4 eq p1 4
g1 and p4 is1
nfa at p3 4
li sub p2 nfa
s1 call emitid p0 li p3 g1
csta at p3 7
g2 and p4 is2
n2 select g2 1 0
s2 call putc s1 csta 27 n2
gn or is2 is3
gnum and p4 gn
s3 call putnum s2 p2 gnum
vt ne p2 0
gtr and is4 vt
gtr2 and p4 gtr
ntr select gtr2 4 0
s4 call putc s3 csta 28 ntr
vf eq p2 0
gfa and is4 vf
gfa2 and p4 gfa
nfl select gfa2 5 0
s5 call putc s4 csta 32 nfl
ret s5
end

# One argument: a space and the operand, when the kind is not 0.
fn emitarg (u32x128x128,u32) u32 u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> (u32x128x128,u32)
nz ne p1 0
n1 select nz 1 0
csta at p3 7
s1 call putc p0 csta 3 n1
s2 call emitop s1 p1 p2 p3 nz
ret s2
end

# One argument of a call: its pool entry (kind, value), written as an argument.
fn cargs (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> (u32x128x128,u32)
ix add p3 p1
e call pget p2 ix
k at e 0
v at e 1
r call emitarg p0 k v p4
ret r
end

# One node line: `id op args`.
fn nodeline (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> (u32x128x128,u32)
ix add p1 p3
nd call ntget p2 ix
op at nd 0
na at nd 2
k0 at nd 3
v0 at nd 4
k1 at nd 5
v1 at nd 6
k2 at nd 7
v2 at nd 8
k3 at nd 9
v3 at nd 10
isc1 ge op 24
isc2 le op 26
isc and isc1 isc2
isl eq op 26
nac select isc 0 na
q0 gt nac 0
q1 gt nac 1
q2 gt nac 2
q3 gt nac 3
kg0 select q0 k0 0
kg1 select q1 k1 0
kg2 select q2 k2 0
kg3 select q3 k3 0
csta at p4 7
fta at p4 8
toka at p4 5
srca at p4 6
s0 call emitid p0 p1 p4 true
s1 call putc s0 csta 3 1
oo arr 37 37 40 43 46 49 52 54 57 60 63 65 67 69 71 73 75 81 84 87 89 92 95 98 101 105 109
ol arr 0 3 3 3 3 3 2 3 3 3 2 2 2 2 2 2 6 3 3 2 3 3 3 3 4 4 4
ofs get oo op
olen get ol op
s2 call putc s1 csta ofs olen
pdf call ftget fta v3
pdn at pdf 0
pdt call tkget toka pdn
pds at pdt 2
pdl at pdt 1
pdp select isl 1 0
pdl2 select isl pdl 0
pd1 call putc s2 csta 3 pdp
pd2 call putsrc pd1 srca pds pdl2
cfe call ftget fta v0
cfn at cfe 0
cft call tkget toka cfn
cfs at cft 2
cfl at cft 1
csp select isc 1 0
sc1 call putc pd2 csta 3 csp
cfl2 select isc cfl 0
sc2 call putsrc sc1 srca cfs cfl2
cna select isc na 0
sc3 fold cargs cna sc2 p2 v2 p4
s3 call emitarg sc3 kg0 v0 p4
s4 call emitarg s3 kg1 v1 p4
s5 call emitarg s4 kg2 v2 p4
s6 call emitarg s5 kg3 v3 p4
s7 call putc s6 csta 11 1
ret s7
end

# A parameter of an explicit list: a space and the span of its type tokens.
fn parem (u32x128x128,u32) u32 (u32,u32)x128x16 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32x128x128 u32x256 u32 -> (u32x128x128,u32)
pix add p6 p1
pe call ptget p2 pix
ps at pe 0
pn at pe 1
bs call tkget p3 ps
bst at bs 2
ee call tkget p3 pn
eb at ee 2
el at ee 1
enb add eb el
nb sub enb bst
sp1 call putc p0 p5 3 1
r call putsrc sp1 p4 bst nb
ret r
end

# An implicit parameter: a space and u32.
fn impem (u32x128x128,u32) u32 u32x256 -> (u32x128x128,u32)
sp1 call putc p0 p2 3 1
r call putc sp1 p2 8 3
ret r
end

# One function: its header, node lines, ret line and end; then the separator to the next.
fn pfn (u32x128x128,u32) u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 (u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4 (u32,u32)x128x16 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32x128x128 u32x256 u32 u32 -> (u32x128x128,u32)
fr call ftget p3 p1
fnm at fr 0
npar at fr 1
pfs at fr 2
rss at fr 3
rse at fr 4
nfi at fr 5
rk at fr 6
rv at fr 7
f1 add p1 1
nxt call ftget p3 f1
nxf at nxt 5
lastf eq f1 p8
nfend select lastf p9 nxf
nl0 sub nfend nfi
lt3 lt nfi nfend
nl select lt3 nl0 0
za call z2048
zb call z2048
ids0 rec za zb 0
ids fold idfold nl ids0 p2 nfi
idk at ids 0
idv at ids 1
zc call z2048
zd call z2048
dns0 rec zc zd 0
nlc add nl 64
dns fold dncand nlc dns0 idk idv p5 nl
dnw at dns 0
dnl at dns 1
need0 fold needfold nl 0 p2 nfi
rk2 eq rk 2
rv1 add rv 1
rkm select rk2 rv1 0
gneed gt need0 rkm
needed select gneed need0 rkm
ctx rec idk idv dnw dnl nfi p5 p6 p7 p3
ex0 eq npar 4294967295
expl ne npar 4294967295
nexp select expl npar 0
h1 call putc p0 p7 0 3
ftk call tkget p5 fnm
nst at ftk 2
nln at ftk 1
h2 call putsrc h1 p6 nst nln
h3 fold parem nexp h2 p4 p5 p6 p7 pfs
hn select expl 0 needed
h4 fold impem hn h3 p7
h5 call putc h4 p7 4 4
expl2 ne rss 4294967295
rtk call tkget p5 rss
rst at rtk 2
rtk2 call tkget p5 rse
rend2 at rtk2 2
rlen2 at rtk2 1
rsum add rend2 rlen2
rnb0 sub rsum rst
rn select expl2 rnb0 0
h6 call putsrc h5 p6 rst rn
rty at fr 8
isbo eq rty 2
imp eq expl2 false
nbo eq isbo false
ru0 and imp nbo
ru select ru0 3 0
rbb and imp isbo
rb select rbb 4 0
h7 call putc h6 p7 8 ru
h7b call putc h7 p7 113 rb
h8 call putc h7b p7 11 1
ln0 fold nodeline nl h8 p2 nfi ctx
r1 call putc ln0 p7 17 4
r2 call emitop r1 rk rv ctx true
r3 call putc r2 p7 11 1
e1 call putc r3 p7 14 3
sepn select lastf 1 2
sepo select lastf 11 12
e2 call putc e1 p7 sepo sepn
ret e2
end

# The canonical text of one source: the tables of the lexer and the parser, then every function.
fn canonfn u32x128x128 u32 -> ((u32x128x128,u32),bool)
lx call lexall p0 p1
nb at lx 3
bd at lx 2
tk at lx 0
g00 call zg
g0 call seedg g00 nb bd tk
gl fold lnstep nb g0 bd tk
g call fin gl tk
gnt at g 0
gnn at g 1
gft at g 2
gnf at g 3
gpt at g 4
cst text "fn   -> u32\n\n\nendret retvalptruefalsemovaddsubmulandorxorshlshreqneltlegtgeselectgetsetatputdivremreccallfoldloopbool                                                                                                                                           "
zo call zout
o0 rec zo 0
o1 fold pfn gnf o0 gnt gft gpt tk p0 cst gnf gnn
lxe at lx 4
gge at g 6
gnp at g 5
cap1 gt p1 16384
ov1 gt gnn 2048
ov2 gt gnf 512
ov3 gt gnp 2048
opos at o1 1
ov4 gt opos 16384
e01 or lxe gge
e02 or e01 cap1
e03 or e02 ov1
e04 or e03 ov2
e05 or e04 ov3
e06 or e05 ov4
res rec o1 e06
ret res
end
