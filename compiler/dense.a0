# A token of kind 8 (a quote) on the line: the flag, set once any token from base + i is one.
fn q8fold bool u32 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32 -> bool
ix add p3 p1
t call tkget p2 ix
k at t 0
isq eq k 8
r or p0 isq
ret r
end

# hdr and stmt as fold steps (a count of 0 reads nothing).
fn hdrf ((u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31,u32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32,(u32,u32)x128x16,u32,bool) u32 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32 u32 -> ((u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31,u32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32,(u32,u32)x128x16,u32,bool)
