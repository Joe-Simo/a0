# The reader's pass 2 over the lexer state of the whole input.
fn parsefn u32x128x128 u32 -> ((u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31,u32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32,(u32,u32)x128x16,u32,bool)
lx call lexall p0 p1
nb at lx 3
bd at lx 2
tk at lx 0
g00 call zg
g0 call seedg g00 nb bd tk
g fold lnstep nb g0 bd tk
ret g
end


# Pass 3: the canonical text. Every emit writes a count of bytes, and a count of 0 writes nothing,
# so a branch that does not apply is an emit of 0 bytes. The constant text (cst) holds
# the fixed words; OPOFFS and OPLENS locate the name of each op code in it.

