end

# One candidate name: accepted when no explicit id and no keyword has it.
fn dncand (u32x256,u32x256,u32) u32 u32x256 u32x256 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32 -> (u32x256,u32x256,u32)
