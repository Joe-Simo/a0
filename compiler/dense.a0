ret r
end

fn putsb (u32x128x128,u32) u32 u32x128x128 u32 -> (u32x128x128,u32)
x add p3 p1
xp shr x 7
pg get p2 xp
b get pg x
r call ob p0 b
ret r
end

# n bytes of the source from byte start.
fn putsrc (u32x128x128,u32) u32x128x128 u32 u32 -> (u32x128x128,u32)
