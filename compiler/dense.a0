dc fold dcnb 9 1 pw p1
ng select p2 dc 0
r fold putnb ng p0 pw p1 dc
ret r
end

# The name of the candidate j in the default sequence a, b, ..., z, aa, ...: (length, packed).
fn cnstep (u32,u32,u32) u32 -> (u32,u32,u32)
nn at p0 0
lw at p0 1
ll at p0 2
pos0 gt nn 0
nm1 sub nn 1
dd rem nm1 26
nx div nm1 26
ch add dd 97
sh mul ll 8
one mov 1
pwr shl one sh
term mul ch pwr
lw2 add lw term
ll2 add ll 1
nn2 select pos0 nx nn
lw3 select pos0 lw2 lw
ll3 select pos0 ll2 ll
r rec nn2 lw3 ll3
ret r
end

fn cname u32 -> (u32,u32)
n0 add p0 1
r0 rec n0 0 0
fin fold cnstep 4 r0
lw at fin 1
ll at fin 2
out rec ll lw
ret out
end

