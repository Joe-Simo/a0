fn frset (u32,u32,u32,bool,u32,u32,u32,u32,u32,u32,u32,u32)x9 u32 (u32,u32,u32,bool,u32,u32,u32,u32,u32,u32,u32,u32) -> (u32,u32,u32,bool,u32,u32,u32,u32,u32,u32,u32,u32)x9
r set p0 p1 p2
ret r
end

