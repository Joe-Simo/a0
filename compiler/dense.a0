fn emitop (u32x128x128,u32) u32 u32 (u32x256,u32x256,u32x256,u32x256,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256) bool -> (u32x128x128,u32)
