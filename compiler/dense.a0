# The flag st, set when local node i has an explicit id of length L and packed word lw.
fn exfind u32 u32 u32x2048 u32x2048 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32 u32 -> u32
kk get p2 p1
vv get p3 p1
tk call tkget p4 vv
tl at tk 1
tw at tk 3
e1 eq kk 1
e2 eq tl p5
e3 eq tw p6
e4 and e1 e2
e5 and e4 e3
