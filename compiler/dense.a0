# The mask of a type token: 1 for `u32`, 2 for `bool`, else 8.
fn tycls (u32,u32,u32,u32,u32,u32,u32,u32) -> u32
kd at p0 0
ln at p0 1
w0 at p0 3
w1 at p0 4
isw eq kd 1
w1z eq w1 0
a1 eq ln 3
a2 eq w0 7680818
a3 and a1 a2
a4 and a3 w1z
isu and a4 isw
b1 eq ln 4
b2 eq w0 1651470188
b3 and b1 b2
b4 and b3 w1z
isb and b4 isw
r0 select isb 2 8
r select isu 1 r0
ret r
end

# The mask of the written parameter j (p4) of a function whose parameter spans start at p1 of the
# table p0 (p2 parameters written, or 4294967295 when none): `u32`, `bool` or another type; an
# implicit parameter and one past the written ones are u32.
fn ptyp (u32,u32)x128x16 u32 u32 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 u32 -> u32
expl ne p2 4294967295
inr lt p4 p2
use and expl inr
ix add p1 p4
ix2 select use ix 0
pe call ptget p0 ix2
ps at pe 0
pn at pe 1
one eq ps pn
tk call tkget p3 ps
c call tycls tk
c2 select one c 8
r select use c2 1
ret r
end

# The mask of an operand (kind p1, value p2) of a node of a function whose first node is p3, given the
# masks of its earlier nodes p0 and the parameters (spans, first span, count written, tokens, functions) p4.
fn tyopd u32x2048 u32 u32 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> u32
isn eq p1 1
isp eq p1 2
isbl eq p1 4
ge1 ge p2 p3
li sub p2 p3
lt1 lt li 2048
gn0 and isn ge1
gn and gn0 lt1
lis select gn li 0
tn get p0 lis
pp at p4 0
pf at p4 1
pnp at p4 2
ptk at p4 3
pj select isp p2 0
tp call ptyp pp pf pnp ptk pj
r1 select isbl 2 1
r2 select isp tp r1
r select isn tn r2
ret r
end

# One argument of a call, fold or loop in the pool (argument p4 + i): the state (an error possible, a
# non-error possible for each so far, the mask of the second argument).
fn tyarg (bool,bool,u32) u32 u32x2048 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> (bool,bool,u32)
ae at p0 0
an at p0 1
t1 at p0 2
ix add p4 p1
e call pget p3 ix
k at e 0
v at e 1
t call tyopd p2 k v p5 p6
te and t 4
tee ne te 0
tn and t 11
tnn ne tn 0
ae2 or ae tee
an2 and an tnn
is1 eq p1 1
t12 select is1 t t1
r rec ae2 an2 t12
ret r
end

# The mask of node p3 + i, set in the masks of the nodes before it (p0). p5 is tytab.
fn tystep u32x2048 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) u32x1280 -> u32x2048
ix add p3 p1
nd call ntget p2 ix
op at nd 0
na at nd 2
k0 at nd 3
v0 at nd 4
k1 at nd 5
v1 at nd 6
k2 at nd 7
v2 at nd 8
k3 at nd 9
v3 at nd 10
isc1 ge op 24
isc2 le op 26
isc and isc1 isc2
nac select isc 0 na
n0 gt nac 0
n1 gt nac 1
n2 gt nac 2
n3 gt nac 3
a0 call tyopd p0 k0 v0 p3 p4
b0 call tyopd p0 k1 v1 p3 p4
c0 call tyopd p0 k2 v2 p3 p4
d0 call tyopd p0 k3 v3 p3 p4
a select n0 a0 15
b select n1 b0 15
c select n2 c0 15
d select n3 d0 15
cn select isc na 0
zst rec false true 0
pa fold tyarg cn zst p0 p2 v2 p3 p4
pae at pa 0
pan at pa 1
pt1 at pa 2
o1 eq op 1
o2 eq op 2
o3 eq op 3
o4 eq op 4
o5 eq op 5
o6 eq op 6
o7 eq op 7
o8 eq op 8
o9 eq op 9
o10 eq op 10
o11 eq op 11
o16 eq op 16
o21 eq op 21
o22 eq op 22
o23 eq op 23
o24 eq op 24
o25 eq op 25
o26 eq op 26
ar1 or o2 o3
ar2 or o4 o8
ar3 or o9 o21
ar4 or ar1 ar2
ar5 or ar3 o22
isar or ar4 ar5
lg1 or o5 o6
islg or lg1 o7
iseq or o10 o11
ge12 ge op 12
le15 le op 15
iscm and ge12 le15
binp1 or isar islg
binp2 or iseq iscm
binp or binp1 binp2
cl1 select iscm 768 0
cl2 select iseq 512 cl1
cl3 select islg 256 cl2
cls select isar 0 cl3
a16 mul a 16
ab add a16 b
