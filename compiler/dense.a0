fn zg -> ((u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31,u32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32,(u32,u32)x128x16,u32,bool)
gn call zntab
gf call zftab
gp call zptab
r rec gn 0 gf 0 gp 0 false
ret r
end

# Pool argument j: the operand (kind, value). The pool keeps four operands to an entry of the node
# table, from entry 2049; argument 3072 and over is a dummy write target (entry 2817).
fn pget (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 -> (u32,u32)
ix shr p1 2
m and p1 3
ei add ix 2049
e call ntget p0 ei
k0 at e 3
v0 at e 4
k1 at e 5
v1 at e 6
k2 at e 7
v2 at e 8
k3 at e 9
v3 at e 10
m1 eq m 1
m2 eq m 2
m3 eq m 3
ka select m1 k1 k0
va select m1 v1 v0
kb select m2 k2 ka
vb select m2 v2 va
kc select m3 k3 kb
vc select m3 v3 vb
r rec kc vc
ret r
end

# The node table with pool argument j (p1) set to the operand (kind p2, value p3).
fn pput (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 u32 u32 -> (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31
ix shr p1 2
m and p1 3
ei add ix 2049
e call ntget p0 ei
op at e 0
idt at e 1
na at e 2
k0 at e 3
v0 at e 4
k1 at e 5
v1 at e 6
k2 at e 7
v2 at e 8
k3 at e 9
v3 at e 10
m0 eq m 0
m1 eq m 1
m2 eq m 2
m3 eq m 3
k0n select m0 p2 k0
v0n select m0 p3 v0
k1n select m1 p2 k1
v1n select m1 p3 v1
k2n select m2 p2 k2
v2n select m2 p3 v2
k3n select m3 p2 k3
v3n select m3 p3 v3
ne rec op idt na k0n v0n k1n v1n k2n v2n k3n v3n
r call ntset p0 ei ne
ret r
end

# pput as a fold step (a count of 0 writes nothing).
fn pputf (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 u32 u32 u32 -> (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31
r call pput p0 p2 p3 p4
ret r
end

# The largest parameter index plus one among the first i arguments of a call (pool arguments from base).
fn ppar u32 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 -> u32
ix add p3 p1
e call pget p2 ix
k at e 0
v at e 1
isp eq k 2
v1 add v 1
c select isp v1 0
g gt c p0
r select g c p0
ret r
end

# The function whose name spells the token p4, else the state (4294967295); the table p2 holds the
# name token of every function of the input (a function table seeded by fnscan).
fn findfn u32 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 (u32,u32,u32,u32,u32,u32,u32,u32) -> u32
fe call ftget p2 p1
nm at fe 0
tk call tkget p3 nm
la at tk 1
lb at p4 1
w0a at tk 3
w0b at p4 3
w1a at tk 4
w1b at p4 4
ha at tk 5
hb at p4 5
e1 eq la lb
e2 eq w0a w0b
e3 eq w1a w1b
e4 eq ha hb
e5 and e1 e2
e6 and e3 e4
hit and e5 e6
non eq p0 4294967295
h2 and hit non
r select h2 p1 p0
ret r
end

# The prescan state: (function table, count, error). A line whose first token is `fn` names a function.
fn fnscan ((u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32,bool) u32 u32x128x16 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 -> ((u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32,bool)
ft at p0 0
cnt at p0 1
er at p0 2
km1 sub p1 1
bp call bget p2 km1
z0k eq p1 0
s select z0k 0 bp
e call bget p2 p1
t0 call tkget p3 s
c0 call wcls t0
isf0 eq c0 30
nem lt s e
isf and isf0 nem
nm add s 1
nmt call tkget p3 nm
hn lt nm e
isn and isf hn
dc select isn cnt 0
dj fold findfn dc 4294967295 ft p3 nmt
dup ne dj 4294967295
dupe and isn dup
ent rec nm 0 0 0 0 0 0 0 0
ft2 call ftset ft cnt ent
c1 add cnt 1
cnt2 select isf c1 cnt
er2 or er dupe
r rec ft2 cnt2 er2
ret r
end

# The function table of the input before any line is read: the name token of every function, and
# their count in the node table's meta entry (index 2048; the call-argument pool follows it).
fn seedg ((u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31,u32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32,(u32,u32)x128x16,u32,bool) u32 u32x128x16 (u32,u32,u32,u32,u32,u32,u32,u32)x128x32 -> ((u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31,u32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4,u32,(u32,u32)x128x16,u32,bool)
nt0 at p0 0
nn0 at p0 1
ft0 at p0 2
nf0 at p0 3
pt0 at p0 4
np0 at p0 5
fs0 rec ft0 0 false
fsr fold fnscan p1 fs0 p2 p3
ftx at fsr 0
cx at fsr 1
ex at fsr 2
meta rec 0 0 0 0 0 cx 0 0 0 0 0
ntm call ntset nt0 2048 meta
r rec ntm nn0 ftx nf0 pt0 np0 ex
ret r
end

