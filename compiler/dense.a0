r rec idk2 idv2 m2
ret r
end

# The id of local node li, written when gate: a default name, the explicit token, or retval.
fn emitid (u32x128x128,u32) u32 (u32x2048,u32x2048,u32x2048,u32x2048,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32x128x128,u32x256,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) bool -> (u32x128x128,u32)
