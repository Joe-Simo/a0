# The masks of the p2 nodes of a function from node p1, in order.
fn tyfold (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x31 u32 u32 ((u32,u32)x128x16,u32,u32,(u32,u32,u32,u32,u32,u32,u32,u32)x128x32,(u32,u32,u32,u32,u32,u32,u32,u32,u32)x128x4) -> u32x2048
