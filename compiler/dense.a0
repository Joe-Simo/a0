pfn select upd pfa false
lfa select z0 up false
lfn select upd lfa false
ch or cmt hs
cmtn select nl false ch
ea and act erch
eb or err0 ea
ov1 gt ntkb 4095
ov2 gt nbkb 2047
ov or ov1 ov2
errn or eb ov
r rec tkb ntkb bdb nbkb errn upd cmtn wstn wlnn w0n w1n hhn nvn dfn pfn lfn
