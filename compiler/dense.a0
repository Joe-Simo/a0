# The lexer over the whole input: n + 1 steps (the last one is the virtual newline).
fn lexall u32x128x128 u32 -> ((u32,u32,u32,u32,u32,u32,u32,u32)x128x32,u32,u32x128x16,u32,bool,bool,bool,u32,u32,u32,u32,u32,u32,bool,bool,bool)
s0 call s1zero
m add p1 1
s fold lexb m s0 p0 p1
ret s
end

