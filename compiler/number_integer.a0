fn ni_exp_byte u32x128 u32 u32 u32 u32 -> u32x128
q0 eq p1 0
q1 eq p4 3
q2 eq p4 2
q3 select q2 10 1
q4 select q1 100 q3
q5 eq p1 1
q6 eq p4 3
q7 select q6 10 1
q8 select q5 q7 1
divisor select q0 q4 q8
q9 add p3 2
q10 add q9 p1
q11 div p2 divisor
q12 rem q11 10
q13 add 48 q12
q14 set p0 q10 q13
ret q14
end
fn ni_text (bool,u32x128,u32,(u32,u32)) -> (u32,u32x128,u32)
coefficient at p0 1
low call ni_extract coefficient 0
high call ni_extract coefficient 32
zero call arena_zero
q0 rec low high
q1 set zero 0 48
q2 rec q0 0 q1
digits loop ni_digits_more ni_digits_step 20 q2
q3 at digits 1
q4 eq q3 0
q5 at digits 1
length select q4 1 q5
q6 at p0 2
q7 add length q6
exponent sub q7 1
scientific ge exponent 21
q8 at digits 2
page fold ni_coeff_byte length zero q8 length scientific
q9 gt length 1
dot and scientific q9
q10 get page 1
q11 select dot 46 q10
page_1 set page 1 q11
q12 select dot 1 0
prefix add length q12
q13 at p0 2
q14 select scientific 0 q13
page_2 fold ni_zero_byte q14 page_1 length
q15 get page_2 prefix
q16 select scientific 101 q15
page_3 set page_2 prefix q16
q17 add prefix 1
q18 add prefix 1
q19 get page_3 q18
q20 select scientific 43 q19
page_4 set page_3 q17 q20
q21 ge exponent 100
q22 ge exponent 10
q23 select q22 2 1
expdigits select q21 3 q23
q24 select scientific expdigits 0
page_5 fold ni_exp_byte q24 page_4 exponent prefix expdigits
q25 add prefix 2
q26 add q25 expdigits
q27 at p0 2
q28 add length q27
size select scientific q26 q28
q29 set zero 0 73
q30 set q29 1 110
q31 set q30 2 102
q32 set q31 3 105
q33 set q32 4 110
q34 set q33 5 105
q35 set q34 6 116
infinity set q35 7 121
q36 call ni_bits coefficient
q37 le q36 57
q38 le length 17
good and q37 q38
q39 at p0 0
q40 select good 0 3
q41 select q39 0 q40
q42 at p0 0
q43 select q42 infinity page_5
q44 at p0 0
q45 select q44 8 size
q46 rec q41 q43 q45
ret q46
end
fn ni_parts_go (bool,u32x128,u32,(u32,u32)) u32 u32x128 -> (bool,u32x128,u32,(u32,u32))
