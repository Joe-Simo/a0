ret x27
end

fn tm_more ((u32,(u32,u32,u32),io),u32) u32 u32x16 u32 u32 u32 u32 -> bool
s at p0 0
code at s 0
idx at p0 1
a eq code 0
b lt idx p6
r and a b
ret r
end

fn metal_emit io u32x16 -> (u32,(u32,u32,u32),io)
phase call tc_analyze p0 p1 256 1024 1 0
s at phase 0
ctx at phase 1
code at s 0
okay eq code 0
times select okay 1 0
rendered fold tc_program times s ctx 0 0
v at rendered 1
t at rendered 2
status at rendered 0
h at v 0
n at v 1
z rec 0 0 0
start rec status z t
pre fold tm_prelude times start ctx 0 0
offset add 0 69

position rec pre offset
mapped loop tm_more tm_step n position ctx 0 0 h n
body at mapped 0
count get ctx 11
kernels loop sv_ok tm_kernel_fn count body ctx 0 0
result call ew_public kernels
ret result
end


fn tc_forward_metal (u32,(u32,u32,u32),io) u32 u32x16 -> (u32,(u32,u32,u32),io)
t at p0 2
r call metal_emit t p2
ret r
end

fn metal_emit_shaped io u32x16 u32x16 -> (u32,(u32,u32,u32),io)
phase call tc_analyze p0 p1 256 1024 1 0
s at phase 0
checked call tc_same_count s p1 p2
code at checked 0
okay eq code 0
times select okay 1 0
r fold tc_forward_metal times checked p2
out call ew_public r
ret out
end
