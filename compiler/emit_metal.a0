# Experimental Metal emission composes the A0 C stage, token mapper and scalar kernels.
# Checked/unsafe strict/IO/vector failures are explicit; C-large ABI currently returns14.
# This module is not a production CLI route and has no Metal device validation here.
use "emit_c_arena.a0"

fn tm_prelude (u32,(u32,u32,u32),io) u32 u32x16 u32 u32 -> (u32,(u32,u32,u32),io)
x1 call tcl146 p0
ret x1
end

