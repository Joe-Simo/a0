x5 le p5 90
x6 and x4 x5
x7 ge p5 48
x8 le p5 57
x9 and x7 x8
x10 or x3 x6
x11 eq p5 95
x12 or x9 x11
x13 or x10 x12
x14 select x13 1 0
x15 at p0 0
x16 at p0 1
x17 at p0 2
x18 rec x15 x16 x14 x17
ret x18
end

fn tm_length_step ((u32,(u32,u32,u32),io),u32,u32) u32 u32x16 u32 u32 u32 u32 u32 -> ((u32,(u32,u32,u32),io),u32,u32)
x1 at p0 0
x2 at p0 1
x3 add p6 x2
x4 call sv_get x1 p5 x3
x5 at x4 0
x6 at x4 1
x7 at x4 3
x8 rec x5 x6 x7
x9 at x4 2
x10 call tm_ident x8 0 p2 p3 p4 x9
x11 at x10 0
x12 at x10 1
x13 at x10 2
x14 at x10 3
x15 rec x11 x12 x14
x16 ne x13 0
x17 select x16 1 0
x18 add x2 x17
x19 eq x13 0
x20 select x19 1 0
x21 rec x15 x18 x20
ret x21
end

fn tm_length_more ((u32,(u32,u32,u32),io),u32,u32) u32 u32x16 u32 u32 u32 u32 u32 -> bool
s at p0 0
code at s 0
done at p0 2
a eq code 0
b eq done 0
r and a b
ret r
end

fn tm_length (u32,(u32,u32,u32),io) u32 u32x16 u32 u32 u32 u32 u32 -> (u32,(u32,u32,u32),u32,io)
x1 rec p0 0 0
x2 sub p7 p6
x3 loop tm_length_more tm_length_step x2 x1 p2 p3 p4 p5 p6 p7
x4 at x3 0
x5 at x3 1
x6 at x4 0
x7 at x4 1
x8 at x4 2
x9 rec x6 x7 x5 x8
ret x9
end

