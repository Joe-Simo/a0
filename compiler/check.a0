fn argseg (u32x128x65,u32x128x24,u32x64,u32,u32,u32,u32,u32,u32,u32) u32 u32x128x512 u32x128x24 u32x64 u32x128x65 u32 u32 u32 u32 u32 bool u32 u32 u32 u32 bool bool bool u32 -> (u32x128x65,u32x128x24,u32x64,u32,u32,u32,u32,u32,u32,u32)
