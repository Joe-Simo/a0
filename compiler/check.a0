# the parameter list of a function (tlist[p3..), at most 64) and its io count
fn plstep u32x64 u32 u32x128x65 u32 -> u32x64
k add p3 p1
kh shr k 7
kl and k 127
kg get p2 kh
t get kg kl
r set p0 p1 t
ret r
end
fn ioparam u32 u32 u32x64 u32x128x65 -> u32
t get p2 p1
th shr t 7
tl and t 127
tg get p3 th
ti get tg tl
io shr ti 31
r add p0 io
ret r
end
