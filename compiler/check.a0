t5 eq tag 5
bh shr b 7
bl and b 127
bg get tinfo bh
ei get bg bl
eio shr ei 31
eb and ei 2147483647
abits call satmul a eb 2097152
cnt select t5 b 0
r0 rec 0 0 2166136261
ri fold recinfo cnt r0 p3 tinfo a
rio at ri 0
rbits at ri 1
rh at ri 2
io0 select t3i 1 rio
io1 select t4 eio io0
io2 select t2 0 io1
io select t1 0 io2
b0 select t3i 0 rbits
b1 select t4 abits b0
b2 select t2 1 b1
bits select t1 32 b2
iw mul io 2147483648
v add iw bits
tig get tinfo th
tig2 set tig tl v
tinfo2 set tinfo th tig2
sx xor rh b
sg0 mul sx 16777619
sg select t5 sg0 0
sgg get tsig th
sgg2 set sgg tl sg
tsig2 set tsig th sgg2
r rec tinfo2 tsig2
ret r
end
