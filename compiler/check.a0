# check functions [p9, p8) of the IR (types tlist fns nodes args, counts p6 p7) given the
# iteration bounds p5 of the functions before p9
fn checkir u32x384x65 u32x128x65 u32x128x45 u32x128x128 u32x128x512 u32x128x8 u32 u32 u32 u32 -> (u32x384x65,u32x128x65,u32x128x65,u32x128x65,u32x128x24,u32x128x24,u32x64,u32x128x8,u32,u32,u32,u32,u32,u32,u32)
