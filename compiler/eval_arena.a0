fn ae_run_begin (u32x128,u32x128,io) u32 (u32,u32,u32) -> (u32x128,u32x128,io)
a call ae_prepare p0 p1 p2
q0 at p2 2
q1 call ae_mset a 62 q0
q2 call ae_mset q1 12 1
ret q2
end

fn ae_validated_start (u32x128,u32x128,io) u32 -> (u32x128,u32x128,io)
m at p0 0
q0 get m 29
q1 get m 30
q2 get m 31
q3 get m 62
q4 rec q1 q2 q3
a call ae_start_checked p0 q0 q4
q5 call ae_mset a 12 2
ret q5
