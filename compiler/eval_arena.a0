# Experimental arena evaluator; canonical A0 owns execution and continuations.
use "arena_vector.a0"

fn ae_umul u32 u32 -> (u32,u32)
a0 and p0 65535
a1 shr p0 16
b0 and p1 65535
b1 shr p1 16
prod0 mul a0 b0
prod1 mul a0 b1
prod2 mul a1 b0
prod3 mul a1 b1
q0 shr prod0 16
q1 and prod1 65535
q2 add q0 q1
q3 and prod2 65535
mid add q2 q3
q4 and prod0 65535
q5 and mid 65535
q6 shl q5 16
q7 or q4 q6
q8 shr prod1 16
q9 add prod3 q8
q10 shr prod2 16
q11 add q9 q10
q12 shr mid 16
q13 add q11 q12
q14 rec q7 q13
ret q14
end

fn ae_bitstep u32 u32 u32 -> u32
q0 shr p2 p1
q1 ne q0 0
q2 add p1 1
q3 select q1 q2 p0
ret q3
end

fn ae_bitlen u32 -> u32
q0 fold ae_bitstep 32 0 p0
ret q0
end

fn ae_uadd (u32,u32) (u32,u32) -> (u32,u32)
q0 at p0 0
q1 at p1 0
lo add q0 q1
q2 at p0 1
q3 at p1 1
q4 add q2 q3
q5 at p0 0
q6 lt lo q5
q7 select q6 1 0
q8 add q4 q7
q9 rec lo q8
ret q9
end

fn ae_usub (u32,u32) (u32,u32) -> (u32,u32)
q0 at p0 0
q1 at p1 0
q2 sub q0 q1
q3 at p0 1
q4 at p1 1
q5 sub q3 q4
q6 at p0 0
q7 at p1 0
q8 lt q6 q7
q9 select q8 1 0
q10 sub q5 q9
q11 rec q2 q10
ret q11
end

fn ae_ult (u32,u32) (u32,u32) -> bool
q0 at p0 1
q1 at p1 1
q2 lt q0 q1
q3 at p0 1
q4 at p1 1
q5 eq q3 q4
q6 at p0 0
q7 at p1 0
q8 lt q6 q7
q9 and q5 q8
q10 or q2 q9
ret q10
end

fn ae_ushl (u32,u32) u32 -> (u32,u32)
q0 eq p1 0
q1 at p0 0
q2 lt p1 32
q3 at p0 0
q4 shl q3 p1
q5 select q2 q4 0
lo select q0 q1 q5
q6 eq p1 0
q7 at p0 1
q8 lt p1 32
q9 at p0 1
q10 shl q9 p1
q11 at p0 0
q12 sub 32 p1
q13 shr q11 q12
q14 or q10 q13
q15 lt p1 64
q16 at p0 0
q17 sub p1 32
q18 shl q16 q17
q19 select q15 q18 0
q20 select q8 q14 q19
hi select q6 q7 q20
q21 rec lo hi
ret q21
end

fn ae_ushr (u32,u32) u32 -> (u32,u32)
q0 eq p1 0
q1 at p0 0
q2 lt p1 32
q3 at p0 0
q4 shr q3 p1
q5 at p0 1
q6 sub 32 p1
q7 shl q5 q6
q8 or q4 q7
q9 lt p1 64
q10 at p0 1
q11 sub p1 32
q12 shr q10 q11
q13 select q9 q12 0
q14 select q2 q8 q13
lo select q0 q1 q14
q15 eq p1 0
q16 at p0 1
q17 lt p1 32
q18 at p0 1
q19 shr q18 p1
q20 select q17 q19 0
hi select q15 q16 q20
q21 rec lo hi
ret q21
end

fn ae_ujam (u32,u32) u32 -> (u32,u32)
z call ae_ushr p0 p1
back call ae_ushl z p1
q0 at back 0
q1 at p0 0
q2 ne q0 q1
q3 at back 1
q4 at p0 1
q5 ne q3 q4
lost or q2 q5
q6 at z 0
q7 select lost 1 0
q8 or q6 q7
q9 at z 1
q10 rec q8 q9
ret q10
end

fn ae_nan (u32,u32) -> bool
q0 at p0 1
q1 and q0 2146435072
q2 eq q1 2146435072
q3 at p0 1
q4 and q3 1048575
q5 ne q4 0
q6 at p0 0
q7 ne q6 0
q8 or q5 q7
q9 and q2 q8
ret q9
end

fn ae_negative (u32,u32) -> bool
q0 call ae_nan p0
q1 xor q0 true
q2 at p0 1
q3 and q2 2147483648
q4 ne q3 0
q5 and q1 q4
q6 at p0 1
q7 and q6 2147483647
q8 ne q7 0
q9 at p0 0
q10 ne q9 0
q11 or q8 q10
q12 and q5 q11
ret q12
end

fn ae_nonpositive (u32,u32) -> bool
q0 call ae_negative p0
q1 at p0 1
q2 and q1 2147483647
q3 eq q2 0
q4 at p0 0
q5 eq q4 0
q6 and q3 q5
q7 or q0 q6
ret q7
end

fn ae_fsub (u32,u32) u32 -> (u32,u32)
q0 at p0 1
q1 shr q0 20
exp and q1 2047
q2 eq exp 0
ax select q2 1 exp
q3 at p0 0
q4 at p0 1
q5 and q4 1048575
q6 eq exp 0
q7 select q6 0 1048576
q8 or q5 q7
q9 rec q3 q8
am call ae_ushl q9 3
len call ae_bitlen p1
bx add 1022 len
q10 rec p1 0
q11 sub 56 len
bm call ae_ushl q10 q11
q12 gt ax bx
q13 eq ax bx
q14 call ae_ult am bm
q15 xor q14 true
q16 and q13 q15
abig or q12 q16
big select abig am bm
small select abig bm am
ex select abig ax bx
sx select abig bx ax
q17 sub ex sx
aligned call ae_ujam small q17
q18 at p0 1
q19 and q18 2147483648
neg ne q19 0
sum call ae_uadd big aligned
diff call ae_usub big aligned
raw select neg sum diff
q20 xor abig true
sign or neg q20
q21 at raw 1
carry ge q21 16777216
q22 call ae_ujam raw 1
shifted select carry q22 raw
q23 select carry 1 0
ex1 add ex q23
q24 at shifted 1
q25 ne q24 0
q26 at shifted 1
q27 call ae_bitlen q26
q28 add 32 q27
q29 at shifted 0
q30 call ae_bitlen q29
bits select q25 q28 q30
q31 lt bits 56
q32 sub 56 bits
want select q31 q32 0
q33 lt want ex1
q34 sub ex1 1
left select q33 want q34
norm call ae_ushl shifted left
ex2 sub ex1 left
q35 at norm 0
q36 and q35 7
q37 gt q36 4
q38 at norm 0
q39 and q38 7
q40 eq q39 4
q41 at norm 0
q42 and q41 8
q43 ne q42 0
q44 and q40 q43
round or q37 q44
q45 select round 8 0
q46 rec q45 0
q47 call ae_uadd norm q46
rounded call ae_ushr q47 3
q48 at rounded 1
rc ge q48 2097152
q49 call ae_ushr rounded 1
mant select rc q49 rounded
q50 select rc 1 0
ex3 add ex2 q50
q51 at raw 0
q52 eq q51 0
q53 at raw 1
q54 eq q53 0
iszero and q52 q54
q55 eq ex3 1
q56 at mant 1
q57 lt q56 1048576
q58 and q55 q57
packedexp select q58 0 ex3
overflow ge ex3 2047
q59 select sign 2147483648 0
q60 shl packedexp 20
q61 at mant 1
q62 and q61 1048575
q63 or q60 q62
q64 select overflow 2146435072 q63
hi or q59 q64
q65 at mant 0
lo select overflow 0 q65
special eq exp 2047
q66 select iszero 0 lo
q67 select iszero 0 hi
q68 eq p1 0
q69 or special q68
q70 rec q66 q67
q71 select q69 p0 q70
ret q71
end

fn ae_fail (u32x128,u32x128,io) u32 -> (u32x128,u32x128,io)
m at p0 0
q0 get m 0
q1 eq q0 0
q2 ne p1 0
active and q1 q2
q3 get m 0
q4 select active 9 q3
a set m 0 q4
q5 get a 1
q6 select active p1 q5
q7 set a 1 q6
q8 at p0 1
q9 at p0 2
q10 rec q7 q8 q9
ret q10
end

fn ae_ldgo (u32x128,u32x128,u32x128,io) u32 u32 u32 u32 u32 -> (u32x128,u32x128,u32x128,io)
m at p0 0
ir at p0 1
q0 eq p2 0
q1 get ir p3
q2 add p3 1
q3 get ir q2
q4 add p3 2
q5 get ir q4
q6 rec q1 q3 q5
q7 get m p3
q8 add p3 1
q9 get m q8
q10 add p3 2
q11 get m q10
q12 rec q7 q9 q11
v select q0 q6 q12
q13 at p0 3
a call av_load q13 v p4 p5
q14 at a 0
q15 set m 0 q14
q16 at a 1
q17 at a 2
q18 rec q15 ir q16 q17
ret q18
end

fn ae_load (u32x128,u32x128,io) u32 u32 u32 u32 -> (u32x128,u32x128,u32x128,io)
m at p0 0
z call arena_zero
q0 get m 0
