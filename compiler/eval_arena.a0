# Experimental arena evaluator; canonical A0 owns execution and continuations.
use "arena_vector.a0"
use "eval_arena_shared.a0"

fn ae_ok (u32x128,u32x128,io) u32 -> bool
m at p0 0
q0 get m 0
q1 eq q0 0
ret q1
end

fn ae_arg (u32x128,u32x128,io) u32 -> (u32x128,u32x128,u32,u32,io)
q0 mul p1 2
r call ae_load p0 1 38 q0 2
a at r 2
q1 at r 0
q2 at r 1
q3 get a 0
q4 get a 1
q5 at r 3
q6 rec q1 q2 q3 q4 q5
ret q6
end

fn ae_io_new (u32x128,u32x128,io) (u32,u32,u32) u32 -> (u32x128,u32x128,u32,u32,io)
a call ae_alloc p0 7
z call arena_zero
q0 at p1 0
q1 set z 0 q0
q2 at p1 1
q3 set q1 1 q2
q4 at p1 2
q5 set q3 2 q4
b set q5 3 p2
q6 at a 0
q7 at a 1
q8 at a 4
q9 rec q6 q7 q8
q10 at a 3
c call ae_hstore q9 q10 0 7 b
q11 at c 0
q12 at c 1
q13 at a 3
q14 at c 2
q15 rec q11 q12 2 q13 q14
ret q15
end

fn ae_trap_frame (u32x128,u32x128,io) u32 -> (u32x128,u32x128,u32x128,io)
q0 mul p1 24
q1 call ae_load p0 1 32 q0 24
ret q1
end

fn ae_literals_begin (u32x128,u32x128,io) (u32,u32,u32) (u32,u32,u32) -> (u32x128,u32x128,io)
m at p0 0
q0 at p1 0
m0_a set m 50 q0
q1 at p1 1
m0_b set m0_a 51 q1
q2 at p1 2
q3 set m0_b 52 q2
q4 at p2 0
m1_a set q3 53 q4
q5 at p2 1
m1_b set m1_a 54 q5
q6 at p2 2
q7 set m1_b 55 q6
q8 set q7 57 0
b set q8 16 0
q9 at p0 1
q10 at p0 2
q11 rec b q9 q10
q12 at p1 1
q13 rem q12 6
q14 ne q13 0
q15 select q14 790 0
q16 call ae_fail q11 q15
ret q16
end

fn ae_import_request (u32x128,u32x128,io) (u32,u32,u32) (u32,u32,u32) -> (u32x128,u32x128,io)
q0 call ae_literals_begin p0 p1 p2
q1 call ae_mset q0 12 3
ret q1
end
