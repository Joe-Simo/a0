fn ae_validation_pump (u32x128,u32x128,io) u32 u32 -> (u32x128,u32x128,io)
a call ae_check_resume p0 p2
m at a 0
q0 get m 0
q1 eq q0 0
q2 get m 45
q3 eq q2 0
q4 and q1 q3
q5 select q4 1 0
q6 fold ae_validated_start q5 a
ret q6
end

fn ae_execution_pump (u32x128,u32x128,io) u32 u32 -> (u32x128,u32x128,io)
a call ae_resume p0 p2
m at a 0
q0 get m 2
q1 ne q0 0
q2 get m 12
q3 select q1 0 q2
q4 call ae_mset a 12 q3
ret q4
