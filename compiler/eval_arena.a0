q0 get m 0
q1 eq q0 0
q2 select q1 1 0
q3 fold ae_ir_appendgo q2 p0 p1 p2 p3
ret q3
end

fn ae_copy_irpage (u32x128,u32x128,io) u32 u32 (u32,u32,u32) -> (u32x128,u32x128,io)
first mul p1 128
q0 at p3 1
q1 sub q0 first
q2 gt q1 128
q3 at p3 1
q4 sub q3 first
count select q2 128 q4
q5 at p0 2
a call av_load q5 p3 first count
q6 at p0 0
q7 at a 0
q8 set q6 0 q7
q9 at p0 1
q10 at a 2
q11 rec q8 q9 q10
q12 at a 1
q13 call ae_ir_append q11 p2 count q12
ret q13
end

fn ae_copy_irmore (u32x128,u32x128,io) u32 u32 (u32,u32,u32) -> bool
m at p0 0
q0 get m 0
q1 eq q0 0
ret q1
end

fn ae_copy_ir (u32x128,u32x128,io) u32 -> (u32x128,u32x128,io)
ir at p0 1
q0 get ir p1
q1 add p1 1
q2 get ir q1
q3 add p1 2
q4 get ir q3
q5 rec 0 0 0
m1_a set ir p1 0
q6 add p1 1
m1_b set m1_a q6 0
q7 add p1 2
q8 set m1_b q7 0
q9 div q2 128
q10 rem q2 128
q11 eq q10 0
q12 select q11 0 1
q13 add q9 q12
q14 at p0 0
q15 at p0 2
q16 rec q14 q8 q15
q17 rec q0 q2 q4
q18 loop ae_copy_irmore ae_copy_irpage q13 q16 p1 q17
ret q18
end

fn ae_external_ir (u32x128,u32x128,io) u32 (u32,u32,u32) -> (u32x128,u32x128,io)
q0 at p2 1
q1 div q0 128
q2 at p2 1
q3 rem q2 128
q4 eq q3 0
q5 select q4 0 1
q6 add q1 q5
q7 loop ae_copy_irmore ae_copy_irpage q6 p0 p1 p2
ret q7
end

fn ae_fillword u32x128 u32 u32 -> u32x128
q0 set p0 p1 p2
ret q0
end

fn ae_ir_fillstep (u32x128,u32x128,io) u32 u32 u32 u32 -> (u32x128,u32x128,io)
q0 call arena_zero
z fold ae_fillword 128 q0 p4
first mul p1 128
q1 sub p3 first
q2 gt q1 128
q3 sub p3 first
q4 select q2 128 q3
q5 call ae_ir_append p0 p2 q4 z
ret q5
end

fn ae_ir_fillmore (u32x128,u32x128,io) u32 u32 u32 u32 -> bool
m at p0 0
q0 get m 0
q1 eq q0 0
ret q1
end

fn ae_ir_fill (u32x128,u32x128,io) u32 u32 u32 -> (u32x128,u32x128,io)
q0 div p2 128
q1 rem p2 128
q2 eq q1 0
q3 select q2 0 1
q4 add q0 q3
q5 loop ae_ir_fillmore ae_ir_fillstep q4 p0 p1 p2 p3
ret q5
end

fn ae_contract_view (u32x128,u32x128,io) u32 u32x128 (u32,u32,u32) (u32,u32,u32) u32 u32 -> (u32x128,u32x128,io)
q0 mul p1 14
a call ae_load p0 0 41 q0 14
original at a 2
q1 at a 0
q2 at a 1
q3 at a 3
