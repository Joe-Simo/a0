already eq c 1
err and consider already
none eq bad 4294967295
newbad and none err
bad2 select newbad p1 bad
isbad eq t 4294967295
nonea eq bada 4294967295
newbada and nonea isbad
bada2 select newbada p1 bada
markn and consider isn
markp and consider isp
ncons1 set ncons gi 1
ncons2 select markn ncons1 ncons
pcons1 set pcons pi 1
pcons2 select markp pcons1 pcons
r rec ncons2 pcons2 bad2 bada2
ret r
end
# the first operand whose type differs from p9
fn v1eqargstep u32 u32 u32x8192 u32x1024 u32x1024 u32 u32 u32 u32 u32 -> u32
g add p5 p1
g2 mul g 2
k get p2 g2
g21 add g2 1
v get p2 g21
t call v1opndty k v p3 p4 p6 p7 p8
ne0 ne t p9
none eq p0 4294967295
new and none ne0
r select new p1 p0
ret r
end
# the first operand k (from p10 on) whose type differs from the callee parameter tlist[p9+k]
fn v1sigstep u32 u32 u32x8192 u32x1024 u32x1024 u32 u32 u32 u32 u32 u32 -> u32
k add p10 p1
g add p5 k
g2 mul g 2
ak get p2 g2
g21 add g2 1
av get p2 g21
t call v1opndty ak av p3 p4 p6 p7 p8
w add p9 k
wt get p3 w
ne0 ne t wt
none eq p0 4294967295
new and none ne0
r select new k p0
ret r
end
# the field types of a `rec` written to tlist[p10..), with the io count and the width
fn v1recstep (u32x1024,u32,u32) u32 u32x8192 u32x1024 u32x256 u32x256 u32 u32 u32 u32 u32 -> (u32x1024,u32,u32)
tlist at p0 0
nio at p0 1
bits at p0 2
g add p6 p1
g2 mul g 2
k get p2 g2
g21 add g2 1
v get p2 g21
t call v1opndty k v tlist p3 p7 p8 p9
io get p4 t
b get p5 t
nio2 add nio io
bits2 call v1satadd bits b 2097152
d add p10 p1
tlist2 set tlist d t
r rec tlist2 nio2 bits2
ret r
end
fn v1ioparamstep u32 u32 u32x1024 u32x256 u32 -> u32
k add p4 p1
t get p2 k
io get p3 t
r add p0 io
ret r
end
# state: (types tlist tio tbits ntypes ntlist ntys ncons pcons fstat err errfn errnode lit stat)
# ntys: type per node; ncons/pcons: consumed tokens by node / by parameter (tlist index);
# fstat: iteration bound per function; lit/stat: literal and total iteration bounds so far.
fn v1nodestep (u32x768,u32x1024,u32x256,u32x256,u32,u32,u32x1024,u32x1024,u32x1024,u32x256,u32,u32,u32,u32,u32) u32 u32x4096 u32x8192 u32x1024 u32 -> (u32x768,u32x1024,u32x256,u32x256,u32,u32,u32x1024,u32x1024,u32x1024,u32x256,u32,u32,u32,u32,u32)
types at p0 0
tlist at p0 1
tio at p0 2
tbits at p0 3
ntypes at p0 4
ntlist at p0 5
ntys at p0 6
ncons at p0 7
pcons at p0 8
fstat at p0 9
err at p0 10
errfn at p0 11
errnode at p0 12
lit at p0 13
stat at p0 14
# the function and the node
f7 mul p5 7
f71 add f7 1
np get p4 f71
f72 add f7 2
fp get p4 f72
f74 add f7 4
first get p4 f74
g add first p1
g6 mul g 6
g61 add g6 1
op get p2 g61
g62 add g6 2
nargs get p2 g62
g63 add g6 3
fa get p2 g63
g64 add g6 4
callee get p2 g64
g65 add g6 5
pred get p2 g65
ismov eq op 1
o2 ge op 2
o4 le op 4
a24 and o2 o4
o8 ge op 8
o11 le op 11
a811 and o8 o11
isarith or a24 a811
o5 ge op 5
o7 le op 7
islog and o5 o7
o12 eq op 12
o13 eq op 13
iseq or o12 o13
o14 ge op 14
o17 le op 17
iscmp and o14 o17
issel eq op 18
iscall eq op 19
isfold eq op 20
isloop eq op 21
isfl or isfold isloop
isarr eq op 22
isrec eq op 23
istext eq op 24
arrlike or isarr istext
isget eq op 25
isset eq op 26
isat eq op 27
isput eq op 28
isatp or isat isput
isread eq op 29
iswrite eq op 30
isputs eq op 31
# v1arity
ar call v1arity op
var eq ar 4294967295
noargs eq nargs 0
arbad0 ne nargs ar
arbad1 select var false arbad0
aggl or arrlike isrec
arbad2 and aggl noargs
arbad or arbad1 arbad2
# operand types (the first three directly, the rest by folds)
fa20 mul fa 2
fa21 add fa20 1
fa22 add fa20 2
fa23 add fa20 3
fa24 add fa20 4
fa25 add fa20 5
k0 get p3 fa20
v0 get p3 fa21
k1 get p3 fa22
v1 get p3 fa23
k2 get p3 fa24
v2 get p3 fa25
t0 call v1opndty k0 v0 tlist ntys fp np first
t1 call v1opndty k1 v1 tlist ntys fp np first
t2 call v1opndty k2 v2 tlist ntys fp np first
ls0 rec ncons pcons 4294967295 4294967295
ls fold v1linstep nargs ls0 p3 tlist ntys tio fa fp np first op
ncons2 at ls 0
pcons2 at ls 1
badb at ls 2
bada at ls 3
abad ne bada 4294967295
bbad ne badb 4294967295
# shapes of the first operands
t03 mul t0 3
tag0 get types t03
t031 add t03 1
ta0 get types t031
t032 add t03 2
tb0 get types t032
t13 mul t1 3
tag1 get types t13
t132 add t13 2
tb1 get types t132
u0 eq t0 0
u1 eq t1 0
b0 eq t0 1
b1 eq t1 1
io0 eq t0 2
uu and u0 u1
notuu select uu false true
notb1 select b1 false true
notu1 select u1 false true
notio0 select io0 false true
isarr0 eq tag0 4
notarr0 select isarr0 false true
isrec0 eq tag0 5
notrec0 select isrec0 false true
# scalar operations
arithbad and isarith notuu
logop or islog iseq
logbad0 select b0 notb1 notuu
logbad and logop logbad0
cmpbad and iscmp notuu
t1io get tio t1
t1isio eq t1io 1
t12ne ne t1 t2
notb0 select b0 false true
selbad0 or notb0 t12ne
selbad1 or selbad0 t1isio
selbad and issel selbad1
getbad0 or notarr0 notu1
getbad and isget getbad0
t2ne0 ne t2 tb0
setbad0 or getbad0 t2ne0
setbad and isset setbad0
readbad and isread notio0
writebad0 or notio0 notu1
writebad and iswrite writebad0
notarr1 ne tag1 4
notu32arr ne tb1 0
putsbad0 or notio0 notarr1
putsbad1 or putsbad0 notu32arr
putsbad and isputs putsbad1
# at / put: a record, a literal field index in range, then the field value
a1lit eq k1 3
nota1lit select a1lit false true
oor ge v1 tb0
fidx add ta0 v1
field get tlist fidx
atpbad0 or notrec0 nota1lit
atpbad1 or atpbad0 oor
atpbad and isatp atpbad1
fieldne ne t2 field
putty0 and isput fieldne
notatpbad select atpbad1 false true
putty and putty0 notatpbad
# arr / text: every element of the first element's type, no tokens, within the width limit
eqn select arrlike nargs 0
eqk fold v1eqargstep eqn 4294967295 p3 tlist ntys fa fp np first t0
eqbad ne eqk 4294967295
elemio get tio t0
elemisio eq elemio 1
elembits get tbits t0
abits call v1satmul nargs elembits 2097152
awide gt abits 2097152
arrty0 or eqbad elemisio
arrty and arrlike arrty0
notarrty select arrty0 false true
arrlim0 and arrlike awide
arrlim and arrlim0 notarrty
# rec: the field types go to the scratch area of tlist; at most one token; the width limit
rs0 rec tlist 0 0
recn select isrec nargs 0
rs fold v1recstep recn rs0 p3 ntys tio tbits fa fp np first ntlist
tlistr at rs 0
nio at rs 1
rbits at rs 2
recty0 gt nio 1
recty and isrec recty0
rwide gt rbits 2097152
recio eq nio 0
reclim0 and rwide recio
reclim and isrec reclim0
# read yields (u32,io)
nt1 add ntlist 1
tlr0 set tlist ntlist 0
tlr set tlr0 nt1 2
tlists select isread tlr tlistr
cnt select isread 2 nargs
wantrec or isrec isread
ntyr select wantrec ntypes 0
ntya select arrlike ntypes 0
ridx call v1cfindrec types ntyr tlists ntlist cnt
aidx call v1cfindarr types ntya nargs t0
cand select wantrec ridx aidx
found lt cand ntypes
newty select found false true
wantty or wantrec arrlike
addty and wantty newty
idx select found cand ntypes
tagn select wantrec 5 4
tan select wantrec ntlist nargs
tbn select wantrec cnt t0
n3 mul ntypes 3
n31 add n3 1
n32 add n3 2
tya set types n3 tagn
tyb set tya n31 tan
tyc set tyb n32 tbn
types2 select addty tyc types
nty1 add ntypes 1
ntypes2 select addty nty1 ntypes
addrec and addty wantrec
ntl2 add ntlist cnt
ntlist2 select addrec ntl2 ntlist
tlist2 select wantrec tlists tlist
recio1 gt nio 0
recio2 select recio1 1 0
ior select isread 1 recio2
bitsr select isread 32 rbits
newio select wantrec ior elemio
newbits select wantrec bitsr abits
tio1 set tio ntypes newio
tio2 select addty tio1 tio
tbits1 set tbits ntypes newbits
tbits2 select addty tbits1 tbits
# call: the callee's v1arity, then each argument against its parameter
c7 mul callee 7
c71 add c7 1
cn get p4 c71
c72 add c7 2
cfirst get p4 c72
c73 add c7 3
cres get p4 c73
cstat get fstat callee
cnne ne nargs cn
callbad and iscall cnne
sign select iscall nargs 0
sig0 fold v1sigstep sign 4294967295 p3 tlist ntys fa fp np first cfirst 0
sig0bad ne sig0 4294967295
notcnne select cnne false true
callty0 and iscall sig0bad
callty and callty0 notcnne
# fold / loop: count and state, the body's (state, index, extra...) shape, the predicate
ge2n ge nargs 2
flbad1 select ge2n false true
notu0 select u0 false true
cn2 ge cn 2
flbad2 select cn2 false true
statet get tlist cfirst
cf1 add cfirst 1
indext get tlist cf1
flty2 ne indext 0
flty3 ne t1 statet
flty4 ne cres statet
nx sub nargs 2
cx sub cn 2
flbad3 ne nx cx
nxc0 select ge2n nx 0
nxc select isfl nxc0 0
sigx fold v1sigstep nxc 4294967295 p3 tlist ntys fa fp np first cfirst 2
flty5 ne sigx 4294967295
pr7 mul pred 7
pr71 add pr7 1
pn get p4 pr71
pr72 add pr7 2
pfirst get p4 pr72
pr73 add pr7 3
pres get p4 pr73
lpty1 ne pres 1
peq fold v1cfleqstep cn true tlist pfirst cfirst
pnbad ne pn cn
notpeq select peq false true
lpbad0 or pnbad notpeq
lpbad and isloop lpbad0
lpty and isloop lpty1
islit eq k0 3
prod call v1satmul v0 cstat 16777216
litf0 call v1umax lit prod
litf select islit litf0 lit
itbad0 gt litf 16777216
itbad and islit itbad0
flc0 select itbad 2 0
flc1 select lpbad 2 flc0
flc2 select lpty 3 flc1
flc3 select flty5 3 flc2
flc4 select flbad3 2 flc3
flc5 select flty4 3 flc4
flc6 select flty3 3 flc5
flc7 select flty2 3 flc6
flc8 select flbad2 2 flc7
flc9 select notu0 3 flc8
flcode select flbad1 2 flc9
# the iteration bounds after this node
litc call v1umax lit cstat
lit1 select isfl litf lit
lit2 select iscall litc lit1
statc call v1umax stat cstat
tripsx select islit prod 16777217
statf call v1umax stat tripsx
stat1 select isfl statf stat
stat2 select iscall statc stat1
# the diagnostic of the operation, in the checker's order
tybad0 or arithbad logbad
tybad1 or tybad0 cmpbad
tybad2 or tybad1 selbad
tybad3 or tybad2 getbad
tybad4 or tybad3 setbad
tybad5 or tybad4 readbad
tybad6 or tybad5 writebad
tybad7 or tybad6 putsbad
tybad8 or tybad7 putty
tybad9 or tybad8 arrty
tybad10 or tybad9 recty
tybad or tybad10 callty
stbad0 or atpbad callbad
limbad or arrlim reclim
oc0 select isfl flcode 0
oc1 select limbad 4 oc0
oc2 select stbad0 2 oc1
v1opcode select tybad 3 oc2
code0 select bbad 2 v1opcode
code1 select abad 3 code0
code select arbad 2 code1
# the result type
rt0 select ismov t0 0
rt1 select b0 1 0
rt2 select logop rt1 rt0
cmpeq or iscmp iseq
rt3 select cmpeq 1 rt2
rt4 select issel t1 rt3
rt5 select isget tb0 rt4
rt6 select isset t0 rt5
rt7 select isat field rt6
rt8 select isput t0 rt7
rt9 select wantty idx rt8
iow or iswrite isputs
rt10 select iow 2 rt9
rt11 select iscall cres rt10
rt select isfl statet rt11
ntys2 set ntys g rt
err0 ne code 0
err2 select err0 code err
errfn2 select err0 p5 errfn
errnode2 select err0 p1 errnode
r rec types2 tlist2 tio2 tbits2 ntypes2 ntlist2 ntys2 ncons2 pcons2 fstat err2 errfn2 errnode2 lit2 stat2
ret r
end
fn v1nodeok (u32x768,u32x1024,u32x256,u32x256,u32,u32,u32x1024,u32x1024,u32x1024,u32x256,u32,u32,u32,u32,u32) u32 u32x4096 u32x8192 u32x1024 u32 -> bool
err at p0 10
r eq err 0
ret r
end
# one function: the header limits and the io parameter count, the nodes, then the ret operand
fn v1fnstep (u32x768,u32x1024,u32x256,u32x256,u32,u32,u32x1024,u32x1024,u32x1024,u32x256,u32,u32,u32,u32,u32) u32 u32x4096 u32x8192 u32x1024 u32 -> (u32x768,u32x1024,u32x256,u32x256,u32,u32,u32x1024,u32x1024,u32x1024,u32x256,u32,u32,u32,u32,u32)
f add p5 p1
tlist at p0 1
tio at p0 2
f7 mul f 7
f71 add f7 1
np get p4 f71
f72 add f7 2
fp get p4 f72
f73 add f7 3
res get p4 f73
f74 add f7 4
first get p4 f74
f75 add f7 5
cnt get p4 f75
f76 add f7 6
retw get p4 f76
npbad gt np 64
cntbad gt cnt 4096
nio fold v1ioparamstep np 0 tlist tio fp
iobad gt nio 1
hc0 select iobad 2 0
hc1 select cntbad 4 hc0
hcode select npbad 4 hc1
s1 put p0 13 1
s2 put s1 14 1
s3 put s2 10 hcode
s4 put s3 11 f
s5 put s4 12 4294967295
s6 loop v1nodeok v1nodestep cnt s5 p2 p3 p4 f
err at s6 10
tlist6 at s6 1
tio6 at s6 2
ntys6 at s6 6
ncons6 at s6 7
pcons6 at s6 8
fstat6 at s6 9
errnode6 at s6 12
stat6 at s6 14
rk shr retw 28
rv and retw 268435455
rt call v1opndty rk rv tlist6 ntys6 fp np first
rbad eq rt 4294967295
rne ne rt res
rio get tio6 rt
gi add first rv
pi add fp rv
nc get ncons6 gi
pc get pcons6 pi
isn eq rk 1
isp eq rk 2
c0 select isn nc 0
c select isp pc c0
rio1 eq rio 1
c1 eq c 1
rcons and rio1 c1
rc0 select rcons 2 0
rc1 select rne 3 rc0
rcode select rbad 3 rc1
err0 eq err 0
rerr ne rcode 0
apply and err0 rerr
err2 select apply rcode err
errnode2 select apply cnt errnode6
fstat2 set fstat6 f stat6
s7 put s6 10 err2
s8 put s7 12 errnode2
s9 put s8 9 fstat2
ret s9
end
fn v1fnok (u32x768,u32x1024,u32x256,u32x256,u32,u32,u32x1024,u32x1024,u32x1024,u32x256,u32,u32,u32,u32,u32) u32 u32x4096 u32x8192 u32x1024 u32 -> bool
err at p0 10
r eq err 0
ret r
end
# check functions [p9, p8) of the IR (types tlist fns nodes args, counts p6 p7 p8) given the
# iteration bounds p5 of the functions before p9
fn check u32x768 u32x1024 u32x1024 u32x4096 u32x8192 u32x256 u32 u32 u32 u32 -> (u32x768,u32x1024,u32x256,u32x256,u32,u32,u32x1024,u32x1024,u32x1024,u32x256,u32,u32,u32,u32,u32)
z256 call zeros256
z1024 call zeros1024
inf0 rec z256 z256
inf fold v1infostep p6 inf0 p0 p1
tio at inf 0
tbits at inf 1
toomany gt p8 1024
code0 select toomany 4 0
s0 rec p0 p1 tio tbits p6 p7 z1024 z1024 z1024 p5 code0 4294967295 4294967295 1 1
n sub p8 p9
s loop v1fnok v1fnstep n s0 p3 p4 p2 p9
ret s
end
# widening copies of the parser's tables
fn cp768 u32x768 u32 u32x512 -> u32x768
v get p2 p1
r set p0 p1 v
ret r
end
fn cp1024 u32x1024 u32 u32x512 -> u32x1024
v get p2 p1
r set p0 p1 v
ret r
end
fn cp4096 u32x4096 u32 u32x512 -> u32x4096
v get p2 p1
r set p0 p1 v
ret r
end
fn cp8192 u32x8192 u32 u32x512 -> u32x8192
v get p2 p1
r set p0 p1 v
ret r
end
