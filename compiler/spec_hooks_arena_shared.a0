use "arena_shared.a0"
use "arena_vector_shared.a0"

fn as_resume_load (u32x128,u32x128,io) u32 -> (u32x128,u32x128,io)
p at p0 0
q0 at p0 2
q1 get p 59
q2 get p 60
q3 get p 61
q4 rec q1 q2 q3
r call av_load q0 q4 0 128
q5 at r 0
q6 set p 0 q5
q7 at r 1
q8 at r 2
q9 rec q6 q7 q8
ret q9
end

fn as_resume (u32x128,io) -> (u32x128,u32x128,io)
p at p0 0
z call arena_zero
q0 get p 6
q set z 6 q0
q_1 set q 24 4294967295
q_2 set q_1 92 1
q1 get p 60
q2 ne q1 0
q3 select q2 1 0
q4 at p0 1
q5 rec p q_2 q4
r fold as_resume_load q3 q5
sp at r 1
sp_1 set sp 11 0
q6 get p 62
q7 get p 63
q8 get p 64
q9 rec q6 q7 q8
q10 get p 65
q11 get p 66
q12 get p 67
q13 rec q9 q10 q11 q12
m3_a set sp_1 80 q6
m3_b set m3_a 81 q7
q14 set m3_b 82 q8
m2_b set q14 83 q10
m2_c set m2_b 84 q11
q15 set m2_c 85 q12
q16 at r 0
q17 at r 2
q18 rec q16 q15 q17
ret q18
end

fn as_save_new (u32x128,u32x128,io) u32 -> (u32x128,u32x128,io)
p at p0 0
q0 at p0 2
q1 get p 59
q2 get p 60
q3 get p 61
q4 rec q1 q2 q3
q5 at p0 1
r call av_append q0 q4 128 q5
q6 at r 1
q7 at q6 0
m1_a set p 59 q7
q8 at q6 1
m1_b set m1_a 60 q8
q9 at q6 2
q10 set m1_b 61 q9
q11 at r 0
q12 set q10 0 q11
q13 at p0 1
q14 at r 2
q15 rec q12 q13 q14
ret q15
end

fn as_save_old (u32x128,u32x128,io) u32 -> (u32x128,u32x128,io)
p at p0 0
q0 at p0 2
q1 get p 59
q2 get p 60
q3 get p 61
q4 rec q1 q2 q3
q5 at p0 1
r call av_store q0 q4 0 128 q5
q6 at r 0
q7 set p 0 q6
q8 at p0 1
q9 at r 1
q10 rec q7 q8 q9
ret q10
end
