fn af_opcode(k:(u32,(u32,u32,u32),u32x128,io),op:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let a=af_fail(k,(op==0)|(op>37)?6:0)
 let a1=fold(af_lit_op1,op==1?1:0,a)
 let a2=fold(af_lit_op2,op==2?1:0,a1)
 let a3=fold(af_lit_op3,op==3?1:0,a2)
 let a4=fold(af_lit_op4,op==4?1:0,a3)
 let a5=fold(af_lit_op5,op==5?1:0,a4)
 let a6=fold(af_lit_op6,op==6?1:0,a5)
 let a7=fold(af_lit_op7,op==7?1:0,a6)
 let a8=fold(af_lit_op8,op==8?1:0,a7)
 let a9=fold(af_lit_op9,op==9?1:0,a8)
 let a10=fold(af_lit_op10,op==10?1:0,a9)
 let a11=fold(af_lit_op11,op==11?1:0,a10)
 let a12=fold(af_lit_op12,op==12?1:0,a11)
 let a13=fold(af_lit_op13,op==13?1:0,a12)
 let a14=fold(af_lit_op14,op==14?1:0,a13)
 let a15=fold(af_lit_op15,op==15?1:0,a14)
 let a16=fold(af_lit_op16,op==16?1:0,a15)
 let a17=fold(af_lit_op17,op==17?1:0,a16)
 let a18=fold(af_lit_op18,op==18?1:0,a17)
 let a19=fold(af_lit_op19,op==19?1:0,a18)
 let a20=fold(af_lit_op20,op==20?1:0,a19)
 let a21=fold(af_lit_op21,op==21?1:0,a20)
 let a22=fold(af_lit_op22,op==22?1:0,a21)
 let a23=fold(af_lit_op23,op==23?1:0,a22)
 let a24=fold(af_lit_op24,op==24?1:0,a23)
 let a25=fold(af_lit_op25,op==25?1:0,a24)
 let a26=fold(af_lit_op26,op==26?1:0,a25)
 let a27=fold(af_lit_op27,op==27?1:0,a26)
 let a28=fold(af_lit_op28,op==28?1:0,a27)
 let a29=fold(af_lit_op29,op==29?1:0,a28)
 let a30=fold(af_lit_op30,op==30?1:0,a29)
 let a31=fold(af_lit_op31,op==31?1:0,a30)
 let a32=fold(af_lit_op32,op==32?1:0,a31)
 let a33=fold(af_lit_op33,op==33?1:0,a32)
 let a34=fold(af_lit_op34,op==34?1:0,a33)
 let a35=fold(af_lit_op35,op==35?1:0,a34)
 let a36=fold(af_lit_op36,op==36?1:0,a35)
 let a37=fold(af_lit_op37,op==37?1:0,a36)
 return a37
end

fn af_operand_node(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 return af_symbol(k,m,row[1])
end
fn af_operand_smallparam(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 let short=!af_internal(k)&(row[1]<26)
 let a=fold(af_cbyte,short?1:0,k,65+row[1])
 let b=fold(af_cbyte,short?0:1,a,112)
 return fold(af_cnum,short?0:1,b,row[1])
end
fn af_operand_bigparam_number(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 let s=af_s(k)
 let n=number_integer(s#2,m[6],row[2]+1,row[3]-1)
 return af_k(ad_string((n#0,s#1,n#3),n#2),k#2)
end
fn af_operand_bigparam_do(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 let a=af_byte(k,112)
 return fold(af_operand_bigparam_number,a#0==0?1:0,a,m,row)
end
fn af_operand_bigparam(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 let valid=(row[3]>=2)&(row[2]<=m[7])&(row[3]<=m[7]-row[2])
 let a=af_fail(k,valid?0:7)
 return fold(af_operand_bigparam_do,a#0==0?1:0,a,m,row)
end
fn af_operand_param(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 let big=(row[4]&4)!=0
 let a=fold(af_operand_smallparam,big?0:1,k,m,row)
 return fold(af_operand_bigparam,big?1:0,a,m,row)
end
fn af_operand_number(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 return af_num(k,row[1])
end
fn af_operand_bool(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 let a=af_fail(k,row[1]<=1?0:6)
 let b=fold(af_lit_falseword,row[1]==0?1:0,a)
 return fold(af_lit_trueword,row[1]==0?0:1,b)
end
fn af_operand(k:(u32,(u32,u32,u32),u32x128,io),m:u32x128,args:(u32,u32,u32),id:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let r=af_row(k,args,id,5)
 let row=r#1
 let a=af_fail(r#0,row[0]<=3?0:6)
 let b=fold(af_operand_node,row[0]==0?1:0,a,m,row)
 let c=fold(af_operand_param,row[0]==1?1:0,b,m,row)
 let d=fold(af_operand_number,row[0]==2?1:0,c,m,row)
 return fold(af_operand_bool,row[0]==3?1:0,d,m,row)
end
fn af_operand_region(k:(u32,(u32,u32,u32),u32x128,io),m:u32x128,args:(u32,u32,u32),id:u32,kind:u32,field:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let b=af_begin(k,kind,id,field)
 let a=af_operand(b#0,m,args,id)
 return af_end(a,b#1)
end
fn af_argument(k:(u32,(u32,u32,u32),u32x128,io),i:u32,m:u32x128,args:(u32,u32,u32),first:u32,tag:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let a=af_byte(k,32)
 return af_operand_region(a,m,args,first+i,tag==0?9:15,i)
end
fn af_text_escape(k:(u32,(u32,u32,u32),u32x128,io),unused:u32) -> (u32,(u32,u32,u32),u32x128,io)
 return af_byte(k,92)
end
fn af_textbyte(k:(u32,(u32,u32,u32),u32x128,io),i:u32,args:(u32,u32,u32),first:u32,tag:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let b=af_begin(k,tag==0?9:15,first+i,i)
 let r=af_row(b#0,args,first+i,5)
 let row=r#1
 let value=row[1]
 let a=af_fail(r#0,(row[0]==2)&(value<=255)?0:6)
 let escaped=(value==92)|(value==34)|(value==10)|(value==9)
 let c=fold(af_text_escape,escaped?1:0,a)
 let d=af_byte(c,value==10?110:(value==9?116:value))
 return af_end(d,b#1)
end
fn af_text_ok(k:(u32,(u32,u32,u32),u32x128,io),i:u32,args:(u32,u32,u32),first:u32,tag:u32) -> bool
 return k#0==0
end
fn af_args_ok(k:(u32,(u32,u32,u32),u32x128,io),i:u32,m:u32x128,args:(u32,u32,u32),first:u32,tag:u32) -> bool
 return k#0==0
end
fn af_text(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,args:(u32,u32,u32),row:u32x128,tag:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let a=af_byte(af_byte(k,32),34)
 let b=loop(af_text_ok,af_textbyte,row[3],a,args,row[2],tag)
 return af_byte(b,34)
end
fn af_node_predicate(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128,id:u32,tag:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let a=af_byte(k,32)
 let b=af_begin(a,8,id,tag)
 let c=af_symbol(b#0,m,row[5])
 return af_end(c,b#1)
end
fn af_node_callee(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,row:u32x128,id:u32,tag:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let a=af_byte(k,32)
 let b=af_begin(a,7,id,tag)
 let c=af_symbol(b#0,m,row[4])
 return af_end(c,b#1)
end
fn af_node_arguments(k:(u32,(u32,u32,u32),u32x128,io),unused:u32,m:u32x128,args:(u32,u32,u32),row:u32x128,id:u32,tag:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let a=fold(af_node_predicate,row[1]==21?1:0,k,m,row,id,tag)
 let b=fold(af_node_callee,row[4]!=4294967295?1:0,a,m,row,id,tag)
 return loop(af_args_ok,af_argument,row[3],b,m,args,row[2],tag)
end
fn af_direct_scan(r:((u32,(u32,u32,u32),u32x128,io),bool),i:u32,row:u32x128) -> ((u32,(u32,u32,u32),u32x128,io),bool)
 let old=r#0
 let word=ap_scanword(old#3,row[0],row[1],row[2])
 let k=af_k((old#0==0?word#0:old#0,old#1,word#2),old#2)
 let info=word#1
 return (k,(info[0]!=0)&(info[8]==0)&(info[9]!=10))
end
fn af_direct(r:((u32,(u32,u32,u32),u32x128,io),bool),i:u32,m:u32x128,symbol:u32) -> ((u32,(u32,u32,u32),u32x128,io),bool)
 let a=af_row(r#0,af_vec(m,62),symbol,5)
 let k=a#0
 return fold(af_direct_scan,k#0==0?1:0,(k,false),a#1)
end
fn af_bigkey_read(r:((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32)),i:u32,m:u32x128,row:u32x128) -> ((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32))
 let k=r#0
 let n=number_integer(k#3,m[6],row[2]+1,row[3]-1)
 return ((k#0==0?n#0:k#0,k#1,k#2,n#3),n#2)
end
fn af_bigkey_do(r:((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32)),i:u32,m:u32x128,row:u32x128) -> ((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32))
 let valid=(row[3]>=2)&(row[2]<=m[7])&(row[3]<=m[7]-row[2])
 let k=af_fail(r#0,valid?0:7)
 return fold(af_bigkey_read,k#0==0?1:0,(k,r#1),m,row)
end
fn af_bigkey(k:(u32,(u32,u32,u32),u32x128,io),m:u32x128,row:u32x128) -> ((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32))
 return af_bigkey_do((k,(0,0,0)),0,m,row)
end
fn af_keybyte(r:((u32,(u32,u32,u32),u32x128,io),bool),i:u32,a:(u32,u32,u32),b:(u32,u32,u32)) -> ((u32,(u32,u32,u32),u32x128,io),bool)
 let x=af_row(r#0,a,i,1)
 let y=af_row(x#0,b,i,1)
 return (y#0,get(x#1,0)==get(y#1,0))
end
fn af_keymore(r:((u32,(u32,u32,u32),u32x128,io),bool),i:u32,a:(u32,u32,u32),b:(u32,u32,u32)) -> bool
 return (r#0#0==0)&r#1
end
fn af_obig(r:((u32,(u32,u32,u32),u32x128,io),bool),i:u32,m:u32x128,row:u32x128,key:(u32,u32,u32)) -> ((u32,(u32,u32,u32),u32x128,io),bool)
 let a=af_bigkey(r#0,m,row)
 let equal=key#1==a#1#1
 return loop(af_keymore,af_keybyte,equal?key#1:0,(a#0,equal),key,a#1)
end
fn af_onext(r:((u32,(u32,u32,u32),u32x128,io),bool),i:u32,m:u32x128,args:(u32,u32,u32),first:u32,head:u32x128,key:(u32,u32,u32)) -> ((u32,(u32,u32,u32),u32x128,io),bool)
 let a=af_row(r#0,args,first+i+1,5)
 let row=a#1
 let big=(row[0]==1)&((row[4]&4)!=0)
 let headbig=(head[0]==1)&((head[4]&4)!=0)
 let same=(row[0]==head[0])&(big==headbig)
 let equal=same&(big|(row[1]==head[1]))
 return fold(af_obig,equal&big?1:0,(a#0,equal),m,row,key)
end
fn af_omore(r:((u32,(u32,u32,u32),u32x128,io),bool),i:u32,m:u32x128,args:(u32,u32,u32),first:u32,head:u32x128,key:(u32,u32,u32)) -> bool
 return (r#0#0==0)&r#1
end
fn af_ofirst(r:((u32,(u32,u32,u32),u32x128,io),bool),i:u32,m:u32x128,args:(u32,u32,u32),first:u32,count:u32) -> ((u32,(u32,u32,u32),u32x128,io),bool)
 let a=af_row(r#0,args,first,5)
 let head=a#1
 let big=(head[0]==1)&((head[4]&4)!=0)
 let b=fold(af_bigkey_do,big?1:0,(a#0,(0,0,0)),m,head)
