fn af_lstep(l:((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32)),i:u32,ps:u32x128) -> ((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32))
 let stack=l#1
 let r=af_row(l#0,stack,stack#1/2-1,2)
 let row=r#1
 let a=af_fail(r#0,row[0]<=2?0:6)
 let popped=(a,(stack#0,stack#1-2,stack#2))
 let b=fold(af_lvalue,row[0]==0?1:0,popped,ps,row[1])
 let c=fold(af_lbyte,row[0]==1?1:0,b,ps,row[1])
 return fold(af_lend,row[0]==2?1:0,c,ps,row[1])
end
fn af_literal(k:(u32,(u32,u32,u32),u32x128,io),ps:u32x128,id:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let start=af_lpush((k,(0,0,0)),0,id)
 let r=loop(af_lmore,af_lstep,0-ps[92],start,ps)
