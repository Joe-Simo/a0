fn af_lcontainer(l:((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32)),unused:u32,ps:u32x128,row:u32x128,event:u32) -> ((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32))
 let children=af_vec(ps,35)
 let valid=(row[3]!=0)&(row[2]<=children#1)&(row[3]<=children#1-row[2])
 let k=af_fail(l#0,valid?0:7)
 let opened=af_byte(k,row[0]==3?91:40)
 let a=af_lpush((opened,l#1),2,event)
 let b=af_lpush(a,1,row[0]==3?93:41)
 let c=fold(af_lsemicolon,(row[0]==4)&(row[3]==1)?1:0,b)
 return loop(af_lchildren_ok,af_lchildren,row[3],c,ps,row[2],row[3])
