 let declared=(m[60]==128)&(ps[0]==0)&(ps[6]==m[6])&(ps[24]==4294967295)&(ps[54]==0)&(ps[57]==0)&(ps[92]==1)
 let shape=(ps[33]%6==0)&(ps[42]%8==0)&(ps[45]%7==0)&(ps[48]%14==0)&(ps[51]%5==0)&(ps[60]%2==0)&(ps[63]%5==0)
 let a=af_fail(k,declared&shape?0:7)
 let r=af_row(a,af_vec(m,59),0,128)
 let same=fold(af_same128,128,true,r#1,ps)
 return af_fail(r#0,same?0:7)
end
fn af_schema(k:(u32,(u32,u32,u32),u32x128,io),m:u32x128,ps:u32x128,mode:u32,id:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let accepted=(m[0]==0)|(m[0]==7)
 let status=accepted?0:m[0]
 let shape=(m[93]==1)&((m[10]==0)|(m[96]==1))&(m[8]<=1)&(mode<=2)
 let valid=(m[33]%10==0)&(m[36]%2==0)&(m[39]%3==0)&(m[42]%14==0)&(m[45]%14==0)&(m[48]%5==0)&(m[54]%3==0)&(m[57]%6==0)&(m[69]%5==0)
 let a=af_fail(k,status)
 let b=af_fail(a,shape&valid?0:6)
 let selected=(mode!=0)|(id<m[42]/14)
 let c=af_fail(b,selected?0:6)
 let complete=(m[0]!=7)|((m[30]==1)&(m[57]!=0))
 let d=af_fail(c,complete?0:7)
 return fold(af_auth_spec,m[57]!=0?1:0,d,m,ps)
end
fn af_run(k:(u32,(u32,u32,u32),u32x128,io),i:u32,m:u32x128,ps:u32x128,mode:u32,id:u32,skip:bool) -> (u32,(u32,u32,u32),u32x128,io)
 let a=fold(af_format_one,mode==0?1:0,k,m,ps,id,skip)
 let b=fold(af_format_program,mode==1?1:0,a,m,ps,id,skip)
 return fold(af_format_source,mode==2?1:0,b,m,ps,id,skip)
end
fn arena_format_described(t:io,m:u32x128,ps:u32x128,mode:u32,id:u32,skip:bool,mapping:bool) -> (u32,(u32,u32,u32),u32x128,io)
 let d=arena_zero()
 let d=set(d,1,0x41304654)
 let d=set(d,2,1)
 let d=set(d,3,mapping?1:0)
 let d=set(d,8,4294967295)
 let d=set(d,10,mode)
 let d=set(d,11,id)
 let d=set(d,12,skip?1:0)
 let d=set(d,13,m[6])
 let d=set(d,14,m[7])
 let start=(0,(0,0,0),d,t)
 let checked=af_schema(start,m,ps,mode,id)
 let out=fold(af_run,checked#0==0?1:0,checked,m,ps,mode,id,skip)
 let d=set(out#2,0,out#0)
 let d=set(d,9,out#0==0?out#1#1:0)
 let public=out#0==0?d:af_setvec(d,4,(0,0,0))
 return (out#0,out#0==0?out#1:(0,0,0),public,out#3)
end
fn arena_format(t:io,m:u32x128,ps:u32x128,mode:u32,id:u32,skip:bool) -> (u32,(u32,u32,u32),io)
 let r=arena_format_described(t,m,ps,mode,id,skip,false)
 return (r#0,r#1,r#3)
end
