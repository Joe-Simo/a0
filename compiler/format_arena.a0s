 let a=fold(af_node_predicate,row[1]==21?1:0,k,m,row,id,tag)
 let b=fold(af_node_callee,row[4]!=4294967295?1:0,a,m,row,id,tag)
 return loop(af_args_ok,af_argument,row[3],b,m,args,row[2],tag)
end
fn af_node(k:(u32,(u32,u32,u32),u32x128,io),m:u32x128,nodes:(u32,u32,u32),args:(u32,u32,u32),id:u32,tag:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let b=af_begin(k,tag==0?4:14,id,0)
 let r=af_row(b#0,nodes,id,14)
 let row=r#1
 let operands=(row[2]<=args#1/5)&(row[3]<=args#1/5-row[2])
 let known=(row[1]>=1)&(row[1]<=37)&(((row[11]&2)==0)|(row[1]==22)|(row[1]==24))
 let a=af_fail(r#0,operands&known?0:7)
 let name=af_begin(a,5,id,tag)
 let named=af_symbol(name#0,m,row[0])
 let c=af_byte(af_end(named,name#1),32)
 let text=(row[1]==24)|((row[11]&2)!=0)
 let op=af_begin(c,6,id,tag)
 let spelled=af_opcode(op#0,text?24:row[1])
 let d=af_end(spelled,op#1)
 let e=fold(af_text,text?1:0,d,args,row,tag)
 let f=fold(af_node_arguments,text?0:1,e,m,args,row,id,tag)
 return af_end(f,b#1)
end

