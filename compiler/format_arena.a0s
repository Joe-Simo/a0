raw # Full-word canonical formatting over immutable parser/grammar schema1.
raw use "diagnostics_arena.a0"
raw use "number_integer.a0"
raw use "sha256_arena.a0"
extern arena_zero() -> u32x128
extern arena_load(io,u32,u32,u32) -> (u32,u32x128,io)
extern av_load(io,(u32,u32,u32),u32,u32) -> (u32,u32x128,io)
extern av_append(io,(u32,u32,u32),u32,u32x128) -> (u32,(u32,u32,u32),io)
extern av_store(io,(u32,u32,u32),u32,u32,u32x128) -> (u32,io)
extern ad_byte((u32,(u32,u32,u32),io),u32) -> (u32,(u32,u32,u32),io)
extern ad_number((u32,(u32,u32,u32),io),u32) -> (u32,(u32,u32,u32),io)
extern ad_copy((u32,(u32,u32,u32),io),u32,u32,u32) -> (u32,(u32,u32,u32),io)
extern ad_string((u32,(u32,u32,u32),io),(u32,u32,u32)) -> (u32,(u32,u32,u32),io)
extern ad_append((u32,(u32,u32,u32),io),u32,u32x128) -> (u32,(u32,u32,u32),io)
extern ad_symbol((u32,(u32,u32,u32),io),u32x128,u32) -> (u32,(u32,u32,u32),io)
extern number_integer(io,u32,u32,u32) -> (u32,(u32,u32),(u32,u32,u32),io)
extern arena_sha256_hex(io,u32,u32) -> (u32,(u32,u32,u32),io)
def af_vec(m:u32x128,o:u32) -> (u32,u32,u32)
 return (m[o],m[o+1],m[o+2])
end
def af_setvec(m:u32x128,o:u32,v:(u32,u32,u32)) -> u32x128
 let a=set(m,o,v#0)
 let b=set(a,o+1,v#1)
 return set(b,o+2,v#2)
end

def af_s(k:(u32,(u32,u32,u32),u32x128,io)) -> (u32,(u32,u32,u32),io)
 return (k#0,k#1,k#3)
end
fn af_k(s:(u32,(u32,u32,u32),io),d:u32x128) -> (u32,(u32,u32,u32),u32x128,io)
 return (s#0,s#1,d,s#2)
end
fn af_fail(k:(u32,(u32,u32,u32),u32x128,io),code:u32) -> (u32,(u32,u32,u32),u32x128,io)
 return (k#0==0?code:k#0,k#1,k#2,k#3)
end
fn af_ok(k:(u32,(u32,u32,u32),u32x128,io),i:u32) -> bool
 return k#0==0
end
fn af_byte(k:(u32,(u32,u32,u32),u32x128,io),value:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let d=k#2
 return af_k(ad_byte(af_s(k),value),d)
end
fn af_num(k:(u32,(u32,u32,u32),u32x128,io),value:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let d=k#2
 return af_k(ad_number(af_s(k),value),d)
end
fn af_row_load(r:((u32,(u32,u32,u32),u32x128,io),u32x128),i:u32,v:(u32,u32,u32),index:u32,width:u32) -> ((u32,(u32,u32,u32),u32x128,io),u32x128)
 let k=r#0
 let d=k#2
 let out=k#1
 let a=av_load(k#3,v,index*width,width)
 return ((a#0,out,d,a#2),a#1)
end
fn af_row(k:(u32,(u32,u32,u32),u32x128,io),v:(u32,u32,u32),index:u32,width:u32) -> ((u32,(u32,u32,u32),u32x128,io),u32x128)
 let valid=(width!=0)&(width<=128)&(index<=4294967295/(width==0?1:width))
 let a=af_fail(k,valid?0:7)
 return fold(af_row_load,a#0==0?1:0,(a,arena_zero()),v,index,width)
end
fn af_span_copy(k:(u32,(u32,u32,u32),u32x128,io),i:u32,m:u32x128,start:u32,length:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let d=k#2
 return af_k(ad_copy(af_s(k),m[6],start,length),d)
end
fn af_span(k:(u32,(u32,u32,u32),u32x128,io),m:u32x128,start:u32,length:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let valid=(start<=m[7])&(length<=m[7]-start)
 let a=af_fail(k,valid?0:7)
 return fold(af_span_copy,a#0==0?1:0,a,m,start,length)
end
fn af_symbol_copy(k:(u32,(u32,u32,u32),u32x128,io),i:u32,m:u32x128,id:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let d=k#2
 return af_k(ad_symbol(af_s(k),m,id),d)
end
fn af_symbol(k:(u32,(u32,u32,u32),u32x128,io),m:u32x128,id:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let a=af_fail(k,id<=858993459?0:7)
 return fold(af_symbol_copy,a#0==0?1:0,a,m,id)
end
fn af_event_new(r:((u32,(u32,u32,u32),u32x128,io),u32),i:u32,kind:u32,subject:u32,field:u32) -> ((u32,(u32,u32,u32),u32x128,io),u32)
 let k=r#0
 let d=k#2
 let out=k#1
 let v=af_vec(d,4)
 let page=arena_zero()
 let page=set(page,0,kind)
 let page=set(page,1,subject)
 let page=set(page,2,field)
 let page=set(page,3,out#1)
 let page=set(page,5,d[8])
 let a=av_append(k#3,v,6,page)
 let id=v#1/6
 let d=af_setvec(d,4,a#1)
 return ((a#0,out,set(d,8,id),a#2),id)
end
fn af_begin(k:(u32,(u32,u32,u32),u32x128,io),kind:u32,subject:u32,field:u32) -> ((u32,(u32,u32,u32),u32x128,io),u32)
 return fold(af_event_new,(k#0==0)&(get(k#2,3)!=0)?1:0,(k,4294967295),kind,subject,field)
end
fn af_event_end(k:(u32,(u32,u32,u32),u32x128,io),i:u32,id:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let r=af_row(k,af_vec(k#2,4),id,6)
 let a=r#0
 let row=r#1
 let d=a#2
 let out=a#1
 let length=out#1-row[3]
 let page=set(row,4,length)
 let stored=av_store(a#3,af_vec(d,4),id*6,6,page)
 return (stored#0,out,set(d,8,row[5]),stored#1)
end
fn af_end(k:(u32,(u32,u32,u32),u32x128,io),id:u32) -> (u32,(u32,u32,u32),u32x128,io)
 return fold(af_event_end,(k#0==0)&(id!=4294967295)?1:0,k,id)
end

fn af_lit_fnword(k:(u32,(u32,u32,u32),u32x128,io),unused:u32) -> (u32,(u32,u32,u32),u32x128,io)
 let page=arena_zero()
 let page=set(page,0,102)
 let page=set(page,1,110)
 let page=set(page,2,32)
 let s=ad_append(af_s(k),3,page)
 return af_k(s,k#2)
end

