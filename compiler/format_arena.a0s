 let page=set(set(arena_zero(),0,kind),1,value)
 let r=av_append(s#2,l#1,2,page)
 return (af_k((r#0,s#1,r#2),k#2),r#1)
end
fn af_lpush(l:((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32)),kind:u32,value:u32) -> ((u32,(u32,u32,u32),u32x128,io),(u32,u32,u32))
