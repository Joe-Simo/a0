# Lossless line/word/comment scanner. Every syntax decision executes in A0.
# Spans are full-width UTF-8 byte offsets, source cells are immutable bytes in u32 arenas.
# Lines10: lineNo,rawStart,rawLen,codeStart,codeLen,wordFirst,wordCount,commentIndex,leadingFirst,leadingCount.
# Words2: start,len. Comments3: start,len,lineNo. Pending slices index comments.
# Status6: source exceeds2MiB. Runtime statuses1..5 propagate; partial vectors on error must not be consumed.
use "arena_vector.a0"
use "lex_arena.a0"
use "lines_arena_shared.a0"
