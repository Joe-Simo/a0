end
# a register class with the zero registers as their width (wzr as w, xzr as x)
fn aspcls u32 -> u32
w eq p0 7
x eq p0 6
a select x 1 p0
r select w 2 a
ret r
end
# ldp stp (4, 5)
fn asldp (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 u32 -> (u32,bool,u32,u32,u32,u32)
load eq p1 4
k0 call askd p0 0
k1 call askd p0 1
ca0 call asfa p0 0
ca1 call asfa p0 1
n0 call asfb p0 0
n1 call asfb p0 1
c0 call aspcls ca0
c1 call aspcls ca1
r0 eq k0 1
r1 eq k1 1
same eq c0 c1
rr and r0 r1
okr and rr same
