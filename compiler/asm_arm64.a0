ahi0 eq ahi 0
a2 and ang0 ahi0
a3 ge alo 2
a4 le alo 14
a5 and a1 a2
a6 and a3 a4
alok and a5 a6
isal eq di 4
nalok eq alok false
eal and isal nalok
e1 or nf esec
e2 or e1 eal
g1 call asfail p0 1 p7 e2
pc and isal alok
pcn select pc 1 0
g2 fold aspadf pcn g1 alo p7
isz eq di 5
zc select isz 1 0
g3 fold aszf zc g2 p2 p5 p6 p7
ret g3
end
# an instruction: mnemonic [p3, p4), operands [p5, p6) of line p2, line p7
fn asinsn (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32) u32 u32x256 u32 u32 u32 u32 u32 -> (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32)
it call astok p2 p5 p6
ite at it 5
pk call aspack p2 p3 p4
mnt call asmns
mi0 call aslook mnt 50 pk
c0 get p2 p3
b1i add p3 1
c1 get p2 b1i
cb eq c0 98
cd eq c1 46
bs2 add p3 2
pk2 call aspack p2 bs2 p4
cot call ascos
ci call aslook cot 17 pk2
cc call ascc ci
cok ne ci 4294967295
nf eq mi0 4294967295
x1 and cb cd
x2 and x1 cok
isbc and nf x2
m1 select isbc 50 99
mi select nf m1 mi0
e call asenc it mi cc
ee at e 1
bad or ite ee
g1 call asfail p0 1 p7 bad
ok eq bad false
oc select ok 1 0
g2 fold aspush oc g1 p2 it e p7
ret g2
end
# line p1 (p2 bytes, the first 256 stored) with number p3
fn asproc (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32) u32x256 u32 u32 -> (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32)
cut call ascut p1 p2
big gt p2 256
cl ge cut 256
lim and big cl
g1 call asfail p0 2 p3 lim
st0 rec g1 0 false
ls loop aslabp aslabs 257 st0 p1 cut
g2 at ls 0
pos at ls 1
bs call asskip p1 cut pos
be call asrtrim p1 bs cut
nonempty lt bs be
me call astows p1 be bs
mel lt me be
me1 add me 1
rs select mel me1 be
c0 get p1 bs
isdot eq c0 46
dodir and nonempty isdot
nd eq isdot false
doins and nonempty nd
cd select dodir 1 0
ci select doins 1 0
g3 fold asdir cd g2 p1 bs me rs be p3
g4 fold asinsn ci g3 p1 bs me rs be p3
ret g4
end
fn asrdp (io,u32x256,u32,u32,bool) u32 -> bool
d at p0 4
rm0 at p0 3
nd eq d false
more gt rm0 0
r and nd more
ret r
end
# one byte of the line: state (io, line, length, bytes left, newline seen)
fn asrds (io,u32x256,u32,u32,bool) u32 -> (io,u32x256,u32,u32,bool)
t at p0 0
b at p0 1
ln at p0 2
rm0 at p0 3
rr read t
c at rr 0
t2 at rr 1
rm1 sub rm0 1
nl eq c 10
nnl eq nl false
room lt ln 256
st and room nnl
b2 set b ln c
b3 select st b2 b
ln1 add ln 1
ln2 select nl ln ln1
r rec t2 b3 ln2 rm1 nl
ret r
end
fn asmorep (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32) u32 -> bool
er at p0 18
rm0 at p0 21
e0 eq er 0
m gt rm0 0
r and e0 m
ret r
end
# read and assemble one line
fn asline (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32) u32 -> (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32)
rm0 at p0 21
lno at p0 20
t at p0 0
zb call aszb
s0 rec t zb 0 rm0 false
cap add rm0 1
s loop asrdp asrds cap s0
t2 at s 0
b at s 1
ln at s 2
rm1 at s 3
g1 put p0 0 t2
g2 put g1 21 rm1
lno1 add lno 1
g3 put g2 20 lno1
g4 call asproc g3 b ln lno1
ret g4
end
# branch p1 resolved: patched into its word, or a branch26 relocation to an undefined symbol
fn asrsst (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32) u32 -> (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32)
pend at p0 10
k mul p1 8
idx call asg64 pend k
k1 add k 1
form call asg64 pend k1
k2 add k 2
line call asg64 pend k2
k3 add k 3
il call asg64 pend k3
k4 add k 4
pa call asg64 pend k4
k5 add k 5
pb call asg64 pend k5
k6 add k 6
h call asg64 pend k6
isloc eq il 1
loc at p0 12
nl at p0 13
lab at p0 6
nlab at p0 7
pool at p0 4
w at p0 1
rel2 at p0 22
nr2 at p0 23
nlx select isloc nl 0
ls0 rec 0 false 0
lk fold aslkst2 nlx ls0 loc pa pb
lfd at lk 1
lof at lk 2
nlb select isloc 0 nlab
lf call aslfind lab nlb pool pa pb h
ffd at lf 0
fof at lf 1
found select isloc lfd ffd
target select isloc lof fof
at4 mul idx 4
und eq found false
b19 eq form 2
e1a or isloc b19
e1 and und e1a
nloc eq isloc false
f1 eq form 1
ar1 and und nloc
addrel and ar1 f1
d sub target at4
dd shr d 2
m26 and dd 67108863
m19a and dd 524287
m19 shl m19a 5
mm select f1 m26 m19
old call asg256 w idx
nwd or old mm
w2 call ass256 w idx nwd
w3 select found w2 w
full ge nr2 1024
kk mul nr2 4
r1 call ass32 rel2 kk at4
kk1 add kk 1
r2 call ass32 r1 kk1 0
kk2 add kk 2
r3 call ass32 r2 kk2 pa
kk3 add kk 3
r4 call ass32 r3 kk3 pb
nfull eq full false
doadd and addrel nfull
rel3 select doadd r4 rel2
nr3a add nr2 1
nr3 select doadd nr3a nr2
efull and addrel full
g1 put p0 1 w3
g2 put g1 22 rel3
g3 put g2 23 nr3
g4 call asfail g3 1 line e1
g5 call asfail g4 2 line efull
ret g5
end
fn asres (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32) -> (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32)
er at p0 18
np at p0 11
ok eq er 0
cnt select ok np 0
g fold asrsst cnt p0
ret g
end

# ---- output
fn aswst io u32 u32x128x256 -> io
v call asg256 p2 p1
w write p0 v
ret w
end
fn aswb io u32 u32x128x64 u32 -> io
i add p3 p1
v call asg64 p2 i
w write p0 v
ret w
end
fn aswlab io u32 u32x128x32 u32x128x64 -> io
k mul p1 4
k1 add k 1
st call asg32 p2 k1
k2 add k 2
ln call asg32 p2 k2
k3 add k 3
off call asg32 p2 k3
w1 write p0 off
w2 write w1 ln
w3 fold aswb ln w2 p3 st
ret w3
end
# relocations merged by offset (p2 p3 the page ones, p4 p5 the branch26 ones): state (io,
# next of each list)
fn aswrel (io,u32,u32) u32 u32x128x32 u32 u32x128x32 u32 u32x128x64 -> (io,u32,u32)
t at p0 0
i1 at p0 1
i2 at p0 2
k1 mul i1 4
o1 call asg32 p2 k1
k2 mul i2 4
o2 call asg32 p4 k2
h1 lt i1 p3
h2 lt i2 p5
lt12 lt o1 o2
pick1a and h1 lt12
nh2 eq h2 false
pick1b and h1 nh2
pick1 or pick1a pick1b
tb select pick1 p2 p4
kb select pick1 k1 k2
off call asg32 tb kb
kb1 add kb 1
kind call asg32 tb kb1
kb2 add kb 2
st call asg32 tb kb2
kb3 add kb 3
ln call asg32 tb kb3
w1 write t off
w2 write w1 kind
w3 write w2 ln
w4 fold aswb ln w3 p6 st
i1n add i1 1
i2n add i2 1
ni1 select pick1 i1n i1
ni2 select pick1 i2 i2n
r rec w4 ni1 ni2
ret r
end
fn aswbss io u32 u32x128x8 u32x128x64 -> io
k mul p1 4
st call asg8 p2 k
k1 add k 1
ln call asg8 p2 k1
k2 add k 2
off call asg8 p2 k2
k3 add k 3
size call asg8 p2 k3
w1 write p0 off
w2 write w1 size
w3 write w2 ln
w4 fold aswb ln w3 p3 st
ret w4
end
# the module (see the head of the file)
fn aswok io u32 u32x128x256 u32 u32x128x32 u32 u32x128x32 u32 u32x128x32 u32 u32x128x8 u32 u32 u32 u32x128x64 -> io
w0 write p0 0
w1 write w0 p3
w2 fold aswst p3 w1 p2
w4 write w2 p5
w5 fold aswlab p5 w4 p4 p14
tot add p7 p9
w6 write w5 tot
s0 rec w6 0 0
s1 fold aswrel tot s0 p6 p7 p8 p9 p14
w7 at s1 0
w8 write w7 p11
w9 fold aswbss p11 w8 p10 p14
w10 write w9 p12
w11 write w10 p13
ret w11
end
fn aswerr io u32 u32 u32 -> io
w0 write p0 p2
w1 write w0 p3
ret w1
end
fn asout (io,u32x128x256,u32,u32,u32x128x64,u32,u32x128x32,u32,u32x128x32,u32,u32x128x64,u32,u32x128x16,u32,u32x128x8,u32,u32,u32,u32,u32,u32,u32,u32x128x32,u32) -> io
t at p0 0
w at p0 1
nw at p0 3
pool at p0 4
lab at p0 6
nlab at p0 7
rel at p0 8
nrel at p0 9
bss at p0 14
nbss at p0 15
bsz at p0 16
bal at p0 17
er at p0 18
el at p0 19
rel2 at p0 22
nrel2 at p0 23
ok eq er 0
okc select ok 1 0
erc select ok 0 1
w1 fold aswok okc t w nw lab nlab rel nrel rel2 nrel2 bss nbss bsz bal pool
w2 fold aswerr erc w1 er el
ret w2
end
# the entry: n, then the n bytes of the text (see the head of the file)
fn asmio io -> u32
r read p0
n at r 0
t at r 1
z256 call asz256
z64 call asz64
z32 call asz32
z16 call asz16p
z8 call asz8
g0 rec t z256 0 0 z64 0 z32 0 z32 0 z64 0 z16 0 z8 0 0 0 0 0 0 n z32 0
cap add n 1
g1 loop asmorep asline cap g0
g2 call asres g1
code at g2 18
w call asout g2
ret code
end
