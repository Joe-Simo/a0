oh3 call asfc p0 3
ong select sa2 on3 0
olo select sa2 ol3 0
ohi select sa2 oh3 0
pos eq ong 0
unit shl 1 scale
um sub unit 1
al1 and olo um
alg eq al1 0
q shr olo scale
qh eq ohi 0
qr le q 4095
fit and qh qr
uok1 and pos alg
uok and uok1 fit
q10 shl q 10
wu1 or 956301312 base
wu2 or wu1 q10
wu or wu2 low0
isn eq ong 1
l256 le olo 256
l255 le olo 255
inr1 select isn l256 l255
inra and qh inr1
lwa0 sub 0 olo
lwa select isn lwa0 olo
l9 and lwa 511
l12 shl l9 12
ws1 or 939524096 base
ws2 or ws1 l12
ws or ws2 low0
worda select uok wu ws
nuok eq uok false
ninr eq inra false
erra and nuok ninr
sb1 eq p2 1342329153
sb2 eq p2 1617240385
sb or sb1 sb2
bi select sb1 4 3
rgb call asrng p0 bi 256 255
errb eq rgb false
lowb call aslow p0 bi
lb9 and lowb 511
lb12 shl lb9 12
tyb select sb1 1 3
ty10 shl tyb 10
wb1 or 939524096 base
wb2 or wb1 lb12
wb3 or wb2 ty10
wordb or wb3 low0
sc1s eq p2 1342509377
sc2s eq p2 1616318785
sc3s eq p2 1965494593
sc12 or sc1s sc2s
scs or sc12 sc3s
g3 call asgp p0 3
ec0 eq g3 false
ext call asfa p0 4
xuw eq ext 3
xls eq ext 0
xux eq ext 4
xsw eq ext 5
xsx eq ext 6
o3a or xls xux
ov1 select xsx 7 0
ov2 select xsw 6 ov1
ov3 select o3a 3 ov2
ov4 select xuw 2 ov3
badext eq ov4 0
nc1 eq sc1s false
option select sc1s 3 ov4
ec1 and nc1 badext
an call asfa p0 5
alo call asfb p0 5
ahi call asfc p0 5
an0 eq an 0
ah0 eq ahi 0
aeq1 eq alo scale
aeq2 and an0 ah0
aeqs and aeq1 aeq2
az1 eq alo 0
