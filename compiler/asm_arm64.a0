# condition code of condition-table index p0 (eq ne hs cs lo cc mi pl vs vc hi ls ge lt gt le al)
fn ascc u32 -> u32
lt2 lt p0 2
lt6 lt p0 6
d2 sub p0 2
h shr d2 1
m add h 2
r6 select lt6 m d2
r select lt2 p0 r6
ret r
end

# ---- numbers: -?[0-9]+ or -?0x[0-9a-fA-F]+ as sign and a 64-bit magnitude
# (p0, p1) * 10 + p2 as a 64-bit pair, and whether it carried out of 64 bits
fn asm10 u32 u32 u32 -> (u32,u32,bool)
l0 and p0 65535
l1 shr p0 16
t0 mul l0 10
t0b add t0 p2
t0c shr t0b 16
t1 mul l1 10
t1b add t1 t0c
lo16 and t0b 65535
hi16 shl t1b 16
nlo or lo16 hi16
cy shr t1b 16
h0 and p1 65535
h1 shr p1 16
u0 mul h0 10
u0b add u0 cy
u0c shr u0b 16
u1 mul h1 10
u1b add u1 u0c
hlo and u0b 65535
hhi shl u1b 16
nhi or hlo hhi
ov shr u1b 16
ovf ne ov 0
r rec nlo nhi ovf
ret r
end
# state (low, high, digits valid, overflow); p2 the buffer, p3 the first digit, p4 hexadecimal
fn asdgst (u32,u32,bool,bool) u32 u32x256 u32 bool -> (u32,u32,bool,bool)
ix add p3 p1
c get p2 ix
lo at p0 0
hi at p0 1
ok at p0 2
ov at p0 3
isd call asdig c
ish call ashexd c
valid select p4 ish isd
dv sub c 48
hv call ashexv c
m call asm10 lo hi dv
mlo at m 0
mhi at m 1
mov0 at m 2
hl1 shl lo 4
hlo or hl1 hv
hh1 shl hi 4
hcar shr lo 28
hhi or hh1 hcar
hov1 shr hi 28
hov ne hov1 0
nlo select p4 hlo mlo
nhi select p4 hhi mhi
nov select p4 hov mov0
ok2 and ok valid
ov2 or ov nov
r rec nlo nhi ok2 ov2
ret r
end
# the number [p1, p2): (is a number, overflows 64 bits, negative (0 for -0), low, high)
fn asnum u32x256 u32 u32 -> (bool,bool,u32,u32,u32)
c0 get p0 p1
ng eq c0 45
nw select ng 1 0
d0 add p1 nw
gtr gt p2 d0
dd sub p2 d0
ln select gtr dd 0
x0 get p0 d0
d1 add d0 1
x1 get p0 d1
z0 eq x0 48
xx eq x1 120
l3 ge ln 3
hx1 and z0 xx
hx and hx1 l3
st select hx 2 0
ds add d0 st
dn sub ln st
nonempty gt dn 0
init rec 0 0 true false
f fold asdgst dn init p0 ds hx
ok0 at f 2
ov at f 3
lo at f 0
hi at f 1
ok and ok0 nonempty
z or lo hi
nz ne z 0
negm and ng nz
negv select negm 1 0
r rec ok ov negv lo hi
ret r
end

# ---- operand items. An item is a kind and three fields:
#   1 register (class, number): class 1 x, 2 w, 3 q, 4 v (v<n>.2d), 5 sp, 6 xzr, 7 wzr
#   2 immediate `#n` and 3 bare number (negative, low, high)
#   4 `[`  5 `]`  6 `!`  7 shift or extend (0 lsl 1 lsr 2 asr 3 uxtw 4 uxtx 5 sxtw 6 sxtx)
#   8 condition (code)  9 symbol (start, end in the line, modifier 0, 1 @PAGE, 2 @PAGEOFF)
#   10 numeric label reference (number, 0 forward 1 backward)
# The word [p1, p2) as an item: (kind, a, b, c, error)
fn ascls u32x256 u32 u32 -> (u32,u32,u32,u32,bool)
ln sub p2 p1
c0 get p0 p1
pk call aspack p0 p1 p2
rgt call asrgs
ri call aslook rgt 3 pk
isrg ne ri 4294967295
rgc add ri 5
i1 add p1 1
c1 get p0 i1
i2 add p1 2
c2 get p0 i2
isx eq c0 120
isw eq c0 119
isq eq c0 113
xw or isx isw
xwq or xw isq
dg1 call asdig c1
dg2 call asdig c2
l2 eq ln 2
l3 eq ln 3
v1 sub c1 48
v2 sub c2 48
v10 mul v1 10
v12 add v10 v2
num2 select l3 v12 v1
l3d and l3 dg2
lok or l2 l3d
gs1 and xwq dg1
gshape and gs1 lok
maxr select isq 31 30
inr le num2 maxr
isg and gshape inr
gc1 select isw 2 3
gcls select isx 1 gc1
isv eq c0 118
lv5 eq ln 5
lv6 eq ln 6
ts sub p2 3
tc0 get p0 ts
ts1 add ts 1
tc1 get p0 ts1
ts2 add ts 2
tc2 get p0 ts2
td0 eq tc0 46
td1 eq tc1 50
td2 eq tc2 100
tl1 and td0 td1
tail and tl1 td2
v6d and lv6 dg2
vlen or lv5 v6d
vd and isv dg1
vs1 and vd vlen
vshape and vs1 tail
vnum select lv6 v12 v1
vin le vnum 31
isvr and vshape vin
sht call asshs
si call aslook sht 7 pk
issh ne si 4294967295
cot call ascos
ci call aslook cot 17 pk
isco ne ci 4294967295
cc call ascc ci
le1 sub p2 1
lastc get p0 le1
isf eq lastc 102
isb eq lastc 98
fb or isf isb
l2p ge ln 2
dgs call asall p0 p1 le1 0
lc1 and fb l2p
isloc and lc1 dgs
lnum call asnum p0 p1 le1
lhi at lnum 4
lbig ne lhi 0
lval at lnum 3
ldir select isb 1 0
nm call asnum p0 p1 p2
isnum at nm 0
nov at nm 1
nneg at nm 2
nlo at nm 3
nhi at nm 4
ld call asdig c0
lab0 call aslch c0
nld eq ld false
first and lab0 nld
rest call asall p0 i1 p2 1
issym and first rest
# precedence: register, shift, condition, local label, number, symbol
k6 select issym 9 0
k5 select isnum 3 k6
k4 select isloc 10 k5
k3 select isco 8 k4
k2 select issh 7 k3
k1 select isvr 1 k2
k0a select isg 1 k1
kind select isrg 1 k0a
a6 select issym p1 0
a5 select isnum nneg a6
a4 select isloc lval a5
a3 select isco cc a4
a2 select issh si a3
a1 select isvr 4 a2
a0a select isg gcls a1
fa select isrg rgc a0a
b6 select issym p2 0
b5 select isnum nlo b6
b4 select isloc ldir b5
b1 select isvr vnum b4
b0a select isg num2 b1
fb2 select isrg 31 b0a
c5 select isnum nhi 0
nreg eq k0a 0
nr2 eq isrg false
c5k and nr2 nreg
fc select c5k c5 0
none eq kind 0
ln10 eq kind 10
le10 and ln10 lbig
ln3 eq kind 3
le3 and ln3 nov
e1 or none le10
err or e1 le3
r rec kind fa fb2 fc err
ret r
end

# ---- the operand items of a line: (kinds, a, b, c, count, error); the tokenizer state adds
# the position, a pending `#`, a pending `@` and done
fn astkp ((u32x16,u32x16,u32x16,u32x16,u32,bool),u32,bool,bool,bool) u32 u32x256 u32 -> bool
d at p0 4
r eq d false
ret r
end
fn astkst ((u32x16,u32x16,u32x16,u32x16,u32,bool),u32,bool,bool,bool) u32 u32x256 u32 -> ((u32x16,u32x16,u32x16,u32x16,u32,bool),u32,bool,bool,bool)
it at p0 0
pos at p0 1
hsh at p0 2
ats at p0 3
ka at it 0
aa at it 1
ba at it 2
ca at it 3
cnt at it 4
e0 at it 5
ps call asskip p2 p3 pos
fin ge ps p3
c get p2 ps
iscom eq c 44
ishs eq c 35
isat eq c 64
islb eq c 91
isrb eq c 93
isex eq c 33
pp1 or islb isrb
pushp or pp1 isex
pk1 select isrb 5 6
pkind select islb 4 pk1
pq1 or iscom ishs
pq2 or pq1 isat
punct or pq2 pushp
isw call asoch c
we call asscop p2 p3 ps
cl call ascls p2 ps we
nm call asnum p2 ps we
pw call aspack p2 ps we
kwt call askws
kw call aslook kwt 5 pw
ispg eq kw 3
ispo eq kw 4
pgw or ispg ispo
modv select ispg 1 2
last sub cnt 1
lk get ka last
c0n gt cnt 0
lk9 eq lk 9
lasty and c0n lk9
atok and lasty pgw
nfin eq fin false
np eq punct false
wd1 and nfin np
word and wd1 isw
nw eq isw false
oth1 and nfin np
other and oth1 nw
nh eq hsh false
na eq ats false
whash and word hsh
wat1 and word nh
wat and wat1 ats
wpl1 and word nh
wplain and wpl1 na
hok at nm 0
hov at nm 1
hneg at nm 2
hlo at nm 3
hhi at nm 4
hbad1 eq hok false
hbad or hbad1 hov
eh and whash hbad
nat eq atok false
ea and wat nat
cerr at cl 4
ec and wplain cerr
ck at cl 0
cfa at cl 1
cfb at cl 2
cfc at cl 3
pushw1 select whash true wplain
pushw and word pushw1
ppun and nfin pushp
dopush0 or pushw ppun
ik1 select whash 2 ck
ik select ppun pkind ik1
ia1 select whash hneg cfa
ia select ppun 0 ia1
ib1 select whash hlo cfb
ib select ppun 0 ib1
ic1 select whash hhi cfc
ic select ppun 0 ic1
full ge cnt 16
ef and dopush0 full
nfull eq full false
dopush and dopush0 nfull
nk set ka cnt ik
na2 set aa cnt ia
nb set ba cnt ib
nc set ca cnt ic
ka2 select dopush nk ka
aa2 select dopush na2 aa
ba2 select dopush nb ba
domod and wat atok
mc set ca last modv
ca1 select dopush nc ca
ca2 select domod mc ca1
cnt1 add cnt 1
cnt2 select dopush cnt1 cnt
pend1 or hsh ats
efin and fin pend1
x1 or eh ea
x2 or ec ef
x3 or efin other
x4 or x1 x2
enew or x4 x3
e1 or e0 enew
pset and nfin ishs
h1 select pset true hsh
hclr and word hsh
h2 select hclr false h1
aset and nfin isat
a1 select aset true ats
aclr1 and word nh
aclr and aclr1 ats
a2 select aclr false a1
ps1 add ps 1
pos1 select punct ps1 ps
pos2 select word we pos1
dn or fin e1
it2 rec ka2 aa2 ba2 ca2 cnt2 e1
r rec it2 pos2 h2 a2 dn
ret r
end
# the items of [p1, p2)
fn astok u32x256 u32 u32 -> (u32x16,u32x16,u32x16,u32x16,u32,bool)
z call asz16
it0 rec z z z z 0 false
s0 rec it0 p1 false false false
s loop astkp astkst 300 s0 p0 p2
it at s 0
ret it
end
fn asshst u32 u32 u32x16 -> u32
k get p2 p1
sh mul p1 4
v shl k sh
r or p0 v
ret r
end
# the shape: the count in bits 28-31 and the kinds of the first seven items, 4 bits each
# (4294967295 for more than seven items, which no instruction takes)
fn asshape (u32x16,u32x16,u32x16,u32x16,u32,bool) -> u32
cnt at p0 4
k at p0 0
big gt cnt 7
f fold asshst 7 0 k
c28 shl cnt 28
v or f c28
r select big 4294967295 v
ret r
end
# item p3 of the items, register class p1 and number 31, inserted at p2 (cmp cmn tst neg negs)
fn asinsst (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 u32 -> (u32x16,u32x16,u32x16,u32x16,u32,bool)
ka at p0 0
aa at p0 1
ba at p0 2
ca at p0 3
cnt at p0 4
er at p0 5
ok at p2 0
oa at p2 1
ob at p2 2
oc at p2 3
before lt p1 p3
here eq p1 p3
j1 sub p1 1
src select before p1 j1
vk get ok src
va get oa src
vb get ob src
vc get oc src
k1 select here 1 vk
a1 select here p4 va
b1 select here 31 vb
c1 select here 0 vc
ka2 set ka p1 k1
aa2 set aa p1 a1
ba2 set ba p1 b1
ca2 set ca p1 c1
r rec ka2 aa2 ba2 ca2 cnt er
ret r
end
fn asins (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 u32 -> (u32x16,u32x16,u32x16,u32x16,u32,bool)
cnt at p0 4
er at p0 5
z call asz16
s0 rec z z z z cnt er
s fold asinsst 16 s0 p0 p1 p2
ka at s 0
aa at s 1
ba at s 2
ca at s 3
full ge cnt 16
c1 add cnt 1
er2 or er full
r rec ka aa ba ca c1 er2
ret r
end

# ---- item fields
fn askd (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> u32
k at p0 0
r get k p1
ret r
end
fn asfa (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> u32
k at p0 1
r get k p1
ret r
end
fn asfb (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> u32
k at p0 2
r get k p1
ret r
end
fn asfc (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> u32
k at p0 3
r get k p1
ret r
end
# item p1 is a 64-bit register: x, sp or xzr
fn asisx (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> bool
k call askd p0 p1
c call asfa p0 p1
r1 eq k 1
x eq c 1
s eq c 5
z eq c 6
o1 or x s
o2 or o1 z
r and r1 o2
ret r
end
# item p1 is a general register (not q, not v)
fn asgp (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> bool
k call askd p0 p1
c call asfa p0 p1
r1 eq k 1
nq ne c 3
nv ne c 4
o1 and nq nv
r and r1 o1
ret r
end
fn assf (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> u32
x call asisx p0 p1
r select x 1 0
ret r
end
# immediate item p1 lies in [-p2, p3]
fn asrng (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 u32 u32 -> bool
ng call asfa p0 p1
lo call asfb p0 p1
hi call asfc p0 p1
h0 eq hi 0
isn eq ng 1
lneg le lo p2
lpos le lo p3
w select isn lneg lpos
r and h0 w
ret r
end
# the low 32 bits of immediate item p1 in two's complement
fn aslow (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> u32
ng call asfa p0 p1
lo call asfb p0 p1
isn eq ng 1
m sub 0 lo
r select isn m lo
ret r
end
# immediate item p1 is zero
fn asizero (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 -> bool
lo call asfb p0 p1
hi call asfc p0 p1
z or lo hi
r eq z 0
ret r
end
# sign p0 and magnitude (p1 low, p2 high) as a 64-bit two's complement pair
fn as2c u32 u32 u32 -> (u32,u32)
isn eq p0 1
nl sub 0 p1
lz eq p1 0
nh1 xor p2 4294967295
nh2 sub 0 p2
nh select lz nh2 nh1
lo select isn nl p1
hi select isn nh p2
r rec lo hi
ret r
end
# an encoded instruction: (word, error, relocation 0 none 1 page21 2 pageoff12, its item,
# branch 0 none 1 b26 2 b19, its target item)
fn asenc0 u32 bool -> (u32,bool,u32,u32,u32,u32)
r rec p0 p1 0 0 0 0
ret r
end

# ---- bitmask immediates (src/arm64enc.ts logicalImmediate)
fn aspcst u32 u32 u32 -> u32
b shr p2 p1
o and b 1
r add p0 o
ret r
end
fn aspop u32 -> u32
r fold aspcst 32 0 p0
ret r
end
# the element size of a 32-bit value: the smallest power of two (at least 2) it repeats at
fn asesize u32 -> u32
a1 and p0 65535
a2 shr p0 16
h16 eq a1 a2
b1 and p0 255
b3 shr p0 8
b2 and b3 255
h8 eq b1 b2
c1 and p0 15
c3 shr p0 4
c2 and c3 15
h4 eq c1 c2
d1 and p0 3
d3 shr p0 2
d2 and d3 3
h2 eq d1 d2
s4 select h2 2 4
s8 select h4 s4 8
s16 select h8 s8 16
r select h16 s16 32
ret r
end
# rotation search of element p2 of size p3 (mask p4): state (found, rotation)
fn asrot32 (bool,u32) u32 u32 u32 u32 -> (bool,u32)
fd at p0 0
inr lt p1 p3
a shr p2 p1
sh sub p3 p1
b shl p2 sh
o or a b
rr and o p4
r1 add rr 1
x and r1 rr
run eq x 0
nf eq fd false
h1 and inr run
hit and h1 nf
fd2 or fd hit
o0 at p0 1
rot select hit p1 o0
r rec fd2 rot
ret r
end
# the fields (immr << 6 | imms) of a 32-bit pattern p0 of element size p1, and whether it is one
fn asli32 u32 u32 -> (u32,bool)
s32 eq p1 32
one shl 1 p1
m1 sub one 1
sm select s32 4294967295 m1
elt and p0 sm
st0 rec false 0
f fold asrot32 32 st0 elt p1 sm
ok at f 0
rot at f 1
cnt call aspop elt
d sub p1 rot
immr rem d p1
s2 mul p1 2
s21 sub s2 1
ns xor s21 4294967295
nm and ns 63
c1 sub cnt 1
imms or nm c1
i6 shl immr 6
fld or i6 imms
r rec fld ok
ret r
end
fn asror64 u32 u32 u32 -> (u32,u32)
big ge p2 32
a select big p1 p0
b select big p0 p1
rr and p2 31
z eq rr 0
inv sub 32 rr
a1 shr a rr
b1 shl b inv
nlo1 or a1 b1
b2 shr b rr
a2 shl a inv
nhi1 or b2 a2
nlo select z a nlo1
nhi select z b nhi1
r rec nlo nhi
ret r
end
fn asrot64 (bool,u32) u32 u32 u32 -> (bool,u32)
fd at p0 0
v call asror64 p2 p3 p1
lo at v 0
hi at v 1
h0 eq hi 0
l1 add lo 1
lx and l1 lo
lrun eq lx 0
lf eq lo 4294967295
h1 add hi 1
hx and h1 hi
hrun eq hx 0
hr and lf hrun
run select h0 lrun hr
nf eq fd false
hit and run nf
fd2 or fd hit
o0 at p0 1
rot select hit p1 o0
r rec fd2 rot
ret r
end
# the fields (N << 12 | immr << 6 | imms) of the 64-bit pattern (p0, p1) when it does not repeat
fn asli64 u32 u32 -> (u32,bool)
st0 rec false 0
f fold asrot64 64 st0 p0 p1
ok at f 0
rot at f 1
cl call aspop p0
ch call aspop p1
cnt add cl ch
d sub 64 rot
immr and d 63
c1 sub cnt 1
i6 shl immr 6
f1 or i6 c1
fld or f1 4096
r rec fld ok
ret r
end
# the bitmask-immediate fields of (p1 low, p2 high) for a 64-bit (p0) or 32-bit register
fn asli bool u32 u32 -> (u32,bool)
hi select p0 p2 0
z or p1 hi
zero eq z 0
lf eq p1 4294967295
hf eq hi 4294967295
w64ones and lf hf
ones select p0 w64ones lf
diff ne p1 hi
long and p0 diff
sz call asesize p1
s call asli32 p1 sz
l call asli64 p1 hi
fs at s 0
oks at s 1
fl at l 0
okl at l 1
fld select long fl fs
ok1 select long okl oks
nz eq zero false
no eq ones false
ok2 and nz no
ok and ok1 ok2
r rec fld ok
ret r
end

# ---- encoders: the items p0, the mnemonic index p1, the shape p2
# ldr str ldrb strb (0-3)
fn asldst (u32x16,u32x16,u32x16,u32x16,u32,bool) u32 u32 -> (u32,bool,u32,u32,u32,u32)
ld0 eq p1 0
ld2 eq p1 2
load or ld0 ld2
