fn sb_function_found(s:(u32x128,u32x128,u32x128,io),i:u32,function:u32) -> (u32x128,u32x128,u32x128,io)
 let b=s#2
 let row=av_load(s#3,sb_vec(s#1,62),b[112]*5,5)
 let a=sb_runtime((s#0,s#1,b,row#2),row#0)
 return sb_type_function(a,function,row#1)
end
fn arena_spec_types(t:io,checked:u32x128,function:u32) -> (u32,u32x128,u32x128,io)
 let z=arena_zero()
 let b=set(z,0,checked[0])
 let b=set(b,3,function)
 let b=set(b,93,1)
 let present=checked[60]==128
 let loaded=av_load(t,sb_vec(checked,59),0,present?128:0)
 let syntax=loaded#1
 let a=sb_runtime((checked,syntax,b,loaded#2),present?loaded#0:0)
 let b=a#2
 let valid=(checked[96]==1)&((!present)|(syntax[92]==1))
 let a=sb_runtime(a,valid?0:3)
 let found=sb_find(a,function)
 let b=found#2
 let result=fold(sb_function_found,(b[0]==0)&(b[112]!=4294967295)?1:0,found,function)
 let b=result#2
 return (b[0],result#0,b,result#3)
end
