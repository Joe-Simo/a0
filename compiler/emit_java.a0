s_2 fold jvfunction q3 s_1 p2 p3 p4 p5 p6 p7 p8 p9 p12
q4 ne p15 0
q5 select q4 1 0
s_3 fold jvlit97 q5 s_2
ret s_3
end
fn jvsizecheck u32x384x65 u32x128x65 u32 -> u32
