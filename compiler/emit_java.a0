fn jvnamebad u32 u32 u32x128x400 u32x128x16 u32 -> u32
f add p4 p1
q0 call jvnamepart0 p2 p3 f
q1 or p0 q0
q2 call jvnamepart1 p2 p3 f
q3 or q1 q2
q4 call jvnamepart2 p2 p3 f
q5 or q3 q4
ret q5
end
fn jvnames u32x128x400 u32x128x16 u32 u32 -> u32
q0 sub p3 p2
q1 fold jvnamebad q0 0 p0 p1 p2
ret q1
end
