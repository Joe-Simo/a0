fn jvunit io u32x512x64 u32 u32x128x8 u32 bool bool -> (io,u32,u32x128x8,u32)
lx call lexsrc p1 p2
toks at lx 0
nw at lx 1
ntok div nw 3
s1 call pass1 p1 toks ntok
sinfo at s1 1
ta at s1 2
tv at s1 3
hdrs at s1 5
nsym at s1 7
umode at s1 10
uerr at s1 11
uetok at s1 12
nhdr at s1 15
uopen ne umode 0
uerr0 eq uerr 0
ueof and uerr0 uopen
e1 select ueof 1 uerr
et1 select ueof ntok uetok
s2 call pass2 p1 sinfo nsym
pool at s2 0
s3 call pass3 p1 toks ta hdrs nhdr e1 et1 ntok
types at s3 0
tlist at s3 2
hout at s3 4
ntypes at s3 5
ntlist at s3 6
e3 at s3 11
et3 at s3 12
nhc at s3 18
nhn at s3 19
s4 call pass4 hout nhn nhc
fns0 at s4 0
names at s4 1
derr at s4 2
dtok at s4 3
dup ne derr 0
e4 select dup derr e3
et4 select dup dtok et3
s5 call pass5 fns0 names p1 toks ta tv ntok e4 et4 0
fns at s5 0
nodes at s5 1
alo at s5 2
narg at s5 5
args call bodyargs alo narg fns0 names p1 toks ta tv ntok e4 et4
fcs at s1 7
fcu at s1 8
fcp at s2 1
fch at s3 19
fct at s3 5
fcl at s3 6
fcn at s5 4
ovr call fecap toks ntok fcs fcp fcu fch fct fcl fcn narg
pcode0 at s5 8
pcode select ovr 4 pcode0
# after a parse error the function count may be below p4: nothing is checked then
cfrom call cumin p4 nhc
ck call checkir types tlist fns nodes args p3 ntypes ntlist nhc cfrom
types2 at ck 0
tlist2 at ck 2
ntys at ck 4
fstat at ck 7
ntypes2 at ck 8
cerr at ck 10
ns127 add nsym 127
nsp shr ns127 7
z64 call z64
st0 rec z64 0
st fold cstpg nsp st0 sinfo
starts at st 0
z16 call z16
fnm fold cfnm nhc z16 fns sinfo starts
grew ne ntypes2 ntypes
added and grew p5
pok eq pcode 0
c1 select added 5 0
cok eq cerr 0
c2 select cok c1 cerr
code0 select pok c2 pcode
# Java supports all total checked operations; strict metadata/runtime remains refused.
# Strict programs remain explicitly refused until their trap runtime is implemented.
prof at s1 16
unsup eq prof 1
ok0 eq code0 0
ref and ok0 unsup
code1 select ref 2 code0
badnames call jvnames pool fnm p4 nhc
badname ne badnames 0
good0 eq code1 0
badn and badname good0
code2 select badn 2 code1
wide call jvsizecheck types2 tlist2 ntypes2
haswide ne wide 0
good eq code2 0
cap and haswide good
code select cap 4 code2
ok eq code 0
go select ok 1 0
hw select p6 1 0
tfrom select p6 3 ntypes2
t fold jvemit go p0 types2 tlist2 fns nodes args ntys pool fnm ntypes2 tfrom p4 nhc hw 1
r rec t code fstat nhc
ret r
end

# Whole-source entry: canonical+checked; error1 parse,2 structure/profile,3 type,4 capacity.
fn source_packet_javast (io,u32) u32 u32x512x64 u32 -> (io,u32)
t at p0 0
z call z8
out call jvunit t p2 p3 z 0 false true
io at out 0
code at out 1
r rec io code
ret r
end
fn emitjavaio io -> u32
rs call source_packet_readio p0
src at rs 0
n at rs 1
t at rs 2
within le n 131072
complete at rs 3
ok and within complete
go select ok 1 0
inside select complete 0 2
code select within inside 4
st rec t code
out fold source_packet_javast go st src n
result at out 1
ret result
end
