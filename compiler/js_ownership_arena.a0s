 let ready=(get(c#2,0)&2147483648)!=0
 let required=((n[0]==20)|(n[0]==21))&record
 let q=c#0
 return (set(q,93,(q[93]!=0)&(!required|ready)?1:0),c#1,c#2,c#3)
