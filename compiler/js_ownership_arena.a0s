fn jos_finish_fn(s:(u32x128,u32x16,u32x128,io)) -> (u32x128,u32x16,u32x128,io)
 let m=s#0
 let last=m[66]==0?0:m[65]+m[66]-1
 let a=jos_node(s,last)
 let op=get(a#2,0)
 let b=jos_plan(a,last,2)
 let deep=(get(b#2,0)&2)!=0
 let c=jos_fnflag(b,m[64])
 let flags=get(c#2,0)
 let d=jos_same_flat(c,m[74],m[68])
 let same=get(d#2,0)!=0
 let capable=((flags&1)!=0)&((m[75]&2)!=0)&(op==23)&(m[69]==1)&(m[70]==last)&deep&same
 let start=jos_answer(d,true)
 let e=fold(jos_p0_whole,m[67]!=0?1:0,start)
 let whole=get(e#2,0)!=0
 let f=jos_put(e,9,m[64],flags|2147483648|(capable?2:0)|(capable&!whole?4:0))
 let q=f#0
 let q=set(q,61,q[61]-1)
 let q=set(q,62,q[62]+1)
 return (q,f#1,f#2,f#3)
end
fn jos_process_fn(s:(u32x128,u32x16,u32x128,io),unused:u32,id:u32) -> (u32x128,u32x16,u32x128,io)
 let a=jos_fn(s,id)
 let funrow=a#2
 let b=jos_raw(a,get(a#1,1),funrow[3],funrow[2]==0?0:1)
 let firsttype=get(b#2,0)
 let c=jos_typeflag(b,firsttype)
 let shape=get(c#2,0)
 let m=set(c#0,64,id)
 let m=set(m,65,funrow[5])
 let m=set(m,66,funrow[6])
 let m=set(m,67,funrow[2])
 let m=set(m,68,funrow[4])
 let m=set(m,69,funrow[7])
 let m=set(m,70,funrow[8])
 let m=set(m,73,funrow[3])
 let m=set(m,74,firsttype)
 let m=set(m,75,shape)
 let valid=(funrow[2]<=4294967295-funrow[6])&((funrow[6]+funrow[2])<=536870911)
 let d=jos_code((m,c#1,c#2,c#3),valid?0:7)
 let e=jos_alloc(d,15,valid?(funrow[6]+funrow[2])*8:0)
 let f=loop(jos_ok,jos_use_node,funrow[6],e)
 let g=fold(jos_return_use,(funrow[7]==1)|(funrow[7]==2)?1:0,f)
 let h=loop(jos_ok,jos_borrow_node,funrow[6],g)
 let k=loop(jos_ok,jos_proj_node,funrow[6],h)
 let l=loop(jos_ok,jos_mode,3,k)
 return jos_finish_fn(l)
end
