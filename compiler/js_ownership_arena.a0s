 let m=set(z,1,1093683791)
 let m=set(m,2,1)
 let m=set(m,61,ctx[11])
 let s=(m,ctx,z,t)
 let a=jos_alloc(s,6,ctx[12])
 let b=jos_alloc(a,9,ctx[11])
 let valid=ctx[13]<=1431655765
 let c=jos_code(b,valid?0:7)
 let d=jos_alloc(c,12,valid?ctx[13]*3:0)
 let e=loop(jos_ok,jos_type_entry,ctx[12],d)
 let f=loop(jos_ok,jos_fn_seed,ctx[11],e)
 let g=loop(jos_round_more,jos_round,ctx[11],f)
 let result=g#0
 let public=result[0]==0?result:jos_public_directory(result)
 return (result[0],public,g#3)
end
fn js_ownership_context(t:io,ctx:u32x16) -> (u32,u32x16,u32x128,io)
