fn jos_same_flat(s:(u32x128,u32x16,u32x128,io),left:u32,right:u32) -> (u32x128,u32x16,u32x128,io)
 let a=jos_type(s,left)
 let l=a#2
 let b=jos_type(a,right)
 let r=b#2
 let initial=(left==right)|((l[0]==5)&(r[0]==5)&(l[2]==r[2]))
 let m=set(b#0,94,l[1])
 let m=set(m,95,r[1])
 let m=set(m,96,initial?1:0)
 let count=(left!=right)&initial?l[2]:0
 let c=loop(jos_ok,jos_shape_child,count,(m,b#1,b#2,b#3))
 return jos_answer(c,get(c#0,96)!=0)
end
fn jos_p0_whole(s:(u32x128,u32x16,u32x128,io),i:u32) -> (u32x128,u32x16,u32x128,io)
