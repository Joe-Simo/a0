# A0 sources are the language; the compiler is written in TypeScript for now.
*.a0 linguist-language=Text linguist-detectable=true
# results/*.json: measurements are merged by tools/dev/merge-results.ts (never drops a load-gated run
# for an ungated one); the gate-regenerated pass/fail files keep the current side and are regenerated
# by the gate. `a0-dev setup` configures both drivers in a clone.
results/*.json merge=a0-measurements
results/verification.json merge=a0-results
results/equivalence.json merge=a0-results
results/hardware.json merge=a0-results
results/behavior.json merge=a0-results
results/selfhost.json merge=a0-results
results/selfhost-c.json merge=a0-results
results/bootstrap.json merge=a0-results
results/bootstrap-arm64.json merge=a0-results
results/bootstrap-macho.json merge=a0-results
results/app.json merge=a0-results
results/dotnet.json merge=a0-results
results/gpu.json merge=a0-results
