hi le p0 57
r and lo hi
ret r
end
fn isword u32 -> bool
a call isalpha p0
d call isdigit p0
r or a d
ret r
end
fn isspace u32 -> bool
sp eq p0 32
tb eq p0 9
cr eq p0 13
a or sp tb
r or a cr
ret r
end
