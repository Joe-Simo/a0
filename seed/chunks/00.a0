k3 eq p0 3
k6 eq p0 6
k8 eq p0 8
k5 eq p0 5
k7 eq p0 7
k9 eq p0 9
inw or k1 k2
notw select isw false true
wclose and inw notw
escd eq p4 1
notesc select escd false true
sq and k3 isq
sclose and sq notesc
cclose and k8 isnl
s57 or k5 k7
single or s57 k9
arrow and k6 isgt
