cl get p2 ql
ch get p3 ql
c select isl cl ch
isbs eq c 92
e1 eq esc 1
isn eq c 110
ist eq c 116
m0 select isn 10 c
m1 select ist 9 m0
v select e1 m1 c
skip select e1 false isbs
pr add p5 k
pin lt pr 16384
put select skip false pin
wr sub pr p6
f mul wr 2
h0 shr f 7
l0 and f 127
g0 get w h0
o0 get g0 l0
v0 select put 3 o0
g0b set g0 l0 v0
w1 set w h0 g0b
f1 add f 1
h1 shr f1 7
l1 and f1 127
g1 get w1 h1
o1 get g1 l1
v1 select put v o1
g1b set g1 l1 v1
w2 set w1 h1 g1b
k1 add k 1
kn select skip k k1
esc1 select isbs 1 0
esc2 select e1 0 esc1
r rec w2 kn esc2
ret r
end
fn txtseg (u32x128x256,u32,u32) u32 u32x512x64 u32 u32 u32 -> (u32x128x256,u32,u32)
args at p0 0
na at p0 1
esc at p0 2
kb mul p1 64
rest sub p4 kb
big gt rest 64
cnt select big 64 rest
sp add p3 kb
sh shr sp 7
so and sp 127
slo call srcpg p2 sh
sh1 add sh 1
shi call srcpg p2 sh1
rna sub na p5
before lt na p5
wr0 select before 0 rna
a2 mul wr0 2
wh0 shr a2 7
past gt wh0 254
wh select past 254 wh0
wp mul wh 64
wh1 add wh 1
w0 get args wh
w1 get args wh1
win arr w0 w1
s0 rec win 0 esc
s fold txtb cnt s0 slo shi so rna wp
w at s 0
pairs at s 1
esc2 at s 2
v0 get w 0
v1 get w 1
args1 set args wh v0
args2 set args1 wh1 v1
na2 add na pairs
r rec args2 na2 esc2
ret r
end
