fn checked_transport io -> u32
a read p0
status at a 0
t0 at a 1
b read t0
count at b 0
t1 at b 1
c read t1
value at c 0
t2 at c 1
checked cadd value 1
wrapped at checked 0
ok at checked 1
badok select ok 1 0
badcount ne count 1
badcountword select badcount 1 0
out0 or wrapped badok
out1 or out0 badcountword
out or out1 status
w0 write t2 5
w1 write w0 1
w2 write w1 7
d read w2
t3 at d 1
e read t3
ret out
end
fn arena_pattern u32x128 u32 -> u32x128
x mul p1 2654435761
v xor x 4294967295
r set p0 p1 v
ret r
end
