profile strict
fn divide u32 u32 -> u32
r div p0 p1
ret r
end
fn bound u32 -> u32
a arr 11 22 33
r get a p0
ret r
end
fn stp u32 u32 -> u32
den sub p1 2
r div p0 den
ret r
end
fn folded u32 -> u32
iteration fold stp 4 p0
ret iteration
end
fn pred u32 u32 -> bool
a arr 1 2
v get a p1
r ne v 0
ret r
end
fn step u32 u32 -> u32
ret p0
end
fn looped u32 -> u32
original_loop loop pred step 10 p0
ret original_loop
end
