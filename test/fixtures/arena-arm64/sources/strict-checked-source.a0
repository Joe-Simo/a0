fn tuple_flow_v u32 u32 -> u32
a cadd p0 p1
b cmul p0 p1
ok at a 1
selected select ok a b
c put selected 0 77
old at selected 0
fresh at c 0
tail at a 0
t xor old fresh
out xor t tail
ret out
end
fn tuple_flow_ok u32 u32 -> bool
a csub p0 p1
b cdiv p0 p1
cond at a 1
selected select cond a b
c put selected 1 true
old at selected 1
fresh at c 1
out xor old fresh
ret out
end
