{
  "name": "a0",
  "version": "0.8.16",
  "private": true,
  "description": "A0: the programming language built for AI, not for people",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental --tsBuildInfoFile dist/.tsbuildinfo",
    "lint": "biome check . && bun tools/dev/claim-check.ts --since=origin/main && bun tools/loss-ledger.ts && bun tools/scrub-results.ts --check && bun tools/sync-skill.ts --check",
    "scrub-results": "bun tools/scrub-results.ts",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test dist/test/*.test.js",
    "verify": "bun run build && node dist/tools/verify.js",
    "bench": "bun run build && node dist/tools/bench.js",
    "tokens": "bun run build && node dist/tools/token-bench.js",
    "hw": "bun run build && node dist/tools/hw-verify.js",
    "equiv": "bun run build && node dist/tools/equiv-verify.js",
    "spec-tokens": "bun run build && node dist/tools/spec-tokens.js",
    "spec-lines": "bun run build && node dist/tools/spec-lines-summary.js",
    "primer-ablation": "bun run build && node dist/tools/primer-ablation-summary.js",
    "shipped-accounting": "bun run build && node dist/tools/shipped-accounting.js",
    "shipped-summary": "bun run build && node dist/tools/shipped-summary.js",
    "experiment": "bun run build && node dist/tools/ai-edit-experiment.js",
    "exec-bench": "bun run build && node dist/tools/exec-bench.js",
    "wasm-bench": "bun run build && node dist/tools/wasm-bench.js",
    "edit-loop-bench": "bun run build && node dist/tools/edit-loop-bench.js",
    "par-bench": "bun run build && node dist/tools/par-bench.js",
    "lang-axes": "bun run build && node dist/tools/lang-axes.js",
    "behavior": "bun run build && node dist/tools/behavior.js",
    "loss-ledger": "bun run build && node dist/tools/loss-ledger.js",
    "native-check": "bun run build && node dist/tools/native-check.js",
    "app": "bun run build && node dist/tools/app.js",
    "selfhost": "bun run build && node dist/tools/selfhost-verify.js",
    "selfhost:c": "bun run build && node dist/tools/selfhost-c.js",
    "selfhost:wasm": "bun run build && node dist/tools/selfhost-wasm.js",
    "bootstrap": "bun run build && node dist/tools/bootstrap.js && node dist/tools/bootstrap-arm64.js && node dist/tools/bootstrap-macho.js",
    "seed": "bun run build && node dist/tools/seed.js",
    "bootstrap:arm64": "bun run build && node dist/tools/bootstrap-arm64.js",
    "bootstrap:macho": "bun run build && node dist/tools/bootstrap-macho.js",
    "site": "bun run build && node dist/tools/site-build.js",
    "gpu": "bun run build && node dist/tools/gpu-verify.js",
    "dotnet": "bun run build && node dist/tools/dotnet-verify.js",
    "release": "sh tools/release.sh",
    "sync-skill": "bun tools/sync-skill.ts",
    "claims": "bun tools/dev/claim-check.ts",
    "a0-dev": "bun run build && node dist/tools/dev/a0-dev.js",
    "gate-scope": "bun run build && node dist/tools/dev/gate-scope.js",
    "merge-plan": "bun run build && node dist/tools/dev/merge-plan.js",
    "dev-gate": "bun run build && node dist/tools/dev/dev-gate.js",
    "drive": "bun run build && node dist/tools/dev/drive.js",
    "mcpb": "bun run build && node dist/tools/mcpb.js",
    "setup:merge": "bun run build && node dist/tools/dev/a0-dev.js setup"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@anthropic-ai/sdk": "^0.129.0",
    "@biomejs/biome": "^2.2.4",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^24.5.2",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "js-tiktoken": "^1.0.20",
    "tree-sitter-cli": "^0.27.0",
    "typescript": "^5.9.2",
    "vscode-jsonrpc": "^9.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "web-tree-sitter": "^0.27.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@noble/hashes": "^2.4.0",
    "geist": "^1.7.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "z3-solver": "^5.2.0",
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "trustedDependencies": [
    "tree-sitter-cli"
  ]
}
