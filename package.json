{
  "name": "a0",
  "version": "0.1.0",
  "private": true,
  "description": "A0: the programming language built for AI, not for people",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test dist/test/*.test.js",
    "verify": "bun run build && node dist/tools/verify.js",
    "bench": "bun run build && node dist/tools/bench.js",
    "tokens": "bun run build && node dist/tools/token-bench.js",
    "hw": "bun run build && node dist/tools/hw-verify.js",
    "equiv": "bun run build && node dist/tools/equiv-verify.js",
    "experiment": "bun run build && node dist/tools/ai-edit-experiment.js",
    "exec-bench": "bun run build && node dist/tools/exec-bench.js",
    "edit-loop-bench": "bun run build && node dist/tools/edit-loop-bench.js",
    "par-bench": "bun run build && node dist/tools/par-bench.js",
    "app": "bun run build && node dist/tools/app.js",
    "selfhost": "bun run build && node dist/tools/selfhost-verify.js",
    "selfhost:c": "bun run build && node dist/tools/selfhost-c.js",
    "bootstrap": "bun run build && node dist/tools/bootstrap.js && node dist/tools/bootstrap-arm64.js",
    "bootstrap:arm64": "bun run build && node dist/tools/bootstrap-arm64.js",
    "site": "bun run build && node dist/tools/site-build.js",
    "gpu": "bun run build && node dist/tools/gpu-verify.js",
    "dotnet": "bun run build && node dist/tools/dotnet-verify.js",
    "release": "sh tools/release.sh"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.5.2",
    "js-tiktoken": "^1.0.20",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@noble/hashes": "^2.4.0",
    "geist": "^1.7.2",
    "z3-solver": "^5.2.0",
    "zod": "^4.6.5"
  },
  "license": "MIT"
}
