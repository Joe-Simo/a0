{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]"
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "[",
      "]"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*fn\\b",
      "end": "^\\s*end\\b"
    }
  },
  "wordPattern": "[A-Z]|(?:_|[a-z])[a-z0-9_]*|[0-9]+",
  "indentationRules": {
    "increaseIndentPattern": "^$never",
    "decreaseIndentPattern": "^$never"
  }
}
