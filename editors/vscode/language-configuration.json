{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": { "start": "^\\s*fn\\b", "end": "^\\s*end\\b" }
  },
  "wordPattern": "[a-z][a-z0-9_]*|p[0-9]+|[0-9]+",
  "indentationRules": {
    "increaseIndentPattern": "^$never",
    "decreaseIndentPattern": "^$never"
  }
}
