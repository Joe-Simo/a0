# Site generator, module 11: phase D, the template interpreter. It runs the template twice: pass 1
# writes the header lines (`1...`) and the section functions (`{name` ... `}`), pass 2 the session
# lines (`2...`) and every line outside a section. Output lines of A0 are `x<k> OP ...` with k
# counted over the whole template, so both passes number identically.
# Template lines (first byte): `#` comment, `f` input file, `m` map entry, `1TEXT`/`2TEXT` a raw
# line of pass 1/2, `<TAG` open, `.TAG CLASS` open with a class, `=TAG TEXT` a whole element,
# `+KEY VALUE` attribute, `>` close, `"TEXT` text, `w WORD` a protocol word, `c FN ARGS` call,
# `n R EXPR` a node named by register R (a-z, `%R` in later arguments), `s WORD ROLE [LO [HI]]` the text
# file ROLE in chunks of at most 1000 bytes after protocol word WORD (only the chunks that start at
# a byte offset in [LO, HI) of the file, so a long file can be spread over several section functions), `l ROLE` its lines as texts,
# `{NAME` / `}` a section function, `[VAR` / `]` a loop VAR times, or `[VAR FLAG` only over the rows
# whose variable FLAG (read at the row index) is not empty (loops nest twice; variables
# are read with the indices of the enclosing loops). In TEXT, VALUE, ARGS, EXPR and NAME:
# `$var$` a variable (`$k$` the last node number), `{var|A|B}` A when var is not empty else B,
# `\n` newline, `\s` space, `\x` the byte x. An empty text or attribute is not written.
# The state S: 0 io, 1 k, 2 cur (0 tok, 1 p0, n + 2 node n), 3 in a section, 4 no line written yet
# in this function, 5, 6 cur and 4 saved at a section, 7 sections written, 8, 9 the section's name,
# 10 k at the section, 11 registers, 12 template position, 13 loop stack (4 words a level: body,
# count, index, hash of the row filter or 0), 14 loop depth, 15 pass.
use "sgcalc.a0"

fn son (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32) -> bool
sec at p0 2
ps at p0 14
a eq ps 1
b eq sec 1
c eq ps 2
d eq sec 0
x and a b
y and c d
r or x y
ret r
end
fn putw io bool u32x128x512 u32 -> io
s call wstart p2 p3
l call wlen p2 p3
r call cpst p0 p1 false p2 s l
ret r
end
fn putw1 io u32 bool u32x128x512 u32 -> io
r call putw p0 p2 p3 p4
ret r
end
fn putx1 io u32 bool u32 -> io
a call putc p0 p2 120
r call putd a p2 p3
ret r
end
fn putcur io bool u32x128x512 u32 -> io
t eq p3 0
q eq p3 1
x gt p3 1
ct select t 1 0
cq select q 1 0
cx select x 1 0
a fold putw1 ct p0 p1 p2 216
b fold putw1 cq a p1 p2 217
n sub p3 2
c fold putx1 cx b p1 n
ret c
end
# a new output line: the separator, then `x<k + 1>`; k := k + 1
fn nline (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
t at p0 0
p0r at p0 1
k at p0r 0
f at p0r 3
on call son p0r
nf eq f 0
sep and on nf
t1 call putc t sep 10
k1 add k 1
t2 call putc t1 on 120
t3 call putd t2 on k1
s1 rec t3 p0r
s1t at s1 0
s2r put p0r 0 k1
s2 rec s1t s2r
s2t at s2 0
s3r put s2r 3 0
s3 rec s2t s3r
ret s3
end
# `x<k> write <cur> ` (the word follows); cur := k
fn wpre (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
s1 call nline p0 p1
t at s1 0
s1r at s1 1
on call son s1r
cur at s1r 1
t1 call putw t on p1 212
t2 call putcur t1 on p1 cur
t3 call putc t2 on 32
k at s1r 0
k2 add k 2
s2 rec t3 s1r
s2t at s2 0
s3r put s1r 1 k2
s3 rec s2t s3r
ret s3
end
fn wnum (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
s1 call wpre p0 p1
t at s1 0
s1r at s1 1
on call son s1r
t1 call putd t on p2
r rec t1 s1r
ret r
end
# `x<k> call FN <cur> ` with FN the store range [p2, p2 + p3); cur := k
fn cpre (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
s1 call nline p0 p1
t at s1 0
s1r at s1 1
on call son s1r
cur at s1r 1
t1 call putw t on p1 213
t2 call cpst t1 on false p1 p2 p3
t3 call putc t2 on 32
t4 call putcur t3 on p1 cur
t5 call putc t4 on 32
k at s1r 0
k2 add k 2
s2 rec t5 s1r
s2t at s2 0
s3r put s1r 1 k2
s3 rec s2t s3r
ret s3
end
fn cwrd (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
s call wstart p1 p2
l call wlen p1 p2
r call cpre p0 p1 s l
ret r
end

# ---- expansion of template text: state (io, bytes, position)
fn vfmore u32 u32 u32x128x128 u32 u32 u32 u32 -> bool
lt0 lt p0 p3
e0 shl p0 2
e add e0 352
h call rd128 p2 e
e1 add e 1
ky call rd128 p2 e1
d shr ky 28
i0 shr ky 14
i and i0 16383
j and ky 16383
he eq h p4
d0 eq d 0
d1 eq d 1
d2 eq d 2
ie eq i p5
je eq j p6
a1 and d1 ie
a2a and d2 ie
a2 and a2a je
m0 or d0 a1
m1 or m0 a2
m and he m1
nm select m false true
r and lt0 nm
ret r
end
fn vfstep u32 u32 u32x128x128 u32 u32 u32 u32 -> u32
r add p0 1
ret r
end
# the variable with name hash p1 at loop indices p2, p3: its entry, or the count when missing
fn vfind u32x128x128 u32 u32 u32 -> u32
n call rd128 p0 1
r loop vfmore vfstep n 0 p0 n p1 p2 p3
ret r
end
fn ventry u32x128x128 u32 u32 -> u32
e0 shl p1 2
e add e0 352
f add e p2
r call rd128 p0 f
ret r
end
# the ref of a variable (0 when missing)
fn vget u32x128x128 u32 u32 u32 -> u32
e call vfind p0 p1 p2 p3
n call rd128 p0 1
has lt e n
r0 call ventry p0 e 2
r select has r0 0
ret r
end
fn vcount u32x128x128 u32 u32 u32 -> u32
e call vfind p0 p1 p2 p3
n call rd128 p0 1
has lt e n
r0 call ventry p0 e 3
r select has r0 0
ret r
end
# write the byte p2 when p1 (escaped when p3) and count it: state (io, bytes, position)
fn xout (io,u32,u32) bool bool u32 -> (io,u32,u32)
t at p0 0
c at p0 1
p at p0 2
t1 call putx t p1 p2 p3
c1 add c 1
r rec t1 c1 p
ret r
end
fn xoutv (io,u32,u32) u32 bool bool u32x128x128 u32 -> (io,u32,u32)
a add p5 p1
b call vb p4 a
r call xout p0 p2 p3 b
ret r
end
fn xdig (io,u32,u32) u32 bool bool u32 u32 -> (io,u32,u32)
ch call digit p1 p4 p5
r call xout p0 p2 p3 ch
ret r
end
fn xnum (io,u32,u32) bool bool u32 -> (io,u32,u32)
nd call ndig p3
r fold xdig nd p0 p1 p2 p3 nd
ret r
end
fn xout1 (io,u32,u32) u32 bool bool u32 -> (io,u32,u32)
r call xout p0 p2 p3 p4
ret r
end
fn xnum1 (io,u32,u32) u32 bool bool u32 -> (io,u32,u32)
r call xnum p0 p2 p3 p4
ret r
end
# one unit that is not a condition: `\x`, `$var$`, `%r` (when p3), or a byte
fn xunit (io,u32,u32) bool bool bool u32x128x512 u32x128x128 u32x32 u32 u32 u32 u32 -> (io,u32,u32)
pos at p0 2
c call sb p4 pos
bs eq c 92
dl eq c 36
pc0 eq c 37
pc and pc0 p3
o0 or bs dl
o1 or o0 pc
plain select o1 false true
p1a add pos 1
d call sb p4 p1a
dn eq d 110
ds eq d 115
e0 select ds 32 d
esc select dn 10 e0
cb select bs 1 0
x1 fold xout1 cb p0 p1 p2 esc
cp select plain 1 0
x2 fold xout1 cp x1 p1 p2 c
e call sfind p4 p1a p10 36
nl sub e p1a
h call shash p4 p1a nl
kw call whash p4 72
isk eq h kw
nk select isk false true
vd and dl nk
kd and dl isk
ref call vget p5 h p7 p8
rs shr ref 16
rl and ref 65535
cv select vd rl 0
x3 fold xoutv cv x2 p1 p2 p5 rs
ck select kd 1 0
x4 fold xnum1 ck x3 p1 p2 p9
r0 call sb p4 p1a
ri sub r0 97
rn get p6 ri
cr select pc 1 0
x5 fold xout1 cr x4 p1 p2 120
x6 fold xnum1 cr x5 p1 p2 rn
e1 add e 1
p2a add pos 2
p1b add pos 1
n0 select plain p1b p2a
np select dl e1 n0
t at x6 0
cc at x6 1
r rec t cc np
ret r
end
fn ximore (io,u32,u32) u32 bool bool bool u32x128x512 u32x128x128 u32x32 u32 u32 u32 u32 -> bool
p at p0 2
r lt p p11
ret r
end
fn xistep (io,u32,u32) u32 bool bool bool u32x128x512 u32x128x128 u32x32 u32 u32 u32 u32 -> (io,u32,u32)
r call xunit p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11
ret r
end
# a condition `{var|A|B}` at the position
fn xcond (io,u32,u32) u32 bool bool bool u32x128x512 u32x128x128 u32x32 u32 u32 u32 u32 -> (io,u32,u32)
pos at p0 2
t at p0 0
cc at p0 1
bar call sfind p5 pos p11 124
e call sfind p5 bar p11 125
b1 add bar 1
bar2 call sfind p5 b1 e 124
a1 add pos 1
nl sub bar a1
h call shash p5 a1 nl
ref call vget p6 h p8 p9
rl and ref 65535
ne gt rl 0
b21 add bar2 1
has2 lt bar2 e
bs select has2 b21 e
sa select ne b1 bs
se select ne bar2 e
n sub se sa
s0 rec t cc sa
x loop ximore xistep n s0 p2 p3 p4 p5 p6 p7 p8 p9 p10 se
xt at x 0
xc at x 1
e1 add e 1
r rec xt xc e1
ret r
end
fn xomore (io,u32,u32) u32 bool bool bool u32x128x512 u32x128x128 u32x32 u32 u32 u32 u32 -> bool
p at p0 2
r lt p p11
ret r
end
fn xostep (io,u32,u32) u32 bool bool bool u32x128x512 u32x128x128 u32x32 u32 u32 u32 u32 -> (io,u32,u32)
pos at p0 2
c call sb p5 pos
br eq c 123
nb select br false true
cb select br 1 0
cu select nb 1 0
x1 fold xcond cb p0 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11
x2 fold xistep cu x1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11
ret x2
end
# expand the store range [p10, p11): (io, bytes written or counted) when p1 writes, p2 escapes,
# p3 expands registers; p7, p8 the loop indices, p9 the value of $k$
fn expand io bool bool bool u32x128x512 u32x128x128 u32x32 u32 u32 u32 u32 u32 -> (io,u32,u32)
s0 rec p0 0 p10
n sub p11 p10
r loop xomore xostep n s0 p1 p2 p3 p4 p5 p6 p7 p8 p9 p11
ret r
end
fn loopij (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32) -> (u32,u32)
st at p0 12
i get st 2
j get st 6
r rec i j
ret r
end
# expand into the output of S (written when p5 and S's pass is on), returning S and the count
fn sexp (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32x128x128 u32 u32 bool bool bool -> ((io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)),u32)
p0r at p0 1
on0 call son p0r
on and on0 p5
rg at p0r 10
ij call loopij p0r
i at ij 0
j at ij 1
k at p0r 0
t at p0 0
x call expand t on p6 p7 p1 p2 rg i j k p3 p4
t2 at x 0
c at x 1
s rec t2 p0r
r rec s c
ret r
end
fn scount (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32x128x128 u32 u32 -> u32
x call sexp p0 p1 p2 p3 p4 false true false
r at x 1
ret r
end
fn sput (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32x128x128 u32 u32 bool bool -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
x call sexp p0 p1 p2 p3 p4 true p5 p6
r at x 0
ret r
end
fn sbyte (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
t at p0 0
p0r at p0 1
on call son p0r
t1 call putc t on p1
r rec t1 p0r
ret r
end
fn sword (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
t at p0 0
p0r at p0 1
on call son p0r
t1 call putw t on p1 p2
r rec t1 p0r
ret r
end
fn srange (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32 u32 bool -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
t at p0 0
p0r at p0 1
on call son p0r
t1 call cpst t on p4 p1 p2 p3
r rec t1 p0r
ret r
end
# a text literal of the expansion of [p3, p4), then `puts` it: the TEXT command's bytes
fn slit (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32x128x128 u32 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
s1 call nline p0 p1
s1r at s1 1
lit at s1r 0
s2 call sword s1 p1 214
s3 call sbyte s2 34
s4 call sput s3 p1 p2 p3 p4 true false
s5 call sbyte s4 34
s6 call nline s5 p1
s6r at s6 1
n at s6r 0
s7 call sword s6 p1 215
s7r at s7 1
cur at s7r 1
t at s7 0
on call son s7r
t1 call putcur t on p1 cur
t2 call putc t1 on 32
t3 call putc t2 on 120
t4 call putd t3 on lit
n2 add n 2
s8 rec t4 s7r
s8t at s8 0
s9r put s7r 1 n2
s9 rec s8t s9r
ret s9
end
fn dotext (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32 u32x128x512 u32x128x128 u32 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
s1 call wnum p0 p2 2
s2 call slit s1 p2 p3 p4 p5
ret s2
end
fn optext (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32x128x128 u32 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
x call sexp p0 p1 p2 p3 p4 false true false
c at x 1
sx at x 0
ne gt c 0
cn select ne 1 0
r fold dotext cn sx p1 p2 p3 p4
ret r
end
# the value of map word p3, key hash p4 in the lines [p1, p2) of the store: (start, length)
fn mrmore (u32,u32,u32) u32 u32x128x512 u32 u32 u32 -> bool
p at p0 0
r lt p p4
ret r
end
fn mval2 u32x128x512 u32 u32 -> (u32,u32)
a call fstart p0 p1 4
nl call sfind p0 a p2 10
n sub nl a
r rec a n
ret r
end
fn mrstep (u32,u32,u32) u32 u32x128x512 u32 u32 u32 -> (u32,u32,u32)
p at p0 0
fs at p0 1
fl at p0 2
m call sbis p2 p 109
nm call fhash p2 p 2
w call whash p2 p3
k call fhash p2 p 3
a eq nm w
b eq k p5
c0 and a b
c and c0 m
mv call mval2 p2 p p4
va at mv 0
vl at mv 1
fs2 select c va fs
fl2 select c vl fl
nl call sfind p2 p p4 10
np add nl 1
r rec np fs2 fl2
ret r
end
fn mrange u32x128x512 u32 u32 u32 u32 -> (u32,u32)
s0 rec p1 0 0
n sub p2 p1
r0 loop mrmore mrstep n s0 p0 p3 p2 p4
a at r0 1
l at r0 2
r rec a l
ret r
end
# the region (start, length) of the text file with role word p1
fn rgstep (u32,u32) u32 u32x128x512 u32 -> (u32,u32)
a0 shl p1 2
a add a0 8
h call rd512 p2 a
e eq h p3
a1 add a 1
a2 add a 2
s call rd512 p2 a1
l call rd512 p2 a2
s0 at p0 0
l0 at p0 1
rs select e s s0
rl select e l l0
r rec rs rl
ret r
end
fn region u32x128x512 u32 -> (u32,u32)
h call whash p0 p1
n call hd p0 6
s0 rec 0 0
r fold rgstep n s0 p0 h
ret r
end
# the protocol number of tag or attribute name [p2, p3) (map word p4) written as a word
fn tagnum (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32 u32 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
n sub p3 p2
h call shash p1 p2 n
rg call region p1 57
s at rg 0
l at rg 1
e add s l
v call mrange p1 s e p4 h
va at v 0
vl at v 1
r call srange p0 p1 va vl false
ret r
end
fn opopen (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
s1 call cwrd p0 p1 222
s2 call tagnum s1 p1 p2 p3 66
ret s2
end
fn opclose (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
r call cwrd p0 p1 223
ret r
end
# attribute [p3, p4) of value [p5, p6)
fn doattr (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32 u32x128x512 u32x128x128 u32 u32 u32 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
s1 call wnum p0 p2 4
s2 call wpre s1 p2
s3 call tagnum s2 p2 p4 p5 67
s4 call slit s3 p2 p3 p6 p7
ret s4
end
fn opattr (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32)) u32x128x512 u32x128x128 u32 u32 u32 u32 -> (io,(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32x32,u32,u32x16,u32,u32))
x call sexp p0 p1 p2 p5 p6 false true false
c at x 1
sx at x 0
ne gt c 0
cn select ne 1 0
r fold doattr cn sx p1 p2 p3 p4 p5 p6
ret r
end
