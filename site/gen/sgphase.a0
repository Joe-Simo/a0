# Site generator, module 7: phase B, the JSON files of the template's `f` lines after the text
# files, each streamed into the data table by its role (sgjson.a0).
use "sgjson.a0"

# hash of field 3 of the line at p1 (the key of an `m` line)
fn field3 u32x128x512 u32 -> u32
a add p1 2
e call fieldend p0 a
b add e 1
e2 call fieldend p0 b
n sub e2 b
r call shash p0 b n
ret r
end
# the key of `m` line p1 appended to the list at p3 (count p4) when the map is word p5 (fold body)
fn mkey u32x128x64 u32 u32x128 u32x128x512 u32 u32 u32 -> u32x128x64
pos get p2 p1
nm call field2 p3 pos
w call whash p3 p6
is eq nm w
c select is 1 0
k call field3 p3 pos
n call g p0 p5
d add p4 n
s1 fold wr64 c p0 d k
n1 add n 1
s2 fold wr64 c s1 p5 n1
ret s2
end
fn role u32x128x512 u32 -> u32
ex call whash p0 61
co call whash p0 62
eq call whash p0 63
ed call whash p0 64
pa call whash p0 65
a eq p1 ex
b eq p1 co
c eq p1 eq
d eq p1 ed
e eq p1 pa
r0 select e 4 0
r1 select d 3 r0
r2 select c 5 r1
r3 select b 2 r2
r select a 1 r3
ret r
end
# one JSON file (fold body over the remaining `f` lines; state: table, io, next cost slot)
fn pbstep (u32x128x64,io,u32) u32 u32x128 u32 u32x128x512 -> (u32x128x64,io,u32)
pa at p0 0
t at p0 1
slot at p0 2
i add p3 p1
pos get p2 i
h call field2 p4 pos
code call role p4 h
r call jfile pa t code slot p4
pa2 at r 0
t2 at r 1
isc eq code 2
s1 add slot 1
sn select isc s1 slot
o rec pa2 t2 sn
ret o
end
# phase B: the data table (after the first p2 `f` lines were read by phase A)
fn phaseb u32x128x512 io u32 -> (u32x128x64,io)
z call z64
ml call lines p0 109
l at ml 0
c at ml 1
s1 fold mkey c z l p0 8100 8108 62
s2 fold mkey c s1 l p0 8110 8119 65
fl call lines p0 102
f at fl 0
fc at fl 1
n sub fc p2
st rec s2 p1 0
r fold pbstep n st f p2 p0
pa at r 0
t at r 1
o rec pa t
ret o
end
