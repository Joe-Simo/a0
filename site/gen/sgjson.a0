sk call kis s4 3 p2 229
nsk and nm1 sk
csk select nsk 1 0
ski add sl 896
v1 call num s4 1
s5 fold wr64 csk s4 ski v1
# validation.ID.checkMedianMs, checkRunMedianMs: milliseconds x 1000, plus one
vm0 and v3 isnum
vm1 and vm0 kv
ck call kis s5 3 p2 230
cr call kis s5 3 p2 231
nck and vm1 ck
ncr and vm1 cr
cck select nck 1 0
ccr select ncr 1 0
v1000 call num s5 1000
vp add v1000 1
cki add sl 1152
cri add sl 1216
s6 fold wr64 cck s5 cki vp
s7 fold wr64 ccr s6 cri vp
# load.perRound[].loadavg[0] and cpus
