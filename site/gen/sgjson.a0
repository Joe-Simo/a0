# ---- cost: results/ai-edit-experiment.*.json, slot p (14): per representation r (the `m cost`
# lines, hashes 8100 + r, count 8108) at 6800 + 6(8p + r): trials, model calls, primer tokens,
# code tokens, write tokens, accepted; the trial being read at 7760: representation, structured,
# calls, primer, code, write, accepted.
fn celladd u32x128x64 u32 u32 -> u32x128x64
a add 7760 p1
a2 add a 1
v call rd64 p0 a2
f0 eq p1 0
vv select f0 1 v
d add p2 p1
r fold addw 1 p0 d vv
ret r
end
fn clr u32x128x64 u32 -> u32x128x64
a add 7760 p1
z0 eq p1 0
v select z0 255 0
r fold wr64 1 p0 a v
ret r
end
fn hcost u32x128x64 u32 u32x128x512 -> u32x128x64
t call g p0 15
d call g p0 16
tr call kis p0 1 p2 19
d3 eq d 3
