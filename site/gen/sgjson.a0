# ---- cost: results/ai-edit-experiment.*.json, slot p (14): per representation r (the `m cost`
# lines, hashes 8100 + r, count 8108) at 6800 + 6(8p + r): trials, model calls, primer tokens,
# code tokens, write tokens, accepted; the trial being read at 7760: representation, structured,
# calls, primer, code, write, accepted.
fn cadd u32x128x64 u32 u32 -> u32x128x64
a add 7760 p1
a2 add a 1
v call rd64 p0 a2
f0 eq p1 0
vv select f0 1 v
d add p2 p1
r fold addw 1 p0 d vv
ret r
end
fn clr u32x128x64 u32 -> u32x128x64
a add 7760 p1
z0 eq p1 0
v select z0 255 0
r fold wr64 1 p0 a v
ret r
end
fn hcost u32x128x64 u32 u32x128x512 -> u32x128x64
t call g p0 15
d call g p0 16
tr call kis p0 1 p2 19
d3 eq d 3
d4 eq d 4
op0 eq t 7
op1 and op0 d3
op and op1 tr
co select op 7 0
s1 fold clr co p0
isstr eq t 2
isnum eq t 3
istrue eq t 4
a0 and tr d3
rep call kis s1 3 p2 20
pro call kis s1 3 p2 21
acc call kis s1 3 p2 22
mc call kis s1 3 p2 23
tbl call kis s1 3 p2 24
h call g s1 4
nr call g s1 8108
ri call lookup s1 8100 nr h
b0 and a0 isstr
br and b0 rep
c1 select br 1 0
s2 fold wr64 c1 s1 7760 ri
st call hashis s2 p2 43
bp0 and b0 pro
bp and bp0 st
c2 select bp 1 0
s3 fold wr64 c2 s2 7761 1
n0 and a0 isnum
nm and n0 mc
ints call num s3 1
c3 select nm 1 0
s4 fold wr64 c3 s3 7762 ints
ba0 and a0 istrue
ba and ba0 acc
c4 select ba 1 0
s5 fold wr64 c4 s4 7766 1
e0 and tr d4
e1 and e0 isnum
e2 call kis s5 3 p2 24
e3 and e1 e2
lp call kis s5 4 p2 25
wp call kis s5 4 p2 26
tc call kis s5 4 p2 27
ou call kis s5 4 p2 28
pp or lp wp
x1 and e3 pp
c5 select x1 1 0
s6 fold addw c5 s5 7763 ints
x2 and e3 tc
c6 select x2 1 0
s7 fold addw c6 s6 7764 ints
x3 and e3 ou
c7 select x3 1 0
s8 fold addw c7 s7 7765 ints
# the end of a trial: add it to its representation when structured
cl0 eq t 9
cl1 and cl0 d3
cl and cl1 tr
r0 call g s8 7760
sr call g s8 7761
okr lt r0 nr
oks eq sr 1
ok0 and okr oks
ok and ok0 cl
cc select ok 6 0
slot call g s8 14
sl8 shl slot 3
slr add sl8 r0
sl6 mul slr 6
base add sl6 6800
s9 fold cadd cc s8 base
ret s9
end

