kb shl nk 3
kn add kb 256
knl add nk 384
s1 call savecap p0 nkx kn knl
nk1 add nk 1
c1 select nkx 1 0
s2 fold wr64 c1 s1 128 nk1
lh call g s2 4
lslot add nl 656
c2 select nlx 1 0
s3 fold wr64 c2 s2 lslot lh
nl1 add nl 1
s4 fold wr64 c2 s3 129 nl1
# kernels.K.LID.medianNsPerCall / status
lid call key s4 3
li call lookup s4 656 nl lid
found lt li nl
