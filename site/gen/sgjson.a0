# ---- tokfx: results/tokens.json, into the axes table: the o200k tokens of each fixture and view.
# 1450 their number, name hash of the i-th at 1456 + i, its tokens at 1488 + i (up to 32).
fn htok u32x128x64 u32 u32x128x512 -> u32x128x64
t call g p0 15
d call g p0 16
iskey eq t 1
isnum eq t 3
d2 eq d 2
d4 eq d 4
kf call kis p0 1 p2 300
kv call kis p0 1 p2 301
k1 or kf kv
x0 and iskey d2
x1 and x0 k1
c1 select x1 1 0
n call g p0 1450
nh call key p0 2
slot add n 1456
s1 fold wr64 c1 p0 slot nh
n1 add n 1
s2 fold wr64 c1 s1 1450 n1
kt call kis s2 3 p2 227
ko call kis s2 4 p2 302
y0 and isnum d4
y1 and y0 k1
y2 and y1 kt
y and y2 ko
cy select y 1 0
n2 call g s2 1450
last sub n2 1
vslot add last 1488
v call num s2 1
s3 fold wr64 cy s2 vslot v
ret s3
end

fn onev u32x128x64 u32 u32x128x512 -> u32x128x64
role call g p0 13
e eq role 1
c eq role 2
d eq role 3
p eq role 4
x eq role 6
h eq role 7
k eq role 8
ce select e 1 0
cc select c 1 0
cd select d 1 0
cp select p 1 0
cx select x 1 0
ch select h 1 0
ck select k 1 0
s1 fold hexec ce p0 p2
s2 fold hcost cc s1 p2
s3 fold hedit cd s2 p2
s4 fold hpar cp s3 p2
s5 fold haxes cx s4 p2
s6 fold hhw ch s5 p2
s7 fold htok ck s6 p2
ret s7
end
# event p2 at depth p3, handled (fold body)
fn event u32x128x64 u32 u32 u32 u32x128x512 -> u32x128x64
s1 fold wr64 1 p0 15 p2
s2 fold wr64 1 s1 16 p3
s3 fold onev 1 s2 p4
ret s3
end

# ---- the tokenizer
fn isdig u32 -> bool
a ge p0 48
b le p0 57
r and a b
ret r
end
fn islow u32 -> bool
a ge p0 97
b le p0 122
r and a b
ret r
end
# a string byte (fold body): hash it, keep the first 32 bytes
fn sadd u32x128x64 u32 u32 -> u32x128x64
h call g p0 4
x xor h p2
h2 mul x 16777619
s1 fold wr64 1 p0 4 h2
n call g s1 5
small lt n 32
c select small 1 0
w0 shr n 2
wa add w0 80
w call g s1 wa
b0 and n 3
sh shl b0 3
v shl p2 sh
w2 or w v
s2 fold wr64 c s1 wa w2
n1 add n 1
s3 fold wr64 c s2 5 n1
ret s3
end
fn tstr u32x128x64 u32 u32 u32x128x512 -> u32x128x64
esc call g p0 2
e1 eq esc 1
bs eq p2 92
q eq p2 34
ne select e1 false true
isbs and ne bs
isq and ne q
nq select isq false true
add or e1 nq
ca select add 1 0
s1 fold sadd ca p0 p2
ev select isbs 1 0
s2 fold wr64 1 s1 2 ev
k call g s2 3
d call g s2 1
kd add d 32
cq select isq 1 0
h call g s2 4
kq and isq true
k1 eq k 1
kk and isq k1
ck select kk 1 0
s3 fold wr64 ck s2 kd h
typ select k1 1 2
s4 fold event cq s3 typ d p3
s5 fold wr64 cq s4 0 0
ret s5
end
# the end of a number or literal (fold body)
fn tend u32x128x64 u32 u32x128x512 -> u32x128x64
m call g p0 0
fd call g p0 8
fr call g p0 7
rest sub 9 fd
t call tenp rest
fr9 mul fr t
s1 fold wr64 1 p0 7 fr9
lit call g s1 11
lt0 eq lit 116
lf eq lit 102
e1 select lf 5 6
e2 select lt0 4 e1
num eq m 2
typ select num 3 e2
d call g s1 1
s2 fold event 1 s1 typ d p2
s3 fold wr64 1 s2 0 0
ret s3
end
fn tnum u32x128x64 u32 u32 -> u32x128x64
dg call isdig p2
inf call g p0 9
inx call g p0 10
fx eq inf 1
xx eq inx 1
dv sub p2 48
ip call g p0 6
fr call g p0 7
fd call g p0 8
nx select xx false true
nf select fx false true
di0 and dg nx
di and di0 nf
df0 and dg nx
df1 and df0 fx
fsm lt fd 9
df and df1 fsm
ip10 mul ip 10
ipn add ip10 dv
cdi select di 1 0
s1 fold wr64 cdi p0 6 ipn
fr10 mul fr 10
frn add fr10 dv
cdf select df 1 0
s2 fold wr64 cdf s1 7 frn
fd1 add fd 1
s3 fold wr64 cdf s2 8 fd1
dot eq p2 46
cdot select dot 1 0
s4 fold wr64 cdot s3 9 1
e0 eq p2 101
e1 eq p2 69
ex or e0 e1
cex select ex 1 0
s5 fold wr64 cex s4 10 1
ret s5
end
fn zcap u32x128x64 u32 -> u32x128x64
a add 80 p1
r fold wr64 1 p0 a 0
ret r
end
# a byte between tokens (fold body)
fn tsep u32x128x64 u32 u32 u32x128x512 -> u32x128x64
b mov p2
d call g p0 1
d1 add d 1
kd add d 64
kind call g p0 kd
ob eq b 123
ab eq b 91
cb0 eq b 125
cb1 eq b 93
cb or cb0 cb1
op or ob ab
cm eq b 44
co eq b 58
q eq b 34
dg call isdig b
mi eq b 45
nm or dg mi
lw call islow b
# open
co1 select op 1 0
s1 fold wr64 co1 p0 1 d1
kd1 add d1 64
kv select ob 1 2
s2 fold wr64 co1 s1 kd1 kv
kh add d1 32
s3 fold wr64 co1 s2 kh 0
ix add d1 48
s4 fold wr64 co1 s3 ix 0
ek select ob 1 0
s5 fold wr64 co1 s4 12 ek
s6 fold event co1 s5 7 d1 p3
# close
cc1 select cb 1 0
s7 fold event cc1 s6 9 d p3
dm sub d 1
s8 fold wr64 cc1 s7 1 dm
# comma and colon
isarr eq kind 2
ca0 and cm isarr
cac select ca0 1 0
ixd add d 48
iv call g s8 ixd
iv1 add iv 1
s9 fold wr64 cac s8 ixd iv1
nar select isarr false true
co0 and cm nar
coc select co0 1 0
s10 fold wr64 coc s9 12 1
cco select co 1 0
s11 fold wr64 cco s10 12 0
# a string starts
cq select q 1 0
s12 fold wr64 cq s11 0 1
s13 fold wr64 cq s12 4 2166136261
s14 fold wr64 cq s13 5 0
s15 fold wr64 cq s14 2 0
isobj eq kind 1
ek0 call g s15 12
ek1 eq ek0 1
isk0 and isobj ek1
isk select isk0 1 0
s16 fold wr64 cq s15 3 isk
c8 select q 8 0
s17 fold zcap c8 s16
# a number or literal starts
cn select nm 1 0
s18 fold wr64 cn s17 0 2
dv0 sub b 48
dv select dg dv0 0
s19 fold wr64 cn s18 6 dv
s20 fold wr64 cn s19 7 0
s21 fold wr64 cn s20 8 0
s22 fold wr64 cn s21 9 0
s23 fold wr64 cn s22 10 0
cl select lw 1 0
s24 fold wr64 cl s23 0 3
s25 fold wr64 cl s24 11 b
ret s25
end
fn tbyte u32x128x64 u32 u32x128 u32x128x512 -> u32x128x64
w0 shr p1 2
w get p2 w0
b0 and p1 3
sh shl b0 3
v shr w sh
b and v 255
m call g p0 0
ms eq m 1
mn eq m 2
ml eq m 3
m0 eq m 0
dg call isdig b
dot eq b 46
e0 eq b 101
e1 eq b 69
pl eq b 43
mi eq b 45
x0 or dg dot
x1 or e0 e1
x2 or pl mi
x3 or x0 x1
nch or x3 x2
lw call islow b
cont0 and mn nch
cont1 and ml lw
nend0 select nch false true
nend and mn nend0
lend0 select lw false true
lend and ml lend0
ended or nend lend
sep or m0 ended
cs select ms 1 0
s1 fold tstr cs p0 b p3
cn select cont0 1 0
s2 fold tnum cn s1 b
ce select ended 1 0
s3 fold tend ce s2 p3
cp select sep 1 0
s4 fold tsep cp s3 b p3
ret s4
end
# one page of p3 bytes (fold body over pages of a file with state (table, io))
fn jpage (u32x128x64,io,u32) u32 u32x128x512 -> (u32x128x64,io,u32)
pa at p0 0
t at p0 1
n at p0 2
b shl p1 9
rest sub n b
big gt rest 512
cnt select big 512 rest
c3 add cnt 3
nw shr c3 2
r call rdpage t nw
pg at r 0
t2 at r 1
pa2 fold tbyte cnt pa pg p2
o rec pa2 t2 n
ret o
end
# the next JSON file of the input, role p2, cost slot p3
fn jfile u32x128x64 io u32 u32 u32x128x512 -> (u32x128x64,io)
r0 read p1
n at r0 0
t at r0 1
eq5 eq p2 5
has gt n 0
qv select has 1 0
c5 select eq5 1 0
s0 fold wr64 c5 p0 7770 qv
q call g s0 7770
eq3 eq p2 3
q1 eq q 1
skip and eq3 q1
r1 select eq5 3 p2
role select skip 0 r1
s1 fold wr64 1 s0 13 role
s2 fold wr64 1 s1 14 p3
s3 fold wr64 1 s2 0 0
s4 fold wr64 1 s3 1 0
s5 fold wr64 1 s4 12 0
n511 add n 511
np shr n511 9
st rec s5 t n
r fold jpage np st p4
pa at r 0
t2 at r 1
o rec pa t2
ret o
end
