# Site generator, module 6: phase B, the JSON files streamed through a tokenizer into one data
# table (u32x128x64). Each file is read a 128-word page (512 bytes) at a time; a byte loop whose
# state is the table itself tokenizes it, and every completed token is an event handled at once
# by the extractor of the file's role (a fold of count 0 or 1, so the table updates in place).
# Tokenizer words: 0 mode (0 between tokens, 1 string, 2 number, 3 literal) 1 depth 2 escape
# 3 string is a key 4 string hash 5 captured bytes 6 integer part 7 fraction digits (9 of them
# after the event) 8 fraction digit count 9 in fraction 10 in exponent 11 literal's first byte
# 12 a key is expected 13 role (1 exec 2 cost 3 edit 4 par 6 axes 7 hw 8 tokfx, 0 ignore) 14 cost file slot
# 15 event (1 key 2 string 3 number 4 true 5 false 6 null 7 open 9 close) 16 event depth
# 32 + d key hash at depth d, 48 + d array index, 64 + d container (1 object 2 array)
# 80..87 the first 32 bytes of the last string. Data from 128 (the extractors below).
use "sgread.a0"

fn g u32x128x64 u32 -> u32
r call rd64 p0 p1
ret r
end
fn key u32x128x64 u32 -> u32
i add p1 32
r call rd64 p0 i
ret r
end
# does the key at depth p1 equal word p3 of the store p2
fn kis u32x128x64 u32 u32x128x512 u32 -> bool
k call key p0 p1
h call whash p2 p3
r eq k h
ret r
end
fn evis u32x128x64 u32 u32 -> bool
t call g p0 15
d call g p0 16
a eq t p1
b eq d p2
r and a b
ret r
end
fn hashis u32x128x64 u32x128x512 u32 -> bool
h call g p0 4
w call whash p1 p2
r eq h w
ret r
end
# the number of the event in units of 1/p1 (p1 a power of ten up to 10^9), truncated
fn num u32x128x64 u32 -> u32
ip call g p0 6
fr call g p0 7
a mul ip p1
d div 1000000000 p1
f div fr d
r add a f
ret r
end
# write the table word p2 := p3 when the fold count is 1
fn cpcap u32x128x64 u32 u32 -> u32x128x64
s add 80 p1
v call rd64 p0 s
d add p2 p1
r fold wr64 1 p0 d v
ret r
end
# copy the captured string to [p2, p2 + 8) and its length to p3 when p1
fn savecap u32x128x64 bool u32 u32 -> u32x128x64
c select p1 1 0
c8 select p1 8 0
n call g p0 5
s1 fold cpcap c8 p0 p2
s2 fold wr64 c s1 p3 n
ret s2
end
fn lkmore u32 u32 u32x128x64 u32 u32 u32 -> bool
lt0 lt p0 p4
a add p3 p0
h call rd64 p2 a
ne0 ne h p5
r and lt0 ne0
ret r
end
fn lkstep u32 u32 u32x128x64 u32 u32 u32 -> u32
r add p0 1
ret r
end
# index of hash p3 among the p2 words from p1, else p2
fn lookup u32x128x64 u32 u32 u32 -> u32
r loop lkmore lkstep p2 0 p0 p1 p2 p3
ret r
end
fn max u32 u32 -> u32
a lt p0 p1
r select a p1 p0
ret r
end
fn addw u32x128x64 u32 u32 u32 -> u32x128x64
v call rd64 p0 p2
w add v p3
r fold wr64 1 p0 p2 w
ret r
end

# ---- exec: results/exec-benchmark.json
# 128 kernels 129 languages; kernel k: name 256 + 8k, length 384 + k, fields 400 + 16k (0 has
# arm64, 1 arm64 2 handwritten C 3 Rust 4 JavaScript ns x 10^4, 5 a0 build 6 rustc build ms x
# 10^3, 7 emitted 8 handwritten startup ms x 10^6, 9 emitted binary bytes); language l: id hash
# 656 + l, family 720 + l (1 compiled-native 2 interpreted 3 other), ran 784 + l, label length
# 848 + l, label 912 + 8l; median of language l on kernel k 1424 + 16l + k, ran there 2448 + 16l + k;
# startup group g entry e (e < 64): id hash 3472 + 64g + e, id length 3600 + ..., id 3728 +
# 8(64g + e), counts 130 + g, value + 1 on kernel k 4752 + 16(64g + e) + k (ms x 10^6).
fn hexec u32x128x64 u32 u32x128x512 -> u32x128x64
t call g p0 15
d call g p0 16
kk call kis p0 1 p2 0
kl call kis p0 1 p2 1
nk call g p0 128
nl call g p0 129
ck sub nk 1
cl sub nl 1
iskey eq t 1
isnum eq t 3
isstr eq t 2
d2 eq d 2
d3 eq d 3
d4 eq d 4
d5 eq d 5
# a new kernel or language
x0 and iskey d2
nkx and x0 kk
