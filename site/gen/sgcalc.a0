isa eq r0 ai
s2 fold vflag one s1 p2 156 k isa
lt0 call lg t
pc call pct lt0 p7 p8
s3 fold vnum one s2 p2 157 k pc
s4 fold vnum one s3 p2 158 k t
ret s4
end
fn ctrow u32x128x128 u32 u32x128x512 u32 (u32x64,u32x64,u32x64,u32x64,u32x64,u32x64,u32x64,u32) u32 -> u32x128x128
one mov 1
k call key2 p3 p1
rp at p4 0
tt at p4 1
pr at p4 2
co at p4 3
wr at p4 4
ac at p4 5
hk at p4 6
r0 get rp p1
a add r0 22
