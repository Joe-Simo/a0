part ne cv p6
s5 fold vflag one s4a p2 153 k part
s6 fold vnum one s5 p2 154 k n
pm call sortperm tt n
mn call lmin tt n
mx call lmax tt n
l9 call lg 9
l10 call lg 10
lm call lg mn
lo0 add lm l9
lo sub lo0 l10
hi call lg mx
s7 fold cbrow n s6 p2 p1 rp pm tt lo hi
s8 fold vnum one s7 p2 159 k n
s9 fold ctrow n s8 p2 p1 rs a
ret s9
end
fn ccost u32x128x128 u32 u32x128x512 u32x128x64 -> u32x128x128
one mov 1
nr call mcount p2 62
s0 fold clab nr p0 p2
sz call sizes p2
sl at sz 0
ns at sz 1
asc call sortperm sl ns
s1 fold vnum one s0 p2 133 0 ns
s2 fold csumrow ns s1 p2 p3 sl asc
ia call repidx p2 47 nr
it call repidx p2 48 nr
ir call repidx p2 9 nr
z call z64l
ra add ia 22
rt add it 22
rr add ir 22
fa call rd128 s2 ra
ft call rd128 s2 rt
fr call rd128 s2 rr
ha call vhash s2 fa
ht call vhash s2 ft
hr call vhash s2 fr
z1 set z 0 ha
z2 set z1 1 ht
z3 set z2 2 hr
al call alllangs p3 s2
alh at al 0
na at al 1
cv call cover alh na z3 3
s3 fold vcov one s2 p2 140 141 cv na
nl sub ns 1
bi get asc nl
big get sl bi
si get asc 0
sml get sl si
ba call reptot p2 p3 big 47
bt call reptot p2 p3 big 48
s4 fold vnum one s3 p2 142 0 ba
s5 fold vnum one s4 p2 143 0 bt
bq div bt ba
s6 fold vnum one s5 p2 144 0 bq
bc call repacc p2 p3 big 47
s7 fold vnum one s6 p2 145 0 bc
ma call reptot p2 p3 sml 47
mt call reptot p2 p3 sml 48
m100 mul ma 100
mr call rdiv m100 mt
s8 fold vnum one s7 p2 146 0 mr
s9 fold vnum one s8 p2 147 0 ns
s10 fold cszrow ns s9 p2 p3 sl alh na
ret s10
end

# ---- validation latency: rows 7771 + 11i (kind hash, median ms x 1000, ...), kinds at 240 + i
fn elmed u32x128x64 u32 -> u32
a mul p1 11
b add a 7772
r call rd64 p0 b
ret r
end
fn elkstep u32 u32 u32x128x64 u32 -> u32
a mul p1 11
b add a 7771
h call rd64 p2 b
e eq h p3
r select e p1 p0
ret r
end
fn elfind u32x128x64 u32 -> u32
n call rd64 p0 7768
r fold elkstep n 0 p0 p1
ret r
end
fn elvals u32x64 u32 u32x128x64 -> u32x64
v call elmed p2 p1
r set p0 p1 v
ret r
end
# FNV-1a of a pool string up to its first "." (fold body: (hash, stopped))
fn pfxb (u32,bool) u32 u32x128x128 u32 -> (u32,bool)
h at p0 0
d at p0 1
a add p3 p1
b call vb p2 a
dot eq b 46
st or d dot
x xor h b
h2 mul x 16777619
hn select st h h2
r rec hn st
ret r
end
fn pfxhash u32x128x128 u32 -> u32
s shr p1 16
l and p1 65535
s0 rec 2166136261 false
r0 fold pfxb l s0 p0 s
r at r0 0
ret r
end
fn elrow u32x128x128 u32 u32x128x512 u32x128x64 u32x64 u32 u32 -> u32x128x128
one mov 1
i get p4 p1
k call key1 p1
a mul i 11
b add a 7771
h call rd64 p3 b
kr add i 240
s1 fold vmapv one p0 p2 68 h 31 kr
lr call rd128 s1 31
s2 fold vref one s1 p2 172 k lr
kref call rd128 s2 kr
ph call pfxhash s2 kref
a0h call whash p2 47
isa eq ph a0h
s3 fold vflag one s2 p2 173 k isa
m call elmed p3 i
lm call lg m
pc call pct lm p5 p6
s4 fold vnum one s3 p2 174 k pc
m10 call rdiv m 10
s5 fold vnum one s4 p2 175 k m10
ret s5
end
# the label hash of row p1's language (the `m ellang` value), for the coverage line
fn elcov u32x64 u32 u32x128x128 u32x128x512 -> u32x64
kr add p1 240
kref call rd128 p2 kr
ph call pfxhash p2 kref
pos call mfind p3 69 ph
mv call mval p3 pos
a at mv 0
n at mv 1
h call shash p3 a n
r set p0 p1 h
ret r
end
fn cedit u32x128x128 u32 u32x128x512 u32x128x64 -> u32x128x128
one mov 1
a0h call whash p2 52
tsh call whash p2 53
ia call elfind p3 a0h
it call elfind p3 tsh
ma call elmed p3 ia
mt call elmed p3 it
a10 call rdiv ma 10
s1 fold vfix2 one p0 p2 170 0 a10
t100 call rdiv mt 100
s2 fold vfix1 one s1 p2 171 0 t100
n call rd64 p3 7768
z call z64l
vl fold elvals n z p3
pm call sortperm vl n
mn call lmin vl n
mx call lmax vl n
l9 call lg 9
l10 call lg 10
lm call lg mn
lo0 add lm l9
lo sub lo0 l10
hi call lg mx
s3 fold vnum one s2 p2 68 0 n
s4 fold elrow n s3 p2 p3 pm lo hi
q call rd64 p3 7770
quiet eq q 1
s5 fold vflag one s4 p2 176 0 quiet
nq select quiet false true
s6 fold vflag one s5 p2 177 0 nq
ld call rd64 p3 7769
l100 call rdiv ld 100
s7 fold vnum one s6 p2 178 0 l100
hs fold elcov n z s7 p2
al call alllangs p3 s7
alh at al 0
na at al 1
cv call cover alh na hs n
s8 fold vcov one s7 p2 179 180 cv na
ret s8
end

# ---- parallel folds: kernel k at 7953 + 20k, ratio of implementation j + 1 at 7964 + 20k + j
fn prat u32x128x64 u32 u32 -> u32
a mul p1 20
b add a 7964
c add b p2
r call rd64 p0 c
ret r
end
# the rows of kernel p2: (implementation, ratio x 10^5)
fn prstep (u32x64,u32x64,u32) u32 u32x128x64 u32 -> (u32x64,u32x64,u32)
jl at p0 0
rl at p0 1
n at p0 2
r1 call prat p2 p3 p1
has gt r1 0
r sub r1 1
jl2 set jl n p1
rl2 set rl n r
n1 add n 1
nn select has n1 n
o rec jl2 rl2 nn
ret o
end
fn prows u32x128x64 u32 -> (u32x64,u32x64,u32)
z call z64l
s0 rec z z 0
nj call rd64 p0 8119
r fold prstep nj s0 p0 p1
ret r
end
fn pminstep (u32,u32) u32 u32x128x64 -> (u32,u32)
lo at p0 0
hi at p0 1
rs call prows p2 p1
rl at rs 1
n at rs 2
a call lmin rl n
b call lmax rl n
c lt a lo
d gt b hi
lo2 select c a lo
hi2 select d b hi
r rec lo2 hi2
ret r
end
# the labels of the parallel map into variables words 272 + j (fold body)
fn plab u32x128x128 u32 u32x128x512 -> u32x128x128
one mov 1
pos call mnth p2 p1 65
mv call mval p2 pos
a at mv 0
n at mv 1
st call rd128 p0 0
s1 fold vapst n p0 p2 a
r0 call since s1 st
d add p1 272
r fold wr128 one s1 d r0
ret r
end
fn prrow u32x128x128 u32 u32x128x512 u32 u32x64 u32x64 u32x64 u32 u32 -> u32x128x128
one mov 1
i get p6 p1
k call key2 p3 p1
j get p4 i
r get p5 i
lr0 add j 272
lr call rd128 p0 lr0
s1 fold vref one p0 p2 186 k lr
