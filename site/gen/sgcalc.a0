s5 fold vnum one s4 p2 190 k rr
ret s5
end
fn pkrow u32x128x128 u32 u32x128x512 u32x128x64 u32 u32 -> u32x128x128
one mov 1
k call key1 p1
nr0 add p1 256
nm call rd128 p0 nr0
