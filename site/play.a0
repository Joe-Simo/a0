# a0lang.com/play, authored in A0: the live playground. The self-hosted lexer (compiler/lex.a0),
# parser (compiler/parse.a0) and type checker (compiler/check.a0) run on the source in the text
# area, and the page (nav, editor, tokens, word IR with the type of every node, diagnostic,
# stylesheet) is this one io program. Same protocol and runtime as
# page.a0 (see ui.a0). Input: event x y ntext text[ntext] nstate state[nstate]; event 0 renders
# (the state's source, or the default clamp function), event 1 runs the submitted text. The
# state is the source (n then n bytes) so the text survives a re-render. Sources are at most
# 480 bytes (TEXT_CAP of the runtime); the parser's tables are u32x512, widened for the checker
# as checkio does.
use "ui.a0"
use "../compiler/check.a0"
# TEXT with the p1 bytes of p2 from p3
fn substep io u32 u32x512 u32 -> io
i add p3 p1
v get p2 i
w write p0 v
ret w
end
fn putsub io u32 u32x512 u32 -> io
a write p0 2
b write a p1
c fold substep p1 b p2 p3
ret c
end
# TEXT of symbol p3 (pool p1, sym table p2)
fn putsym io u32x512 u32x512 u32 -> io
i2 mul p3 2
s get p2 i2
i21 add i2 1
l get p2 i21
r call putsub p0 l p1 s
ret r
end
fn putsp io u32 -> io
a write p0 2
b write a 1
c write b 32
ret c
end
fn putnl io u32 -> io
a write p0 2
b write a 1
c write b 10
ret c
end
# operation names of DESIGN.md 7a, six bytes per op, with their lengths
fn opnames -> u32x186
t text "mov   add   sub   mul   and   or    xor   shl   shr   div   rem   eq    ne    lt    le    gt    ge    selectcall  fold  loop  arr   rec   text  get   set   at    put   read  write puts  "
ret t
end
fn oplens -> u32x31
a arr 3 3 3 3 3 2 3 3 3 3 3 2 2 2 2 2 2 6 4 4 4 3 3 4 3 3 2 3 4 5 4
ret a
end
fn opstep io u32 u32x186 u32 -> io
i add p3 p1
v get p2 i
w write p0 v
ret w
end
fn putop io u32 -> io
names call opnames
lens call oplens
ok1 ge p1 1
ok2 le p1 31
ok and ok1 ok2
i1 sub p1 1
i select ok i1 0
len get lens i
off mul i 6
a write p0 2
b write a len
c fold opstep len b names off
ret c
end
# token kinds of compiler/lex.a0, seven bytes per kind
fn kindnames -> u32x63
t text "ident  number string arrow  newlineminus  at     ?      error  "
ret t
end
fn kindlens -> u32x9
a arr 5 6 6 5 7 5 2 1 5
ret a
end
fn kindstep io u32 u32x63 u32 -> io
i add p3 p1
v get p2 i
w write p0 v
ret w
end
fn putkind io u32 -> io
names call kindnames
lens call kindlens
ok1 ge p1 1
ok2 le p1 9
ok and ok1 ok2
i1 sub p1 1
i select ok i1 7
len get lens i
off mul i 7
a write p0 2
b write a len
c fold kindstep len b names off
ret c
end
# type p3 of the checker's types p1 (triples tag a b: 1 u32, 2 bool, 3 io, (4 length elem),
# (5 tlist-offset count)) with the record fields in p2, rendered like the source: u32xN,
# (u32,io), (u32,io)x2. Three levels of nesting (ty3); a deeper aggregate prints as ?
fn tynames -> u32x16
t text "u32 boolio  ?   "
ret t
end
fn tylens -> u32x4
a arr 3 4 2 1
ret a
end
fn tystep io u32 u32x16 u32 -> io
i add p3 p1
v get p2 i
w write p0 v
ret w
end
fn numstep io u32 u32 -> io
r call putnum p0 p2
ret r
end
fn putcomma io u32 -> io
a write p0 2
b write a 1
c write b 44
ret c
end
fn basestep io u32 u32 -> io
names call tynames
lens call tylens
ok1 ge p2 1
ok2 le p2 3
ok and ok1 ok2
t1 sub p2 1
t select ok t1 3
len get lens t
off mul t 4
w write p0 2
w2 write w len
w3 fold tystep len w2 names off
ret w3
end
fn ty0 io u32x768 u32x1024 u32 -> io
i3 mul p3 3
tag get p1 i3
w call basestep p0 0 tag
ret w
end
fn arr1 io u32 u32x768 u32x1024 u32 u32 -> io
e call ty0 p0 p2 p3 p5
x write e 2
x1 write x 1
x2 write x1 120
n call putnum x2 p4
ret n
end
fn fld1 io u32 u32x768 u32x1024 u32 -> io
nz gt p1 0
nc select nz 1 0
c fold putcomma nc p0
k add p4 p1
t get p3 k
r call ty0 c p2 p3 t
ret r
end
fn rec1 io u32 u32x768 u32x1024 u32 u32 -> io
o write p0 2
o1 write o 1
o2 write o1 40
f fold fld1 p5 o2 p2 p3 p4
c write f 2
c1 write c 1
c2 write c1 41
ret c2
end
fn ty1 io u32x768 u32x1024 u32 -> io
i3 mul p3 3
tag get p1 i3
i31 add i3 1
a get p1 i31
i32 add i3 2
b get p1 i32
isarr eq tag 4
isrec eq tag 5
isagg or isarr isrec
nbase select isagg 0 1
narr select isarr 1 0
nrec select isrec 1 0
w fold basestep nbase p0 tag
w2 fold arr1 narr w p1 p2 a b
w3 fold rec1 nrec w2 p1 p2 a b
ret w3
end
fn arr2 io u32 u32x768 u32x1024 u32 u32 -> io
e call ty1 p0 p2 p3 p5
x write e 2
x1 write x 1
x2 write x1 120
n call putnum x2 p4
ret n
end
fn fld2 io u32 u32x768 u32x1024 u32 -> io
nz gt p1 0
nc select nz 1 0
c fold putcomma nc p0
k add p4 p1
t get p3 k
r call ty1 c p2 p3 t
ret r
end
fn rec2 io u32 u32x768 u32x1024 u32 u32 -> io
o write p0 2
o1 write o 1
o2 write o1 40
f fold fld2 p5 o2 p2 p3 p4
c write f 2
c1 write c 1
c2 write c1 41
ret c2
end
fn ty2 io u32x768 u32x1024 u32 -> io
i3 mul p3 3
tag get p1 i3
i31 add i3 1
a get p1 i31
i32 add i3 2
b get p1 i32
isarr eq tag 4
isrec eq tag 5
isagg or isarr isrec
nbase select isagg 0 1
narr select isarr 1 0
nrec select isrec 1 0
w fold basestep nbase p0 tag
w2 fold arr2 narr w p1 p2 a b
w3 fold rec2 nrec w2 p1 p2 a b
ret w3
end
fn arr3 io u32 u32x768 u32x1024 u32 u32 -> io
e call ty2 p0 p2 p3 p5
x write e 2
x1 write x 1
x2 write x1 120
n call putnum x2 p4
ret n
end
fn fld3 io u32 u32x768 u32x1024 u32 -> io
nz gt p1 0
nc select nz 1 0
c fold putcomma nc p0
k add p4 p1
t get p3 k
r call ty2 c p2 p3 t
ret r
end
fn rec3 io u32 u32x768 u32x1024 u32 u32 -> io
o write p0 2
o1 write o 1
o2 write o1 40
f fold fld3 p5 o2 p2 p3 p4
c write f 2
c1 write c 1
c2 write c1 41
ret c2
end
fn ty3 io u32x768 u32x1024 u32 -> io
i3 mul p3 3
tag get p1 i3
i31 add i3 1
a get p1 i31
i32 add i3 2
b get p1 i32
isarr eq tag 4
isrec eq tag 5
isagg or isarr isrec
nbase select isagg 0 1
narr select isarr 1 0
nrec select isrec 1 0
w fold basestep nbase p0 tag
w2 fold arr3 narr w p1 p2 a b
w3 fold rec3 nrec w2 p1 p2 a b
ret w3
end
# the type of a node, as a muted span after its line
fn tyspan io u32 u32x768 u32x1024 u32 -> io
a call open p0 6
b write a 4
c write b 2
d text "ty"
e puts c d
f write e 2
g text "  "
h puts f g
i call ty3 h p2 p3 p4
j call close i
ret j
end
# one operand (kind value): 1 node of this function, 2 param, 3 u32, 4 bool
fn argnode io u32 u32x512 u32x512 u32x512 u32 u32 -> io
n add p5 p6
i6 mul n 6
s get p4 i6
r call putsym p0 p2 p3 s
ret r
end
fn argparam io u32 u32 -> io
a write p0 2
b write a 1
c write b 112
d call putnum c p2
ret d
end
fn puttrue io u32 -> io
t text "true"
a write p0 2
b puts a t
ret b
end
fn putfalse io u32 -> io
t text "false"
a write p0 2
b puts a t
ret b
end
fn putarg io u32 u32 u32x512 u32x512 u32x512 u32 -> io
k1 eq p1 1
k2 eq p1 2
k3 eq p1 3
k4 eq p1 4
n1 select k1 1 0
n2 select k2 1 0
n3 select k3 1 0
ist ne p2 0
isf eq p2 0
t4 and k4 ist
f4 and k4 isf
n4t select t4 1 0
n4f select f4 1 0
a fold argnode n1 p0 p3 p4 p5 p6 p2
b fold argparam n2 a p2
c fold numstep n3 b p2
d fold puttrue n4t c
e fold putfalse n4f d
ret e
end
# operand p1 of a node: a space then the operand (args p6 from p7; pool p2 sym p3 nodes p4 firstnode p5)
fn argstep io u32 u32x512 u32x512 u32x512 u32 u32x512 u32 -> io
a call putsp p0 0
i add p7 p1
i2 mul i 2
k get p6 i2
i21 add i2 1
v get p6 i21
r call putarg a k v p2 p3 p4 p5
ret r
end
# node p1 of a function as one line: id op args, then its type when the checker reached it
# (pool p2 sym p3 nodes p4 args p5 firstnode p6 types p7 tlist p8 ntys p9 fn p10 errfn p11
# errnode p12: the nodes of earlier functions and the nodes before the error are typed)
fn irnode io u32 u32x512 u32x512 u32x512 u32x512 u32 u32x768 u32x1024 u32x1024 u32 u32 u32 -> io
n add p6 p1
i6 mul n 6
id get p4 i6
i61 add i6 1
op get p4 i61
i62 add i6 2
nargs get p4 i62
i63 add i6 3
farg get p4 i63
a call putsym p0 p2 p3 id
b call putsp a 0
c call putop b op
d fold argstep nargs c p2 p3 p4 p6 p5 farg
before lt p10 p11
same eq p10 p11
inn lt p1 p12
here and same inn
typed or before here
nt select typed 1 0
ty get p9 n
e fold tyspan nt d p7 p8 ty
f call putnl e 0
ret f
end
# function p1: name, params, result type, node count, then its nodes (typed) and ret
# (pool p2 sym p3 fns p4 nodes p5 args p6 types p7 tlist p8 ntys p9 errfn p10 errnode p11)
fn irfn io u32 u32x512 u32x512 u32x512 u32x512 u32x512 u32x768 u32x1024 u32x1024 u32 u32 -> io
i7 mul p1 7
name get p4 i7
i71 add i7 1
np get p4 i71
i73 add i7 3
rt get p4 i73
i74 add i7 4
fnode get p4 i74
i75 add i7 5
nn get p4 i75
i76 add i7 6
retw get p4 i76
rk shr retw 28
rv and retw 268435455
a call open p0 5
a1 write a 4
a2 write a1 2
a3 text "fnb"
a4 puts a2 a3
b call open a4 15
b1 call putsym b p2 p3 name
b2 call close b1
c call open b2 2
c1 write c 4
c2 write c1 2
c3 text "meta"
c4 puts c2 c3
c5 write c4 2
c6 text "params "
c7 puts c5 c6
c8 call putnum c7 np
c9 write c8 2
c10 text " · result "
c11 puts c9 c10
c12 call ty3 c11 p7 p8 rt
c13 write c12 2
c14 text " · nodes "
c15 puts c13 c14
c16 call putnum c15 nn
c17 call close c16
d call open c17 10
d1 write d 4
d2 write d1 2
d3 text "code"
d4 puts d2 d3
d5 fold irnode nn d4 p2 p3 p5 p6 fnode p7 p8 p9 p1 p10 p11
d6 write d5 2
d7 text "ret"
d8 puts d6 d7
d9 call putsp d8 0
d10 call putarg d9 rk rv p2 p3 p5 fnode
d11 call close d10
e call close d11
ret e
end
# token p1 as a table row: index, kind, text (tokens p2, source p3)
fn tokstep io u32 u32x512 u32x512 -> io
t call tokat p2 p1
k at t 0
s at t 1
l at t 2
a call open p0 20
b call open a 21
b1 write b 4
b2 write b1 2
b3 text "k"
b4 puts b2 b3
b5 call putnum b4 p1
b6 call close b5
c call open b6 21
c1 call putkind c k
c2 call close c1
d call open c2 21
d1 call open d 4
d2 call putsub d1 l p3 s
d3 call close d2
d4 call close d3
e call close d4
ret e
end
fn putparse io u32 -> io
t text "parse error"
a write p0 2
b puts a t
ret b
end
fn putstruct io u32 -> io
t text "structure error"
a write p0 2
b puts a t
ret b
end
fn putok io u32 -> io
t text "valid: parsed and type-checked"
a write p0 2
b puts a t
ret b
end
fn putattok io u32 u32 u32x512 u32x512 -> io
t text " at token "
a write p0 2
b puts a t
c call putnum b p2
tk call tokat p3 p2
s at tk 1
l at tk 2
d write c 2
e text ": "
f puts d e
g call open f 4
h call putsub g l p4 s
i call close h
ret i
end
fn putateof io u32 u32 -> io
t text " at the end of the input (token "
a write p0 2
b puts a t
c call putnum b p2
d write c 2
e text ")"
f puts d e
ret f
end
fn attrok io u32 -> io
t text "diag ok"
a write p0 4
b write a 2
c puts b t
ret c
end
fn attrbad io u32 -> io
t text "diag"
a write p0 4
b write a 2
c puts b t
ret c
end
fn puttyerr io u32 -> io
t text "type error"
a write p0 2
b puts a t
ret b
end
fn putlimit io u32 -> io
t text "limit error"
a write p0 2
b puts a t
ret b
end
fn puthdr io u32 -> io
t text " in the header"
a write p0 2
b puts a t
ret b
end
fn putret io u32 -> io
t text " at ret"
a write p0 2
b puts a t
ret b
end
fn putatnode io u32 u32x512 u32x512 u32 -> io
t text " at node "
a write p0 2
b puts a t
c call putsym b p2 p3 p4
ret c
end
fn meanstruct io u32 -> io
t text "the operand count, an io token consumed twice, or a field index does not fit the operation"
a write p0 2
b puts a t
ret b
end
fn meantype io u32 -> io
t text "an operand has a type the operation does not accept"
a write p0 2
b puts a t
ret b
end
fn meanlimit io u32 -> io
t text "a parameter, node, aggregate width or iteration limit of the language is exceeded"
a write p0 2
b puts a t
ret b
end
# the checker's diagnostic: code p2 (2 structure, 3 type, 4 limit) in function p3 at node p4
# (its index in the function; the node count for the ret operand; 4294967295 for the header),
# named from the pool p5, sym p6, fns p7 and nodes p8
fn putcheck io u32 u32 u32 u32 u32x512 u32x512 u32x512 u32x512 -> io
c2 eq p2 2
c3 eq p2 3
c4 eq p2 4
n2 select c2 1 0
n3 select c3 1 0
n4 select c4 1 0
a fold putstruct n2 p0
b fold puttyerr n3 a
c fold putlimit n4 b
d write c 2
d1 text " in fn "
d2 puts d d1
fok lt p3 1024
f select fok p3 0
f7 mul f 7
name get p7 f7
e call putsym d2 p5 p6 name
i74 add f7 4
fnode get p7 i74
i75 add f7 5
nn get p7 i75
ishdr eq p4 4294967295
isret eq p4 nn
nh select ishdr 1 0
nr select isret 1 0
inb lt p4 nn
nnode select inb 1 0
gi0 add fnode p4
gi select inb gi0 0
i6 mul gi 6
id get p8 i6
g fold puthdr nh e
h fold putret nr g
i fold putatnode nnode h p5 p6 id
j write i 2
j1 text ": "
j2 puts j j1
k fold meanstruct n2 j2
l fold meantype n3 k
m fold meanlimit n4 l
ret m
end
# the first diagnostic: the parser's code p1 (0 none, 1 parse, 2 structure) at token p2 of p3
# (tokens p4, source p5), else the checker's code p6 (0 none) in function p7 at node p8
# (pool p9 sym p10 fns p11 nodes p12); a green line when both passed
fn putdiag io u32 u32 u32 u32x512 u32x512 u32 u32 u32 u32x512 u32x512 u32x512 u32x512 -> io
pok eq p1 0
cok eq p6 0
ok and pok cok
bad select ok false true
c1 eq p1 1
c2 eq p1 2
n0 select ok 1 0
nbad select bad 1 0
n1 select c1 1 0
n2 select c2 1 0
inside lt p2 p3
pbad select pok false true
attok and pbad inside
ateof0 select inside false true
ateof and pbad ateof0
nt select attok 1 0
ne select ateof 1 0
cbad select cok false true
ccheck and pok cbad
nc select ccheck 1 0
a call open p0 2
b fold attrok n0 a
c fold attrbad nbad b
d fold putok n0 c
e fold putparse n1 d
f fold putstruct n2 e
g fold putattok nt f p2 p4 p5
h fold putateof ne g p2
h2 fold putcheck nc h p6 p7 p8 p9 p10 p11 p12
i call close h2
ret i
end
# the default source: the clamp function of the home page
fn deftext -> u32x96
t text "fn clamp u32 u32 u32 -> u32\nlo lt p0 p1\na select lo p1 p0\nhi lt p2 a\nr select hi p2 a\nret r\nend\n"
ret t
end
fn defstep u32x512 u32 u32x96 -> u32x512
v get p2 p1
s set p0 p1 v
ret s
end
fn defsrc -> u32x512
z call zeros512
t call deftext
s fold defstep 96 z t
ret s
end
# event 0: render the state's source (or the default); event 1: run the submitted text
fn session io -> u32
r0 read p0
event at r0 0
t0 at r0 1
r1 read t0
t1 at r1 1
r2 read t1
t2 at r2 1
r3 read t2
ntext0 at r3 0
t3 at r3 1
big lt 480 ntext0
ntext select big 480 ntext0
z call zeros512
s0 rec z t3
rd fold readbyte ntext s0
tin at rd 0
t4 at rd 1
r4 read t4
t5 at r4 1
r5 read t5
nst0 at r5 0
t6 at r5 1
bigs lt 480 nst0
nst select bigs 480 nst0
sd0 rec z t6
sd fold readbyte nst sd0
tst at sd 0
t7 at sd 1
run eq event 1
hasst gt nst 0
def call defsrc
src1 select hasst tst def
n1 select hasst nst 96
src select run tin src1
n select run ntext n1
lx call lex src n
tok at lx 0
nw at lx 1
ntok div nw 3
pr call parse src n
code at pr 0
etok at pr 1
pool at pr 2
sym at pr 3
types at pr 4
tlist at pr 5
fns at pr 6
nodes at pr 7
args at pr 8
ntypes0 at pr 12
ntlist0 at pr 13
nfns0 at pr 14
nnodes0 at pr 15
nargs0 at pr 16
pok eq code 0
ntypes select pok ntypes0 0
ntlist select pok ntlist0 0
nfns select pok nfns0 0
nnodes select pok nnodes0 0
nargs select pok nargs0 0
ntypes3 mul ntypes 3
nfns7 mul nfns 7
nnodes6 mul nnodes 6
nargs2 mul nargs 2
z768 call zeros768
z1024 call zeros1024
z4096 call zeros4096
z8192 call zeros8192
z256 call zeros256
types1 fold cp768 ntypes3 z768 types
tlist1 fold cp1024 ntlist z1024 tlist
fns1 fold cp1024 nfns7 z1024 fns
nodes1 fold cp4096 nnodes6 z4096 nodes
args1 fold cp8192 nargs2 z8192 args
ck call check types1 tlist1 fns1 nodes1 args1 z256 ntypes ntlist nfns 0
types2 at ck 0
tlist2 at ck 1
ntys at ck 6
cerr at ck 10
cfn at ck 11
cnode at ck 12
y1 write t7 9
y2 text "@font-face{font-family:\"Geist\";src:url(\"/fonts/Geist-Variable.woff2\") format(\"woff2\");font-weight:100 900;font-display:swap}\n@font-face{font-family:\"Geist Mono\";src:url(\"/fonts/GeistMono-Variable.woff2\") format(\"woff2\");font-weight:100 900;font-display:swap}\n:root{color-scheme:dark;--bg:#000;--fg:#fff;--fg2:#d8dbe0;--body:#c9ccd1;--muted:#8a8f98;--dim:#5c6169;--line:#1f2227;--line2:#33373d;--card:#0b0c0e;--pillbg:#fff;--pillfg:#000;--ghost:#17191d;--a0:#ffd166;--c:#7aa2ff;--rust:#f0885a;--gray:#9aa0a6;--win:#5ad19a;--loss:#ff7a7a;--glow1:rgba(120,140,255,.22);--glow2:rgba(255,209,102,.12)}\n"
y3 puts y1 y2
y4 write y3 9
y5 text "*{box-sizing:border-box}\nhtml{scroll-behavior:smooth;scroll-padding-top:80px}\nbody{margin:0;background:var(--bg);color:var(--fg);font:16px/1.6 \"Geist\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}\na{color:inherit}\n.pixel{font-family:\"Geist Pixel\",\"Geist Mono\",monospace;font-weight:400}\n.mono{font-family:\"Geist Mono\",ui-monospace,SFMono-Regular,Menlo,monospace}\n.top{position:fixed;inset:0 0 auto 0;z-index:20;height:64px;display:flex;align-items:center;padding:0 28px;background:linear-gradient(var(--bg),transparent)}\n"
y6 puts y4 y5
y7 write y6 9
y8 text ".nav{display:flex;align-items:center;gap:28px;width:100%}\n.brand{font-size:1.25rem;letter-spacing:.02em;text-decoration:none;margin-right:12px}\n.links{display:flex;gap:22px;flex:1}\n.links a{color:var(--fg2);text-decoration:none;font-size:.9rem}\n.links a:hover{color:var(--fg)}\n.pill{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:999px;background:var(--pillbg);color:var(--pillfg);text-decoration:none;font-size:.9rem;font-weight:500}\n.pill.ghost{background:var(--ghost);color:var(--fg)}\n.pill:hover{filter:brightness(.92)}\n@media (max-width:640px){.top{background:var(--bg);border-bottom:1px solid var(--line);height:56px;padding:0 20px}.links{gap:14px}.links a{font-size:.85rem}.pill{padding:6px 12px;font-size:.85rem}}\n.hero{position:relative;min-height:100vh;display:flex;align-items:flex-end;justify-content:space-between;padding:0 28px 96px;overflow:hidden}\n"
y9 puts y7 y8
y10 write y9 9
y11 text ".layout{display:grid;grid-template-columns:200px minmax(0,760px);gap:56px;justify-content:center;padding:80px 24px 0;max-width:1160px;margin:0 auto}\n.rail{position:sticky;top:96px;align-self:start;font-size:.8rem;display:flex;flex-direction:column;gap:10px}\n.rail .rh{color:var(--fg2);margin:14px 0 2px}\n.rail a{color:var(--muted);text-decoration:none;padding-left:12px}\n.rail a:hover{color:var(--fg)}\n@media (max-width:900px){.layout{grid-template-columns:minmax(0,1fr);gap:24px;padding-top:56px}.rail{position:static;flex-direction:row;flex-wrap:wrap;gap:8px}.rail .rh{display:none}.rail a{padding:6px 12px;border:1px solid var(--line);border-radius:999px;font-size:.78rem}}\n.main h2{font-size:clamp(1.6rem,3vw,2.1rem);font-weight:500;letter-spacing:-.02em;margin:0 0 16px}\n.main h3{font-size:1.15rem;font-weight:500;margin:28px 0 8px}\n.main p{color:var(--body);margin:0 0 14px;font-size:1.02rem}\n.main p strong{color:var(--fg);font-weight:500}\n"
y12 puts y10 y11
y13 write y12 9
y14 text ".main section{padding:32px 0 40px;border-top:1px solid var(--line)}\n.main section:last-child{padding-bottom:8px}\n.main section:first-child{border-top:0;padding-top:0}\n.main section.cont{border-top:0;padding-top:0}\n.chart{border:1px solid var(--line);border-radius:18px;background:var(--card);padding:22px 22px 18px;margin:22px 0 28px}\n.chart .ct{font-size:1.05rem;margin:0 0 4px;font-weight:500;color:var(--fg)}\n.chart .sub{color:var(--muted);font-size:.85rem;margin:0 0 16px}\n.legend{display:flex;gap:18px;flex-wrap:wrap;font-size:.82rem;color:var(--fg2);margin:0 0 14px}\n.legend span::before{content:\"\";display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px;vertical-align:1px}\n.legend .la0::before{background:var(--a0)}\n.legend .lc::before{background:var(--c)}\n.legend .lrust::before{background:var(--rust)}\n.legend .lgray::before{background:var(--gray)}\n"
y15 puts y13 y14
y16 write y15 9
y17 text "pre.code{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px;overflow:auto;font:13px/1.65 \"Geist Mono\",ui-monospace,monospace;color:var(--fg2);margin:16px 0 0;white-space:pre}\npre.code .cm{color:var(--dim)}\npre.wrap{white-space:pre-wrap}\n@media (max-width:720px){pre.code{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px}}\ntable.ops{width:100%;border-collapse:collapse;font-size:.9rem;margin:12px 0 20px}\n.ops th{text-align:left;color:var(--muted);font-weight:500;padding:8px 10px;border-bottom:1px solid var(--line);font-size:.8rem}\n.ops td{padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top;color:var(--fg2)}\n.ops td:first-child{white-space:nowrap;color:var(--fg)}\n@media (max-width:720px){.ops tr{display:block;padding:8px 0;border-bottom:1px solid var(--line)}.ops td,.ops th{display:block;border:0;padding:2px 0}.ops th:last-child{display:none}.ops td:first-child{white-space:normal}}\n"
y18 puts y16 y17
y19 write y18 9
y20 text ".limits{border-left:2px solid var(--loss);padding-left:16px}\n.foot{max-width:1160px;margin:32px auto 0;padding:32px 24px 48px;border-top:1px solid var(--line);color:var(--muted);font-size:.85rem;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}\n.foot a{color:var(--fg2);text-decoration:none}\n.card:hover{border-color:var(--line2)}\na:focus-visible,.pill:focus-visible{outline:2px solid var(--c);outline-offset:3px;border-radius:4px}\n.reveal{opacity:0;transform:translateY(14px);transition:opacity .5s ease,transform .5s ease}\n.reveal.in{opacity:1;transform:none}\n.docs .hero{min-height:0;padding:120px 24px 0;align-items:flex-start;flex-direction:column;justify-content:flex-start}\n.docs .hero::after{display:none}\n.docs .hero .name{font-size:clamp(2.6rem,7vw,5rem)}\n"
y21 puts y19 y20
y22 write y21 9
y23 text ".lead{color:var(--muted);max-width:620px;margin:10px 0 0;font-size:1.05rem}\n.single{max-width:860px;margin:0 auto;padding:40px 24px 0}\n.docs .hero.play{max-width:860px;margin:0 auto;padding-left:24px;padding-right:24px}\n@media (max-width:720px){.play-tokens tr{display:table-row}.play-tokens td,.play-tokens th{display:table-cell;padding:6px 8px;border-bottom:1px solid var(--line)}.play-tokens th:last-child{display:table-cell}}\ntextarea.src{display:block;width:100%;min-height:210px;resize:vertical;background:var(--card);color:var(--fg2);border:1px solid var(--line);border-radius:14px;padding:16px 18px;font:13px/1.65 \"Geist Mono\",ui-monospace,monospace;white-space:pre;tab-size:2}\ntextarea.src:focus{outline:2px solid var(--c);outline-offset:2px}\n.bar{display:flex;align-items:center;gap:16px;margin:14px 0 0;flex-wrap:wrap}\nbutton.pill{border:0;cursor:pointer;font:inherit}\n.hint{color:var(--muted);font-size:.85rem}\n.count{font-variant-numeric:tabular-nums;color:var(--fg)}\n.diag{border-left:2px solid var(--loss);padding-left:16px;color:var(--fg2)}\n.diag.ok{border-color:var(--win);color:var(--win)}\npre.code .ty{color:var(--muted)}\n.fnb{margin:0 0 22px}\n.fnb h3{margin:0 0 2px}\n.fnb .meta{color:var(--muted);font-size:.85rem;margin:0}\n.ops td.k{color:var(--muted)}\n"
y24 puts y22 y23
ym0w write y24 9
ym0t text "/* Matrix theme: black screen, neutral type, green only as light */\n:root{--bg:#000;--fg:#ededed;--fg2:#c9c9c9;--body:#a8a8a8;--muted:#6f6f6f;--dim:#4a4a4a;--line:#161616;--line2:#262626;--card:#060606;--pillbg:#000;--pillfg:#00ff41;--ghost:#0d0d0d;--a0:#00ff41;--c:#d9d9d9;--rust:#8c8c8c;--gray:#4d4d4d;--win:#00ff41;--loss:#ff4d4d;--glow1:rgba(0,255,65,.07);--glow2:rgba(0,255,65,.03);--markbg:rgba(0,255,65,.12)}\nbody{font-family:\"Geist Mono\",ui-monospace,SFMono-Regular,Menlo,monospace;font-size:15px;letter-spacing:.01em}\nh1,h2,.brand,.tcard .t{font-family:\"Geist Pixel\",\"Geist Mono\",monospace;font-weight:400}\n"
ym0u puts ym0w ym0t
ym1w write ym0u 9
ym1t text ".hero .name,.hero .tag,.brand,.tcard .big,.tile .n:not(.loss){color:var(--a0)}\n.chart,.tcard,.card,.tile,pre.code{border-radius:3px}\n.pill{border-radius:2px;border:1px solid var(--a0);text-transform:uppercase;letter-spacing:.1em;font-size:.75rem}\n.pill:hover{background:var(--a0);color:#000;filter:none}\n"
ym1u puts ym1w ym1t
ym2w write ym1u 9
ym2t text ".track .fill{border-radius:1px}\n.row .ratio.win{color:var(--a0)}\n.lrow.me .lbl{color:var(--a0)}\n::selection{background:var(--a0);color:#000}\n/* QA fixes */\nheader.top{background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\n.lrow{grid-template-columns:132px 1fr}\n.lrow .track{display:grid;grid-template-columns:1fr 78px;align-items:center;height:18px}\n.track .val{text-align:right;font-variant-numeric:tabular-nums;line-height:1}\n.lrow .lbl,.row .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n@media (max-width:600px){.lrow{grid-template-columns:108px 1fr}}\n:root{--muted:#8f8f8f;--dim:#6f6f6f}\n@media (max-width:720px){pre.code.wrap{white-space:pre-wrap;overflow-wrap:anywhere}}\n"
ym2u puts ym2w ym2t
ym3w write ym2u 9
ym3t text "button:focus-visible{outline:2px solid var(--a0);outline-offset:2px}\n@media (max-width:640px){textarea{font-size:16px!important}}\n@media (max-width:640px){.nav{gap:12px}.links{gap:10px}.links a{font-size:.78rem}.pill{padding:6px 9px;font-size:.68rem;letter-spacing:.05em}}\n"
ym3u puts ym3w ym3t
ym4w write ym3u 9
ym4t text "/* Minimal dark: black, neutral grays, green (#00ff41) only as an accent; Geist Sans for text, Geist Mono for code and the rain */\n:root{--bg:#000;--fg:#ededed;--fg2:#c4c4c4;--body:#a3a3a3;--muted:#7a7a7a;--dim:#555;--line:#1a1a1a;--line2:#2a2a2a;--card:transparent;--pillbg:transparent;--pillfg:#ededed;--ghost:transparent;--a0:#00ff41;--c:#bdbdbd;--rust:#6b6b6b;--gray:#3d3d3d;--win:#00ff41;--loss:#d4d4d4;--markbg:rgba(0,255,65,.1)}\nbody{font-family:\"Geist\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:16px;letter-spacing:0}\n.pixel,h1,h2,h3,.brand,.tcard .t{font-family:\"Geist\",-apple-system,sans-serif;font-weight:600;letter-spacing:-.03em}\n.row .lbl,.track .val,.yl,.xl,.pt .lbl{font-family:\"Geist\",-apple-system,sans-serif;font-variant-numeric:tabular-nums}\n.hero .name,.hero .tag,.brand,.tcard .big,.tile .n:not(.loss){color:var(--fg);text-shadow:none}\n.brand{color:var(--a0)}\n.stage{position:fixed!important;inset:0;z-index:-1!important;pointer-events:none}\n.stage::after{content:\"\";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.35),rgba(0,0,0,.78) 18%,rgba(0,0,0,.78) 82%,rgba(0,0,0,.35))}\n"
ym4u puts ym4w ym4t
ym5w write ym4u 9
ym5t text "header.top{background:rgba(0,0,0,.72);border-bottom:0}\n.chart,.tcard,.card,.tile{background:transparent;border:0;border-top:1px solid var(--line2);border-radius:0;padding-left:0;padding-right:0}\n.tcard{min-height:0}\npre.code{background:rgba(0,0,0,.7);border:1px solid var(--line2);border-radius:6px}\n.live .col{background:rgba(0,0,0,.8);border:0;border-left:1px solid var(--line2);border-radius:0}\n.pill{border:1px solid var(--line2);border-radius:6px;background:transparent;color:var(--fg);text-transform:none;letter-spacing:0;font-size:.85rem}\n.pill:hover{border-color:var(--a0);color:var(--a0);background:transparent}\n.tblwrap,.tblwrap td:first-child,.tblwrap th:first-child{background:#000}\n.legend span::before{border-radius:1px}\n.chart .cov{border:0;padding:0;color:var(--muted)}\n"
