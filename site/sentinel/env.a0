# env.a0: the environment the Sentinel crawls on: the host's cached element geometry (rows of
# id, x0, y0, x1, y1 in page CSS px, then kind | in-viewport << 8), looked up by element id, plus
# page <-> viewport conversion. The table is read, never measured here; the host updates it
# only when layout, scroll position set, or the observed elements change.
use "layout.a0"

# field p2 (0 id, 1 x0, 2 y0, 3 x1, 4 y1, 5 kind and flags) of row p1
fn rg u32x672 u32 u32 -> u32
b mul p1 7
i add b p2
v get p0 i
ret v
end
fn r_kind u32x672 u32 -> u32
f call rg p0 p1 5
k and f 255
ret k
end
fn r_vis u32x672 u32 -> bool
f call rg p0 p1 5
s shr f 8
b and s 1
r eq b 1
ret r
end
# rows are searched while the state is still "not found"
fn env_pred u32 u32 u32x672 u32 -> bool
r eq p0 4294967295
ret r
end
fn env_step u32 u32 u32x672 u32 -> u32
id call rg p2 p1 0
hit eq id p3
r select hit p1 p0
ret r
end
# the row of element p2 among p1 rows, or 4294967295
fn env_find u32x672 u32 u32 -> u32
r loop env_pred env_step p1 4294967295 p0 p2
ret r
end
# page integer px -> viewport Q16 (p0 is the page coordinate, p1 the scroll offset)
fn pg2vp u32 u32 -> u32
d sub p0 p1
r shl d 16
ret r
end
# viewport Q16 -> page integer px
fn vp2pg u32 u32 -> u32
a call fx_sar p0 16
r add a p1
ret r
end

# the point of the box (x0 y0 x1 y1) boundary nearest to (p4, p5)
fn edge_pt u32 u32 u32 u32 u32 u32 -> (u32,u32)
cx call fx_clamp p4 p0 p2
cy call fx_clamp p5 p1 p3
inx eq cx p4
iny eq cy p5
inside and inx iny
dl sub p4 p0
dr sub p2 p4
dt sub p5 p1
db sub p3 p5
m1 call fx_min dl dr
m2 call fx_min dt db
m call fx_min m1 m2
isl eq m dl
isr eq m dr
ist eq m dt
ex2 select isr p2 p4
ex select isl p0 ex2
ey4 select isr p5 p3
ey5 select isl p5 ey4
ey6 select ist p1 ey5
rx select inside ex cx
ry select inside ey6 cy
r rec rx ry
ret r
end


# the outward unit normal (Q16, axis aligned) of the box side that the point (p4, p5) lies nearest to
fn edge_normal u32 u32 u32 u32 u32 u32 -> (u32,u32)
sx add p0 p2
cx call fx_sar sx 1
sy add p1 p3
cy call fx_sar sy 1
wx sub p2 p0
hw call fx_sar wx 1
wy sub p3 p1
hh call fx_sar wy 1
dx sub p4 cx
dy sub p5 cy
adx call fx_abs dx
ady call fx_abs dy
a call fx_mul adx hh
b call fx_mul ady hw
horiz call fx_gt a b
nx0 call fx_isneg dx
ny0 call fx_isneg dy
sgx select nx0 4294901760 65536
sgy select ny0 4294901760 65536
nx select horiz sgx 0
ny select horiz 0 sgy
r rec nx ny
ret r
end
