# env.a0: the environment the Sentinel crawls on: the host's cached element geometry (rows of
# id, x0, y0, x1, y1 in page CSS px, then kind | in-viewport << 8), looked up by element id, plus
# page <-> viewport conversion. The table is read, never measured here; the host updates it
# only when layout, scroll position set, or the observed elements change.
use "layout.a0"

# field p2 (0 id, 1 x0, 2 y0, 3 x1, 4 y1, 5 kind and flags) of row p1
fn rg u32x1344 u32 u32 -> u32
b mul p1 7
i add b p2
v get p0 i
ret v
end
fn r_kind u32x1344 u32 -> u32
f call rg p0 p1 5
k and f 255
ret k
end
fn r_vis u32x1344 u32 -> bool
f call rg p0 p1 5
s shr f 8
b and s 1
r eq b 1
ret r
end
# rows are searched while the state is still "not found"
fn env_pred u32 u32 u32x1344 u32 -> bool
r eq p0 4294967295
ret r
end
fn env_step u32 u32 u32x1344 u32 -> u32
id call rg p2 p1 0
hit eq id p3
r select hit p1 p0
ret r
end
# the row of element p2 among p1 rows, or 4294967295
fn env_find u32x1344 u32 u32 -> u32
r loop env_pred env_step p1 4294967295 p0 p2
ret r
end
# page integer px -> viewport Q16 (p0 is the page coordinate, p1 the scroll offset)
fn pg2vp u32 u32 -> u32
d sub p0 p1
r shl d 16
ret r
end
# viewport Q16 -> page integer px
fn vp2pg u32 u32 -> u32
a call fx_sar p0 16
r add a p1
ret r
end
