x94 write x93 9
x95 text ".stage::after{content:\"\";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.35),rgba(0,0,0,.78) 18%,rgba(0,0,0,.78) 82%,rgba(0,0,0,.35))}\nheader.top{background:rgba(0,0,0,.72);border-bottom:0}\n.chart,.tcard,.card,.tile{background:transparent;border:0;border-top:1px solid var(--line2);border-radius:0;padding-left:0;padding-right:0}\n.tcard{min-height:0}\npre.code{background:rgba(0,0,0,.7);border:1px solid var(--line2);border-radius:6px}\n.live .col{background:rgba(0,0,0,.8);border:0;border-left:1px solid var(--line2);border-radius:0}\n.pill{border:1px solid var(--line2);border-radius:6px;background:transparent;color:var(--fg);text-transform:none;letter-spacing:0;font-size:.85rem}\n.pill:hover{border-color:var(--a0);color:var(--a0);background:transparent}\n.tblwrap,.tblwrap td:first-child,.tblwrap th:first-child{background:#000}\n.legend span::before{border-radius:1px}\n.chart .cov{border:0;padding:0;color:var(--muted)}\n"
