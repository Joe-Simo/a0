fn session io -> u32
r0 read p0
event at r0 0
tok at r0 1
x31 call css_a tok
x62 call css_b x31
x90 call css_c x62
x121 call css_d x90
x152 call css_e x121
x162 call css_f x152
x163 call nav x162 
x510 call sec_head x163
x665 call sec_lang x510
x730 call sec_iter x665
x1105 call sec_run x730
x1106 call foot x1105 
x1107 write x1106 6
x1108 write x1107 0
ret event
end
