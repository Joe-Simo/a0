x113 text "@media (max-width:720px){pre.code{font-size:13px;background:linear-gradient(90deg,rgba(0,0,0,.9) 30%,transparent) left/40px 100% no-repeat local,linear-gradient(270deg,rgba(0,0,0,.9) 30%,transparent) right/40px 100% no-repeat local,linear-gradient(90deg,rgba(255,255,255,.22),transparent) left/20px 100% no-repeat scroll,linear-gradient(270deg,rgba(255,255,255,.22),transparent) right/20px 100% no-repeat scroll,rgba(0,0,0,.7)}pre.code.wrap{background:rgba(0,0,0,.7)}}\n@media (max-width:640px){.links a{font-size:.85rem}.pill{font-size:.8rem}}\n.skip:focus-visible,.rail a:focus-visible{outline:2px solid var(--a0);outline-offset:2px}\n@media (max-width:900px){\n.links a,.hright>a:not(.ico){display:inline-flex;align-items:center;min-height:44px}\n.layout{display:block;padding-top:56px}\n"
