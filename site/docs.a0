x697 write x696 2
x698 text "use \"ui.a0\"\nuse \"../examples/life.a0\"\nfn page io -> io\na call open p0 5\nb call close a\nret b\nend"
x699 puts x697 x698
x700 call close x699 
x701 call close x700 
