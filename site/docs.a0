x59 text ".reveal.in #v3{animation:mark 9600ms cubic-bezier(.2,.7,.2,1) infinite}\n.reveal.in #v4{animation:mark2 9600ms cubic-bezier(.2,.7,.2,1) infinite}\n.reveal.in #a0{animation:a0 9600ms cubic-bezier(.2,.7,.2,1) infinite}\n.reveal.in #a1{animation:a1 9600ms cubic-bezier(.2,.7,.2,1) infinite}\n.reveal.in #a2{animation:a2 9600ms cubic-bezier(.2,.7,.2,1) infinite}\n.reveal.in #a3{animation:a3 9600ms cubic-bezier(.2,.7,.2,1) infinite}\n.reveal.in #a4{animation:a4 9600ms cubic-bezier(.2,.7,.2,1) infinite}\n.reveal.in .ns b::before{animation:ns 9600ms steps(1,end) infinite}\n/* final state without motion */\n.reveal:not(.in) .col,.reveal:not(.in) .asm .ln{opacity:1}\n.reveal:not(.in) #v3t,.reveal:not(.in) #v4t{opacity:0}\n.reveal:not(.in) .ln .ty{width:auto}\n@media (prefers-reduced-motion:reduce){.reveal.in *,.reveal.in *::before,.reveal.in *::after{animation:none!important}.reveal .col,.reveal .asm .ln{opacity:1}.reveal #v3t,.reveal #v4t{opacity:0}.reveal #v4{background:var(--markbg)}}\n"
