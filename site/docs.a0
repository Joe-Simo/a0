x764 puts x762 x763
x765 call close x764 
x766 write x765 2
x767 text "e0 fn clamp u32 u32 u32 -> u32\nlo lt p0 p1\nhi lt p2 p0\na select lo p1 p0\nr select hi p2 a\nret r\n\n"
x768 puts x766 x767
x769 call open x768 6
x770 write x769 4
x771 write x770 2
x772 text "cm"
x773 puts x771 x772
x774 write x773 2
x775 text "# reply\n"
x776 puts x774 x775
x777 call close x776 
x778 write x777 2
x779 text "e0\nhi lt p2 a\nr select hi p2 a"
x780 puts x778 x779
x781 call close x780 
x782 call close x781 
x783 call close x782 
x784 call open x783 13
x785 write x784 4
x786 write x785 1
x787 text "diagnostics"
x788 puts x786 x787
x789 call open x788 11
x790 write x789 2
x791 text "Diagnostics"
x792 puts x790 x791
x793 call close x792 
x794 call open x793 2
x795 write x794 2
x796 text "Every rejection carries a stable code (parse, type, structure, handle, revision, limit), what was expected, what was seen, and the one fix that resolves it. The compiler never guesses: a reply that is ambiguous is rejected with the fix, not applied approximately."
x797 puts x795 x796
x798 call close x797 
x799 call close x798 
ret x799
end

