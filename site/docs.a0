x83 text ".hero .name,.hero .tag,.brand,.tcard .big,.tile .n:not(.loss){color:var(--a0)}\n@media (prefers-color-scheme:dark){:where(:root:not([data-theme=light])) .hero .name,:where(:root:not([data-theme=light])) .hero .tag,:where(:root:not([data-theme=light])) .tcard .big{text-shadow:0 0 18px rgba(0,255,65,.35)}}:where(:root[data-theme=dark]) .hero .name,:where(:root[data-theme=dark]) .hero .tag,:where(:root[data-theme=dark]) .tcard .big{text-shadow:0 0 18px rgba(0,255,65,.35)}\nbody::after{content:\"\";position:fixed;inset:0;pointer-events:none;z-index:50;background:repeating-linear-gradient(to bottom,transparent 0,transparent 2px,rgba(0,0,0,.18) 3px)}\n@media (prefers-color-scheme:light){:where(:root:not([data-theme=dark])) body::after{display:none}}:where(:root[data-theme=light]) body::after{display:none}\n.chart,.tcard,.card,.tile,pre.code{border-radius:3px}\n.pill{border-radius:2px;border:1px solid var(--a0);text-transform:uppercase;letter-spacing:.1em;font-size:.75rem}\n"
