fn session io -> u32
r0 read p0
event at r0 0
tok at r0 1
x31 call css_a tok
x62 call css_b x31
x90 call css_c x62
x109 call css_d x90
x110 call nav x109 
x322 call sec_head x110
x676 call sec_lang x322
x804 call sec_iter x676
x890 call sec_run x804
x891 call foot x890 
x892 write x891 6
x893 write x892 0
ret event
end
