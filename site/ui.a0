hs9 call close hs8
hx1 call open hs9 9
hx2 write hx1 4
hx3 write hx2 3
hx4 text "https://x.com/joesimo"
hx5 puts hx3 hx4
hx6 write hx5 2
hx7 text "X"
hx8 puts hx6 hx7
hx9 call close hx8
x119 call close hx9
x120 call open x119 9
x121 write x120 4
x122 write x121 2
x123 text "pill"
x124 puts x122 x123
x125 write x124 4
x126 write x125 3
x127 text "https://github.com/Joe-Simo/a0"
x128 puts x126 x127
x129 write x128 2
x130 text "GitHub"
x131 puts x129 x130
x132 call close x131 
x133 call close x132 
x134 call close x133 
ret x134
end
# site footer
