# site footer
fn foot io -> io
x908 call open p0 17
x909 write x908 4
x910 write x909 2
x911 text "foot"
x912 puts x910 x911
x913 call open x912 2
x914 write x913 2
x915 text "Every number on this site is measured, reproducible from the repository, and published with its losses."
x916 puts x914 x915
x917 call close x916 
x918 call open x917 2
x919 write x918 2
x920 text "Made by "
x921 puts x919 x920
x922 call open x921 9
x923 write x922 4
x924 write x923 3
x925 text "https://x.com/joesimo"
x926 puts x924 x925
x927 write x926 2
x928 text "@joesimo"
x929 puts x927 x928
x930 call close x929 
x931 write x930 2
x932 text " · "
x933 puts x931 x932
x934 call open x933 9
x935 write x934 4
x936 write x935 3
x937 text "https://github.com/Joe-Simo/a0"
x938 puts x936 x937
x939 write x938 2
x940 text "GitHub"
x941 puts x939 x940
x942 call close x941 
sp1 write x942 2
