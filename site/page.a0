# a0lang.com home page, authored in A0. An io program speaking the A0 UI protocol (see ui.a0):
#   input : event x y ntext text[ntext] nstate state[nstate]   (this page keeps no state)
#   tags: 1 h1 2 p 3 button 4 code 5 div 6 span 7 ul 8 li 9 a 10 pre 11 h2 12 input 13 section
#         14 nav 15 h3 16 strong 17 footer 18 header 19 table 20 tr 21 td 22 th 23 small
#   attr keys: 1 id 2 class 3 href 4 type 5 placeholder 6 aria-label
# The browser runtime (site/app.ts) builds DOM from this stream and reports events back.
use "ui.a0"
fn css_a io -> io
x1 write p0 9
x2 text "@font-face{font-family:\"Geist\";src:url(\"/fonts/Geist-Variable.woff2\") format(\"woff2\");font-weight:100 900;font-display:swap}\n@font-face{font-family:\"Geist Mono\";src:url(\"/fonts/GeistMono-Variable.woff2\") format(\"woff2\");font-weight:100 900;font-display:swap}\n:root{color-scheme:dark;--bg:#000;--fg:#ededed;--mute:#a1a1a1;--line:#1f1f1f;--card:#0a0a0a;--g:#00ff41;--bar:#3a3a3a;--rain:.55;--rain-c:#00ff41;--rain-h:#d6ffe0;--mono:\"Geist Mono\",ui-monospace,\"SF Mono\",\"Cascadia Code\",Menlo,Consolas,monospace;--sans:\"Geist\",Inter,\"Segoe UI\",system-ui,-apple-system,sans-serif;--hdr:60px}\n"
x3 puts x1 x2
x4 write x3 9
x5 text "@media (prefers-color-scheme:light){:root:where(:not([data-theme=dark])){color-scheme:light;--bg:#fafafa;--fg:#0a0a0a;--mute:#666;--line:#e4e4e4;--card:#fff;--g:#007a1f;--bar:#cfcfcf;--rain:.55;--rain-c:#00a832;--rain-h:#006b20}}:root:where([data-theme=light]){color-scheme:light;--bg:#fafafa;--fg:#0a0a0a;--mute:#666;--line:#e4e4e4;--card:#fff;--g:#007a1f;--bar:#cfcfcf;--rain:.55;--rain-c:#00a832;--rain-h:#006b20}\n*{box-sizing:border-box}\nhtml{scroll-behavior:smooth;scroll-padding-top:calc(var(--hdr) + 16px)}\nbody{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 var(--sans);overflow-x:hidden;-webkit-font-smoothing:antialiased}\na{color:inherit}\ncode,.mono,.pixel{font-family:var(--mono)}\ncode{font-size:.9em}\n.mute{color:var(--mute)}\n.small{font-size:13px}\n:focus-visible{outline:2px solid var(--fg);outline-offset:2px}\n.skip{position:absolute;left:-9999px;top:8px;z-index:30;background:var(--fg);color:var(--bg);padding:8px 12px;border-radius:6px}\n.skip:focus{left:16px}\n"
x6 puts x4 x5
x7 write x6 9
x8 text ".copy-status{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n/* header and footer, shared by every page (site/ui.a0 nav and foot) */\n.top{position:sticky;top:0;z-index:20;height:var(--hdr);background:color-mix(in srgb,var(--bg) 85%,transparent);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}\n.nav{display:flex;align-items:center;gap:24px;height:100%;max-width:1200px;margin:0 auto;padding:0 24px}\n.brand{font:700 20px var(--mono);text-decoration:none;color:var(--fg)}\n.links{display:flex;gap:20px;font-size:14px}\n.links a{text-decoration:none;color:var(--mute)}\n.links a:hover{color:var(--fg)}\n.nav .sp{flex:1}\n.btn{display:inline-block;font:600 14px var(--sans);padding:8px 14px;border-radius:6px;background:var(--fg);color:var(--bg);text-decoration:none;border:0;cursor:pointer}\n.btn:hover{opacity:.88}\n"
x9 puts x7 x8
x10 write x9 9
x11 text ".theme{background:none;border:1px solid var(--line);color:var(--mute);border-radius:6px;height:34px;padding:0 10px;cursor:pointer;font:14px var(--mono)}\n.theme:hover{color:var(--fg)}\nhtml:not(.js) .theme{display:none}\n.foot{border-top:1px solid var(--line);padding:40px 0;font-size:13px;color:var(--mute);margin-top:48px}\n.fwrap{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;gap:24px;flex-wrap:wrap}\n.foot a{color:var(--mute)}\n.foot a:hover{color:var(--fg)}\n/* type */\nh1{font-size:clamp(34px,4.6vw,60px);line-height:1.04;letter-spacing:-.035em;margin:0 0 20px;font-weight:800}\nh2{font-size:clamp(28px,4vw,40px);line-height:1.1;letter-spacing:-.025em;margin:0 0 12px}\nh3{font-size:18px;margin:0 0 6px}\n.eyebrow{font:600 12px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--mute);margin:0 0 12px}\n.lede{color:var(--mute);font-size:18px;max-width:560px;margin:0}\n/* copy buttons and install lines */\n"
x12 puts x10 x11
x13 write x12 9
x14 text ".copy{position:relative;min-height:44px;min-width:44px;font:600 14px var(--sans);padding:8px 16px;border-radius:6px;background:none;border:1px solid var(--line);color:var(--fg);cursor:pointer;flex:none}\n.copy:hover{border-color:var(--mute)}\n.copy[hidden]{display:none}\n.copy[data-copied]{color:transparent}\n.copy[data-copied]::after{content:\"Copied\";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--fg)}\n.copy[data-copied=\"fail\"]::after{content:\"Select\"}\n.install{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--card);border-radius:8px;padding:6px 6px 6px 18px;font:15px var(--mono);margin:28px 0 12px;max-width:600px}\n.install code{flex:1;min-width:0;overflow-x:auto;white-space:nowrap;scrollbar-width:none;font-size:inherit}\n.install .pr{color:var(--mute)}\n.switch .os{display:flex;gap:4px;font:13px var(--mono)}\n"
x15 puts x13 x14
x16 write x15 9
x17 text ".switch .os button{background:none;border:1px solid transparent;color:var(--mute);padding:4px 10px;border-radius:6px;cursor:pointer;font:inherit}\n.switch .os button[aria-pressed=true]{border-color:var(--line);color:var(--fg)}\nhtml:not(.js) .switch>.os{display:none}\n.js .switch>.pane:not(.on){display:none}\n.home .switch .install{margin-bottom:8px}\n/* home page (site/gen/page.tpl) */\n.home .wrap{max-width:1200px;margin:0 auto;padding:0 24px}\n.home section{padding:96px 0;border-top:1px solid var(--line)}\n.home section.first{border-top:0}\n.home .hero{position:relative;overflow:hidden;padding:72px 0 88px}\n.home .rain{position:absolute;inset:0;opacity:var(--rain);pointer-events:none;color:transparent;font-size:0;overflow:hidden;--rain-color:var(--rain-c);--rain-head:var(--rain-h);-webkit-mask-image:linear-gradient(180deg,#000 0,#000 70%,transparent);mask-image:linear-gradient(180deg,#000 0,#000 70%,transparent)}\n"
x18 puts x16 x17
x19 write x18 9
x20 text ".home .rain canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n.home .hero .wrap{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:48px;align-items:start}\n.home .hcopy{background:radial-gradient(closest-side,var(--bg) 55%,transparent)}\n.badge{display:inline-flex;gap:8px;align-items:center;font:600 12px var(--mono);border:1px solid var(--line);border-radius:999px;padding:4px 12px 4px 4px;margin-bottom:24px;text-decoration:none;background:var(--card)}\n.badge b{background:var(--fg);color:var(--bg);border-radius:999px;padding:2px 8px}\n.home .row{display:flex;gap:16px;flex-wrap:wrap;align-items:center;font-size:14px;margin-top:14px}\n.home .row a:not(.btn){color:var(--mute);text-decoration:none}\n.home .row a:not(.btn):hover{color:var(--fg)}\n.panel{border:1px solid var(--line);background:var(--card);border-radius:10px;overflow:hidden;min-width:0}\n"
x21 puts x19 x20
x22 write x21 9
x23 text ".panel.tab>.os{display:flex;gap:0;overflow-x:auto;border-bottom:1px solid var(--line);scrollbar-width:none;font:13px var(--mono)}\n.panel.tab>.os button{flex:none;border:0;border-bottom:2px solid transparent;border-radius:0;padding:12px 14px}\n.panel.tab>.os button[aria-pressed=true]{border-color:var(--fg);color:var(--fg)}\n.home .chart{padding:20px;margin:0;border:0;border-radius:0}\n.home .panel.chart{border:1px solid var(--line);border-radius:10px}\n.home .chart+.chart{border-top:1px solid var(--line)}\n.home .chart .ct{font-size:16px;margin:0 0 4px}\n.home .chart .sub{font:12px var(--mono);color:var(--mute);margin:0 0 16px}\n.home .bars{display:grid;gap:7px}\n.brow{display:grid;grid-template-columns:minmax(84px,128px) minmax(0,1fr) auto;gap:12px;align-items:center}\n.brow .lbl{font-size:13px;line-height:1.15;color:var(--mute)}\n.brow.me .lbl{color:var(--fg);font-weight:700}\n.home .track{display:block;height:14px}\n"
x24 puts x22 x23
x25 write x24 9
x26 text ".home .track .fill{height:14px;max-width:100%;border-radius:2px;background:var(--bar);min-width:2px;transition:width .7s cubic-bezier(.2,.7,.2,1)}\n.track.win .fill{background:var(--g)!important}\n.home .val{font:12px var(--mono);text-align:right;white-space:nowrap;min-width:3.5em}\n.brow.me .val{font-weight:600}\n.home .alt{font:12px var(--mono);color:var(--mute);margin:10px 0 0}\n.home .verdict{margin:16px 0 0;font:600 14px var(--mono)}\n.home .losses{list-style:none;margin:8px 0 0;padding:0;font:13px var(--mono)}\n.home .losses li{padding:7px 0;border-top:1px solid var(--line);color:var(--mute)}\n.home .src{margin:10px 0 0;font-size:12px;color:var(--mute)}\n.home .src a{color:var(--fg)}\n.home .grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));margin-top:40px}\n.home .grid.two{grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr))}\n.card{border:1px solid var(--line);background:var(--card);border-radius:10px;padding:22px}\n"
x27 puts x25 x26
x28 write x27 9
x29 text ".card p{color:var(--mute);margin:6px 0 14px;font-size:15px}\n.tag{font:600 11px var(--mono);letter-spacing:.1em;color:var(--mute);text-transform:uppercase}\n.cmd{font:13px var(--mono);color:var(--fg);overflow-wrap:anywhere}\n.cmd::before{content:\"$ \";color:var(--mute)}\n.steps{counter-reset:s;display:grid;margin:32px 0 0;padding:0}\n.steps li{list-style:none;display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:18px 0;border-top:1px solid var(--line)}\n.steps li::before{counter-increment:s;content:counter(s,decimal-leading-zero);font:600 13px var(--mono);color:var(--mute)}\n.steps p{margin:4px 0 0;color:var(--mute);grid-column:2}\n.steps li>.cmd{grid-column:2;grid-row:1}\n.home p.small{margin-top:16px}\n.home table{width:100%;border-collapse:collapse;font-size:14px}\n.home td.small{font-size:12px;color:var(--mute)}\n/* inner pages: a sticky contents rail beside one column (benchmarks, docs) */\n.center{max-width:760px;margin:0 auto;padding:72px 24px 16px}\n"
x30 puts x28 x29
ret x30
end

fn css_b io -> io
x32 write p0 9
x33 text ".center h1{font-size:clamp(34px,4.6vw,56px)}\n.center p{color:var(--mute);font-size:18px;margin:0 0 20px}\n.pill{display:inline-block;font:600 14px var(--sans);padding:8px 14px;border-radius:6px;background:var(--fg);color:var(--bg);text-decoration:none;margin:0 6px 6px 0}\n.pill.ghost{background:none;border:1px solid var(--line);color:var(--fg)}\n.docs .hero{max-width:1200px;margin:0 auto;padding:56px 24px 0}\n.docs .hero h1{font-family:var(--sans)}\n.layout{display:grid;grid-template-columns:220px minmax(0,760px);gap:48px;max-width:1200px;margin:0 auto;padding:40px 24px 0}\n.rail{position:sticky;top:calc(var(--hdr) + 24px);align-self:start;font-size:14px;display:flex;flex-direction:column;max-height:calc(100vh - var(--hdr) - 48px);overflow-y:auto}\n.rail .rh{font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--mute);margin:20px 0 8px}\n.rail a{display:block;padding:4px 0;color:var(--mute);text-decoration:none}\n.rail a:hover,.rail a.on{color:var(--fg)}\n"
x34 puts x32 x33
x35 write x34 9
x36 text ".toc>summary{display:none}\n@media (min-width:901px){.toc::details-content{content-visibility:visible;display:block}.toc:not([open])>*:not(summary){display:block}}\n.main{min-width:0}\n.main section{padding:40px 0;border-top:1px solid var(--line)}\n.main section:first-child{border-top:0;padding-top:0}\n.main h2{font-size:clamp(26px,3.2vw,34px);margin:0 0 14px}\n.main h3{font-size:18px;margin:28px 0 8px}\n.main p{color:var(--mute);margin:0 0 14px}\n.main p strong,.main p b{color:var(--fg)}\n.main p.q{color:var(--fg);font-size:18px}\n.main p.take{color:var(--fg)}\n.main .nx{font-size:14px;margin-top:20px}\n.main .nx a{color:var(--fg)}\npre{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:16px;overflow-x:auto;font:13px/1.6 var(--mono);margin:0 0 16px}\npre.wrap{white-space:pre-wrap;overflow-wrap:anywhere}\npre code{font-size:inherit}\n.cm{color:var(--mute)}\n/* charts and tables of the benchmarks page; one neutral bar color, green only for an A0 bar that wins */\n"
x37 puts x35 x36
x38 write x37 9
x39 text ".chart{border:1px solid var(--line);border-radius:10px;background:var(--card);padding:20px;margin:22px 0 28px;min-width:0}\n.chart .ct{font-size:16px;margin:0 0 4px;font-weight:600;color:var(--fg)}\n.chart .sub{color:var(--mute);font-size:13px;margin:0 0 14px}\n.chart .cov,.chart .kh{font:12px var(--mono);color:var(--mute);margin:0 0 12px}\n.legend{display:none}\n.lrow{display:grid;grid-template-columns:120px minmax(0,1fr);gap:12px;align-items:center;padding:3px 0}\n.lrow .lbl{font-size:13px;color:var(--mute);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.lrow.me .lbl{color:var(--fg);font-weight:700}\n.lrow.wide{grid-template-columns:160px minmax(0,1fr)}\n.track{display:grid;grid-template-columns:minmax(0,1fr) 72px;gap:10px;align-items:center;height:12px}\n.track .fill{height:10px;border-radius:2px;background:var(--bar);min-width:2px;transition:width .7s cubic-bezier(.2,.7,.2,1)}\n.track .val,.lrow .val{font:12px var(--mono);color:var(--fg);white-space:nowrap;text-align:right}\n"
x40 puts x38 x39
x41 write x40 9
x42 text ".js .fill:not(.grown){width:0!important}\n.bars{display:grid;gap:4px}\n.row{display:grid;grid-template-columns:140px minmax(0,1fr) auto;gap:12px;align-items:center;padding:7px 0;border-top:1px solid var(--line)}\n.row .lbl{font:12px var(--mono);color:var(--mute);white-space:nowrap}\n.row .ratio{font:13px var(--mono);white-space:nowrap;text-align:right}\ndetails.more{margin-top:12px}\ndetails>summary{cursor:pointer;color:var(--mute);font:13px var(--mono);margin:8px 0}\n.cap{color:var(--mute);font-size:13px;margin:14px 0 0;border-top:1px solid var(--line);padding-top:12px}\n.tblwrap{overflow-x:auto;margin:16px 0}\ntable{width:100%;border-collapse:collapse;font-size:14px}\ncaption{text-align:left;color:var(--mute);font-size:13px;padding:0 0 8px}\nth,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}\nth{font:600 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}\ntd.mono{font-family:var(--mono);font-size:13px}\n"
x43 puts x41 x42
x44 write x43 9
x45 text "td.first{color:var(--fg);font-weight:700}\ntd.behind,td.loss,.val.loss,.ratio.loss{color:var(--mute)}\n.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:16px 0}\n.tile{border:1px solid var(--line);border-radius:10px;background:var(--card);padding:16px}\n.tile .n{font:700 28px var(--mono);color:var(--fg)}\n/* phone widths */\n@media (max-width:900px){.home .hero .wrap,.layout{grid-template-columns:minmax(0,1fr)}.rail{position:static;flex-direction:row;flex-wrap:wrap;gap:8px;max-height:none}.rail .rh{display:none}.rail a{padding:6px 12px;border:1px solid var(--line);border-radius:999px;font-size:13px}.toc{width:100%}.toc>summary{display:block}.toc[open]{display:flex;flex-wrap:wrap;gap:8px}}\n"
x46 puts x44 x45
x47 write x46 9
x48 text "@media (max-width:640px){.nav,.fwrap,.home .wrap,.layout,.center,.docs .hero{padding-left:16px;padding-right:16px}.nav{gap:12px}.links{gap:12px}.nav .btn{display:none}.home section{padding:64px 0}.home .hero{padding:48px 0 56px}.home .chart,.chart{padding:16px}.brow{grid-template-columns:minmax(64px,92px) minmax(0,1fr) auto;gap:8px}.lrow,.lrow.wide{grid-template-columns:96px minmax(0,1fr)}.track{grid-template-columns:minmax(0,1fr) 60px}.row{grid-template-columns:minmax(0,1fr) auto}.row .lbl{grid-column:1/-1}.install{font-size:13px;padding-left:12px}}\n@media (max-width:400px){.links a[href^=\"https\"]{display:none}.theme{padding:0 8px}}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}\n\n/* Source-token charts use one zero-based linear scale on both pages. */\n.token-bars{display:grid;gap:14px}\n.token-bars .track{display:block;height:14px;background:var(--line);border-radius:2px}\n"
x49 puts x47 x48
x50 write x49 9
x51 text ".token-bars .track .fill{height:14px;max-width:100%;background:var(--bar);border-radius:2px;min-width:0}\n.token-bars .me .fill{background:var(--fg)}\n.token-bars .val{font:13px var(--mono);text-align:right;white-space:nowrap;min-width:5em}\n.token-axis{font:12px var(--mono);color:var(--mute);margin:14px 0 0}\n.token-chart{max-width:760px;margin:24px 0}\n.token-bars .token-a0{width:90.28%}\n.token-bars .token-c{width:64.02%}\n.token-bars .token-js{width:64.00%}\n.token-bars .token-rust{width:65.65%}\n\n"
x52 puts x50 x51
ret x52
end

