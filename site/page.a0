x83 text ".chart details.more[open]>summary{padding-bottom:10px}\n.tblwrap table.rank th{white-space:normal;vertical-align:bottom;line-height:1.3;font-size:.74rem}\n.tblwrap table.rank th,.tblwrap table.rank td{padding:8px 7px}\n.tblwrap table.rank th:first-child{min-width:0}\n.tblwrap table.rank.fit{min-width:0}\n@media (max-width:720px){.tblwrap table.rank.fit th,.tblwrap table.rank.fit td{white-space:normal;padding:7px 6px;font-size:.82rem;line-height:1.35}.tblwrap table.rank.fit th{min-width:0}}\n@media (max-width:600px){.main p.take{font-size:1rem}.rank td{padding:7px 8px}}\n.chart .tblwrap{margin-top:18px}\n@media (max-width:600px){.lrow.wide{grid-template-columns:118px 1fr}.lrow.wide .track{grid-template-columns:1fr 84px}}\n/* Layout QA: hero scene columns per breakpoint (the prototype's own rules place the columns) */\n/* column widths fit the longest final line (27, 25 and 23 characters at 13px plus padding), so a line being typed never resizes or clips its column */\n"
