x115 text "stage"
x116 puts x114 x115
x117 write x116 13
x118 text "#version 300 es\nprecision highp float;\nuniform vec2 u_res;uniform float u_time;uniform vec2 u_mouse;uniform float u_dark;\nout vec4 o;\n#define N 40\nfloat h1(float n){return fract(sin(n)*43758.5453);}\nfloat hash2(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}\nmat2 rot(float a){float c=cos(a),s=sin(a);return mat2(c,-s,s,c);}\nvec3 node(int k,float t){\nfloat fk=float(k);\nfloat y=1.-2.*(fk+.5)/float(N);\nfloat r=sqrt(1.-y*y);\nfloat ph=fk*2.39996+t*.05*(.5+h1(fk*3.3));\nvec3 p=vec3(cos(ph)*r,y,sin(ph)*r);\np*=.95+.12*sin(t*.7+fk*1.7);\np.xz=rot(t*.12)*p.xz;p.yz=rot(.35+.15*sin(t*.2))*p.yz;\nreturn p;}\nvec2 proj(vec3 p,out float z){z=p.z+3.2;return p.xy/z*1.6;}\nfloat seg(vec2 p,vec2 a,vec2 b,out float u){vec2 ab=b-a;u=clamp(dot(p-a,ab)/dot(ab,ab),0.,1.);return length(p-(a+ab*u));}\nvoid main(){\nvec2 uv=(gl_FragCoord.xy-.5*u_res)/u_res.y;\nvec2 m=(u_mouse-.5);\nfloat t=u_time;\nfloat dk=u_dark;\nvec3 C=vec3(.85,.08,0.);\nvec2 cs=C.xy/(C.z+3.2)*1.6;\nuv-=m*vec2(.03,.02);\n"
x119 puts x117 x118
x120 write x119 13
x121 text "vec3 bg=mix(vec3(.985,.985,.99),vec3(.004,.005,.012),dk);\nfloat nebd=smoothstep(.2,1.,length(uv-cs));\nvec3 tint=mix(vec3(.05,.06,.16),vec3(.93,.94,1.),1.-dk);\nvec3 col=mix(mix(tint,bg,nebd),bg,mix(.15,.35,dk));\nvec2 sp=uv*150.;vec2 id=floor(sp);float st=hash2(id);vec2 g=fract(sp)-.5+(vec2(hash2(id+7.),hash2(id+13.))-.5)*.6;\nfloat tw=.5+.5*sin(t*1.3+st*80.);\ncol+=vec3(smoothstep(.08,0.,length(g))*step(.982,st)*tw)*dk*.9;\nvec3 ca=mix(vec3(.35,.4,.55),vec3(.55,.62,.8),dk);\nvec3 cb=mix(vec3(.45,.45,.5),vec3(.85,.85,.9),dk);\nfloat acc=0.;vec3 accc=vec3(0.);\nvec2 P[N];float Z[N];\nfor(int k=0;k<N;k++){float z;P[k]=proj(node(k,t)+C,z);Z[k]=z;}\nfor(int k=0;k<N;k++){\nfloat fk=float(k);\nfor(int j=0;j<3;j++){\nint o2=(k*(j==0?7:j==1?13:1)+j*5+3)%N;\nif(o2==k)continue;\nvec2 a=P[k],b=P[o2];\nfloat len=length(a-b);\nif(len>.5)continue;\nvec2 lo=min(a,b)-.03,hi=max(a,b)+.03;\nif(uv.x<lo.x||uv.x>hi.x||uv.y<lo.y||uv.y>hi.y)continue;\nfloat za=Z[k],zb=Z[o2];\nfloat u;float d=seg(uv,a,b,u);\n"
x122 puts x120 x121
x123 write x122 13
x124 text "float depth=smoothstep(4.3,2.2,mix(za,zb,u));\nfloat w=.0009*3.2/mix(za,zb,u);\nfloat line=smoothstep(w*3.,w*.3,d)*(.28+.5*depth)*(1.-smoothstep(.3,.52,len));\nvec3 lc=mix(ca,cb,h1(fk*5.1+float(j)));\naccc+=lc*line*.55;\nfloat ph=fract(t*(.12+.1*h1(fk*2.2+float(j)))+h1(fk*9.7+float(j)*3.));\nvec2 pp=mix(a,b,ph);\nfloat pd=length(uv-pp);\nfloat pulse=smoothstep(w*8.,0.,pd)*depth*step(ph,1.)*smoothstep(0.,.08,ph)*smoothstep(1.,.92,ph);\naccc+=(lc*.5+.5)*pulse*1.2;}}\nfor(int k=0;k<N;k++){\nfloat fk=float(k);\nfloat depth=smoothstep(4.3,2.2,Z[k]);\nfloat d=length(uv-P[k]);\nif(d>.09)continue;\nfloat rad=(.006+.006*h1(fk*1.9))*3.2/Z[k];\nfloat core=smoothstep(rad,rad*.35,d);\nfloat glow=exp(-d*d/(rad*rad*16.))*.5;\nfloat blink=.7+.3*sin(t*1.5+fk*2.1);\nvec3 nc=mix(ca,cb,h1(fk*4.4));\naccc+=(nc*glow+mix(nc,vec3(1.),.7)*core)*(.35+.65*depth)*blink;}\nfloat halo=exp(-pow(length(uv-cs),2.)*2.4)*.08;\ncol+=mix(vec3(.25,.4,1.),vec3(.3,.45,1.),dk)*halo*mix(.6,1.,dk);\ncol=mix(col+accc,col-accc*.75,1.-dk);\n"
x125 puts x123 x124
x126 write x125 13
x127 text "col=clamp(col,0.,1.);\nfloat vig=1.-smoothstep(.6,1.2,length(uv))*mix(.0,.5,dk);\ncol*=vig;\no=vec4(col,1.);}\n\n"
x128 puts x126 x127
