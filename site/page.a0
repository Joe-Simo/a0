x29 text ".track .val{transition:none;font-size:.7rem;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap;font-family:\"Geist Mono\",ui-monospace,monospace}\n.single .row{grid-template-columns:150px 1fr 118px}\n.lrow{display:grid;grid-template-columns:110px 1fr;gap:10px;align-items:center;padding:3px 0}\n.lrow .lbl{font-size:.8rem;color:var(--fg2);white-space:nowrap}\n.lrow .track{height:10px;grid-template-columns:1fr 64px}\n.lrow .track .fill{height:8px}\n.track.nat .fill{background:var(--a0)}\n.track.jit .fill{background:var(--c)}\n.track.int .fill{background:var(--rust)}\n.legend .lnat::before{background:var(--a0)}\n.legend .ljit::before{background:var(--c)}\n.legend .lint::before{background:var(--rust)}\n@media (max-width:600px){.lrow{grid-template-columns:84px 1fr}}\n.row .lbl{white-space:nowrap}\n.row .ratio{padding-right:4px}\n"
