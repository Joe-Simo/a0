x74 text "@keyframes a1{0%,61.354%{opacity:0;transform:translateY(5px)}65.729%,100%{opacity:1;transform:none}}\n@keyframes a2{0%,62.292%{opacity:0;transform:translateY(5px)}66.667%,100%{opacity:1;transform:none}}\n@keyframes a3{0%,63.229%{opacity:0;transform:translateY(5px)}67.604%,100%{opacity:1;transform:none}}\n@keyframes a4{0%,64.167%{opacity:0;transform:translateY(5px)}68.542%,100%{opacity:1;transform:none}}\n@keyframes ns{0%,65.615%{opacity:0}65.625%{opacity:1;content:\"0.0\"}66.667%{opacity:1;content:\"1.2\"}67.708%{opacity:1;content:\"2.4\"}68.750%{opacity:1;content:\"3.4\"}69.792%{opacity:1;content:\"4.2\"}70.833%{opacity:1;content:\"4.7\"}71.875%{opacity:1;content:\"4.9\"}72.917%{opacity:1;content:\"5.0\"}100%{opacity:1;content:\"5.0\"}}\n/* Matrix theme: black screen, neutral type, green only as light */\n"
x75 puts x73 x74
