fn session io -> u32
r0 read p0
event at r0 0
t0 at r0 1
r1 read t0
x at r1 0
ta at r1 1
r2 read ta
y at r2 0
tb at r2 1
rn read tb
nraw at rn 0
tc at rn 1
big lt 64 nraw
n select big 64 nraw
z call zeros
init0 rec z tc
rd fold readbyte n init0
buf at rd 0
td at rd 1
rs read td
te at rs 1
rc read te
counter at rc 0
tf at rc 1
rg0 read tf
gen at rg0 0
tg at rg0 1
rr read tg
running at rr 0
th at rr 1
zg call zero
rg call readgrid zg th
grid at rg 0
tok0 at rg 1

isclick eq event 1
isstep eq event 3
isrun eq event 4
isclear eq event 5
isglider eq event 6
iscell eq event 7
istick eq event 8
dostep select isstep true istick

stepped call step grid
gen1 add gen 1
zeroed call zero
gr1 get grid 1
gr1n or gr1 4
ga set grid 1 gr1n
gr2 get ga 2
gr2n or gr2 8
gb set ga 2 gr2n
gr3 get gb 3
gr3n or gr3 14
gc set gb 3 gr3n
bit shl 1 x
row get grid y
fl xor row bit
tg2 set grid y fl
g_a select iscell tg2 grid
g_b select isglider gc g_a
g_c select isclear zeroed g_b
grid2 select dostep stepped g_c
gen_a select isclear 0 gen
gen2 select dostep gen1 gen_a
run_t xor running 1
run_a select isclear 0 running
running2 select isrun run_t run_a
notrun sub 1 running2
counter_i add counter 1
counter1 select isclick counter_i counter
pop call population grid2

tok mov tok0
x1 write tok 9
x2 text ":root{--bg:#0a0c10;--panel:#11151c;--line:#232a35;--fg:#e8edf3;--muted:#98a2b3;--accent:#7c9cff;--accent2:#34d399;--win:#34d399;--loss:#f87171;--tie:#fbbf24}\n@media (prefers-color-scheme:light){:root{--bg:#ffffff;--panel:#f6f8fa;--line:#e5e7eb;--fg:#0f172a;--muted:#475569;--accent:#3b5bdb;--accent2:#059669;--win:#059669;--loss:#dc2626;--tie:#b45309}}\n*{box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--bg);color:var(--fg);font:16px/1.6 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Inter,Roboto,sans-serif;-webkit-font-smoothing:antialiased}\n.wrap{max-width:1040px;margin:0 auto;padding:0 24px}\n.top{position:sticky;top:0;backdrop-filter:blur(12px);background:color-mix(in srgb,var(--bg) 82%,transparent);border-bottom:1px solid var(--line);z-index:10}\n.nav{display:flex;align-items:center;justify-content:space-between;height:60px}\n.brand{font-weight:800;letter-spacing:.1em;font-size:1.1rem;color:var(--fg);text-decoration:none}\n"
x3 puts x1 x2
x4 write x3 9
x5 text ".links a{color:var(--muted);text-decoration:none;margin-left:24px;font-size:.95rem}\n.links a:hover{color:var(--fg)}\n.hero{padding:96px 24px 64px;text-align:center}\n.eyebrow{color:var(--accent2);font-size:.82rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;margin:0 0 18px}\nh1{font-size:clamp(2.4rem,6vw,4.3rem);line-height:1.04;letter-spacing:-.03em;margin:0 auto 22px;max-width:900px}\n.lede{color:var(--muted);font-size:1.15rem;max-width:760px;margin:0 auto 28px}\n.cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:52px}\n.btn{display:inline-block;padding:12px 22px;border-radius:8px;border:1px solid var(--line);color:var(--fg);text-decoration:none;font-weight:600;background:var(--panel);cursor:pointer;font:inherit;line-height:1.3}\n.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n.btn:hover{filter:brightness(1.12)}\n"
x6 puts x4 x5
x7 write x6 9
x8 text ".sample{text-align:left;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px 24px;max-width:760px;margin:0 auto;overflow:auto;font:14px/1.65 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--fg)}\n.sample .c{color:var(--muted)}\n.sample.wide{max-width:1040px;white-space:pre-wrap;font-size:13px}\nsection{padding:64px 24px}\nh2{font-size:clamp(1.7rem,3.5vw,2.4rem);letter-spacing:-.02em;margin:0 0 12px}\nh3{font-size:1.05rem;margin:0 0 8px}\np{margin:0 0 12px}\n.grid{display:grid;gap:16px;margin-top:32px}\n.three{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}\n.four{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px}\n.card p{color:var(--muted);margin:0;font-size:.95rem}\ntable.evidence{width:100%;border-collapse:collapse;margin-top:28px;font-size:.95rem}\n"
x9 puts x7 x8
x10 write x9 9
x11 text ".evidence th{text-align:left;color:var(--muted);font-weight:600;padding:10px 12px;border-bottom:1px solid var(--line)}\n.evidence td{padding:12px;border-bottom:1px solid var(--line);vertical-align:top}\n.evidence td:first-child{font-weight:600;white-space:nowrap}\n.tag{display:inline-block;padding:2px 10px;border-radius:999px;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em}\n.tag.win,.tag.pass{background:color-mix(in srgb,var(--win) 18%,transparent);color:var(--win)}\n.tag.tie{background:color-mix(in srgb,var(--tie) 18%,transparent);color:var(--tie)}\n.tag.loss{background:color-mix(in srgb,var(--loss) 18%,transparent);color:var(--loss)}\n.note{color:var(--muted);font-size:.95rem}\n.demo{display:grid;gap:16px;grid-template-columns:1fr 1fr;margin:24px 0}\n@media (max-width:720px){.demo{grid-template-columns:1fr}}\n.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px}\n"
