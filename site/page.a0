fn session io -> u32
r0 read p0
event at r0 0
t0 at r0 1
r1 read t0
x at r1 0
ta at r1 1
r2 read ta
y at r2 0
tb at r2 1
rn read tb
nraw at rn 0
tc at rn 1
big lt 64 nraw
n select big 64 nraw
z call zeros
init0 rec z tc
rd fold readbyte n init0
buf at rd 0
td at rd 1
rs read td
te at rs 1
rc read te
counter at rc 0
tf at rc 1
rg0 read tf
gen at rg0 0
tg at rg0 1
rr read tg
running at rr 0
th at rr 1
zg call zero
rg call readgrid zg th
grid at rg 0
tok0 at rg 1

isclick eq event 1
isstep eq event 3
isrun eq event 4
isclear eq event 5
isglider eq event 6
iscell eq event 7
istick eq event 8
dostep select isstep true istick

stepped call step grid
gen1 add gen 1
zeroed call zero
gr1 get grid 1
gr1n or gr1 4
ga set grid 1 gr1n
gr2 get ga 2
gr2n or gr2 8
gb set ga 2 gr2n
gr3 get gb 3
gr3n or gr3 14
gc set gb 3 gr3n
bit shl 1 x
row get grid y
fl xor row bit
tg2 set grid y fl
g_a select iscell tg2 grid
g_b select isglider gc g_a
g_c select isclear zeroed g_b
grid2 select dostep stepped g_c
gen_a select isclear 0 gen
gen2 select dostep gen1 gen_a
run_t xor running 1
run_a select isclear 0 running
running2 select isrun run_t run_a
notrun sub 1 running2
counter_i add counter 1
counter1 select isclick counter_i counter
pop call population grid2

