x14 text "input{font:inherit;width:100%;padding:10px 12px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--fg);margin-bottom:10px}\ncanvas{width:100%;max-width:512px;aspect-ratio:1;display:block;border:1px solid var(--line);border-radius:12px;background:var(--panel);color:var(--accent);touch-action:manipulation;margin:16px 0}\n.bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center}\n.stat{color:var(--muted);margin-left:6px}\n.stat strong{color:var(--fg);font-variant-numeric:tabular-nums}\n.tiles{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin:28px 0 8px}\n.tile{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px}\n.tile .big{font-size:2.2rem;font-weight:800;letter-spacing:-.03em;line-height:1.1}\n.tile .big.loss{color:var(--loss)}\n.tile .big.win{color:var(--win)}\n.tile p{color:var(--muted);margin:6px 0 0;font-size:.9rem}\n.chart{margin:28px 0 8px}\n.chart h3{margin-bottom:4px}\n"
