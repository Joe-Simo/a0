x47 text ".stamp{margin-top:1.2em;display:flex;align-items:center;gap:.7ch;color:var(--win);white-space:nowrap}\n.stamp i{position:relative;width:.6em;height:.6em;border-radius:50%;background:var(--win);flex:none}\n.stamp i::after{content:\"\";position:absolute;inset:0;border-radius:50%;border:1px solid var(--win);opacity:0}\n.stamp b{font-weight:500}\n.stamp span{color:var(--muted)}\n.asm .ln{color:var(--fg2);opacity:0}\n.ns{margin-top:1.2em;color:var(--muted);white-space:nowrap}\n.ns b{font-weight:500;color:var(--fg)}\n.ns b::before{content:\"5.0\"}\n@media (max-width:960px){.live{grid-template-columns:29ch 25ch;gap:1.2em 3ch;top:84px}.col.asm{grid-column:1}.col.model{grid-column:2;grid-row:1}}\n"
