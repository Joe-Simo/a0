x17 text ".chart .sub{color:var(--muted);font-size:.9rem;margin:0 0 14px}\n.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:.85rem;color:var(--muted);margin-bottom:10px}\n.legend span::before{content:\"\";display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:middle}\n.legend .la0::before{background:var(--accent)}\n.legend .lc::before{background:#9aa4b2}\n.legend .lrust::before{background:#c98b5f}\n.row{display:grid;grid-template-columns:110px 1fr 84px;gap:10px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}\n.row .lbl{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85rem;color:var(--muted)}\n.row .ratio{text-align:right;font-variant-numeric:tabular-nums;font-weight:700;font-size:.9rem}\n.row .ratio.loss{color:var(--loss)}\n.row .ratio.win{color:var(--win)}\n.bars{display:grid;gap:3px}\n.track{display:grid;grid-template-columns:1fr 70px;gap:8px;align-items:center;height:12px}\n"
x18 puts x16 x17
x19 write x18 9
x20 text ".track .fill{height:12px;border-radius:3px;background:#9aa4b2;min-width:2px}\n.track.a0 .fill{background:var(--accent)}\n.track.rust .fill{background:#c98b5f}\n.track .val{font-size:.75rem;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}\n.single .row{grid-template-columns:230px 1fr 84px}\n@media (max-width:600px){.row{grid-template-columns:80px 1fr 64px}.single .row{grid-template-columns:120px 1fr 64px}}\n.scatter{position:relative;height:280px;border-left:1px solid var(--line);border-bottom:1px solid var(--line);margin:18px 0 8px 48px}\n.pt{position:absolute;width:12px;height:12px;border-radius:50%;transform:translate(-50%,50%);background:#9aa4b2}\n.pt.a0{background:var(--accent)}\n.pt.rust{background:#c98b5f}\n.pt.haiku{opacity:.55}\n.pt .lbl{position:absolute;left:14px;top:-4px;font-size:.7rem;color:var(--muted);white-space:nowrap;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}\n"
x21 puts x19 x20
x22 write x21 9
x23 text ".axis{color:var(--muted);font-size:.8rem;display:flex;justify-content:space-between;margin-left:48px}\n.ylab{color:var(--muted);font-size:.8rem;margin:0 0 -8px 48px}\n.head{font-size:1.15rem;margin:28px 0 6px}\n.head strong{color:var(--fg)}\n.foot{padding:40px 24px 64px;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem}\n.dim{opacity:.6}\nhtml{scroll-padding-top:72px}\nbody{font-size:17px;line-height:1.65}\n.wrap{max-width:1120px}\n.hero{position:relative;overflow:hidden;padding:120px 24px 72px;text-align:left}\n.hero::before{content:\"\";position:absolute;inset:-40% -20% auto -20%;height:120%;background:radial-gradient(60% 50% at 30% 30%,color-mix(in srgb,var(--accent) 28%,transparent),transparent 70%),radial-gradient(40% 40% at 75% 20%,color-mix(in srgb,var(--accent2) 22%,transparent),transparent 70%);filter:blur(40px);animation:glow 18s ease-in-out infinite alternate;pointer-events:none;z-index:0}\n"
x24 puts x22 x23
x25 write x24 9
x26 text "@keyframes glow{from{transform:translate3d(-4%,0,0) scale(1)}to{transform:translate3d(4%,6%,0) scale(1.08)}}\n.hero>*{position:relative;z-index:1}\nh1{font-size:clamp(2.6rem,6.5vw,4.8rem);max-width:980px;margin:0 0 24px}\n.lede{max-width:820px;margin:0 0 32px}\n.cta{justify-content:flex-start}\n.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin:8px 0 48px}\n.stat-n{font-size:clamp(2rem,4.5vw,3.2rem);font-weight:800;letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums}\n.stat-n.win{color:var(--win)} .stat-n.loss{color:var(--loss)}\n.stat-l{color:var(--muted);margin-top:8px;font-size:.95rem;max-width:280px}\n.layout{display:grid;grid-template-columns:200px 1fr;gap:48px;align-items:start}\n.toc{position:sticky;top:84px;font-size:.9rem;display:flex;flex-direction:column;gap:10px}\n.toc a{color:var(--muted);text-decoration:none;border-left:2px solid var(--line);padding-left:12px}\n.toc a:hover{color:var(--fg);border-color:var(--accent)}\n"
x27 puts x25 x26
x28 write x27 9
x29 text "@media (max-width:860px){.layout{grid-template-columns:1fr}.toc{display:none}}\nsection{padding:72px 24px}\nh2{font-size:clamp(1.9rem,4vw,2.8rem);margin:0 0 14px}\n.claim{font-size:1.25rem;line-height:1.5;margin:0 0 18px;max-width:820px}\n.claim strong{color:var(--fg);font-weight:700}\n.reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease}\n.reveal.in{opacity:1;transform:none}\n.fill{transition:width .9s cubic-bezier(.2,.7,.2,1)}\n.fill:not(.grown){width:0!important}\n.card{transition:transform .25s ease,border-color .25s ease}\n.card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--accent) 50%,var(--line))}\n.faq{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}\n.faq .card h3{font-size:1rem}\n.limits{border-left:3px solid var(--loss);padding-left:16px;color:var(--muted)}\n.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9rem}\n"
x30 puts x28 x29
x31 write x30 9
x32 text "@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}.fill{transition:none}.hero::before{animation:none}}\n"
