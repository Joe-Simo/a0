x11 text ".evidence th{text-align:left;color:var(--muted);font-weight:600;padding:10px 12px;border-bottom:1px solid var(--line)}\n.evidence td{padding:12px;border-bottom:1px solid var(--line);vertical-align:top}\n.evidence td:first-child{font-weight:600;white-space:nowrap}\n.tag{display:inline-block;padding:2px 10px;border-radius:999px;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em}\n.tag.win,.tag.pass{background:color-mix(in srgb,var(--win) 18%,transparent);color:var(--win)}\n.tag.tie{background:color-mix(in srgb,var(--tie) 18%,transparent);color:var(--tie)}\n.tag.loss{background:color-mix(in srgb,var(--loss) 18%,transparent);color:var(--loss)}\n.note{color:var(--muted);font-size:.95rem}\n.demo{display:grid;gap:16px;grid-template-columns:1fr 1fr;margin:24px 0}\n@media (max-width:720px){.demo{grid-template-columns:1fr}}\n.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px}\n"
