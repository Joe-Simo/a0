x42 text ".docs .hero{min-height:0;padding:120px 24px 0;align-items:flex-start;flex-direction:column;justify-content:flex-start}\n.docs .hero::after{display:none}\n.docs .hero .name{font-size:clamp(2.6rem,7vw,5rem)}\n.live{position:absolute;left:28px;right:28px;top:96px;height:calc(66vh - 96px);display:grid;grid-template-columns:29ch 25ch 22ch;gap:0 5ch;align-content:start;font-size:clamp(13px,1.2vw,16px);line-height:1.75;pointer-events:none}\n.col{opacity:0;will-change:opacity,transform}\n.col h6{margin:0 0 .6em;font:inherit;font-size:.8em;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);display:flex;justify-content:space-between;gap:1em;white-space:nowrap}\n.col h6 b{font-weight:400;color:var(--muted)}\n.ln{position:relative;height:1.75em;white-space:nowrap;color:var(--fg2)}\n.ln .ty{display:inline-block;overflow:hidden;vertical-align:bottom;width:auto}\n"
