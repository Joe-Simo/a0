x119 text "/* Benchmark charts, one visual language: bold outlined bars, A0 the only saturated solid (the accent), every other language graphite or hollow, a large value on every bar, monospace figures, generous space, one grow-in */\n:root{--g-fill:#262626;--g-line:#d4d4d4;--g-dash:#a3a3a3}\n.chart{padding:32px 0 28px;margin:40px 0 48px}\n.chart .ct{font-size:clamp(1.25rem,2.4vw,1.6rem);font-weight:600;letter-spacing:-.02em;line-height:1.2;margin:0 0 10px;text-wrap:balance}\n.chart p.take{margin:0 0 14px;padding-left:0;border-left:0;color:var(--fg2);font-size:1.02rem;font-weight:400;line-height:1.5;max-width:68ch}\n.chart .sub{font-size:13px;line-height:1.5;color:var(--muted);margin:0 0 18px}\n.chart .cov{font-size:13px;margin:0 0 16px;font-family:\"Geist Mono\",ui-monospace,monospace}\n.chart .legend{gap:10px 22px;font-size:13px;color:var(--fg2);margin:0 0 22px}\n"
