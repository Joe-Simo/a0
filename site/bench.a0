x101 text ".rank td,.rank th{font-family:\"Geist\",-apple-system,sans-serif;font-variant-numeric:tabular-nums}\n.rail a.on{color:var(--fg);border-color:var(--a0)}\n@media (max-width:900px){.rail a.on{border:1px solid var(--a0);color:var(--a0);padding:6px 12px}}\n/* Header right group: Sponsor as text, X and GitHub as icon links (40px hit targets). The icons are\n   the simple-icons paths for X and GitHub (simple-icons 16.33.0, CC0-1.0; the marks stay the property\n   of their owners) as data: URIs used as a CSS mask, so they follow the text colour. No requests. */\n.ico-x{--ico:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M14.234%2010.162%2022.977%200h-2.072l-7.591%208.824L7.251%200H.258l9.168%2013.343L.258%2024H2.33l8.016-9.318L16.749%2024h6.993zm-2.837%203.299-.929-1.329L3.076%201.56h3.182l5.965%208.532.929%201.329%207.754%2011.09h-3.182z%22%2F%3E%3C%2Fsvg%3E\")}\n"
