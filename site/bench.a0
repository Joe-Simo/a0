x119 text ".chart{padding:32px 0 28px;margin:40px 0 48px}\n.chart .ct{font-size:clamp(1.25rem,2.4vw,1.6rem);font-weight:600;letter-spacing:-.02em;line-height:1.2;margin:0 0 10px;text-wrap:balance}\n.chart p.take{margin:0 0 14px;padding-left:0;border-left:0;color:var(--fg2);font-size:1.02rem;font-weight:400;line-height:1.5;max-width:68ch}\n.chart .sub{font-size:13px;line-height:1.5;color:var(--muted);margin:0 0 18px}\n.chart .cov{font-size:13px;margin:0 0 16px;font-family:\"Geist Mono\",ui-monospace,monospace}\n.chart .legend{gap:10px 22px;font-size:13px;color:var(--fg2);margin:0 0 22px}\n.chart .legend span::before{width:20px;height:14px;margin-right:9px;vertical-align:-2px;border:2px solid var(--g-line);border-radius:2px 6px 6px 2px;background:var(--g-fill)}\n.chart .legend .la0::before{background:var(--a0);border-color:var(--a0)}\n.chart .legend .lc::before,.chart .legend .lnat::before{background:var(--g-fill);border-color:var(--g-line)}\n"
x120 puts x118 x119
x121 write x120 9
x122 text ".chart .legend .lrust::before,.chart .legend .ljit::before{background:transparent;border-color:var(--g-line)}\n.chart .legend .lgray::before,.chart .legend .lint::before{background:transparent;border:2px dashed var(--g-dash)}\n.chart .lrow{grid-template-columns:140px minmax(0,1fr);gap:14px;padding:5px 0}\n.chart .lrow .lbl{font-size:14px;color:var(--fg2)}\n.chart .lrow .track,.chart .row .track{height:30px;grid-template-columns:minmax(0,1fr) 86px;gap:10px}\n.chart .row .track{grid-template-columns:minmax(0,1fr) 100px}\n.chart .lrow .track{background:linear-gradient(var(--line2),var(--line2)) 0 50%/calc(100% - 96px) 1px no-repeat}\n.chart .track .fill{height:24px;min-width:12px;box-sizing:border-box;border:2px solid var(--g-line);border-radius:2px 5px 5px 2px;background:var(--g-fill);transition:width .8s cubic-bezier(.2,.7,.2,1)}\n.chart .track.a0 .fill{background:var(--a0);border-color:var(--a0)}\n"
x123 puts x121 x122
x124 write x123 9
x125 text ".chart .track.c .fill,.chart .track.nat .fill{background:var(--g-fill);border-color:var(--g-line)}\n.chart .track.rust .fill,.chart .track.jit .fill{background:transparent;border-color:var(--g-line)}\n.chart .track.int .fill{background:transparent;border:2px dashed var(--g-dash)}\n.chart .track .val{font:600 15px \"Geist Mono\",ui-monospace,monospace;color:var(--fg);text-align:right;font-variant-numeric:tabular-nums}\n.chart .track.a0 .val,.chart .lrow.me .val{color:var(--a0)}\n.chart .lrow.me{background:transparent;border-radius:0;margin:0;padding-left:0;padding-right:0}\n.chart .lrow.me .lbl{color:var(--a0);font-weight:600;font-size:15px}\n.chart .lrow.me .track{height:34px}\n.chart .lrow.me .fill{height:28px}\n.chart .row{grid-template-columns:140px minmax(0,1fr) auto;gap:14px;padding:12px 0}\n.chart .row .lbl{font-size:14px;color:var(--fg2)}\n.chart .bars{gap:6px}\n"
x126 puts x124 x125
x127 write x126 9
x128 text ".chart .row .ratio{font:600 15px \"Geist Mono\",ui-monospace,monospace;color:var(--fg);padding:3px 10px;border:2px solid transparent;border-radius:999px}\n.chart .row .ratio.win{color:var(--a0);border-color:var(--a0)}\n.chart .row .ratio.loss{color:var(--fg);border:2px dashed var(--g-line)}\n.chart details.more{margin-top:20px}\n.chart .cap{font-size:13px;font-style:normal;color:var(--muted)}\n@media (max-width:600px){\n.chart{padding:24px 0 20px;margin:28px 0 36px}\n.chart .lrow,.chart .lrow.wide{grid-template-columns:96px minmax(0,1fr);gap:8px}\n.chart .lrow .lbl{font-size:13px}\n.chart .lrow .track,.chart .row .track{grid-template-columns:minmax(0,1fr) 64px;gap:6px}\n.chart .row .track{grid-template-columns:minmax(0,1fr) 76px}\n.chart .track .val{font-size:13px}\n.chart .row,.chart .single .row{grid-template-columns:minmax(0,1fr) auto;row-gap:6px}\n.chart .row .lbl{grid-column:1/-1}\n}\n@media (prefers-reduced-motion:reduce){.chart .track .fill{transition:none}}\n"
x129 puts x127 x128
x130 write x129 9
x131 text "/* a page without the section rail (the landing page) is one centred column */\n.layout:not(:has(.rail)){grid-template-columns:minmax(0,820px)}\n/* the code rain belongs to the hero: behind the content it sits under a soft dark panel so text and charts stay legible */\n.layout{position:relative;z-index:1}\n.layout::before{content:\"\";position:absolute;inset:0 -32px;z-index:-1;background:rgba(0,0,0,.92);box-shadow:0 0 56px 40px rgba(0,0,0,.92);pointer-events:none}\n/* docs page only (scoped by the .docs ancestor): a readable column, a sticky contents on desktop, a collapsible one on mobile */\n.docs .layout{grid-template-columns:220px minmax(0,780px);gap:48px}\n.docs .main p{max-width:70ch;line-height:1.65}\n.docs .main h3{font-size:1.05rem;font-weight:600;margin:28px 0 10px;color:var(--fg)}\n.docs .main section{scroll-margin-top:80px}\n.docs pre.code{font-size:14px;line-height:1.6}\n.docs .toc>summary{list-style:none;cursor:pointer}\n.docs .toc>summary::-webkit-details-marker{display:none}\n"
x132 puts x130 x131
x133 write x132 9
x134 text ".docs .toc>summary:focus-visible{outline:2px solid var(--a0);outline-offset:2px;border-radius:6px}\n.docs .rail a{display:block;padding:6px 0 6px 12px}\n.docs .rail a.on{padding:6px 0 6px 10px}\n@media (min-width:901px){.docs .toc>summary{display:none}.docs .toc::details-content{content-visibility:visible;display:block}.docs .rail{max-height:calc(100vh - 120px);overflow-y:auto}}\n@media (max-width:900px){\n.docs .layout{display:block}\n.docs .rail{position:static;display:block;overflow:visible;margin:0 0 24px;padding:0;background:none;border:0;-webkit-mask:none;mask:none}\n.docs .toc>summary{display:flex;align-items:center;justify-content:space-between;min-height:44px;padding:0 16px;border:1px solid var(--line);border-radius:8px;color:var(--fg);font-size:15px}\n.docs .toc>summary::after{content:\"+\";color:var(--muted)}\n.docs .toc[open]>summary::after{content:\"\\2212\"}\n.docs .toc[open] .rh{display:block;margin:14px 0 2px 12px}\n"
