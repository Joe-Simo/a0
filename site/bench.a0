x157 text ".home h1,.home h2,.home h3{font-family:\"Geist\",-apple-system,sans-serif;margin:0;color:var(--fg)}\n.home p{margin:0}\n.home .hhero{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:center;border-top:1px solid var(--hline)}\n.home .rain{position:absolute;inset:0;opacity:var(--hrain);pointer-events:none;color:transparent;font-size:0;overflow:hidden;--rain-color:var(--hg);--rain-head:var(--hhead)}\n.home .rain canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n.home .hfade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,color-mix(in srgb,var(--bg) 88%,transparent) 0,color-mix(in srgb,var(--bg) 70%,transparent) 42%,transparent 75%),linear-gradient(0deg,var(--bg) 0,transparent 22%)}\n.home .hcopy,.home .hside{position:relative;z-index:1;padding:72px 48px;min-width:0}\n.home .hhero h1{font-size:64px;line-height:64px;font-weight:400;letter-spacing:-.06em;max-width:10ch}\n"
