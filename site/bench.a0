x45 text ".col h6 b{font-weight:400;color:var(--muted)}\n.ln{position:relative;height:1.75em;white-space:nowrap;color:var(--fg2)}\n.ln .ty{display:inline-block;overflow:hidden;vertical-align:bottom;width:auto}\n.ln::after{content:\"\";display:inline-block;width:.55ch;height:1.05em;margin-left:.1ch;background:var(--fg);vertical-align:-.15em;opacity:0}\n.ln.mark{margin:0 -.6ch;padding:0 .6ch;border-radius:4px}\n.ln .alt{position:absolute;left:.6ch;top:0}\n.stamp{margin-top:1.2em;display:flex;align-items:center;gap:.7ch;color:var(--win);white-space:nowrap}\n.stamp i{position:relative;width:.6em;height:.6em;border-radius:50%;background:var(--win);flex:none}\n.stamp i::after{content:\"\";position:absolute;inset:0;border-radius:50%;border:1px solid var(--win);opacity:0}\n.stamp b{font-weight:500}\n.stamp span{color:var(--muted)}\n.asm .ln{color:var(--fg2);opacity:0}\n.ns{margin-top:1.2em;color:var(--muted);white-space:nowrap}\n.ns b{font-weight:500;color:var(--fg)}\n.ns b::before{content:\"5.0\"}\n"
