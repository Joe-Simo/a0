x95 text "/* Minimal dark: black, neutral grays, green (#00ff41) only as an accent; Geist Sans for text, Geist Mono for code and the rain */\n:root{--bg:#000;--fg:#ededed;--fg2:#c4c4c4;--body:#a3a3a3;--muted:#7a7a7a;--dim:#555;--line:#1a1a1a;--line2:#2a2a2a;--card:transparent;--pillbg:transparent;--pillfg:#ededed;--ghost:transparent;--a0:#00ff41;--c:#bdbdbd;--rust:#6b6b6b;--gray:#3d3d3d;--win:#00ff41;--loss:#d4d4d4;--markbg:rgba(0,255,65,.1)}\nbody{font-family:\"Geist\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:16px;letter-spacing:0}\n.pixel,h1,h2,h3,.brand,.tcard .t{font-family:\"Geist\",-apple-system,sans-serif;font-weight:600;letter-spacing:-.03em}\n.row .lbl,.track .val,.yl,.xl,.pt .lbl{font-family:\"Geist\",-apple-system,sans-serif;font-variant-numeric:tabular-nums}\n.hero .name,.hero .tag,.brand,.tcard .big,.tile .n:not(.loss){color:var(--fg);text-shadow:none}\n.brand{color:var(--a0)}\n.stage{position:fixed!important;inset:0;z-index:-1!important;pointer-events:none}\n"
