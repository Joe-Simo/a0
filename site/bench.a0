x107 text ".hright{display:flex;align-items:center;gap:6px}\n.hright>a{color:var(--fg2);text-decoration:none;font-size:.9rem}\n.hright>a:hover{color:var(--a0)}\n.hright .ico{display:inline-block;width:40px;height:40px;background:currentColor;-webkit-mask:var(--ico) center/20px 20px no-repeat;mask:var(--ico) center/20px 20px no-repeat}\n.hright .ico:focus-visible{outline:2px solid var(--a0);outline-offset:-4px;border-radius:6px}\n.hright>a:first-child{margin-right:6px}\n@media (max-width:640px){.nav{gap:10px}.brand{margin-right:0}.links{gap:12px}.hright{gap:0}.hright>a:first-child{margin-right:2px;font-size:.85rem}}\n/* Accessibility and legibility: muted text at 7.5:1 on black, a 13px floor for labels, a skip link, 44px touch targets */\n:root{--muted:#9a9a9a;--dim:#808080}\n.skip{position:absolute;left:12px;top:-120px;z-index:100;padding:10px 16px;border-radius:6px;background:var(--a0);color:#000;font-weight:600;text-decoration:none}\n.skip:focus{top:10px}\n"
