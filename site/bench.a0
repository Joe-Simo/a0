x144 text "/* /benchmarks: purpose lines, chart rules (A0 filled and accented, the rest outlined, a loss is a word), page head */\n.bench.center{max-width:1016px;padding:56px 24px 0;text-align:left}\n.bench.center h1,.bench.center p{margin:0 0 12px;max-width:none}\n.bench.layout{padding-top:24px}\n.bench .pill:not(.ghost){background:var(--a0);color:#000}\n.bench .pill.ghost{background:none;border:1px solid var(--line2);color:var(--fg)}\n.bench .q{color:var(--fg);margin:0 0 14px}\n.bench .nx{font-size:.9rem;color:var(--muted);margin:16px 0 0}\n.bench .nx a,.bench td a{color:var(--fg);text-underline-offset:3px;display:inline-block;padding:12px 0}\n.bench .tblwrap table.rank td{white-space:normal}\n@media (min-width:1064px){.bench.center{padding-left:0}}\n.bench p.take{border-color:var(--line2)}\n.bench .rail a.on{border-color:var(--fg)}\n.bench .rank td.first,.bench .tile .n:not(.loss){color:var(--fg)}\n.bench .lrow .track,.bench .row .track{grid-template-columns:1fr 130px;height:auto;min-height:18px}\n"
