l call wab2 k 13 1 p1
m call walx l 32 0 p1
n call walx m 32 1 p1
o call walx n 32 3 p1
q call waci o 4 p1
r call wab2 q 108 106 p1
s call wamem r 40 0 p1
u call walx s 16 1 p1
v call walx u 32 3 p1
w call waci v 1 p1
x call wab w 106 p1
y call walx x 33 3 p1
z call wab2 y 12 0 p1
z1 call wab3 z 11 11 11 p1
ret z1
end
# the three helpers, each with its size first
fn wkhelp (io,u32,u32,u32) u32 u32 u32 bool -> (io,u32,u32,u32)
t at p0 0
c at p0 1
m0 rec t 0 0 0
x1 call wkhrd m0 p2 false
h1 at x1 1
y1 at x1 0
s1 rec y1 c 0 0
a1 call waul s1 h1 p4
a2 call wkhrd a1 p2 p4
t2 at a2 0
c2 at a2 1
m2 rec t2 0 0 0
x2 call wkhwr m2 p2 p3 false
h2 at x2 1
y2 at x2 0
s2 rec y2 c2 0 0
b1 call waul s2 h2 p4
b2 call wkhwr b1 p2 p3 p4
t3 at b2 0
c3 at b2 1
m3 rec t3 0 0 0
x3 call wkhpu m3 false
h3 at x3 1
y3 at x3 0
s3 rec y3 c3 0 0
d1 call waul s3 h3 p4
d2 call wkhpu d1 p4
ret d2
end
# the helpers' code section bytes (sizes included)
fn wkhsum io u32 u32 -> (io,u32)
m0 rec p0 0 0 0
x call wkhelp m0 0 p1 p2 false
t at x 0
c at x 1
r rec t c
ret r
end
# body size of variant p1 (p2: the io helpers are present)
fn wkbsz u32x128x256 u32 bool -> u32
b mul p1 8
b1 add b 1
lc_p shr b1 7
lc_g get p0 lc_p
lc_w and b1 127
lc get lc_g lc_w
b2 add b 2
fr_p shr b2 7
fr_g get p0 fr_p
fr_w and b2 127
fr get fr_g fr_w
b3 add b 3
fp_p shr b3 7
fp_g get p0 fp_p
fp_w and b3 127
fp get fp_g fp_w
b4 add b 4
nb_p shr b4 7
nb_g get p0 nb_p
nb_w and b4 127
nb get nb_g nb_w
b6 add b 6
z0_p shr b6 7
z0_g get p0 z0_p
z0_w and b6 127
z0 get z0_g z0_w
b7 add b 7
z1_p shr b7 7
z1_g get p0 z1_p
z1_w and b7 127
z1 get z1_g z1_w
lz eq lc 0
vz eq fr 0
ul call wauln lc
vl call wauln fr
lg2 add ul 1
vg2 add vl 1
ig select lz 0 lg2
vg select vz 0 vg2
lsz0 add ig vg
lsz add lsz0 1
rz select p2 z1 z0
s1 add lsz nb
s2 add s1 rz
s add s2 1
ret s
end
fn wkcsz u32 u32 u32x128x256 bool -> u32
b call wkbsz p2 p1 p3
u call wauln b
s add u b
r add p0 s
ret r
end
# word p1 of a page of code: a byte, a call marker or a pool marker (literal addresses p3,
# p4 the io helper count)
fn wkcw (io,u32,u32,u32) u32 u32x128 u32x128x8 u32 -> (io,u32,u32,u32)
w get p2 p1
isb lt w 256
isp ge w 2147483648
ge259 ge w 259
nisp select isp false true
isf and ge259 nisp
nisb select isb false true
nf select isf false true
ish1 and nisb nisp
ish and ish1 nf
nb select isb 1 0
a fold wabst nb p0 w true
fi sub w 259
fidx add fi p4
hidx sub w 256
cidx select isf fidx hidx
isc or isf ish
nc select isc 1 0
b fold walxst nc a 16 cidx true
seq and w 2147483647
ad_p shr seq 7
ad_g get p3 ad_p
ad_w and seq 127
ad get ad_g ad_w
np select isp 1 0
c fold wacist np b ad true
ret c
end
# page p1 of a variant's p2 code words, read and written
fn wkcpg (io,u32,u32,u32) u32 u32 u32x128x8 u32 -> (io,u32,u32,u32)
t at p0 0
c at p0 1
l at p0 2
m at p0 3
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp t
s fold rbyte cnt s0
pg at s 0
t2 at s 1
s1 rec t2 c l m
r fold wkcw cnt s1 pg p3 p4
ret r
end
# the literal addresses of a function: occurrences [p1, p1 + 1024)
fn wkfow u32x128 u32 u32x128 u32x128 u32 -> u32x128
i add p4 p1
inb ge i 128
r0 and i 127
x get p2 r0
y get p3 r0
v select inb y x
r set p0 p1 v
ret r
end
fn wkfop u32x128x8 u32 u32x128x32 u32 -> u32x128x8
s mul p1 128
s2 add p3 s
a shr s2 7
o and s2 127
a1 add a 1
pa get p2 a
pb get p2 a1
zp call zpage
pg fold wkfow 128 zp pa pb o
r set p0 p1 pg
ret r
end
fn wkfocc u32x128x32 u32 -> u32x128x8
z call z8
r fold wkfop 8 z p0 p1
ret r
end
# variant p4 + p1: size, local groups (i32, v128), code, end
fn wkcvar (io,u32,u32,u32) u32 u32x128x256 u32x128x8 u32 bool -> (io,u32,u32,u32)
v add p4 p1
bs call wkbsz p2 v p5
nh select p5 3 0
b mul v 8
b1 add b 1
lc_p shr b1 7
lc_g get p2 lc_p
lc_w and b1 127
lc get lc_g lc_w
b2 add b 2
fr_p shr b2 7
fr_g get p2 fr_p
fr_w and b2 127
fr get fr_g fr_w
b3 add b 3
fp_p shr b3 7
fp_g get p2 fp_p
fp_w and b3 127
fp get fp_g fp_w
b4 add b 4
nb_p shr b4 7
nb_g get p2 nb_p
nb_w and b4 127
nb get nb_g nb_w
b5 add b 5
nr_p shr b5 7
nr_g get p2 nr_p
nr_w and b5 127
nr get nr_g nr_w
a call waul p0 bs true
lz eq lc 0
vz eq fr 0
nlz select lz 0 1
nvz select vz 0 1
ng1 add nlz nvz
c call wab a ng1 true
d fold waulst nlz c lc true
e fold wabst nlz d 127 true
f fold waulst nvz e fr true
g fold wabst nvz f 123 true
nw add nb nr
n127 add nw 127
np shr n127 7
l fold wkcpg np g nw p3 nh
r call wab l 11 true
ret r
end
# function p1's variants (field 2 of the state: the index of its first variant)
fn wkcfn (io,u32,u32,u32) u32 u32x128x256 u32x128x64 u32x128x32 bool -> (io,u32,u32,u32)
b mul p1 4
b2 add b 2
nv_p shr b2 7
nv_g get p3 nv_p
nv_w and b2 127
nv get nv_g nv_w
b3 add b 3
ob_p shr b3 7
ob_g get p3 ob_p
ob_w and b3 127
ob get ob_g ob_w
fo call wkfocc p4 ob
vi at p0 2
r fold wkcvar nv p0 p2 fo vi p5
t at r 0
c at r 1
m at r 3
vi2 add vi nv
o rec t c vi2 m
ret o
end
# the pool: the words of page 80 + p1 as bytes
fn wkdw (io,u32,u32,u32) u32 u32x128 bool -> (io,u32,u32,u32)
w get p2 p1
b0 and w 255
s1 shr w 8
b1 and s1 255
s2 shr w 16
b2 and s2 255
b3 shr w 24
a call wab2 p0 b0 b1 p3
b call wab2 a b2 b3 p3
ret b
end
fn wkdpg (io,u32,u32,u32) u32 u32x128x500 u32 bool -> (io,u32,u32,u32)
pi add 80 p1
pg get p2 pi
base mul p1 128
rest sub p3 base
big gt rest 128
cnt select big 128 rest
r fold wkdw cnt p0 pg p4
ret r
end
fn wkdata (io,u32,u32,u32) u32 u32x128x500 u32 bool -> (io,u32,u32,u32)
