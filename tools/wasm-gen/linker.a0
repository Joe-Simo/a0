# the io helpers' bodies (locals, code, end): src/wasm.ts `ioRead`, `ioWrite`, `ioPuts`
fn wkhrd (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
ni mul p1 4
ps add ni 4
a call wab p0 0 p2
b call walx a 32 0 p2
c call wamem b 40 ps p2
d call walx c 32 0 p2
e call wamem d 40 ni p2
f call wab e 73 p2
