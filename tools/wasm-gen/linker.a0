fr at r4 0
t4 at r4 1
r5 call wardw t4
fp at r5 0
t5 at r5 1
q0 rec t5 0 0 0 false
q loop wkrgo wkref 16777216 q0 p2 p3
t6 at q 0
z0 at q 1
z1 at q 2
nr at q 3
r7 call wardw t6
nb at r7 0
t7 at r7 1
rh shl rs 16
w0 or pa rh
b mul vi 8
a0_p shr b 7
a0_g get lv a0_p
a0_w and b 127
a0_h set a0_g a0_w w0
a0 set lv a0_p a0_h
b1 add b 1
a1_p shr b1 7
a1_g get a0 a1_p
a1_w and b1 127
a1_h set a1_g a1_w lc
a1 set a0 a1_p a1_h
b2 add b 2
a2_p shr b2 7
a2_g get a1 a2_p
a2_w and b2 127
a2_h set a2_g a2_w fr
a2 set a1 a2_p a2_h
b3 add b 3
a3_p shr b3 7
a3_g get a2 a3_p
a3_w and b3 127
a3_h set a3_g a3_w fp
a3 set a2 a3_p a3_h
b4 add b 4
a4_p shr b4 7
a4_g get a3 a4_p
a4_w and b4 127
a4_h set a4_g a4_w nb
a4 set a3 a4_p a4_h
b5 add b 5
a5_p shr b5 7
a5_g get a4 a5_p
a5_w and b5 127
a5_h set a5_g a5_w nr
a5 set a4 a5_p a5_h
b6 add b 6
a6_p shr b6 7
a6_g get a5 a6_p
a6_w and b6 127
a6_h set a6_g a6_w z0
a6 set a5 a6_p a6_h
b7 add b 7
a7_p shr b7 7
a7_g get a6 a7_p
a7_w and b7 127
a7_h set a7_g a7_w z1
a7 set a6 a7_p a7_h
vi2 add vi 1
o rec a7 t7 vi2
ret o
end
# state: (variants functions names io variants literals depth io-flag name-bytes code)
fn wkmf (u32x128x256,u32x128x64,u32x128x64,io,u32,u32,u32,u32,u32,u32) u32 u32x128x32 -> (u32x128x256,u32x128x64,u32x128x64,io,u32,u32,u32,u32,u32,u32)
lv at p0 0
lf at p0 1
ln at p0 2
tk at p0 3
nvar at p0 4
occb at p0 5
maxd at p0 6
iof at p0 7
nnm at p0 8
err at p0 9
r1 call wardw tk
nlit at r1 0
t1 at r1 1
r2 call wardw t1
fio at r2 0
t2 at r2 1
r3 call wardw t2
dep at r3 0
t3 at r3 1
r4 call wardw t3
nlen at r4 0
t4 at r4 1
nm0 rec ln t4
nm call wkrdln nm0 nnm nlen
ln2 at nm 0
t5 at nm 1
r6 call wardw t5
nv at r6 0
t6 at r6 1
vs0 rec lv t6 nvar
vs fold wkmv nv vs0 p2 occb
lv2 at vs 0
t7 at vs 1
nvar2 at vs 2
b mul p1 4
f0_p shr b 7
f0_g get lf f0_p
f0_w and b 127
f0_h set f0_g f0_w nnm
f0 set lf f0_p f0_h
b1 add b 1
f1_p shr b1 7
f1_g get f0 f1_p
f1_w and b1 127
f1_h set f1_g f1_w nlen
f1 set f0 f1_p f1_h
b2 add b 2
f2_p shr b2 7
f2_g get f1 f2_p
f2_w and b2 127
f2_h set f2_g f2_w nv
f2 set f1 f2_p f2_h
b3 add b 3
f3_p shr b3 7
f3_g get f2 f3_p
f3_w and b3 127
f3_h set f3_g f3_w occb
f3 set f2 f3_p f3_h
occb2 add occb nlit
maxd2 call umax maxd dep
iof2 or iof fio
nnm2 add nnm nlen
l1 gt nlit 1024
l2 gt nnm2 8192
l3 gt nvar2 4096
l4 or l1 l2
l5 or l4 l3
err2 select l5 4 err
o rec lv2 f3 ln2 t7 nvar2 occb2 maxd2 iof2 nnm2 err2
ret o
end
# --- module writers (state (io,u32,u32,u32); field 2 is a running variant index where one is needed)
fn wkcusb (io,u32,u32,u32) u32 u32x128 bool -> (io,u32,u32,u32)
v get p2 p1
r call wab p0 v p3
ret r
end
# the custom section's payload: name "a0", the version bytes
fn wkcus (io,u32,u32,u32) u32x128 u32 bool -> (io,u32,u32,u32)
a call wab3 p0 2 97 48 p3
b fold wkcusb p2 a p1 p3
ret b
end
fn wktyadd (u32x256,u32x256,u32) u32 -> (u32x256,u32x256,u32)
mp at p0 0
ls at p0 1
n at p0 2
cur get mp p1
new eq cur 0
n1 add n 1
v select new n1 cur
mp2 set mp p1 v
li select new n 255
ls2 set ls li p1
n2 select new n1 n
r rec mp2 ls2 n2
ret r
end
# the signatures of the io helpers (keys 2 params + result: 3, 4, 6)
fn wktyh (u32x256,u32x256,u32) u32 -> (u32x256,u32x256,u32)
a call wktyadd p0 3
b call wktyadd a 4
c call wktyadd b 6
ret c
end
fn wkkey u32x128x256 u32 -> u32
b mul p1 8
w_p shr b 7
w_g get p0 w_p
w_w and b 127
w get w_g w_w
np and w 65535
rs shr w 16
k0 mul np 2
k add k0 rs
ret k
end
fn wktyv (u32x256,u32x256,u32) u32 u32x128x256 -> (u32x256,u32x256,u32)
k call wkkey p2 p1
r call wktyadd p0 k
ret r
end
fn wab7f (io,u32,u32,u32) u32 bool -> (io,u32,u32,u32)
r call wab p0 127 p2
ret r
end
fn wktyone (io,u32,u32,u32) u32 u32x256 bool -> (io,u32,u32,u32)
key get p2 p1
np shr key 1
rs and key 1
a call wab p0 96 p3
b call waul a np p3
c fold wab7f np b p3
isr eq rs 1
n1 select isr 1 0
n0 select isr 0 1
d fold wab2st n1 c 1 127 p3
e fold wabst n0 d 0 p3
ret e
end
fn wktypes (io,u32,u32,u32) u32x256 u32 bool -> (io,u32,u32,u32)
a call waul p0 p2 p3
b fold wktyone p2 a p1 p3
ret b
end
fn wkfnone (io,u32,u32,u32) u32 u32x128x256 u32x256 bool -> (io,u32,u32,u32)
k call wkkey p2 p1
ti get p3 k
t1 sub ti 1
r call waul p0 t1 p4
ret r
end
fn wkfnh (io,u32,u32,u32) u32 u32x256 bool -> (io,u32,u32,u32)
a get p2 3
a1 sub a 1
b get p2 4
b1 sub b 1
c get p2 6
c1 sub c 1
x call waul p0 a1 p3
y call waul x b1 p3
z call waul y c1 p3
ret z
end
fn wkfuncs (io,u32,u32,u32) u32x128x256 u32 u32x256 bool bool -> (io,u32,u32,u32)
nh select p4 3 0
nh1 select p4 1 0
nfn add nh p2
a call waul p0 nfn p5
b fold wkfnh nh1 a p3 p5
c fold wkfnone p2 b p1 p3 p5
ret c
end
fn wklnb (io,u32,u32,u32) u32 u32x128x64 u32 bool -> (io,u32,u32,u32)
i add p3 p1
v_p shr i 7
v_g get p2 v_p
v_w and i 127
v get v_g v_w
r call wab p0 v p4
ret r
end
fn wkexone (io,u32,u32,u32) u32 u32x128x64 u32x128x64 u32 bool -> (io,u32,u32,u32)
b mul p1 4
ns_p shr b 7
ns_g get p2 ns_p
ns_w and b 127
