# the induction local of body node p1 of the loop of frame p2 as block word 0 of frame p2 + 1's
# node (the host's induction map)
fn wxindw u32x128x512 u32 u32 -> u32x128x512
dn add p2 1
a add 40 p1
l call wxcg p0 p2 a
m1 fold wxbs 1 p0 dn p1 0 l
ret m1
end
# the arguments of a body or predicate call of loop d: the state, the counter, the extras
fn wxiarg u32x128x512 u32 u32 u32x128x132 u32x128x512 -> u32x128x512
st call wxcg p0 p2 0
ic call wxcg p0 p2 1
nx call wxcg p0 p2 17
j call wxcg p0 p2 9
g0 call wxfg p0 p2 2
g add g0 j
fa call wxnw p3 g 3
fa2 add fa 2
m1 fold wxlg 1 p0 st
m2 fold wxlg 1 m1 ic
m3 fold wxpa nx m2 p2 fa2 p4
ret m3
end
# the start of a trip of loop p2 (`trip`): the predicate (inlined, else called) before the body
fn wxtrip u32x128x512 u32 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x200 u32x128x16 -> u32x128x512
pq call wxcg p0 p2 6
pf call wxcg p0 p2 7
hp ne pq 0
npq select hp false true
m1 fold wxhost hp p0 p2 0
m2 fold wxcan hp m1 p2 pf 0 24 0 p3 p4 p5 p6 p7 p8 p9 p10
okr call wxg m2 16
ok1 eq okr 1
ok and hp ok1
nok select ok false true
dir and hp nok
dn add p2 1
m3 fold wxpu 1 m2 10 p2 0 0
m4 fold wxenter ok m3 dn
m5 fold wxiarg dir m4 p2 p4 p5
x mul pf 2
x1 add x 1
mk0 call wa16 p11 x
mk add mk0 259
dp call wa16 p11 x1
md call wxg m5 12
mx call umax md dp
m6 fold wxe dir m5 6 mk
m7 fold wxs dir m6 12 mx
ret m7
end
# the body of a trip of loop p2: leave the loop when the predicate is false, then the body
# (inlined when it was probed so, else called: the owned variant for aggregate state)
fn wxtbod u32x128x512 u32 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x200 u32x128x16 -> u32x128x512
pq call wxcg p0 p2 6
hp ne pq 0
m1 fold wxop hp p0 69
m2 fold wxe hp m1 12 1
bf call wxcg m2 p2 8
inl call wxcg m2 p2 10
ag call wxcg m2 p2 2
vr call wxcg m2 p2 11
wd call wxcg m2 p2 12
isi ne inl 0
nis select isi false true
m3 fold wxhost isi m2 p2 1
m4a fold wxcan isi m3 p2 bf vr 24 wd p3 p4 p5 p6 p7 p8 p9 p10
okr call wxg m4a 16
bad1 ne okr 1
bad and isi bad1
m4 fold wxs bad m4a 8 3
dn add p2 1
nnb call wxfw p3 bf 5
cn select isi nnb 0
m5 fold wxindw cn m4 p2
m6 fold wxpu isi m5 11 p2 0 0
m7 fold wxenter isi m6 dn
m8 fold wxpu nis m7 11 p2 0 0
m9 fold wxiarg nis m8 p2 p4 p5
x mul bf 2
x1 add x 1
mk0 call wa16 p11 x
agi ne ag 0
mk1 add mk0 259
mk2 add mk1 1
mk select agi mk2 mk1
dp call wa16 p11 x1
md call wxg m9 12
mx call umax md dp
m10 fold wxe nis m9 6 mk
m11 fold wxs nis m10 12 mx
ret m11
end
