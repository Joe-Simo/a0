# forget the splat of parameter p1
fn wxvclr u32x128x512 u32 -> u32x128x512
a add 19072 p1
r fold wxs 1 p0 a 0
ret r
end
# phase p3 of loop p2 as (limit kind p4, literal flag p5, literal or constant p6, first trip p7,
# copies p8)
fn wxphs u32x128x512 u32 u32 u32 u32 u32 u32 u32 u32 -> u32x128x512
