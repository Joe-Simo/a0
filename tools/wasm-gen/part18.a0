# ---------------------------------------------------------------------------------------------
# The machine: pop an item of the work stack and run it. Items (kind, a, b, c): 1 nodes of frame
# a from node b (the node, then the items of the rest), 2 node b of frame a alone, 3 push the
# operand (kind b, value c) of frame a, 4 emit the instruction (kind a, value b), 5 the end of
# frame a, 6 the next node of frame a owned by select b in arm c & 3 from node c >> 2, 7 bind
# and set node b of frame a, 8 start phase b of loop a, 9 a trip of loop a, 10 its body, 11 its
# end
fn wxstep u32x128x512 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x200 u32x128x16 -> u32x128x512
m0 fold wxad 1 p0 95 1
m1x fold wxpo 1 m0
k call wxg m1x 16
a call wxg m1x 17
b call wxg m1x 18
c call wxg m1x 19
m1y fold wxs 1 m1x 96 k
m1z fold wxs 1 m1y 97 a
m1 fold wxs 1 m1z 98 b
k1 eq k 1
k2 eq k 2
k3 eq k 3
k4 eq k 4
k5 eq k 5
k6 eq k 6
k7 eq k 7
k8 eq k 8
k9 eq k 9
k10 eq k 10
k11 eq k 11
nn call wxfg m1 a 3
g0 call wxfg m1 a 2
b1 add b 1
mor lt b1 nn
rest1 and k1 mor
m2 fold wxpu rest1 m1 1 a b1 0
gg add g0 b
oc add 2816 gg
own call wxsh p9 oc
nown eq own 0
run1 and k1 nown
runn or run1 k2
m3 fold wxnode runn m2 a b p2 p3 p4 p5 p6 p7 p8 p9 p10
m4 fold wxpsh k3 m3 a b c
m5 fold wxe k4 m4 a b
m6 fold wxend k5 m5 a p2 p8
arm and c 3
fr shr c 2
arm1 add arm 1
fg gt nn fr
cnt0 sub nn fr
cnt1 select fg cnt0 0
cnt select k6 cnt1 0
fnd fold wxfnd cnt 4294967295 g0 b arm1 fr p9
has ne fnd 4294967295
fm1 add fnd 1
nxt shl fm1 2
cc or arm nxt
h6 and k6 has
m9 fold wxpu h6 m6 6 a b cc
m10 fold wxpu h6 m9 2 a fnd 0
m11 fold wxset k7 m10 a b
m12 fold wxlst k8 m11 a b
m13 fold wxtrip k9 m12 a p2 p3 p4 p5 p6 p7 p8 p9 p10
m14 fold wxtbod k10 m13 a p2 p3 p4 p5 p6 p7 p8 p9 p10
m15 fold wxtend k11 m14 a
ret m15
end
# keep stepping while items remain and no error was raised
fn wxgo u32x128x512 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x200 u32x128x16 -> bool
sp call wxg p0 7
er call wxg p0 8
st call wxg p0 95
a gt sp 0
b eq er 0
c lt st 400000
ab and a b
r and ab c
ret r
end
