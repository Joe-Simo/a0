c0 select n0 c0r 0
s0 select n0 s0r 0
m2 fold wxres n1 m1 p2 k1 v1
c1r call wxg m2 16
s1r call wxg m2 17
c1 select n1 c1r 0
s1 select n1 s1r 0
m3 fold wxres n2 m2 p2 k2 v2
c2r call wxg m3 16
s2r call wxg m3 17
c2 select n2 c2r 0
s2 select n2 s2r 0
ty0 call wxopty k0 v0 p7 p9 fpt g0
ty1 call wxopty k1 v1 p7 p9 fpt g0
rw call wxrg m3 p2 p3 3
ali ne rw 0
aliu select ali 1 0
c rec p2 p3 g op na fa ce pr t tag by k0 v0 k1 v1 k2 v2 c0 s0 c1 s1 c2 s2 ty0 ty1 aliu 0 0
dpos gt p2 0
bk0 call wxbk p2 p3 0
indv call wxg m3 bk0
hi1 ne indv 0
hasind and dpos hi1
cf call wxfg m3 p2 18
cg call wxfg m3 p2 19
cf1 ne cf 0
cg1 eq cg p3
carryget and cf1 cg1
wd call wxfg m3 p2 9
hw gt wd 0
o25 eq op 25
o27 eq op 27
isget or o25 o27
isp1 eq k0 2
isp2 eq v0 0
isp0 and isp1 isp2
l1 eq k1 3
f1 and hw isget
f2 and f1 isp0
fldr0 and f2 l1
fl call wxrg m3 p2 p3 2
ch1 and fl 2
ch2 ne ch1 0
chn and hw ch2
nota select hasind false true
rcar and nota carryget
notb select rcar false true
notab and nota notb
rfld and notab fldr0
notc select rfld false true
notabc and notab notc
rwrd and notabc chn
notd select rwrd false true
rest and notabc notd
o26 eq op 26
o28 eq op 28
upd or o26 o28
o20 eq op 20
o21 eq op 21
it or o20 o21
ra and rest ali
rset and ra upd
riter and rest it
nal select ali false true
rn and rest nal
nit select it false true
rs and rn nit
isv eq op 1
isc1 eq op 19
isc2 eq op 18
isar1 eq op 22
isar2 eq op 24
isar or isar1 isar2
isrec eq op 23
isdv1 eq op 10
isdv2 eq op 11
isdv or isdv1 isdv2
b2a ge op 2
b2b le op 9
b12a ge op 12
b12b le op 17
bina and b2a b2b
binb and b12a b12b
isbin or bina binb
isset eq op 26
isput eq op 28
sp or isset isput
isat eq op 27
isrd eq op 29
iswr eq op 30
ispu eq op 31
hmov and rs isv
hbin and rs isbin
hdiv and rs isdv
hsel and rs isc2
hcall and rs isc1
harr and rs isar
hrec and rs isrec
hget and rs o25
hset and rs sp
hat and rs isat
hrd and rs isrd
hwr and rs iswr
hpu and rs ispu
m4 fold wxhind hasind m3 c
m5 fold wxhcar rcar m4 c
m6 fold wxhfld rfld m5 c
m7 fold wxhwrd rwrd m6 c p6
m8 fold wxhali rset m7 c p8 p9 p10
m9 fold wxiter riter m8 c p4 p5 p6 p7 p8 p9 p10 p11
m10 fold wxhmov hmov m9 c
m11 fold wxhbin hbin m10 c
m12 fold wxhdiv hdiv m11 c
m13 fold wxhsel hsel m12 c p11
m14 fold wxhcall hcall m13 c p4 p5 p6 p7 p8 p9 p10 p11 p12
m15 fold wxharr harr m14 c p5 p6 p11 p8 p10
m16 fold wxhrec hrec m15 c p6 p8 p9 p10
