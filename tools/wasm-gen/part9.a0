# ---------------------------------------------------------------------------------------------
# Handlers of the nodes whose emission does not run another frame. Each is a fold body
# (M, trip, context, tables...) run once when its case applies; the context is described above
# `wxslot`.

# (a node bound to a loop's induction variable) its local is the induction local
fn wxhind u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) -> u32x128x512
d at p2 0
j at p2 1
w call wxbk d j 0
l call wxg p0 w
l1 sub l 1
r fold wxrs 1 p0 d j 0 l1
ret r
end
# (the carried previous element) its local is the carry local
fn wxhcar u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) -> u32x128x512
d at p2 0
j at p2 1
l call wxfg p0 d 21
r fold wxrs 1 p0 d j 0 l
ret r
end
# (scalar state in locals) a read of p0 at a literal index is that word's local: field
# (index mod width) of the host
fn wxhfld u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) -> u32x128x512
d at p2 0
j at p2 1
v1 at p2 14
w call wxfg p0 d 9
k rem v1 w
fi add k 10
l call wxfg p0 d fi
r fold wxrs 1 p0 d j 0 l
ret r
end
# (scalar state in locals) the words of a chain node p3 of frame p2: operand p1 of a rec/arr
# (operands from p5, table p6) as a source (kind 0 local / 1 literal); word k of node j is block
# words 4 + 2k (kind) and 5 + 2k (value)
fn wxwk u32x128x512 u32 u32 u32 u32 u32 u32x128x512 -> u32x128x512
o add p5 p1
k call wxok p6 o
v call wxov p6 o
m1 fold wxres 1 p0 p2 k v
c call wxg m1 16
s call wxg m1 17
w0 mul p1 2
w1 add w0 4
w2 add w0 5
a1 call wxbk p2 p3 w1
a2 call wxbk p2 p3 w2
m2 fold wxs 1 m1 a1 c
m3 fold wxs 1 m2 a2 s
ret m3
end
# word p1 of an update's words (frame p2, node p3): from the host's fields (p4 = 1) or the words of
# node p5, with word p6 replaced by the source (p7 kind, p8 value)
fn wxwu u32x128x512 u32 u32 u32 u32 u32 u32 u32 u32 -> u32x128x512
w0 mul p1 2
w1 add w0 4
w2 add w0 5
fi add p1 10
fl call wxfg p0 p2 fi
bk call wxbk p2 p5 w1
bv call wxbk p2 p5 w2
ak call wxg p0 bk
av call wxg p0 bv
ik eq p4 1
fk0 select ik 0 ak
fv0 select ik fl av
at eq p1 p6
vk select at p7 fk0
vv select at p8 fv0
a1 call wxbk p2 p3 w1
a2 call wxbk p2 p3 w2
m1 fold wxs 1 p0 a1 vk
m2 fold wxs 1 m1 a2 vv
ret m2
end
# (scalar state in locals) the chain node's words (args table p3)
fn wxhwrd u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x512 -> u32x128x512
d at p2 0
j at p2 1
op at p2 3
na at p2 4
fa at p2 5
k0 at p2 11
v0 at p2 12
v1 at p2 14
c2 at p2 21
s2 at p2 22
o22 eq op 22
o23 eq op 23
o24 eq op 24
r1 or o22 o23
isrec or r1 o24
nrec select isrec 1 0
nupd select isrec 0 1
w call wxfg p0 d 9
nwk select isrec na 0
m1 fold wxwk nwk p0 d j 0 fa p3
isp1 eq k0 2
isp2 eq v0 0
onp0 and isp1 isp2
ik select onp0 1 0
bn select onp0 0 v0
at rem v1 w
m2 fold wxwu nupd m1 d j ik bn at c2 s2
ret m2
end
# set (26) and put (28) element store (src/wasm.ts `#storeElement`): element / field (operand k1 v1)
# of the target operand (tk tv) of frame d to the value operand (k2 v2), the container type ty0:
# (M, trip, d tk tv k1 v1 k2 v2 op ty0, types tlist info)
fn wxsto u32x128x512 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32 u32x384x65 u32x128x65 u32x128x65 -> u32x128x512
issets eq p9 26
isput eq p9 28
len call wxty p11 p10 1
et call wxty p11 p10 2
etag call wxtag p11 et
esz call wxbyt p13 et
m1 fold wxea issets p0 p2 p3 p4 p5 p6 len esz
offs call wxg m1 16
fs call wxty p11 p10 1
lit3 eq p5 3
kk1 select lit3 p6 0
kk select isput kk1 0
offp call wafo p12 p13 fs kk
ft0 add fs kk
ft call wa65 p12 ft0
ftag call wxtag p11 ft
fby call wxbyt p13 ft
m2 fold wxpsh isput m1 p2 p3 p4
off select issets offs offp
tag select issets etag ftag
by select issets esz fby
r fold wxsa 1 m2 p2 p7 p8 tag by off
ret r
end
# set / put in place (the node aliases its target's storage): one element store, and the carried
# previous element takes the stored value
fn wxhali u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x384x65 u32x128x65 u32x128x65 -> u32x128x512
d at p2 0
j at p2 1
op at p2 3
k0 at p2 11
v0 at p2 12
k1 at p2 13
v1 at p2 14
k2 at p2 15
v2 at p2 16
ty0 at p2 23
m1 fold wxsto 1 p0 d k0 v0 k1 v1 k2 v2 op ty0 p3 p4 p5
cf call wxfg m1 d 18
cs call wxfg m1 d 20
cl call wxfg m1 d 21
a ne cf 0
b eq cs j
c and a b
m2 fold wxpsh c m1 d k2 v2
m3 fold wxls c m2 cl
ret m3
end
# set / put not in place: copy the container into the node's own storage, then store there
fn wxhset u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x384x65 u32x128x65 u32x128x65 -> u32x128x512
d at p2 0
j at p2 1
op at p2 3
by at p2 10
k0 at p2 11
v0 at p2 12
k1 at p2 13
v1 at p2 14
k2 at p2 15
v2 at p2 16
ty0 at p2 23
m1 fold wxslot 1 p0 d j by
l call wxg m1 16
m2 fold wxlg 1 m1 l
m3 fold wxpsh 1 m2 d k0 v0
m4 fold wxcp 1 m3 by
m5 fold wxsto 1 m4 d 1 j k1 v1 k2 v2 op ty0 p3 p4 p5
ret m5
end
# does node p1 of frame p2 (an arr literal) hold dead initial contents: its only use is the initial
# state of a fold that overwrites it all (register 27 := 1); the statistics word of the node is
# in its row (uses: bits 18-19, last user + 1: bits 0-15)
fn wxdead u32x128x512 u32 u32 u32 u32x128x132 u32x128x512 u32x128x200 -> u32x128x512
w call wxrg p0 p2 p3 1
t0 shr w 18
tot and t0 3
lu and w 65535
user sub lu 1
g0 call wxfg p0 p2 2
rk call wxfg p0 p2 5
rv call wxfg p0 p2 6
r1 eq rk 1
r2 eq rv p3
isret and r1 r2
ug add g0 user
fa call wxnw p4 ug 3
fa1 add fa 1
k1 call wxok p5 fa1
v1 call wxov p5 fa1
i1 eq k1 1
i2 eq v1 p3
init and i1 i2
rt call wxrg p0 p2 user 3
ali ne rt 0
oa add 8448 ug
ov call wxsh p6 oa
over ne ov 0
t1 eq tot 1
nr select isret false true
c1 and t1 nr
c2 and c1 init
c3 and c2 ali
c4 and c3 over
d select c4 1 0
r fold wxs 1 p0 27 d
ret r
end
# element p1 of an arr (operands from p3, element type tag p5 bytes p6): store it at local p4
fn wxael u32x128x512 u32 u32 u32 u32 u32 u32 u32x128x512 -> u32x128x512
o add p3 p1
k call wxok p7 o
v call wxov p7 o
off mul p1 p6
m1 fold wxlg 1 p0 p4
r fold wxsa 1 m1 p2 k v p5 p6 off
ret r
end
# the operands [p1, p1 + p2) are all literals (kind 3 or 4), all zero
fn wxlitop (bool,bool) u32 u32x128 u32 -> (bool,bool)
oi add p3 p1
xw mul oi 2
x and xw 127
k get p2 x
x1 add x 1
v get p2 x1
k3 eq k 3
k4 eq k 4
lk or k3 k4
z eq v 0
a at p0 0
b at p0 1
a2 and a lk
b2 and b z
r rec a2 b2
ret r
end
fn wxlitpg (bool,bool) u32 u32x128x512 u32 u32 u32 -> (bool,bool)
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold wxlitop cnt p0 pg lo
ret r
end
fn wxlits u32x128x512 u32 u32 -> (bool,bool)
hi add p1 p2
has lt p1 hi
lp shr p1 6
h1 sub hi 1
hp shr h1 6
d sub hp lp
np add d 1
n select has np 0
s0 rec true true
r fold wxlitpg n s0 p0 p1 hi lp
ret r
end
# arr (22) and text (24): its storage; a literal of four or more scalars is filled (all zero) or
# copied from the pool (an occurrence recorded for the function's POOL), anything else is stored
# element by element; a dead initial value (`wxdead`) leaves storage only
fn wxharr u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x132 u32x128x512 u32x128x200 u32x384x65 u32x128x65 -> u32x128x512
d at p2 0
j at p2 1
g at p2 2
na at p2 4
fa at p2 5
t at p2 8
by at p2 10
m1 fold wxslot 1 p0 d j by
l call wxg m1 16
m2 fold wxdead 1 m1 d j p3 p4 p5
dead call wxg m2 27
live eq dead 0
et call wxty p6 t 2
etag call wxtag p6 et
esz call wxbyt p7 et
lz call wxlits p4 fa na
al at lz 0
az at lz 1
eprim lt etag 4
n4 ge na 4
q1 and n4 eprim
lit and q1 al
nlit select lit false true
dolit and live lit
doel and live nlit
nz select az false true
dozero and dolit az
dopool0 and dolit nz
nbytes mul na 4
cnt select doel na 0
npl call wxg m2 5
pfull ge npl 1024
npok select pfull false true
dopool and dopool0 npok
pfl and dopool0 pfull
m2e fold wxs pfl m2 8 1
m3 fold wxlg dolit m2e l
m4 fold wxkc dozero m3 0
m5 fold wxkc dozero m4 nbytes
m6 fold wxe dozero m5 17 0
pad add 3392 npl
m8 fold wxs dopool m6 pad g
npl1 add npl 1
m9 fold wxs dopool m8 5 npl1
m10 fold wxe dopool m9 7 npl
m12 fold wxcp dopool m10 nbytes
r fold wxael cnt m12 d fa l etag esz p4
ret r
end
# field p1 of a rec (field types from tlist p4 at p3, operands from p2... ): see `wxhrec`
fn wxrecf u32x128x512 u32 u32 u32 u32 u32 u32x128x512 u32x384x65 u32x128x65 u32x128x65 -> u32x128x512
o add p3 p1
k call wxok p6 o
v call wxov p6 o
ti add p5 p1
ft call wa65 p8 ti
ftag call wxtag p7 ft
fby call wxbyt p9 ft
off call wxg p0 27
m1 fold wxlg 1 p0 p4
m2 fold wxsa 1 m1 p2 k v ftag fby off
noff add off fby
m3 fold wxs 1 m2 27 noff
ret m3
end
# rec (23): its storage, then each field stored at its offset
fn wxhrec u32x128x512 u32 (u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32) u32x128x512 u32x384x65 u32x128x65 u32x128x65 -> u32x128x512
d at p2 0
j at p2 1
na at p2 4
fa at p2 5
t at p2 8
by at p2 10
m1 fold wxslot 1 p0 d j by
l call wxg m1 16
fs call wxty p4 t 1
m2 fold wxs 1 m1 27 0
r fold wxrecf na m2 d fa l fs p3 p4 p5 p6
ret r
end
