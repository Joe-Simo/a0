# ---------------------------------------------------------------------------------------------
# simd128 fill runs (src/wasm.ts `#vectorFill`). Scratch words of M: 19008 + j the v128 local of
# body node j's lanes, 19072 + p the splat of parameter p (0: none yet), 19104 the index vector
# local, 19105 the pointer local, 19110 the host frame d, 19111 the first extra operand of the
# fold, 19112 the body's first node, 19113 its set node, 19114 19115 the stored value operand,
# 19116 the body's node count, 19117 the state local.

# push the lanes of the body operand (kind p1... as (M, trip, kind p2, value p3)): a literal
# splat, the index vector, a parameter's splat, or a node's lanes
fn wxvpl u32x128x512 u32 u32 u32 -> u32x128x512
l3 eq p2 3
isn eq p2 1
isp eq p2 2
iv eq p3 1
ixp and isp iv
niv select iv false true
spp and isp niv
ix call wxg p0 19104
a1 add 19072 p3
sp call wxg p0 a1
a2 add 19008 p3
ln call wxg p0 a2
m1 fold wxe l3 p0 21 p3
m2 fold wxlg ixp m1 ix
m3 fold wxlg spp m2 sp
m4 fold wxlg isn m3 ln
ret m4
end
# the scalar of a shift amount (literal or parameter p3 >= 2: the extra operand)
fn wxvsc u32x128x512 u32 u32 u32 u32x128x512 -> u32x128x512
l3 eq p2 3
isp eq p2 2
d call wxg p0 19110
fa2 call wxg p0 19111
e0 sub p3 2
e1 add fa2 e0
ek call wxok p4 e1
ev call wxov p4 e1
m1 fold wxkc l3 p0 p3
m2 fold wxpsh isp m1 d ek ev
ret m2
end
# the splat of the extra operand of body parameter p3 (>= 2), once
fn wxvsp u32x128x512 u32 u32 u32 u32x128x512 -> u32x128x512
isp eq p2 2
big ge p3 2
wsp and isp big
a add 19072 p3
cur call wxg p0 a
none eq cur 0
go and wsp none
d call wxg p0 19110
fa2 call wxg p0 19111
e0 sub p3 2
e1 add fa2 e0
ek call wxok p4 e1
ev call wxov p4 e1
m1 fold wxnv go p0
v call wxg m1 16
m2 fold wxpsh go m1 d ek ev
m3 fold wxe go m2 18 17
m4 fold wxls go m3 v
m5 fold wxs go m4 a v
ret m5
end
# operand p1 (operands from p2, table p3) of a body node: its splat
fn wxvsb u32x128x512 u32 u32 u32x128x512 -> u32x128x512
o add p2 p1
k call wxok p3 o
v call wxov p3 o
r fold wxvsp 1 p0 k v p3
ret r
end
# splats for body node p1 (nodes p2, operands p3): its operands, then the stored value operand
fn wxvsa u32x128x512 u32 u32x128x132 u32x128x512 -> u32x128x512
g0 call wxg p0 19112
sj call wxg p0 19113
vk call wxg p0 19114
vv call wxg p0 19115
g add g0 p1
foa call wxnw p2 g 3
na call wxnw p2 g 2
noset ne p1 sj
cn select noset na 0
m1 fold wxvsb cn p0 foa p3
m2 fold wxvsp noset m1 vk vv p3
ret m2
end
# the lane operation of body node p1 (nodes p2, operands p3): operands, operation, its lanes
fn wxvn1 u32x128x512 u32 u32x128x132 u32x128x512 -> u32x128x512
g0 call wxg p0 19112
sj call wxg p0 19113
g add g0 p1
op call wxnw p2 g 1
foa call wxnw p2 g 3
foa1 add foa 1
ak call wxok p3 foa
av call wxov p3 foa
bk call wxok p3 foa1
bv call wxov p3 foa1
noset ne p1 sj
sh8 eq op 8
sh9 eq op 9
isw or sh8 sh9
nsw select isw false true
m1 fold wxvpl noset p0 ak av
nsw2 and nsw noset
m2 fold wxvpl nsw2 m1 bk bv
ds and noset isw
m3 fold wxvsc ds m2 bk bv p3
e2 eq op 2
e3 eq op 3
e4 eq op 4
e5 eq op 5
e6 eq op 6
e7 eq op 7
e8 eq op 8
e9 eq op 9
c0 mov 0
c2 select e2 174 c0
c3 select e3 177 c2
c4 select e4 181 c3
c5 select e5 78 c4
c6 select e6 80 c5
c7 select e7 81 c6
c8 select e8 171 c7
vop select e9 173 c8
m4 fold wxe noset m3 18 vop
m5 fold wxnv noset m4
v call wxg m5 16
m6 fold wxls noset m5 v
a add 19008 p1
m7 fold wxs noset m6 a v
ret m7
end
# a fill run of the fold of frame p2 whose body is function p3 and whose first operand is p4 (state
# local p5, elements [0, p6) by four per trip; nodes p7, args p8, fns p9): src/wasm.ts
# `#vectorFill`
fn wxvfill u32x128x512 u32 u32 u32 u32 u32 u32 u32x128x132 u32x128x512 u32x128x45 -> u32x128x512
g0 call wxfw p9 p3 4
nn call wxfw p9 p3 5
rw call wxfw p9 p3 6
rop call waretop p8 rw
rv at rop 1
sg add g0 rv
sfa call wxnw p7 sg 3
sfa2 add sfa 2
vk call wxok p8 sfa2
vv call wxov p8 sfa2
fa2 add p4 2
m1 fold wxs 1 p0 19110 p2
m2 fold wxs 1 m1 19111 fa2
m3 fold wxs 1 m2 19112 g0
m4 fold wxs 1 m3 19113 rv
m5 fold wxs 1 m4 19114 vk
m6 fold wxs 1 m5 19115 vv
m7 fold wxs 1 m6 19116 nn
m8 fold wxs 1 m7 19117 p5
m9 fold wxnv 1 m8
ix call wxg m9 16
m10 fold wxs 1 m9 19104 ix
m11 fold wxe 1 m10 20 0
m12 fold wxls 1 m11 ix
m13 fold wxvsa nn m12 p7 p8
m14 fold wxnl 1 m13
ptr call wxg m14 16
m15 fold wxs 1 m14 19105 ptr
m16 fold wxlg 1 m15 p5
m17 fold wxls 1 m16 ptr
m18 fold wxe 1 m17 8 0
m19 fold wxvn1 nn m18 p7 p8
m20 fold wxlg 1 m19 ptr
m21 fold wxvpl 1 m20 vk vv
m22 fold wxe 1 m21 19 0
m23 fold wxlg 1 m22 ix
m24 fold wxe 1 m23 21 4
m25 fold wxe 1 m24 18 174
m26 fold wxls 1 m25 ix
m27 fold wxlg 1 m26 ptr
m28 fold wxkc 1 m27 16
m29 fold wxop 1 m28 106
m30 fold wxe 1 m29 5 ptr
m31 fold wxlg 1 m30 p5
end4 mul p6 4
m32 fold wxkc 1 m31 end4
m33 fold wxop 1 m32 106
m34 fold wxop 1 m33 73
m35 fold wxe 1 m34 12 0
m36 fold wxe 1 m35 9 0
ret m36
end
