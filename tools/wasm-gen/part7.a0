# the first node at or after node p5 of the frame (first node p2) owned by select p3 in ARM column
# value p4 (1 or 2); p0 is the node found so far (4294967295: none): node p1 + p5
fn wxfnd u32 u32 u32 u32 u32 u32 u32x128x200 -> u32
j add p5 p1
g add p2 j
a add 2816 g
own call wxsh p6 a
b add 5632 g
arm call wxsh p6 b
j1 add p3 1
o1 eq own j1
a2 eq arm p4
none eq p0 4294967295
h1 and o1 a2
hit and h1 none
r select hit j p0
ret r
end
# ---------------------------------------------------------------------------------------------
# Frames. A frame is an emitter of one function (variant p4: 0 value, 1 owned): frame 0 the
# function being emitted, frame d + 1 a body or callee inlined by frame d (INLINE_DEPTH 3).

# frame p2's description of function p3 (variant p4): first node, node count, parameter count
# and ret operand from the fns table p5 and the operand table p6; the host's words are kept
fn wxfset u32x128x512 u32 u32 u32 u32 u32x128x45 u32x128x512 -> u32x128x512
g0 call wxfw p5 p3 4
nn call wxfw p5 p3 5
np call wxfw p5 p3 1
rw call wxfw p5 p3 6
rop call waretop p6 rw
rk at rop 0
rv at rop 1
hh gt p2 0
hhv select hh 1 0
m1 fold wxfs 1 p0 p2 0 p3
m2 fold wxfs 1 m1 p2 1 p4
m3 fold wxfs 1 m2 p2 2 g0
m4 fold wxfs 1 m3 p2 3 nn
m5 fold wxfs 1 m4 p2 4 np
m6 fold wxfs 1 m5 p2 5 rk
m7 fold wxfs 1 m6 p2 6 rv
m8 fold wxfs 1 m7 p2 7 hhv
ret m8
end
# clear the row (and the induction and use words) of node p1 of inline frame p2
fn wxclr u32x128x512 u32 u32 -> u32x128x512
m1 fold wxrs 1 p0 p2 p1 0 0
m2 fold wxrs 1 m1 p2 p1 1 0
m3 fold wxrs 1 m2 p2 p1 2 0
m4 fold wxrs 1 m3 p2 p1 3 0
m5 fold wxbs 1 m4 p2 p1 0 0
m6 fold wxbs 1 m5 p2 p1 1 0
ret m6
end
# register 18 := 1 when node p1 (first node p3) of frame p2 needs frame storage: an aggregate
# that is not an alias, not in the scalar state chain, and not a get at select mov
fn wxnf u32x128x512 u32 u32 u32 u32x128x132 u32x128x24 u32x384x65 -> u32x128x512
g add p3 p1
op call wxnw p4 g 1
t call wa24 p5 g
tag call wxtag p6 t
agg ge tag 4
rt call wxrg p0 p2 p1 3
fl call wxrg p0 p2 p1 2
ch and fl 2
na eq rt 0
nch eq ch 0
o25 eq op 25
o27 eq op 27
o18 eq op 18
o1 eq op 1
x1 or o25 o27
x2 or x1 o18
x3 or x2 o1
nox select x3 false true
a1 and agg na
a2 and a1 nch
a3 and a2 nox
m1 fold wxs a3 p0 18 1
ret m1
end
# register 19 := 1 when parameter p1 (first parameter type p2 of tlist p3, info p4) / node p1
# (first node p2, node types p3, info p4) contains io
fn wxiop u32x128x512 u32 u32 u32x128x65 u32x128x65 -> u32x128x512
i add p2 p1
t call wa65 p3 i
io call wxio p4 t
a ne io 0
m1 fold wxs a p0 19 1
ret m1
end
fn wxion u32x128x512 u32 u32 u32x128x24 u32x128x65 -> u32x128x512
g add p2 p1
t call wa24 p3 g
io call wxio p4 t
a ne io 0
m1 fold wxs a p0 19 1
ret m1
end
# ---------------------------------------------------------------------------------------------
# Scalar replacement of small fold state (src/wasm.ts `scalarState`): can the state p0 of a body
# live in locals? Register 22 := 0 when not; the chain nodes (updates and rebuilds of the state)
# get bit 1 of their row flags in frame p2. Steps: the state type, then every node, the ret, the
# uses of the chain nodes.

# the state type of the function with first parameter type p2 (tlist p3, types p4): an aggregate of
# at most 8 scalar words; register 24 := its width, 25 := the record's first field and 26 the
# count (0 for an array)
fn wxsm0 u32x128x512 u32 u32 u32x128x65 u32x384x65 -> u32x128x512
t call wa65 p3 p2
tag call wxtag p4 t
a call wxty p4 t 1
b call wxty p4 t 2
agg ge tag 4
isa eq tag 4
n select isa a b
nok le n 8
el le b 1
eok select isa el true
o1 and agg nok
ok and o1 eok
okv select ok 1 0
nr select isa 0 b
m1 fold wxs 1 p0 22 okv
m2 fold wxs 1 m1 24 n
m3 fold wxs 1 m2 25 a
m4 fold wxs 1 m3 26 nr
ret m4
end
# field p1 of the record whose first field is p2 (tlist p3) is a scalar
fn wxsm1 u32x128x512 u32 u32 u32x128x65 -> u32x128x512
i add p2 p1
t call wa65 p3 i
bad gt t 1
m1 fold wxs bad p0 22 0
ret m1
end
# operand p1 of a node whose operands start at p3: register 23 |= is p0 or a chain node (not for
# operand 0), 24 |= the same (operands 0 included); frame p2
fn wxchs u32x128x512 u32 u32 u32 u32x128x512 -> u32x128x512
o add p3 p1
k call wxok p4 o
v call wxov p4 o
isp1 eq k 2
isp2 eq v 0
isp and isp1 isp2
isn eq k 1
vn select isn v 0
fl call wxrg p0 p2 vn 2
c1 and fl 2
c2 ne c1 0
inc and isn c2
hit or isp inc
h1 select hit 1 0
a24 call wxg p0 24
n24 or a24 h1
m1 fold wxs 1 p0 24 n24
a23 call wxg m1 23
n23 or a23 h1
nz ne p1 0
w23 select nz n23 a23
m2 fold wxs 1 m1 23 w23
ret m2
end
# node p1 (first node p3) of frame p2, its type p6 the state type p7: the first loop of `scalarState`
fn wxch1 u32x128x512 u32 u32 u32 u32x128x132 u32x128x512 u32x128x24 u32 -> u32x128x512
g add p3 p1
op call wxnw p4 g 1
na call wxnw p4 g 2
fa call wxnw p4 g 3
t call wa24 p6 g
fa1 add fa 1
k0 call wxok p5 fa
v0 call wxov p5 fa
k1 call wxok p5 fa1
isp1 eq k0 2
isp2 eq v0 0
isp and isp1 isp2
isn eq k0 1
vn select isn v0 0
fl call wxrg p0 p2 vn 2
c1 and fl 2
c2 ne c1 0
inc and isn c2
a0 or isp inc
o26 eq op 26
o28 eq op 28
o25 eq op 25
o27 eq op 27
upd or o26 o28
rd or o25 o27
ur or upd rd
cond1 and ur a0
m1 fold wxs 1 p0 23 0
m2 fold wxs 1 m1 24 0
m3 fold wxchs na m2 p2 fa p5
any1v call wxg m3 23
anyv call wxg m3 24
any1 ne any1v 0
anyall ne anyv 0
nk3 ne k1 3
nisp select isp false true
rdn and rd nisp
f1a or nk3 rdn
f1 or f1a any1
fail1 and cond1 f1
o22 eq op 22
o23 eq op 23
o24 eq op 24
r1 or o22 o23
r2 or r1 o24
tst eq t p7
r3 and r2 tst
ncond select cond1 false true
rebuild and ncond r3
cadd1 and cond1 upd
cadd or cadd1 rebuild
nreb select rebuild false true
f2a and ncond nreb
fail2 and f2a anyall
fail or fail1 fail2
m4 fold wxrs cadd m3 p2 p1 2 2
m5 fold wxs fail m4 22 0
ret m5
end
# operand p1 of a node (first operand p3, update op p4): a chain node used other than as the base
# of an update fails (register 22 := 0); every node operand counts a use (block word 1)
fn wxch3 u32x128x512 u32 u32 u32 u32 u32x128x512 -> u32x128x512
o add p3 p1
k call wxok p5 o
v call wxov p5 o
isn eq k 1
vn select isn v 0
fl call wxrg p0 p2 vn 2
c1 and fl 2
c2 ne c1 0
inc and isn c2
z eq p1 0
updb ne p4 0
base and updb z
nb select base false true
bad and inc nb
m1 fold wxs bad p0 22 0
us call wxbk p2 vn 1
u0 call wxg m1 us
u1 add u0 1
m2 fold wxs isn m1 us u1
ret m2
end
fn wxch2 u32x128x512 u32 u32 u32 u32x128x132 u32x128x512 -> u32x128x512
g add p3 p1
op call wxnw p4 g 1
na call wxnw p4 g 2
fa call wxnw p4 g 3
o26 eq op 26
o28 eq op 28
upd or o26 o28
u1 select upd 1 0
r fold wxch3 na p0 p2 fa u1 p5
ret r
end
# chain node p1 of frame p2 used more than once
fn wxch4 u32x128x512 u32 u32 -> u32x128x512
fl call wxrg p0 p2 p1 2
c1 and fl 2
c2 ne c1 0
us call wxbk p2 p1 1
n call wxg p0 us
many gt n 1
bad and c2 many
m1 fold wxs bad p0 22 0
ret m1
end
# can the state of function p3 (nodes p4, ...) live in locals: register 22 (frame p2's rows must
# be clear); on success p2's chain nodes are marked
fn wxsmall u32x128x512 u32 u32 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x65 -> u32x128x512
nn call wxfw p4 p3 5
g0 call wxfw p4 p3 4
fp call wxfw p4 p3 2
rw call wxfw p4 p3 6
rop call waretop p6 rw
rk at rop 0
rv at rop 1
st call wa65 p9 fp
m1 fold wxsm0 1 p0 fp p9 p8
fa1 call wxg m1 25
nfl call wxg m1 26
m2 fold wxsm1 nfl m1 fa1 p9
m3 fold wxch1 nn m2 p2 g0 p5 p6 p7 st
m4 fold wxch2 nn m3 p2 g0 p5 p6
rp1 eq rk 2
rp2 eq rv 0
rp and rp1 rp2
rn eq rk 1
rvn select rn rv 0
rfl call wxrg m4 p2 rvn 2
rc1 and rfl 2
rc2 ne rc1 0
rinc and rn rc2
rok or rp rinc
nrok select rok false true
m5 fold wxs nrok m4 22 0
rus call wxbk p2 rvn 1
ru0 call wxg m5 rus
ru1 add ru0 1
m6 fold wxs rn m5 rus ru1
m7 fold wxch4 nn m6 p2
ret m7
end
# ---------------------------------------------------------------------------------------------
# The analysis of frame p2's function p3 (variant p4): the alias root of every node, from the use
# statistics and the shape table
fn wxana u32x128x512 u32 u32 u32 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x200 -> u32x128x512
g0 call wxfw p5 p3 4
nn call wxfw p5 p3 5
rw call wxfw p5 p3 6
rop call waretop p7 rw
rk at rop 0
rv at rop 1
z call z64
us fold wxusn nn z p6 p7 g0
r fold wxroot nn p0 p2 g0 p4 us rk rv p6 p7 p8 p9 p10
ret r
end
