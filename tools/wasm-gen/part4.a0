# ---------------------------------------------------------------------------------------------
# Analysis of a frame's function (src/wasm.ts `mutableHere`, `#analyse`, `#retSlot`). Use
# statistics, paged like emit_c.a0 `cusn`: word v (node v; parameter v at 4096 + v) holds
# 2^16 * (operand uses other than operand 0 of a get/at) + (last user + 1). A value may be
# updated in place by node j at its target operand when it is fresh (arr text rec set put) or
# the owned parameter, is not the ret, its only such use is that operand, no later node uses
# it, and no borrow of it is read later (the shape table's BORR column).

# operand p3 + p1 (args page p2) of node p5 whose operands start at p4; p6: the node is a get/at
# word p1 of use statistics p0
fn wxu64 u32x128x64 u32 -> u32
pg shr p1 7
w and p1 127
g get p0 pg
v get g w
ret v
end
fn wxusa u32x128x64 u32 u32x128 u32 u32 u32 bool -> u32x128x64
oi add p3 p1
xw mul oi 2
x2 and xw 127
kd get p2 x2
x3 add x2 1
vd get p2 x3
isn eq kd 1
isp eq kd 2
q add vd 4096
slot select isp q vd
w_p shr slot 7
w_g get p0 w_p
w_w and slot 127
w get w_g w_w
nb0 shr w 16
nb and nb0 3
tt0 shr w 18
tt and tt0 3
k0 eq oi p4
good and p6 k0
bad select good 0 1
nb2 add nb bad
nb3 call cumin nb2 3
tt2 add tt 1
tt3 call cumin tt2 3
hb shl nb3 16
ht shl tt3 18
j1 add p5 1
nw0 or hb ht
nw or nw0 j1
val or isn isp
out select val nw w
r_h set w_g w_w out
r set p0 w_p r_h
ret r
end
fn wxuspg u32x128x64 u32 u32x128x512 u32 u32 u32 u32 bool -> u32x128x64
pi add p5 p1
pg get p2 pi
b mul pi 64
e add b 64
lo call umax p3 b
hi call cumin p4 e
cnt sub hi lo
r fold wxusa cnt p0 pg lo p3 p6 p7
ret r
end
# node p1 (first node p4) of the nodes p2 with operands p3
fn wxusn u32x128x64 u32 u32x128x132 u32x128x512 u32 -> u32x128x64
g add p4 p1
op call wxnw p2 g 1
na call wxnw p2 g 2
fa call wxnw p2 g 3
isg eq op 25
isa eq op 27
ga or isg isa
hi add fa na
has lt fa hi
lp shr fa 6
h1 sub hi 1
hp shr h1 6
d sub hp lp
np add d 1
n select has np 0
r fold wxuspg n p0 p3 fa hi lp p1 ga
ret r
end

fn wxroot u32x128x512 u32 u32 u32 u32 u32x128x64 u32 u32 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x200 -> u32x128x512
g add p3 p1
op call wxnw p8 g 1
fa call wxnw p8 g 3
t call wa24 p10 g
tag call wxtag p11 t
agg ge tag 4
o1 eq op 1
o26 eq op 26
o28 eq op 28
o20 eq op 20
o21 eq op 21
sp or o26 o28
fl or o20 o21
isa1 or sp fl
fa1 add fa 1
ik0 call wxok p9 fa
iv0 call wxov p9 fa
ik1 call wxok p9 fa1
iv1 call wxov p9 fa1
uk select fl ik1 ik0
uv select fl iv1 iv0
isn eq uk 1
isp eq uk 2
ug add p3 uv
dop call wxnw p8 ug 1
d22 eq dop 22
d23 eq dop 23
d24 eq dop 24
d26 eq dop 26
d28 eq dop 28
f1 or d22 d23
f2 or f1 d24
f3 or f2 d26
fresh or f3 d28
fr1 and isn fresh
ow eq p4 1
v0 eq uv 0
own0 and ow v0
own1 and isp own0
okk or fr1 own1
rk1 eq uk p6
rv1 eq uv p7
rs and rk1 rv1
nrs select rs false true
us0 add uv 4096
us1 select isp us0 uv
w call wxu64 p5 us1
nb0 shr w 16
nb and nb0 3
lu and w 65535
c1 eq nb 1
j1 add p1 1
c2 le lu j1
bg add 11264 g
bor call wxsh p12 bg
nbor eq bor 0
u1 and okk nrs
u2 and u1 c1
u3 and u2 c2
mut and u3 nbor
a1 and isa1 mut
a2 and a1 agg
a3 and agg o1
ali or a2 a3
uvn select isn uv 0
rr call wxrg p0 p2 uvn 3
rz eq rr 0
nrt add 268435456 uv
rootn select rz nrt rr
pw add 536870912 uv
tr select isn rootn pw
val select ali tr 0
nuse call wxu64 p5 p1
m1 fold wxrs 1 p0 p2 p1 3 val
r fold wxrs 1 m1 p2 p1 1 nuse
ret r
end
