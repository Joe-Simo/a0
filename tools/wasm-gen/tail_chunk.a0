fn warb384 (u32x384,io) u32 -> (u32x384,io)
buf at p0 0
tk at p0 1
r read tk
v at r 0
t at r 1
nb set buf p1 v
out rec nb t
ret out
end
fn wartty (u32x384x65,io) u32 u32 -> (u32x384x65,io)
src at p0 0
tk at p0 1
base mul p1 384
rest sub p2 base
big gt rest 384
cnt select big 384 rest
zp call z384
s0 rec zp tk
s fold warb384 cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warnty io u32 -> (u32x384x65,io)
z call zty
n383 add p1 383
np div n383 384
s0 rec z p0
s fold wartty np s0 p1
ret s
end
fn z200 -> u32x128x200
z call zpage
t arr z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z z
ret t
end
fn wart200 (u32x128x200,io) u32 u32 -> (u32x128x200,io)
src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn200 io u32 -> (u32x128x200,io)
z call z200
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart200 np s0 p1
ret s
end
# page p1 of the nodes table p2 (128 pages) into the 132-page table
fn wxcvn u32x128x132 u32 u32x128x128 -> u32x128x132
pg get p2 p1
r set p0 p1 pg
ret r
end
# the new chunk driver's wrapper in the shape the callers of compiler/optimize.a0 use: without
# the shape table (all analyses empty: not exact), the default options
fn wachunkst io u32 u32x384x65 u32x128x65 u32x128x45 u32x128x128 u32x128x512 u32x128x24 u32x128x400 u32x128x16 u32x128x16 u32x128x8 u32 u32 u32 u32 -> io
z call z200
zn call z132
nd fold wxcvn 128 zn p5
r call wachunk p0 p2 p3 p4 nd p6 p7 p8 p9 p10 p11 p12 p13 p14 p15 z 1 1
io at r 0
ret io
end
# mode 2: a chunk as tables, then the shape table (count, words), then (for tests) the simd option
# (2: off) and the unroll option (0: default 1)
fn wairchunk io -> (io,u32)
r1 call wardw p0
base at r1 0
t1 at r1 1
r2 call wardw t1
from at r2 0
t2 at r2 1
nd mul from 2
rd call warn16 t2 nd
dt at rd 0
t3 at rd 1
r4 call wardw t3
nty at r4 0
t4 at r4 1
ntw mul nty 3
rt call warnty t4 ntw
ty at rt 0
t5 at rt 1
r6 call wardw t5
ntl at r6 0
t6 at r6 1
rl call warn65 t6 ntl
tl at rl 0
t7 at rl 1
r8 call wardw t7
nf at r8 0
t8 at r8 1
nfw mul nf 7
rf call warn45 t8 nfw
fs at rf 0
t9 at rf 1
r10 call wardw t9
nn at r10 0
t10 at r10 1
nnw mul nn 6
rn call warn132 t10 nnw
nds at rn 0
t11 at rn 1
ry call warn24 t11 nn
nty2 at ry 0
t12 at ry 1
r13 call wardw t12
no at r13 0
t13 at r13 1
now mul no 2
ra call warn512 t13 now
ar at ra 0
t14 at ra 1
r15 call wardw t14
npl at r15 0
t15 at r15 1
rp call warn400 t15 npl
pl at rp 0
t16 at rp 1
nfm mul nf 2
rm call warn16 t16 nfm
fm at rm 0
t17 at rm 1
z8 call z8
r18 call wardw t17
nsh at r18 0
t18 at r18 1
rs call warn200 t18 nsh
sh at rs 0
t19 at rs 1
r19 call wardw t19
osd at r19 0
t20 at r19 1
r20 call wardw t20
ouw at r20 0
t21 at r20 1
simdoff eq osd 2
dmp eq osd 3
dmq eq osd 4
dmx or dmp dmq
sone0 select dmp 3 1
sone select dmq 4 sone0
simd select simdoff 0 sone
uz eq ouw 0
unroll select uz 1 ouw
w call wachunk t21 ty tl fs nds ar nty2 pl fm dt z8 nty from nf base sh simd unroll
ret w
end
fn wasunit io u32x512x64 u32 u32x128x8 u32 u32x128x16 u32 -> (io,u32)
lx call lexsrc p1 p2
toks at lx 0
nw at lx 1
ntok div nw 3
s1 call pass1 p1 toks ntok
sinfo at s1 1
ta at s1 2
tv at s1 3
hdrs at s1 5
nsym at s1 7
umode at s1 10
uerr at s1 11
uetok at s1 12
nhdr at s1 15
uopen ne umode 0
uerr0 eq uerr 0
ueof and uerr0 uopen
e1 select ueof 1 uerr
et1 select ueof ntok uetok
s2 call pass2 p1 sinfo nsym
pool at s2 0
s3 call pass3 p1 toks ta hdrs nhdr e1 et1 ntok
types at s3 0
tlist at s3 2
hout at s3 4
ntypes at s3 5
ntlist at s3 6
e3 at s3 11
et3 at s3 12
nhc at s3 18
nhn at s3 19
s4 call pass4 hout nhn nhc
fns0 at s4 0
names at s4 1
derr at s4 2
dtok at s4 3
dup ne derr 0
e4 select dup derr e3
et4 select dup dtok et3
s5 call pass5 fns0 names p1 toks ta tv ntok e4 et4 0
fns at s5 0
nodes at s5 1
alo at s5 2
narg at s5 5
args call bodyargs alo narg fns0 names p1 toks ta tv ntok e4 et4
fcs at s1 7
fcu at s1 8
fcp at s2 1
fch at s3 19
fct at s3 5
fcl at s3 6
fcn at s5 4
ovr call fecap toks ntok fcs fcp fcu fch fct fcl fcn narg
pcode0 at s5 8
pcode select ovr 4 pcode0
# after a parse error the function count may be below p4: nothing is checked then
cfrom call cumin p4 nhc
ck call checkir types tlist fns nodes args p3 ntypes ntlist nhc cfrom
types2 at ck 0
tlist2 at ck 2
ntys at ck 4
fstat at ck 7
ntypes2 at ck 8
cerr at ck 10
ns127 add nsym 127
nsp shr ns127 7
z64 call z64
st0 rec z64 0
st fold cstpg nsp st0 sinfo
starts at st 0
z16 call z16
fnm fold cfnm nhc z16 fns sinfo starts
pok eq pcode 0
code select pok cerr pcode
ok eq code 0
go select ok 1 0
t fold wachunkst go p0 types2 tlist2 fns nodes args ntys pool fnm p5 fstat ntypes2 p4 nhc p6
r rec t code
ret r
end

