src at p0 0
tk at p0 1
base mul p1 128
rest sub p2 base
big gt rest 128
cnt select big 128 rest
zp call zpage
s0 rec zp tk
s fold rbyte cnt s0
pg at s 0
t at s 1
src2 set src p1 pg
r rec src2 t
ret r
end
fn warn24 io u32 -> (u32x128x24,io)
z call z24
n127 add p1 127
np shr n127 7
s0 rec z p0
s fold wart24 np s0 p1
ret s
end
