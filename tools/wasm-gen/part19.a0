# One variant of one function (src/wasm.ts `FunctionEmitter.emit`).

# a runaway machine (too many steps) is an internal error
fn wxdbg u32x128x512 u32 -> u32x128x512
r fold wxs 1 p0 8 9
ret r
end
# the result slot of the value variant of a function with an aggregate result: the node the ret
# operand's root is, when that node owns storage (an `arr` `rec` `call` ... not get at select
# mov and not an alias); register 11 (4294967295: none)
fn wxrsl u32x128x512 u32 u32 u32x128x132 -> u32x128x512
rk call wxfg p0 0 5
rv call wxfg p0 0 6
g0 call wxfg p0 0 2
isn eq rk 1
rj select isn rv 0
rr call wxrg p0 0 rj 3
rz eq rr 0
rkk shr rr 28
rvv and rr 268435455
rnk eq rkk 1
rnode0 select rnk rvv 4294967295
rnode select rz rj rnode0
sflag ne p2 0
okn0 and isn sflag
hasn ne rnode 4294967295
okn and okn0 hasn
rn2 select okn rnode 0
rr2 call wxrg p0 0 rn2 3
al2 eq rr2 0
ng add g0 rn2
op call wxnw p3 ng 1
o25 eq op 25
o27 eq op 27
o18 eq op 18
o1 eq op 1
x1 or o25 o27
x2 or x1 o18
x3 or x2 o1
nox select x3 false true
c1 and okn al2
c2 and c1 nox
res select c2 rn2 4294967295
r fold wxs 1 p0 11 res
ret r
end
# the end of a top-level function (`emit`): the result is stored (owned variant, unless it is p0's
# storage; value variant with a result address, unless it is the result slot) or pushed (scalar);
# then the frame prologue (instruction slots 0-4) and epilogue
# the frame prologue in instruction slots 0-4: global.get 0; i32.const frame; i32.sub;
# local.tee fp; global.set 0
fn wxprol u32x128x512 u32 u32 u32 -> u32x128x512
m1 fold wxs 1 p0 20480 22
m2 fold wxs 1 m1 20481 0
m3 fold wxs 1 m2 20482 2
m4 fold wxs 1 m3 20483 p3
m5 fold wxs 1 m4 20484 1
m6 fold wxs 1 m5 20485 107
m7 fold wxs 1 m6 20486 5
m8 fold wxs 1 m7 20487 p2
m9 fold wxs 1 m8 20488 23
m10 fold wxs 1 m9 20489 0
ret m10
end
fn wxfinal u32x128x512 u32 u32x128x45 u32x128x65 -> u32x128x512
variant call wxfg p0 0 1
rk call wxfg p0 0 5
rv call wxfg p0 0 6
fi call wxfg p0 0 0
isn eq rk 1
rj select isn rv 0
rr call wxrg p0 0 rj 3
rkk shr rr 28
rvv and rr 268435455
isn2 eq rk 2
ispa eq rv 0
rp0 and isn2 ispa
rn1 eq rkk 2
rn2 eq rvv 0
rn3 and rn1 rn2
rnn1 and isn rn3
rp1 or rp0 rnn1
nrp0 select rp1 false true
own eq variant 1
sret call wxg p0 9
hasret ne sret 4294967295
rsl call wxg p0 11
norsl eq rsl 4294967295
pbase call wxg p0 10
rt call wxfw p2 fi 3
by call wxbyt p3 rt
c1 and own nrp0
v0 eq variant 0
sr1 and v0 hasret
sr2 and sr1 norsl
cp or c1 sr2
dst select own pbase sret
nown select own false true
nsr select hasret false true
sc1 and nown nsr
m1 fold wxlg cp p0 dst
m2 fold wxpsh cp m1 0 rk rv
m3 fold wxcp cp m2 by
m4 fold wxpsh sc1 m3 0 rk rv
fr call wxg m4 3
fr15 add fr 15
frame and fr15 4294967280
hf gt frame 0
fp call wxg m4 4
m5 fold wxlg hf m4 fp
m6 fold wxkc hf m5 frame
m7 fold wxop hf m6 106
m8 fold wxe hf m7 23 0
r fold wxprol hf m8 fp frame
ret r
end
# emit variant p3 of function p2 into the machine table (fresh: all zero): registers, frame 0 and
# its analysis, then the machine runs until the work stack is empty, then `wxfinal`; p4 is the
# number of pool occurrences of the function so far, p5 / p6 the simd and unroll options
fn wxemit u32x128x512 u32 u32 u32 u32 u32 u32 u32x128x45 u32x128x132 u32x128x512 u32x128x24 u32x384x65 u32x128x65 u32x128x65 u32x128x200 u32x128x16 -> u32x128x512
np call wxfw p7 p2 1
nn call wxfw p7 p2 5
rt call wxfw p7 p2 3
rtag call wxtag p11 rt
ragg ge rtag 4
v0 eq p3 0
sret and v0 ragg
pbase select sret 1 0
pcount add pbase np
srt select sret 0 4294967295
m1 fold wxs 1 p0 0 5
m2 fold wxs 1 m1 1 pcount
m3 fold wxs 1 m2 4 4294967295
m4 fold wxs 1 m3 5 p4
m5 fold wxs 1 m4 9 srt
m6 fold wxs 1 m5 10 pbase
m7 fold wxs 1 m6 11 4294967295
m8 fold wxs 1 m7 13 p5
m9 fold wxs 1 m8 14 p6
m10 fold wxfset 1 m9 0 p2 p3 p7 p9
m11 fold wxana 1 m10 0 p2 p3 p7 p8 p9 p10 p11 p14
sretu select sret 1 0
m12 fold wxrsl sret m11 sretu p8
has gt nn 0
m13 fold wxpu has m12 1 0 0 0
bign add 0 16777216
m14 loop wxgo wxstep bign m13 p7 p8 p9 p10 p11 p12 p13 p14 p15
st call wxg m14 95
bigs ge st 400000
m14b fold wxdbg bigs m14
m15 fold wxfinal 1 m14b p7 p13
ret m15
end
