# extra p1 (operands from p3, table p4) of loop p2 resolved into the loop context
fn wxext u32x128x512 u32 u32 u32 u32x128x512 -> u32x128x512
o add p3 p1
k call wxok p4 o
v call wxov p4 o
m1 fold wxres 1 p0 p2 k v
c call wxg m1 16
s call wxg m1 17
a0 mul p1 2
a1 add a0 104
a2 add a1 1
m2 fold wxcs 1 m1 p2 a1 c
m3 fold wxcs 1 m2 p2 a2 s
ret m3
end
# clear induction slot p1 of loop p2 (local + 1 and step)
fn wxcclr u32x128x512 u32 u32 -> u32x128x512
a add 40 p1
b add 72 p1
m1 fold wxcs 1 p0 p2 a 0
m2 fold wxcs 1 m1 p2 b 0
ret m2
end
# state word p1 of loop p2 (state local p3) is loaded into a fresh local
fn wxfld1 u32x128x512 u32 u32 u32 -> u32x128x512
m1 fold wxnl 1 p0
l call wxg m1 16
off mul p1 4
m2 fold wxlg 1 m1 p3
m3 fold wxld 1 m2 off
m4 fold wxls 1 m3 l
a add 168 p1
m5 fold wxcs 1 m4 p2 a l
ret m5
end
# strength reduction: body node p1 (first node p3) of loop p2 that is `p1 * K` (or `K * p1`)
# with K a literal gets an induction local starting at start * K (start p6)
fn wxind1 u32x128x512 u32 u32 u32 u32x128x132 u32x128x512 u32 -> u32x128x512
g add p3 p1
op call wxnw p4 g 1
fa call wxnw p4 g 3
fa1 add fa 1
k0 call wxok p5 fa
v0 call wxov p5 fa
k1 call wxok p5 fa1
v1 call wxov p5 fa1
ism eq op 4
i0a eq k0 2
i0b eq v0 1
isi0 and i0a i0b
i1a eq k1 2
i1b eq v1 1
isi1 and i1a i1b
l1 eq k1 3
l0 eq k0 3
c1 and isi0 l1
c2a and isi1 l0
nc1 select c1 false true
c2 and c2a nc1
cc or c1 c2
found and ism cc
kv select c1 v1 v0
m1 fold wxnl found p0
l call wxg m1 16
iv mul p6 kv
m2 fold wxkc found m1 iv
m3 fold wxls found m2 l
l1p add l 1
a add 40 p1
b add 72 p1
m4 fold wxcs found m3 p2 a l1p
m5 fold wxcs found m4 p2 b kv
ret m5
end
# carried previous element (src/wasm.ts `carriedRead`): register 31 counts the set/put nodes of
# the body (first node p2), 28 := 1 when the body is `set p0 p1 v` (its ret) with exactly one update
# and some `get p0 (p1 - 1)` whose node is in 29 (the first), the set node in 30
fn wxcr0 u32x128x512 u32 u32 u32x128x132 -> u32x128x512
g add p2 p1
op call wxnw p3 g 1
o26 eq op 26
o28 eq op 28
u or o26 o28
n call wxg p0 31
n1 add n 1
r fold wxs u p0 31 n1
ret r
end
fn wxcr1 u32x128x512 u32 u32 u32x128x132 u32x128x512 -> u32x128x512
g add p2 p1
op call wxnw p3 g 1
fa call wxnw p3 g 3
fa1 add fa 1
k0 call wxok p4 fa
v0 call wxov p4 fa
k1 call wxok p4 fa1
v1 call wxov p4 fa1
isg eq op 25
a1 eq k0 2
a2 eq v0 0
isp0 and a1 a2
b1 eq k1 1
dg add p2 v1
dop call wxnw p3 dg 1
dfa call wxnw p3 dg 3
dfa1 add dfa 1
dk0 call wxok p4 dfa
dv0 call wxov p4 dfa
dk1 call wxok p4 dfa1
dv1 call wxov p4 dfa1
is3 eq dop 3
e1 eq dk0 2
e2 eq dv0 1
isp1 and e1 e2
e3 eq dk1 3
e4 eq dv1 1
one and e3 e4
cur call wxg p0 29
none eq cur 4294967295
t1 and isg isp0
t2 and t1 b1
t3 and t2 is3
t4 and t3 isp1
t5 and t4 one
hit and t5 none
r fold wxs hit p0 29 p1
ret r
end
fn wxcarry u32x128x512 u32 u32 u32x128x45 u32x128x132 u32x128x512 -> u32x128x512
g0 call wxfw p3 p2 4
nn call wxfw p3 p2 5
rw call wxfw p3 p2 6
rop call waretop p5 rw
rk at rop 0
rv at rop 1
isn eq rk 1
sj select isn rv 0
sg add g0 sj
sop call wxnw p4 sg 1
sfa call wxnw p4 sg 3
sfa1 add sfa 1
sk0 call wxok p5 sfa
sv0 call wxov p5 sfa
sk1 call wxok p5 sfa1
sv1 call wxov p5 sfa1
a1 eq sop 26
a2 eq sk0 2
a3 eq sv0 0
a4 eq sk1 2
a5 eq sv1 1
b1 and isn a1
b2 and b1 a2
b3 and b2 a3
b4 and b3 a4
cond and b4 a5
m1 fold wxs 1 p0 31 0
m2 fold wxs 1 m1 29 4294967295
m3 fold wxcr0 nn m2 g0 p4
m4 fold wxcr1 nn m3 g0 p4 p5
cnt call wxg m4 31
gj call wxg m4 29
one eq cnt 1
fnd ne gj 4294967295
c1 and cond one
c2 and c1 fnd
f select c2 1 0
m5 fold wxs 1 m4 28 f
m6 fold wxs 1 m5 30 sj
ret m6
end
