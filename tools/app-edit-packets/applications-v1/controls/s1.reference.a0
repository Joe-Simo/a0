fn edge_pt u32 u32 u32 u32 u32 u32 -> (u32,u32)
cx call fx_clamp p4 p0 p2
cy call fx_clamp p5 p1 p3
inx eq cx p4
iny eq cy p5
inside and inx iny
dl sub p4 p0
dr sub p2 p4
dt sub p5 p1
db sub p3 p5
m1 call fx_min dl dr
m2 call fx_min dt db
m call fx_min m1 m2
isl eq m dl
isr eq m dr
ist eq m dt
ex2 select isr p2 p4
ex select isl p0 ex2
ey4 select ist p1 p3
ey5 select isr p5 ey4
ey6 select isl p5 ey5
rx select inside ex cx
ry select inside ey6 cy
r rec rx ry
ret r
end
