{ "tasks": [
{ "id": "h-at-most-100", "kind": "targeted-edit", "wrongEditKind": "off-by-one", "target": "f",
  "instruction": "Return true when the argument is at most 100, with 100 itself included.",
  "start": { "functions": [ { "name": "f", "params": ["u32"], "result": "bool",
    "body": [ { "id": "a", "op": "lt", "args": ["p0", 100] }, { "id": "b", "op": "mov", "args": ["a"] } ], "ret": "b" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32"], "result": "bool",
    "body": [ { "id": "a", "op": "le", "args": ["p0", 100] }, { "id": "b", "op": "mov", "args": ["a"] } ], "ret": "b" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32"], "result": "bool",
    "body": [ { "id": "a", "op": "le", "args": ["p0", 101] }, { "id": "b", "op": "mov", "args": ["a"] } ], "ret": "b" } ] } ],
  "tests": [
    { "fn": "f", "args": [0], "expected": true }, { "fn": "f", "args": [1], "expected": true },
    { "fn": "f", "args": [50], "expected": true }, { "fn": "f", "args": [99], "expected": true },
    { "fn": "f", "args": [100], "expected": true }, { "fn": "f", "args": [101], "expected": false },
    { "fn": "f", "args": [1000], "expected": false }, { "fn": "f", "args": [4294967295], "expected": false } ],
  "note": "Boundary comparison; start excludes 100, wrong edit includes 101." },

{ "id": "h-low-byte", "kind": "targeted-edit", "wrongEditKind": "changed-constant", "target": "f",
  "instruction": "Return the lowest 8 bits of the argument.",
  "start": { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "m", "op": "and", "args": ["p0", 127] }, { "id": "r", "op": "mov", "args": ["m"] } ], "ret": "r" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "m", "op": "and", "args": ["p0", 255] }, { "id": "r", "op": "mov", "args": ["m"] } ], "ret": "r" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "m", "op": "and", "args": ["p0", 256] }, { "id": "r", "op": "mov", "args": ["m"] } ], "ret": "r" } ] } ],
  "tests": [
    { "fn": "f", "args": [0], "expected": 0 }, { "fn": "f", "args": [127], "expected": 127 },
    { "fn": "f", "args": [128], "expected": 128 }, { "fn": "f", "args": [255], "expected": 255 },
    { "fn": "f", "args": [256], "expected": 0 }, { "fn": "f", "args": [300], "expected": 44 },
    { "fn": "f", "args": [511], "expected": 255 }, { "fn": "f", "args": [4294967295], "expected": 255 } ],
  "note": "Bit mask constant; 127 drops bit 7, 256 is a single bit." },

{ "id": "h-last-elem", "kind": "targeted-edit", "wrongEditKind": "off-by-one", "target": "f",
  "instruction": "Return the last element of the array.",
  "start": { "functions": [ { "name": "f", "params": ["u32x4"], "result": "u32",
    "body": [ { "id": "e", "op": "get", "args": ["p0", 4] }, { "id": "r", "op": "mov", "args": ["e"] } ], "ret": "r" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32x4"], "result": "u32",
    "body": [ { "id": "e", "op": "get", "args": ["p0", 3] }, { "id": "r", "op": "mov", "args": ["e"] } ], "ret": "r" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32x4"], "result": "u32",
    "body": [ { "id": "e", "op": "get", "args": ["p0", 2] }, { "id": "r", "op": "mov", "args": ["e"] } ], "ret": "r" } ] } ],
  "tests": [
    { "fn": "f", "args": [[1,2,3,4]], "expected": 4 }, { "fn": "f", "args": [[0,0,0,0]], "expected": 0 },
    { "fn": "f", "args": [[9,8,7,6]], "expected": 6 }, { "fn": "f", "args": [[5,5,5,5]], "expected": 5 },
    { "fn": "f", "args": [[4294967295,0,0,1]], "expected": 1 }, { "fn": "f", "args": [[0,0,0,4294967295]], "expected": 4294967295 },
    { "fn": "f", "args": [[1,0,0,0]], "expected": 0 }, { "fn": "f", "args": [[7,1,2,3]], "expected": 3 } ],
  "note": "Index 4 wraps to 0 under modulo indexing." },

{ "id": "h-saturating-add", "kind": "targeted-edit", "wrongEditKind": "wrapping", "target": "f",
  "instruction": "Return the sum of the two arguments, but when the true sum does not fit in 32 bits return 4294967295 instead of a wrapped value.",
  "start": { "functions": [ { "name": "f", "params": ["u32","u32"], "result": "u32",
    "body": [ { "id": "s", "op": "add", "args": ["p0","p1"] }, { "id": "o", "op": "lt", "args": ["s","p0"] },
              { "id": "r", "op": "select", "args": ["o", 0, "s"] } ], "ret": "r" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32","u32"], "result": "u32",
    "body": [ { "id": "s", "op": "add", "args": ["p0","p1"] }, { "id": "o", "op": "lt", "args": ["s","p0"] },
              { "id": "r", "op": "select", "args": ["o", 4294967295, "s"] } ], "ret": "r" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32","u32"], "result": "u32",
    "body": [ { "id": "s", "op": "add", "args": ["p0","p1"] }, { "id": "o", "op": "le", "args": ["s","p0"] },
              { "id": "r", "op": "select", "args": ["o", 4294967295, "s"] } ], "ret": "r" } ] } ],
  "tests": [
    { "fn": "f", "args": [1,2], "expected": 3 }, { "fn": "f", "args": [0,0], "expected": 0 },
    { "fn": "f", "args": [5,0], "expected": 5 }, { "fn": "f", "args": [4294967295,0], "expected": 4294967295 },
    { "fn": "f", "args": [4294967295,1], "expected": 4294967295 }, { "fn": "f", "args": [2147483648,2147483648], "expected": 4294967295 },
    { "fn": "f", "args": [4294967290,5], "expected": 4294967295 }, { "fn": "f", "args": [4294967290,6], "expected": 4294967295 },
    { "fn": "f", "args": [100,4294967200], "expected": 4294967295 } ],
  "note": "Overflow detected by wrapped sum < first operand; wrong edit uses <= and misfires when p1 is 0." },

{ "id": "h-set-second", "kind": "targeted-edit", "wrongEditKind": "swapped-argument", "target": "f",
  "instruction": "Return a copy of the array with the element at position 1 (the second element) replaced by the second argument.",
  "start": { "functions": [ { "name": "f", "params": ["u32x4","u32"], "result": "u32x4",
    "body": [ { "id": "n", "op": "set", "args": ["p0","p1",1] }, { "id": "r", "op": "mov", "args": ["n"] } ], "ret": "r" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32x4","u32"], "result": "u32x4",
    "body": [ { "id": "n", "op": "set", "args": ["p0",1,"p1"] }, { "id": "r", "op": "mov", "args": ["n"] } ], "ret": "r" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32x4","u32"], "result": "u32x4",
    "body": [ { "id": "n", "op": "set", "args": ["p0",2,"p1"] }, { "id": "r", "op": "mov", "args": ["n"] } ], "ret": "r" } ] } ],
  "tests": [
    { "fn": "f", "args": [[0,0,0,0],7], "expected": [0,7,0,0] }, { "fn": "f", "args": [[1,2,3,4],9], "expected": [1,9,3,4] },
    { "fn": "f", "args": [[1,2,3,4],2], "expected": [1,2,3,4] }, { "fn": "f", "args": [[5,6,7,8],0], "expected": [5,0,7,8] },
    { "fn": "f", "args": [[0,0,0,0],4294967295], "expected": [0,4294967295,0,0] }, { "fn": "f", "args": [[9,9,9,9],1], "expected": [9,1,9,9] },
    { "fn": "f", "args": [[1,1,1,1],5], "expected": [1,5,1,1] }, { "fn": "f", "args": [[4,3,2,1],3], "expected": [4,3,2,1] } ],
  "note": "Start swaps index and value; wrong edit writes position 2." },

{ "id": "h-is-even", "kind": "targeted-edit", "wrongEditKind": "bit-mask", "target": "f",
  "instruction": "Return true when the argument is even.",
  "start": { "functions": [ { "name": "f", "params": ["u32"], "result": "bool",
    "body": [ { "id": "lo", "op": "and", "args": ["p0",1] }, { "id": "t", "op": "eq", "args": ["lo",1] } ], "ret": "t" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32"], "result": "bool",
    "body": [ { "id": "lo", "op": "and", "args": ["p0",1] }, { "id": "t", "op": "eq", "args": ["lo",0] } ], "ret": "t" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32"], "result": "bool",
    "body": [ { "id": "lo", "op": "and", "args": ["p0",2] }, { "id": "t", "op": "eq", "args": ["lo",0] } ], "ret": "t" } ] } ],
  "tests": [
    { "fn": "f", "args": [0], "expected": true }, { "fn": "f", "args": [1], "expected": false },
    { "fn": "f", "args": [2], "expected": true }, { "fn": "f", "args": [3], "expected": false },
    { "fn": "f", "args": [6], "expected": true }, { "fn": "f", "args": [7], "expected": false },
    { "fn": "f", "args": [4294967294], "expected": true }, { "fn": "f", "args": [4294967295], "expected": false } ],
  "note": "Bool result; start tests odd." },

{ "id": "h-abs-diff", "kind": "targeted-edit", "wrongEditKind": "comparison", "target": "f",
  "instruction": "Return the absolute difference between the two arguments.",
  "start": { "functions": [
    { "name": "d", "params": ["u32","u32"], "result": "u32", "body": [ { "id": "x", "op": "sub", "args": ["p0","p1"] }, { "id": "y", "op": "mov", "args": ["x"] } ], "ret": "y" },
    { "name": "f", "params": ["u32","u32"], "result": "u32",
      "body": [ { "id": "a", "op": "lt", "args": ["p0","p1"] }, { "id": "b", "op": "call", "args": ["d","p1","p0"] },
                { "id": "c", "op": "call", "args": ["d","p0","p1"] }, { "id": "r", "op": "select", "args": ["a","c","b"] } ], "ret": "r" } ] },
  "reference": { "functions": [
    { "name": "d", "params": ["u32","u32"], "result": "u32", "body": [ { "id": "x", "op": "sub", "args": ["p0","p1"] }, { "id": "y", "op": "mov", "args": ["x"] } ], "ret": "y" },
    { "name": "f", "params": ["u32","u32"], "result": "u32",
      "body": [ { "id": "a", "op": "lt", "args": ["p0","p1"] }, { "id": "b", "op": "call", "args": ["d","p1","p0"] },
                { "id": "c", "op": "call", "args": ["d","p0","p1"] }, { "id": "r", "op": "select", "args": ["a","b","c"] } ], "ret": "r" } ] },
  "wrongEdits": [ { "functions": [
    { "name": "d", "params": ["u32","u32"], "result": "u32", "body": [ { "id": "x", "op": "sub", "args": ["p0","p1"] }, { "id": "y", "op": "mov", "args": ["x"] } ], "ret": "y" },
    { "name": "f", "params": ["u32","u32"], "result": "u32",
      "body": [ { "id": "a", "op": "gt", "args": ["p0","p1"] }, { "id": "b", "op": "call", "args": ["d","p1","p0"] },
                { "id": "c", "op": "call", "args": ["d","p0","p1"] }, { "id": "r", "op": "select", "args": ["a","b","c"] } ], "ret": "r" } ] } ],
  "tests": [
    { "fn": "f", "args": [3,5], "expected": 2 }, { "fn": "f", "args": [5,3], "expected": 2 },
    { "fn": "f", "args": [0,0], "expected": 0 }, { "fn": "f", "args": [10,10], "expected": 0 },
    { "fn": "f", "args": [0,4294967295], "expected": 4294967295 }, { "fn": "f", "args": [4294967295,0], "expected": 4294967295 },
    { "fn": "f", "args": [1,2], "expected": 1 }, { "fn": "f", "args": [100,1], "expected": 99 } ],
  "note": "Helper call; start picks the wrapped (negative) difference." },

{ "id": "h-times-eight", "kind": "targeted-edit", "wrongEditKind": "changed-constant", "target": "f",
  "instruction": "Return the argument multiplied by 8 (wrapping modulo 2^32).",
  "start": { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "s", "op": "shl", "args": ["p0",2] }, { "id": "r", "op": "mov", "args": ["s"] } ], "ret": "r" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "s", "op": "shl", "args": ["p0",3] }, { "id": "r", "op": "mov", "args": ["s"] } ], "ret": "r" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "s", "op": "shl", "args": ["p0",8] }, { "id": "r", "op": "mov", "args": ["s"] } ], "ret": "r" } ] } ],
  "tests": [
    { "fn": "f", "args": [0], "expected": 0 }, { "fn": "f", "args": [1], "expected": 8 },
    { "fn": "f", "args": [2], "expected": 16 }, { "fn": "f", "args": [5], "expected": 40 },
    { "fn": "f", "args": [100], "expected": 800 }, { "fn": "f", "args": [536870911], "expected": 4294967288 },
    { "fn": "f", "args": [536870912], "expected": 0 }, { "fn": "f", "args": [4294967295], "expected": 4294967288 } ],
  "note": "Shift distance is log2 of the factor, not the factor." },

{ "id": "h-sum-squares", "kind": "multi-node-edit", "wrongEditKind": "fold-bound", "target": "f",
  "instruction": "Return the sum of the squares of all four array elements (wrapping modulo 2^32).",
  "start": { "functions": [
    { "name": "step", "params": ["u32","u32","u32x4"], "result": "u32",
      "body": [ { "id": "g", "op": "get", "args": ["p2","p1"] }, { "id": "s", "op": "add", "args": ["p0","g"] } ], "ret": "s" },
    { "name": "f", "params": ["u32x4"], "result": "u32",
      "body": [ { "id": "t", "op": "fold", "args": ["step",3,0,"p0"] }, { "id": "r", "op": "mov", "args": ["t"] } ], "ret": "r" } ] },
  "reference": { "functions": [
    { "name": "step", "params": ["u32","u32","u32x4"], "result": "u32",
      "body": [ { "id": "g", "op": "get", "args": ["p2","p1"] }, { "id": "q", "op": "mul", "args": ["g","g"] }, { "id": "s", "op": "add", "args": ["p0","q"] } ], "ret": "s" },
    { "name": "f", "params": ["u32x4"], "result": "u32",
      "body": [ { "id": "t", "op": "fold", "args": ["step",4,0,"p0"] }, { "id": "r", "op": "mov", "args": ["t"] } ], "ret": "r" } ] },
  "wrongEdits": [ { "functions": [
    { "name": "step", "params": ["u32","u32","u32x4"], "result": "u32",
      "body": [ { "id": "g", "op": "get", "args": ["p2","p1"] }, { "id": "q", "op": "mul", "args": ["g","g"] }, { "id": "s", "op": "add", "args": ["p0","q"] } ], "ret": "s" },
    { "name": "f", "params": ["u32x4"], "result": "u32",
      "body": [ { "id": "t", "op": "fold", "args": ["step",3,0,"p0"] }, { "id": "r", "op": "mov", "args": ["t"] } ], "ret": "r" } ] } ],
  "tests": [
    { "fn": "f", "args": [[1,2,3,4]], "expected": 30 }, { "fn": "f", "args": [[0,0,0,0]], "expected": 0 },
    { "fn": "f", "args": [[0,0,0,5]], "expected": 25 }, { "fn": "f", "args": [[1,1,1,1]], "expected": 4 },
    { "fn": "f", "args": [[65536,0,0,0]], "expected": 0 }, { "fn": "f", "args": [[65535,0,0,0]], "expected": 4294836225 },
    { "fn": "f", "args": [[2,0,0,3]], "expected": 13 }, { "fn": "f", "args": [[10,10,10,10]], "expected": 400 } ],
  "note": "Needs both squaring in the helper and the fold count raised to 4." },

{ "id": "h-in-range", "kind": "multi-node-edit", "wrongEditKind": "comparison", "target": "f",
  "instruction": "Return true when the first argument lies between the second and third arguments, with both ends included.",
  "start": { "functions": [ { "name": "f", "params": ["u32","u32","u32"], "result": "bool",
    "body": [ { "id": "lo", "op": "gt", "args": ["p0","p1"] }, { "id": "hi", "op": "lt", "args": ["p0","p2"] },
              { "id": "both", "op": "and", "args": ["lo","hi"] } ], "ret": "both" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32","u32","u32"], "result": "bool",
    "body": [ { "id": "lo", "op": "ge", "args": ["p0","p1"] }, { "id": "hi", "op": "le", "args": ["p0","p2"] },
              { "id": "both", "op": "and", "args": ["lo","hi"] } ], "ret": "both" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32","u32","u32"], "result": "bool",
    "body": [ { "id": "lo", "op": "ge", "args": ["p0","p1"] }, { "id": "hi", "op": "lt", "args": ["p0","p2"] },
              { "id": "both", "op": "and", "args": ["lo","hi"] } ], "ret": "both" } ] } ],
  "tests": [
    { "fn": "f", "args": [5,1,10], "expected": true }, { "fn": "f", "args": [1,1,10], "expected": true },
    { "fn": "f", "args": [10,1,10], "expected": true }, { "fn": "f", "args": [0,1,10], "expected": false },
    { "fn": "f", "args": [11,1,10], "expected": false }, { "fn": "f", "args": [5,5,5], "expected": true },
    { "fn": "f", "args": [0,0,4294967295], "expected": true }, { "fn": "f", "args": [4294967295,0,4294967295], "expected": true },
    { "fn": "f", "args": [3,5,2], "expected": false } ],
  "note": "Both bounds must become inclusive; wrong edit fixes only the lower." },

{ "id": "h-second-byte", "kind": "multi-node-edit", "wrongEditKind": "changed-constant", "target": "f",
  "instruction": "Change the function to return bits 8 through 15 of the argument (its second-lowest byte) instead of bits 4 through 7.",
  "start": { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "sh", "op": "shr", "args": ["p0",4] }, { "id": "m", "op": "and", "args": ["sh",15] } ], "ret": "m" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "sh", "op": "shr", "args": ["p0",8] }, { "id": "m", "op": "and", "args": ["sh",255] } ], "ret": "m" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32"], "result": "u32",
    "body": [ { "id": "sh", "op": "shr", "args": ["p0",8] }, { "id": "m", "op": "and", "args": ["sh",15] } ], "ret": "m" } ] } ],
  "tests": [
    { "fn": "f", "args": [0], "expected": 0 }, { "fn": "f", "args": [255], "expected": 0 },
    { "fn": "f", "args": [256], "expected": 1 }, { "fn": "f", "args": [4096], "expected": 16 },
    { "fn": "f", "args": [4660], "expected": 18 }, { "fn": "f", "args": [43981], "expected": 171 },
    { "fn": "f", "args": [65280], "expected": 255 }, { "fn": "f", "args": [65535], "expected": 255 },
    { "fn": "f", "args": [4294967295], "expected": 255 } ],
  "note": "Shift and mask both change; wrong edit keeps the 4-bit mask." },

{ "id": "h-swap-ends", "kind": "multi-node-edit", "wrongEditKind": "swapped-argument", "target": "f",
  "instruction": "Change the function so it swaps the first and last elements of the array instead of the first two.",
  "start": { "functions": [ { "name": "f", "params": ["u32x4"], "result": "u32x4",
    "body": [ { "id": "x", "op": "get", "args": ["p0",0] }, { "id": "y", "op": "get", "args": ["p0",1] },
              { "id": "u", "op": "set", "args": ["p0",0,"y"] }, { "id": "v", "op": "set", "args": ["u",1,"x"] } ], "ret": "v" } ] },
  "reference": { "functions": [ { "name": "f", "params": ["u32x4"], "result": "u32x4",
    "body": [ { "id": "x", "op": "get", "args": ["p0",0] }, { "id": "y", "op": "get", "args": ["p0",3] },
              { "id": "u", "op": "set", "args": ["p0",0,"y"] }, { "id": "v", "op": "set", "args": ["u",3,"x"] } ], "ret": "v" } ] },
  "wrongEdits": [ { "functions": [ { "name": "f", "params": ["u32x4"], "result": "u32x4",
    "body": [ { "id": "x", "op": "get", "args": ["p0",0] }, { "id": "y", "op": "get", "args": ["p0",3] },
              { "id": "u", "op": "set", "args": ["p0",0,"y"] }, { "id": "v", "op": "set", "args": ["u",3,"y"] } ], "ret": "v" } ] } ],
  "tests": [
    { "fn": "f", "args": [[1,2,3,4]], "expected": [4,2,3,1] }, { "fn": "f", "args": [[0,0,0,0]], "expected": [0,0,0,0] },
    { "fn": "f", "args": [[5,6,7,5]], "expected": [5,6,7,5] }, { "fn": "f", "args": [[9,0,0,1]], "expected": [1,0,0,9] },
    { "fn": "f", "args": [[4294967295,1,2,0]], "expected": [0,1,2,4294967295] }, { "fn": "f", "args": [[1,1,2,2]], "expected": [2,1,2,1] },
