+void a0_runtime_write_many(a0_arena_session *s, const uint32_t *words,
+                           uint32_t count) {
+  assert(s != NULL);
+  assert(words != NULL || count == 0);
+  while (count != 0) {
+    if (s->protocol_failed) return;
+    if (s->response_position == s->response_count && s->request_phase == 2) {
+      const uint32_t remaining = s->argument_count - s->arguments_received;
+      const uint32_t n = count < remaining ? count : remaining;
+      assert(n != 0);
+      memcpy(s->arguments + s->arguments_received, words,
+             (size_t)n * sizeof(uint32_t));
+      s->arguments_received += n;
+      words += n;
+      count -= n;
+      if (s->arguments_received == s->argument_count) complete_request(s);
+    } else {
+      a0_runtime_write(s, *words++);
+      count--;
+    }
+  }
+}
